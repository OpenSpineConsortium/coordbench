+MonitorCallback = t.Callable[[str, int, str, float], None]
+
+# How often the monitor looks at the editor process, in seconds. Short
+# enough to notice a suspension while the editor is still on screen,
+# long enough to cost nothing next to a person typing.
+_MONITOR_INTERVAL = 0.1
+
+
+def _monitor_settings(option: t.Any) -> tuple[MonitorCallback, float] | None:
+    """Turn the ``monitor_process`` argument of :func:`click.edit` into
+    the callback to call and the polling interval, or ``None`` when
+    monitoring is off. The argument is either the callback itself or a
+    configuration object with a ``callback`` and optionally an
+    ``interval`` in seconds, given as a mapping or as attributes.
+    """
+    if option is None or option is False:
+        return None
+
+    if callable(option):
+        return option, _MONITOR_INTERVAL
+
+    if isinstance(option, cabc.Mapping):
+        callback = option.get("callback")
+        interval = option.get("interval", _MONITOR_INTERVAL)
+    else:
+        callback = getattr(option, "callback", None)
+        interval = getattr(option, "interval", _MONITOR_INTERVAL)
+
+    if not callable(callback):
+        raise TypeError(
+            "monitor_process must be a callable or a configuration object"
+            " with a callable 'callback'."
+        )
+
+    if (
+        isinstance(interval, bool)
+        or not isinstance(interval, (int, float))
+        or not interval > 0
+    ):
+        raise TypeError("The monitor_process interval must be a positive number.")
+
+    return callback, interval
+
+
+def _is_process_stopped(pid: int) -> bool | None:
+    """Whether the process is stopped by a signal such as SIGSTOP or
+    SIGTSTP, or ``None`` if this platform gives no way to tell. Only
+    Linux's ``/proc`` is read; elsewhere an editor shows no suspend or
+    resume events, which the callback interface allows.
+    """
+    try:
+        with open(f"/proc/{pid}/stat", "rb") as f:
+            stat = f.read()
+    except (OSError, ValueError):
+        return None
+
+    # The state is the field after the command name. The name sits in
+    # parentheses and may itself contain spaces or parentheses, so
+    # split after the last closing one.
+    fields = stat.rpartition(b")")[2].split()
+
+    if not fields:
+        return None
+
+    return fields[0] in (b"T", b"t")
+
+
+class _ProcessMonitor:
+    """Reports the life of an editor process to a callback from a
+    thread of its own, while the caller keeps blocking on the editor.
+
+    The thread calls the callback as ``callback(event_type, process_id,
+    editor_command, timestamp)``, one call at a time and in order:
+    ``"start"``, then ``"suspend"`` and ``"resume"`` as the process is
+    stopped and continued, and ``"terminate"`` once :meth:`stop` is
+    called. :meth:`stop` returns after the last call, so no callback
+    runs once the caller has gone on.
+
+    A callback that raises does not end the monitoring: the error
+    becomes a :class:`UserWarning` and later events are still reported.
+    """
+
+    def __init__(
+        self,
+        process_id: int,
+        editor_command: str,
+        callback: MonitorCallback,
+        interval: float = _MONITOR_INTERVAL,
+    ) -> None:
+        import threading
+
+        self.process_id = process_id
+        self.editor_command = editor_command
+        self.callback = callback
+        self.interval = interval
+        self._done = threading.Event()
+        self._thread = threading.Thread(
+            target=self._run, name="click-editor-monitor", daemon=True
+        )
+
+    def start(self) -> None:
+        self._thread.start()
+
+    def stop(self) -> None:
+        """Report the termination and wait for the thread to finish."""
+        self._done.set()
+        self._thread.join()
+
+    def _run(self) -> None:
+        self._notify("start")
+        suspended = False
+
+        while not self._done.wait(self.interval):
+            stopped = _is_process_stopped(self.process_id)
+
+            if stopped is None or stopped == suspended:
+                continue
+
+            suspended = stopped
+            self._notify("suspend" if suspended else "resume")
+
+        self._notify("terminate")
+
+    def _notify(self, event_type: str) -> None:
+        import warnings
+
+        try:
+            self.callback(
+                event_type, self.process_id, self.editor_command, time.time()
+            )
+        except Exception as e:
+            # A broken callback must neither stop the editor session nor
+            # the monitoring. A warning filter that turns warnings into
+            # errors must not kill the thread either.
+            with contextlib.suppress(Exception):
+                warnings.warn(
+                    f"The editor process monitor callback failed on"
+                    f" {event_type!r}: {e!r}",
+                    UserWarning,
+                    stacklevel=2,
+                )
+
+
