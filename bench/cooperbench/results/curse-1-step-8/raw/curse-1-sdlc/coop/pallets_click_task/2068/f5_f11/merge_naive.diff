+    def _get_lock_filename(self, filename: str) -> str:
+        """Return the path of the lock file that guards ``filename``.
+
+        The lock sits beside the file as ``.{name}.lock``, so two
+        sessions editing the same file always agree on where it is.
+        """
+        directory, name = os.path.split(filename)
+        return os.path.join(directory, f".{name}.lock")
+
+    def _create_lock_file(self, filename: str) -> str:
+        """Create the lock file for ``filename`` and return its path.
+
+        The file is created with ``O_CREAT | O_EXCL``, which makes the
+        existence check and the creation one atomic step on every
+        platform, so two processes can never both believe they made the
+        lock. It records the process id and the time, to help whoever
+        has to work out why a lock is still there.
+
+        :raises ClickException: if the lock exists, which means another
+            edit session holds the file, or if it cannot be created.
+        """
+        from datetime import datetime
+
+        lock_filename = self._get_lock_filename(filename)
+
+        try:
+            fd = os.open(lock_filename, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
+        except FileExistsError as e:
+            raise ClickException(
+                _(
+                    "{filename}: Editing failed: the file is already being"
+                    " edited by another process ({lock} already exists)"
+                ).format(filename=filename, lock=lock_filename)
+            ) from e
+        except OSError as e:
+            raise ClickException(
+                _("{filename}: Editing failed: cannot create {lock}: {e}").format(
+                    filename=filename, lock=lock_filename, e=e
+                )
+            ) from e
+
+        try:
+            with os.fdopen(fd, "w", encoding="utf-8") as f:
+                f.write(f"PID: {os.getpid()}\nTime: {datetime.now().isoformat()}")
+        except BaseException:
+            # A lock with no owner information is still a lock, but one
+            # this call failed to make must not be left behind.
+            self._remove_lock_file(lock_filename)
+            raise
+
+        return lock_filename
+
+    def _remove_lock_file(self, lock_filename: str) -> None:
+        """Remove a lock file made by :meth:`_create_lock_file`.
+
+        A lock that is already gone is not an error, and neither is one
+        that cannot be removed: this runs while another error may be
+        propagating, and hiding that error would be worse than leaving a
+        stale lock for the person to delete.
+        """
+        with contextlib.suppress(OSError):
+            os.unlink(lock_filename)
+
+    def _start_monitor(self, process: t.Any, editor: str) -> _EditorMonitor | None:
+        if self._monitor_callback is None:
+            return None
+
+        monitor = _EditorMonitor(
+            process, editor, self._monitor_callback, self._monitor_interval
+        )
+        monitor.start()
+        return monitor
+
