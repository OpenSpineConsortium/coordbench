+# How often the monitor looks at the editor's state, in seconds. A person
+# suspending an editor is slow next to this, and a look is one small file read.
+_MONITOR_POLL_INTERVAL = 0.1
+
+
+def _read_process_state(pid: t.Any) -> str | None:
+    """Return the one-letter run state of a process, or ``None`` when the
+    platform cannot tell.
+
+    Only Linux's ``/proc`` is read. Asking another platform means
+    starting a program such as ``ps`` on every look, which is not worth
+    it for the optional ``suspend`` and ``resume`` events.
+    """
+    if not isinstance(pid, int) or isinstance(pid, bool):
+        return None
+
+    try:
+        with open(f"/proc/{pid}/stat", "rb") as f:
+            data = f.read()
+    except OSError:
+        return None
+
+    # The state is the first field after the command name, which is in
+    # parentheses and may itself contain spaces and parentheses.
+    end = data.rfind(b")")
+    state = data[end + 2 : end + 3]
+    return state.decode("ascii", "replace") if end != -1 and state else None
+
+
+def _resolve_monitor(
+    monitor_process: t.Any,
+) -> tuple[cabc.Callable[[str, int, str, float], None] | None, float]:
+    """Turn the ``monitor_process`` argument into the callback to call
+    and the interval between looks at the process.
+
+    The argument is the callback itself, a mapping with the keys
+    ``callback`` and, optionally, ``poll_interval``, or an object with
+    those attributes. ``None`` and a plain ``bool`` register no callback,
+    so the editor runs unmonitored.
+    """
+    interval = _MONITOR_POLL_INTERVAL
+
+    if monitor_process is None or isinstance(monitor_process, bool):
+        return None, interval
+
+    if callable(monitor_process):
+        return monitor_process, interval
+
+    if isinstance(monitor_process, cabc.Mapping):
+        callback = monitor_process.get("callback")
+        interval = monitor_process.get("poll_interval", interval)
+    else:
+        callback = getattr(monitor_process, "callback", None)
+        interval = getattr(monitor_process, "poll_interval", interval)
+
+    if callback is not None and not callable(callback):
+        raise TypeError("The monitor_process callback must be callable.")
+
+    if (
+        isinstance(interval, bool)
+        or not isinstance(interval, (int, float))
+        or not interval > 0
+    ):
+        raise ValueError("The monitor_process poll_interval must be above zero.")
+
+    return callback, float(interval)
+
+
+class _EditorMonitor:
+    """Reports the life of an editor process to a callback.
+
+    A background thread calls ``callback(event_type, process_id,
+    editor_command, timestamp)`` for these events, in this order: the
+    ``"start"`` of the process, any ``"suspend"`` and ``"resume"`` the
+    platform can see, and the ``"terminate"`` of the process. The thread
+    only looks at the process and never waits for it, so the editing
+    session itself stays with the thread that started it.
+
+    A callback that raises does not stop the monitoring: the error is
+    issued as a :class:`UserWarning` and the next event is delivered.
+    """
+
+    def __init__(
+        self,
+        process: t.Any,
+        editor_command: str,
+        callback: cabc.Callable[[str, int, str, float], None],
+        poll_interval: float = _MONITOR_POLL_INTERVAL,
+    ) -> None:
+        import threading
+
+        self.process_id = process.pid
+        self.editor_command = editor_command
+        self.callback = callback
+        self.poll_interval = poll_interval
+        self._started_at = time.time()
+        self._ended_at = self._started_at
+        self._finished = threading.Event()
+        self._thread = threading.Thread(
+            target=self._run, name="click-editor-monitor", daemon=True
+        )
+
+    def start(self) -> None:
+        self._thread.start()
+
+    def stop(self) -> None:
+        """Report that the process has ended, and return once the last
+        event has been delivered."""
+        self._ended_at = time.time()
+        self._finished.set()
+        self._thread.join()
+
+    def _emit(self, event_type: str, timestamp: float) -> None:
+        import warnings
+
+        try:
+            self.callback(event_type, self.process_id, self.editor_command, timestamp)
+        except Exception as e:
+            warnings.warn(
+                _("The editor monitor callback failed on {event}: {error}").format(
+                    event=event_type, error=f"{type(e).__name__}: {e}"
+                ),
+                UserWarning,
+                stacklevel=1,
+            )
+
+    def _run(self) -> None:
+        self._emit("start", self._started_at)
+        suspended = False
+
+        while not self._finished.wait(self.poll_interval):
+            state = _read_process_state(self.process_id)
+
+            # No answer, or a process that ended and awaits its wait().
+            if state is None or state == "Z":
+                continue
+
+            stopped = state in ("T", "t")
+
+            if stopped and not suspended:
+                self._emit("suspend", time.time())
+            elif suspended and not stopped:
+                self._emit("resume", time.time())
+
+            suspended = stopped
+
+        self._emit("terminate", self._ended_at)
+
+
