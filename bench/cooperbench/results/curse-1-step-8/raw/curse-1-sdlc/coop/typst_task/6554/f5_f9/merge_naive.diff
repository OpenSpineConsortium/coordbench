+/// Rejects a requested number of grapheme clusters that extracts nothing.
+fn check_count(count: usize) -> StrResult<()> {
+    if count == 0 {
+        bail!("count must be at least 1");
+    }
+    Ok(())
+}
+
+/// Turns the extracted grapheme clusters into an array, failing if fewer were
+/// found than requested.
+fn collect_chars(chars: Vec<&str>, count: usize) -> StrResult<Value> {
+    if chars.len() < count {
+        bail!(
+            "not enough characters (requested {}, but string only has {})",
+            count,
+            chars.len()
+        );
+    }
+    Ok(Value::Array(chars.into_iter().map(|s| s.into_value()).collect()))
+}
