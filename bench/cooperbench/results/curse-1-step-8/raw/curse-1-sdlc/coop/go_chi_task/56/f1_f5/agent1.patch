@@ -0,0 +1,81 @@
+package middleware
+
+import (
+	"net/http"
+
+	"github.com/go-chi/chi/v5"
+)
+
+// allowHeaderMethods are the methods SetAllowHeader tries, in the order it
+// lists them. It is the order chi's own 405 response uses, so the two give the
+// same Allow header for the same route.
+var allowHeaderMethods = []string{
+	http.MethodConnect,
+	http.MethodDelete,
+	http.MethodGet,
+	http.MethodHead,
+	http.MethodOptions,
+	http.MethodPatch,
+	http.MethodPost,
+	http.MethodPut,
+	http.MethodTrace,
+}
+
+// SetAllowHeader adds the Allow header for 405 responses based on
+// registered methods for the requested path.
+//
+// When the request's method has no handler for the path but other methods do,
+// the methods that have one are added to the Allow header, one value each,
+// before the next handler runs. It does not look at the response, so it is
+// meant for a router that answers such a request with 405, and it is of most
+// use when the router has a custom MethodNotAllowed handler, which chi leaves
+// to set its own headers. A request whose method is registered, or whose path
+// matches no route, gets no Allow header.
+func SetAllowHeader(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if rctx := chi.RouteContext(r.Context()); rctx != nil && rctx.Routes != nil {
+			addAllowHeader(w, r, rctx)
+		}
+		next.ServeHTTP(w, r)
+	})
+}
+
+// addAllowHeader adds the Allow header when the request's method does not
+// match a route but another method does. A header that is there already,
+// from the same middleware on an outer router, is left as it is.
+func addAllowHeader(w http.ResponseWriter, r *http.Request, rctx *chi.Context) {
+	if len(w.Header().Values("Allow")) > 0 {
+		return
+	}
+	path := allowHeaderPath(r, rctx)
+
+	// Match updates the context it is given, so every try starts from
+	// a clean one.
+	mctx := chi.NewRouteContext()
+	if rctx.Routes.Match(mctx, r.Method, path) {
+		return
+	}
+	for _, method := range allowHeaderMethods {
+		mctx.Reset()
+		if rctx.Routes.Match(mctx, method, path) {
+			w.Header().Add("Allow", method)
+		}
+	}
+}
+
+// allowHeaderPath is the path the router would search for this request, as
+// seen from rctx.Routes, the router the request first entered. A routing path
+// that an earlier middleware set (strip.go) counts only while no route has
+// matched yet: from then on it is relative to a sub-router.
+func allowHeaderPath(r *http.Request, rctx *chi.Context) string {
+	if rctx.RoutePath != "" && len(rctx.RoutePatterns) == 0 {
+		return rctx.RoutePath
+	}
+	if r.URL.RawPath != "" {
+		return r.URL.RawPath
+	}
+	if r.URL.Path == "" {
+		return "/"
+	}
+	return r.URL.Path
+}
