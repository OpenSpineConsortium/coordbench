diff --git a/cors.go b/cors.go
new file mode 100644
index 0000000..d4ca0d5
--- /dev/null
+++ b/cors.go
@@ -0,0 +1,347 @@
+package chi
+
+import (
+	"net/http"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+// CORSOptions configures the built-in CORS (Cross-Origin Resource Sharing)
+// support of CORS, Mux.EnableCORSWithOptions and Mux.WithCORS.
+type CORSOptions struct {
+	// AllowOrigin is the value of Access-Control-Allow-Origin. Use "*" to
+	// allow any origin, or one origin such as "https://example.com". Browsers
+	// refuse "*" for requests that carry credentials, so name an origin when
+	// AllowCredentials is set.
+	AllowOrigin string
+
+	// AllowMethods is the value of Access-Control-Allow-Methods on a preflight
+	// response. When it is empty, the methods that the requested path has a
+	// handler for are used, found in the routing tree.
+	AllowMethods []string
+
+	// AllowHeaders is the value of Access-Control-Allow-Headers on a preflight
+	// response. When it is empty, the headers named by the preflight request
+	// are allowed, or the common headers of DefaultCORSOptions if it names none.
+	AllowHeaders []string
+
+	// ExposeHeaders is the value of Access-Control-Expose-Headers: the response
+	// headers that scripts of other origins may read.
+	ExposeHeaders []string
+
+	// MaxAge is how many seconds a browser may cache a preflight response, sent
+	// as Access-Control-Max-Age. Zero sends no header, so the browser uses its
+	// own default; -1 tells the browser not to cache.
+	MaxAge int
+
+	// AllowCredentials sets Access-Control-Allow-Credentials to true, so that
+	// browsers send cookies and authorization headers with cross-origin
+	// requests.
+	AllowCredentials bool
+}
+
+// DefaultCORSOptions returns the options that EnableCORS uses: any origin, the
+// methods found for each path, the common request headers and a preflight
+// cache of one hour.
+func DefaultCORSOptions() CORSOptions {
+	return CORSOptions{
+		AllowOrigin:  "*",
+		AllowHeaders: append([]string(nil), corsCommonHeaders...),
+		MaxAge:       3600,
+	}
+}
+
+// corsCommonHeaders are the request headers that a preflight response allows
+// by default.
+var corsCommonHeaders = []string{
+	"Accept", "Authorization", "Content-Type", "X-CSRF-Token", "X-Requested-With",
+}
+
+// corsFallbackMethods are named by a preflight response for a path that has no
+// route, where there are no methods to find.
+const corsFallbackMethods = "GET, HEAD, POST, PUT, PATCH, DELETE, OPTIONS"
+
+// CORS returns a middleware that sets the CORS headers on every response and
+// answers preflight requests with 204 No Content, without calling the next
+// handler.
+//
+// A preflight request is an OPTIONS request that has an
+// Access-Control-Request-Method header, or one for a path that has no OPTIONS
+// handler of its own. When AllowMethods is empty, the response names the
+// methods that the path has a handler for, found through the routing context
+// of the request, so the middleware is meant to run inside a chi router; it
+// works without one but then names a fixed list of methods.
+func CORS(options CORSOptions) func(http.Handler) http.Handler {
+	return newCORSPolicy(options, nil).middleware
+}
+
+// EnableCORS adds CORS support to the router with DefaultCORSOptions. See
+// EnableCORSWithOptions.
+func (mx *Mux) EnableCORS() {
+	mx.EnableCORSWithOptions(DefaultCORSOptions())
+}
+
+// EnableCORSWithOptions adds CORS support to the router: the CORS middleware,
+// which sets the CORS headers and answers preflight requests, and a method not
+// allowed handler that answers a preflight request for a path that has routes
+// but none for OPTIONS. Its other 405 responses are those of chi without CORS,
+// with the Allow header and now also the CORS headers.
+//
+// Like Use, it is not safe to call while the router serves requests. Unlike
+// Use, it may be called after routes are defined, and then covers them too.
+// The method not allowed handler is set as MethodNotAllowed sets it, so a
+// custom one set before this call keeps writing the response and one set
+// after it replaces the handler; a router made by With or Group sets it on its
+// parent.
+func (mx *Mux) EnableCORSWithOptions(options CORSOptions) {
+	policy := newCORSPolicy(options, mx)
+
+	if mx.handler != nil && !mx.inline {
+		mx.middlewares = append(mx.middlewares, policy.middleware)
+		mx.updateRouteHandler()
+	} else {
+		mx.Use(policy.middleware)
+	}
+
+	holder := mx
+	if mx.inline && mx.parent != nil {
+		holder = mx.parent
+	}
+	mx.MethodNotAllowed(policy.methodNotAllowed(holder.methodNotAllowedHandler))
+}
+
+// WithCORS returns a new router, as With does, whose routes have CORS support
+// with DefaultCORSOptions, or with the options given. See
+// EnableCORSWithOptions for what that adds, and for where the method not
+// allowed handler is set.
+func (mx *Mux) WithCORS(options ...CORSOptions) Router {
+	opts := DefaultCORSOptions()
+	if len(options) > 0 {
+		opts = options[0]
+	}
+	im := mx.With().(*Mux)
+	im.EnableCORSWithOptions(opts)
+	return im
+}
+
+// corsPolicy is a CORSOptions with its headers worked out once.
+type corsPolicy struct {
+	origin      string
+	methods     string
+	headers     string
+	expose      string
+	maxAge      string
+	credentials bool
+
+	// routes is searched for methods when a request's routing context names
+	// none, as when a test makes the context by hand.
+	routes Routes
+}
+
+func newCORSPolicy(options CORSOptions, routes Routes) *corsPolicy {
+	p := &corsPolicy{
+		origin:      options.AllowOrigin,
+		methods:     strings.Join(options.AllowMethods, ", "),
+		headers:     strings.Join(options.AllowHeaders, ", "),
+		expose:      strings.Join(options.ExposeHeaders, ", "),
+		credentials: options.AllowCredentials,
+		routes:      routes,
+	}
+	if options.MaxAge != 0 {
+		p.maxAge = strconv.Itoa(options.MaxAge)
+	}
+	return p
+}
+
+func (p *corsPolicy) middleware(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		p.setHeaders(w)
+		if p.isPreflight(r) {
+			p.preflight(w, r)
+			return
+		}
+		next.ServeHTTP(w, r)
+	})
+}
+
+// methodNotAllowed returns the handler for requests that reach a path with a
+// method it has no handler for. A preflight request is answered here, since
+// the path usually has no OPTIONS handler. Any other request gets the 405 that
+// chi would give without CORS, with its Allow header, unless next, the handler
+// that was set before, writes it.
+func (p *corsPolicy) methodNotAllowed(next http.HandlerFunc) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		p.setHeaders(w)
+		if r.Method == http.MethodOptions {
+			p.preflight(w, r)
+			return
+		}
+		if next != nil {
+			next(w, r)
+			return
+		}
+		var allowed []methodTyp
+		if rctx := RouteContext(r.Context()); rctx != nil {
+			allowed = rctx.methodsAllowed
+		}
+		methodNotAllowedHandler(allowed...)(w, r)
+	}
+}
+
+// setHeaders sets the headers that every response carries.
+func (p *corsPolicy) setHeaders(w http.ResponseWriter) {
+	h := w.Header()
+	if p.origin != "" {
+		h.Set("Access-Control-Allow-Origin", p.origin)
+		if p.origin != "*" {
+			addVary(h, "Origin")
+		}
+	}
+	if p.credentials {
+		h.Set("Access-Control-Allow-Credentials", "true")
+	}
+	if p.expose != "" {
+		h.Set("Access-Control-Expose-Headers", p.expose)
+	}
+}
+
+// preflight writes the response to a preflight request.
+func (p *corsPolicy) preflight(w http.ResponseWriter, r *http.Request) {
+	h := w.Header()
+
+	methods := p.methods
+	if methods == "" {
+		methods = strings.Join(p.allowedMethods(r), ", ")
+	}
+	if methods == "" {
+		methods = corsFallbackMethods
+	}
+	h.Set("Access-Control-Allow-Methods", methods)
+
+	headers := p.headers
+	if headers == "" {
+		headers = r.Header.Get("Access-Control-Request-Headers")
+		addVary(h, "Access-Control-Request-Headers")
+	}
+	if headers == "" {
+		headers = strings.Join(corsCommonHeaders, ", ")
+	}
+	h.Set("Access-Control-Allow-Headers", headers)
+
+	if p.maxAge != "" {
+		h.Set("Access-Control-Max-Age", p.maxAge)
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
+
+// isPreflight reports whether r asks which requests a browser may send. An
+// OPTIONS request that names a method to be used is one. A plain OPTIONS
+// request is one unless the path handles OPTIONS itself, which is then left to
+// that handler.
+func (p *corsPolicy) isPreflight(r *http.Request) bool {
+	if r.Method != http.MethodOptions {
+		return false
+	}
+	if r.Header.Get("Access-Control-Request-Method") != "" {
+		return true
+	}
+	match := p.matcher(r)
+	return match == nil || !match(http.MethodOptions)
+}
+
+// allowedMethods returns the methods that the requested path has a handler for,
+// in the order of corsMethodNames.
+func (p *corsPolicy) allowedMethods(r *http.Request) []string {
+	match := p.matcher(r)
+	if match == nil {
+		return nil
+	}
+	var allowed []string
+	for _, method := range corsMethodNames() {
+		if match(method) {
+			allowed = append(allowed, method)
+		}
+	}
+	return allowed
+}
+
+// matcher returns a function that reports whether the requested path has a
+// handler for a method, searching the routing tree with a context of its own
+// so that the request's context is left as it is. It returns nil when there is
+// no router to search.
+func (p *corsPolicy) matcher(r *http.Request) func(method string) bool {
+	rctx := RouteContext(r.Context())
+	if rctx == nil {
+		return nil
+	}
+
+	routes, path := rctx.Routes, requestPath(r)
+	if routes == nil {
+		// Only this router is known, and it routes by the context's path.
+		routes = p.routes
+		if rctx.RoutePath != "" {
+			path = rctx.RoutePath
+		}
+	} else if len(rctx.RoutePatterns) == 0 && rctx.RoutePath != "" {
+		// No route has matched yet, so the path was set by a middleware, such
+		// as StripSlashes, and not by a router that took the request on.
+		path = rctx.RoutePath
+	}
+	if routes == nil {
+		return nil
+	}
+
+	probe := NewRouteContext()
+	return func(method string) bool {
+		probe.Reset()
+		return routes.Match(probe, method, path)
+	}
+}
+
+// requestPath returns the path that the root router searches for a request.
+func requestPath(r *http.Request) string {
+	if r.URL.RawPath != "" {
+		return r.URL.RawPath
+	}
+	if r.URL.Path == "" {
+		return "/"
+	}
+	return r.URL.Path
+}
+
+// corsMethodOrder is the order in which the standard methods are named in a
+// header.
+var corsMethodOrder = []methodTyp{
+	mGET, mHEAD, mPOST, mPUT, mPATCH, mDELETE, mOPTIONS, mCONNECT, mTRACE,
+}
+
+// corsMethodNames returns the names of all methods that chi routes: the
+// standard ones in the order of corsMethodOrder, then those added by
+// RegisterMethod in alphabetical order.
+func corsMethodNames() []string {
+	names := make([]string, 0, len(methodMap))
+	for _, mt := range corsMethodOrder {
+		names = append(names, GetMethodName(mt))
+	}
+	custom := make([]string, 0, len(methodMap)-len(names))
+	for name, mt := range methodMap {
+		if _, standard := methodNames[mt]; !standard {
+			custom = append(custom, name)
+		}
+	}
+	sort.Strings(custom)
+	return append(names, custom...)
+}
+
+// addVary adds a field name to the Vary header unless it is there already.
+func addVary(h http.Header, name string) {
+	for _, line := range h.Values("Vary") {
+		for _, field := range strings.Split(line, ",") {
+			if strings.EqualFold(strings.TrimSpace(field), name) {
+				return
+			}
+		}
+	}
+	h.Add("Vary", name)
+}
