+# Matches HTTP and HTTPS web URLs: a scheme, an optional "user:password@", a
+# host (a domain name, an IPv4 address or a bracketed IPv6 address), an optional
+# port, then an optional path, query and fragment. The last label of a domain
+# name starts with a letter, so "localhost" and "example.com" match while
+# "999.999.999.999" does not. Nothing in the path, query or fragment may be
+# whitespace or one of the characters RFC 3986 leaves out of a URL, which keeps
+# generated URLs safe to place inside a JSON string.
+url = Regex(
+    r"https?://"
+    r"([a-zA-Z0-9._~%!$&'()*+,;=:-]+@)?"
+    r"("
+    r"([a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?\.)*[a-zA-Z]([a-zA-Z0-9-]*[a-zA-Z0-9])?"
+    r"|((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])"
+    r"|\[[0-9a-fA-F:.]+\]"
+    r")"
+    r"(:[0-9]{1,5})?"
+    r"(/[^\s\x00-\x1f\x22<>\\^`?#]*)?"
+    r"(\?[^\s\x00-\x1f\x22<>\\^`#]*)?"
+    r"(#[^\s\x00-\x1f\x22<>\\^`#]*)?"
+)
