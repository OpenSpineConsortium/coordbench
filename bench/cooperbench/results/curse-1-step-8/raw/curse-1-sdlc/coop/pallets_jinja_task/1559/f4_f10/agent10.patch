+    def _parse_metadata_value(self, parser: "Parser", name_token: "Token") -> str:
+        """Parse the ``= "value"`` after a metadata parameter name and return
+        the string.  The value must be a string literal; anything that is
+        evaluated at runtime could not be stored on the node at parse time.
+        """
+        name = name_token.value
+
+        if parser.stream.current.type != "assign":
+            parser.fail(
+                f"metadata parameter '{name}' requires a value assignment.",
+                name_token.lineno,
+                exc=TemplateAssertionError,
+            )
+
+        next(parser.stream)
+        value = parser.parse_expression()
+
+        if not isinstance(value, nodes.Const) or not isinstance(value.value, str):
+            parser.fail(
+                f"metadata parameter '{name}' must be a string literal.",
+                name_token.lineno,
+                exc=TemplateAssertionError,
+            )
+
+        return t.cast(str, value.value)
+
