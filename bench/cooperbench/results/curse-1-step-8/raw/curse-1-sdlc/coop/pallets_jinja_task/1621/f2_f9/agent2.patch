+    @internalcode
+    def load(
+        self,
+        environment: "Environment",
+        name: str,
+        globals: t.Optional[t.MutableMapping[str, t.Any]] = None,
+    ) -> "Template":
+        if self.auto_reload:
+            self._environments.add(environment)
+            self._start_monitoring()
+
+        return super().load(environment, name, globals)
+
+    def _start_monitoring(self) -> None:
+        """Start the thread that polls the search paths, unless it is
+        already running. The first snapshot is taken here, before the
+        template that asked for monitoring is read, so a change made
+        after that read is always seen as a change.
+        """
+        with self._monitor_lock:
+            # A thread does not survive a fork, so one that is no longer
+            # alive is started again by the next load in the child.
+            if self._monitor_thread is not None and self._monitor_thread.is_alive():
+                return
+
+            self._stop_monitoring()
+            stop = threading.Event()
+            self._snapshot = _snapshot_files(self.searchpath, self.followlinks)
+            thread = threading.Thread(
+                target=_watch_search_paths,
+                args=(weakref.ref(self), stop),
+                name="jinja2-FileSystemLoader-monitor",
+                daemon=True,
+            )
+
+            try:
+                thread.start()
+            except RuntimeError:
+                # No thread to be had. Monitoring is a convenience, so
+                # loading the template goes on without it.
+                return
+
+            self._monitor_thread = thread
+            # Stop the thread as soon as the loader is collected, and
+            # not only when it next wakes up.
+            self._monitor_finalizer = weakref.finalize(self, stop.set)
+
+    def _stop_monitoring(self) -> None:
+        """Forget the monitoring thread. It ends by itself; this only
+        releases what the loader kept for it. Hold ``_monitor_lock``.
+        """
+        self._monitor_thread = None
+
+        if self._monitor_finalizer is not None:
+            self._monitor_finalizer.detach()
+            self._monitor_finalizer = None
+
+    def _poll_search_paths(self) -> bool:
+        """Compare the search paths with the last snapshot and
+        invalidate what changed. Return ``False`` once the monitoring
+        thread should end.
+        """
+        with self._monitor_lock:
+            if not self.auto_reload or not self._environments:
+                # Nothing is cached anywhere, or the watching was turned
+                # off. A later load starts a fresh thread and snapshot.
+                self._stop_monitoring()
+                return False
+
+        try:
+            snapshot = _snapshot_files(self.searchpath, self.followlinks)
+            old = self._snapshot
+            self._snapshot = snapshot
+            changed = sorted(
+                path
+                for path in old.keys() | snapshot.keys()
+                if old.get(path) != snapshot.get(path)
+            )
+
+            if changed:
+                self._on_template_changed(changed)
+        except Exception:
+            # One bad round, such as a directory removed halfway
+            # through the walk, must not end the monitoring.
+            pass
+
+        return True
+
+    def _on_template_changed(self, file_paths: t.List[str]) -> None:
+        """Remove the templates that the given files provide from the
+        cache of every environment that uses this loader. Called by the
+        monitoring thread, and by tests to invalidate by hand.
+
+        :param file_paths: Absolute paths of the files that were
+            modified, deleted or added. Paths outside the search paths
+            and paths of files that do not exist are ignored.
+        """
+        changed: t.Set[t.Tuple[str, ...]] = set()
+
+        for file_path in file_paths:
+            changed.update(self._template_pieces(file_path))
+
+        if not changed:
+            return
+
+        for environment in list(self._environments):
+            self._invalidate(environment, changed)
+
+    def _template_pieces(self, file_path: t.Any) -> t.Set[t.Tuple[str, ...]]:
+        """The template name, as segments, that a file provides in each
+        search path that contains it. A path in no search path gives an
+        empty set.
+        """
+        try:
+            path = os.fspath(file_path)
+        except TypeError:
+            return set()
+
+        if not isinstance(path, str):
+            return set()
+
+        found = set()
+
+        # Compare as written first, then with links resolved, so a
+        # search path reached through a link still matches.
+        for resolve in (os.path.abspath, os.path.realpath):
+            for searchpath in self.searchpath:
+                pieces = _relative_pieces(resolve(path), resolve(searchpath))
+
+                if pieces is not None:
+                    found.add(pieces)
+
+            if found:
+                break
+
+        return found
+
+    def _invalidate(
+        self, environment: "Environment", changed: t.Set[t.Tuple[str, ...]]
+    ) -> None:
+        """Drop from one environment's cache the templates whose names
+        stand for one of the changed files. The names are matched by
+        their segments, since the cache is keyed by the name as it was
+        asked for, which may be spelled ``a//b.html`` or ``a/./b.html``.
+        """
+        cache = environment.cache
+
+        if cache is None:
+            return
+
+        # An environment may wrap this loader in a PrefixLoader or a
+        # ChoiceLoader, and the cache is keyed by the outermost loader.
+        owners = (self, environment.loader)
+
+        for key in list(cache.keys()):
+            try:
+                loader_ref, name = key
+                owner = loader_ref()
+            except (TypeError, ValueError):
+                continue
+
+            if not isinstance(name, str) or not any(owner is o for o in owners):
+                continue
+
+            if self._name_pieces(name) & changed:
+                try:
+                    del cache[key]
+                except KeyError:
+                    # Another thread removed or evicted it first.
+                    pass
+
+    @staticmethod
+    def _name_pieces(name: str) -> t.Set[t.Tuple[str, ...]]:
+        """The segments a template name resolves to, as written and with
+        ``.`` and ``..`` collapsed first.
+        """
