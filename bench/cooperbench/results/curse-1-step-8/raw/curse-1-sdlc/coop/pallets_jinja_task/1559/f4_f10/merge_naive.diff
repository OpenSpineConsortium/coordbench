+    def _parse_metadata(
+        self, parser: "Parser", token: "Token", metadata: t.Dict[str, str]
+    ) -> None:
+        """Parse the ``="value"`` after a metadata parameter name of a
+        ``trans`` tag and store the string in ``metadata``. Only a string
+        literal is accepted, since the value is read from the AST by
+        translation tools and never evaluated.
+        """
+        name = token.value
+
+        if parser.stream.current.type != "assign":
+            parser.fail(
+                f"metadata parameter {name!r} requires a value assignment.",
+                token.lineno,
+                exc=TemplateAssertionError,
+            )
+
+        if name in metadata:
+            parser.fail(
+                f"metadata parameter {name!r} defined twice.",
+                token.lineno,
+                exc=TemplateAssertionError,
+            )
+
+        next(parser.stream)
+        value = parser.parse_expression()
+
+        if not isinstance(value, nodes.Const) or not isinstance(value.value, str):
+            parser.fail(
+                f"metadata parameter {name!r} must be a string literal.",
+                token.lineno,
+                exc=TemplateAssertionError,
+            )
+
+        metadata[name] = value.value
+
