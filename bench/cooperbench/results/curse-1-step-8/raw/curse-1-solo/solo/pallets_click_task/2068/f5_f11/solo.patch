+_STOPPED_STATES = frozenset("Tt")
+
+
+def _read_process_state(pid: int) -> str | None:
+    """Return the one letter state of a process, such as ``R``, ``S`` or
+    ``T`` (stopped), or ``None`` if it cannot be found out. Windows has
+    no such state, so the monitor sees no suspend or resume there.
+    """
+    if WIN:
+        return None
+
+    try:
+        if os.path.exists("/proc/self/stat"):
+            with open(f"/proc/{pid}/stat", "rb") as f:
+                # The command name is in parentheses and may hold spaces
+                # and parentheses, so the state follows the last one.
+                return f.read().decode("ascii", "replace").rsplit(")", 1)[1].split()[0]
+
+        import subprocess
+
+        out = subprocess.run(
+            ["ps", "-o", "stat=", "-p", str(pid)],
+            stdout=subprocess.PIPE,
+            stderr=subprocess.DEVNULL,
+            text=True,
+            check=True,
+        ).stdout.strip()
+        return out[:1] or None
+    except Exception:
+        # The process ended, or this platform cannot tell. The monitor
+        # then reports nothing, which is what an unknown state means.
+        return None
+
+
+class _ProcessMonitor:
+    """Tells a callback about the life of one editor process.
+
+    ``start`` and ``terminate`` are reported from the thread that edits,
+    so ``start`` always comes first and ``terminate`` always last, even
+    for an editor that exits at once. A background thread polls the
+    process in between and reports ``suspend`` and ``resume``.
+    """
+
+    def __init__(
+        self,
+        callback: cabc.Callable[[str, int, str, float], None],
+        process_id: int,
+        editor_command: str,
+        interval: float = 0.1,
+    ) -> None:
+        import threading
+
+        self.callback = callback
+        self.process_id = process_id
+        self.editor_command = editor_command
+        self.interval = interval
+        self._done = threading.Event()
+        self._thread = threading.Thread(
+            target=self._watch, name="click-editor-monitor", daemon=True
+        )
+
+    def start(self) -> None:
+        self._notify("start")
+        self._thread.start()
+
+    def stop(self) -> None:
+        self._done.set()
+        self._thread.join()
+        self._notify("terminate")
+
+    def _notify(self, event_type: str) -> None:
+        import warnings
+
+        try:
+            self.callback(event_type, self.process_id, self.editor_command, time.time())
+        except Exception as e:
+            # A broken callback must not break editing or end monitoring.
+            # If warnings are turned into errors, there is nobody to
+            # raise to here, so the report is dropped with the warning.
+            with contextlib.suppress(Exception):
+                warnings.warn(
+                    f"Process monitor callback failed: {e or type(e).__name__}",
+                    UserWarning,
+                    stacklevel=2,
+                )
+
+    def _watch(self) -> None:
+        suspended = False
+
+        while not self._done.wait(self.interval):
+            stopped = _read_process_state(self.process_id) in _STOPPED_STATES
+
+            if stopped != suspended:
+                suspended = stopped
+                self._notify("suspend" if suspended else "resume")
+
+
