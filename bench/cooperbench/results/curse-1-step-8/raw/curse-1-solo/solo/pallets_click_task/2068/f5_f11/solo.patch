+    def _get_lock_filename(self, filename: str) -> str:
+        """The lock file of ``filename``: ``.<name>.lock`` beside it."""
+        directory, name = os.path.split(filename)
+        return os.path.join(directory, f".{name}.lock")
+
+    def _create_lock_file(self, filename: str) -> str:
+        """Create the lock file of ``filename`` and return its path.
+
+        The file is created with ``O_EXCL``, so of two processes that
+        race for the lock exactly one succeeds, on every platform. It
+        holds the process id and the time, for whoever finds it later.
+        """
+        from datetime import datetime
+
+        lock_filename = self._get_lock_filename(filename)
+
+        try:
+            fd = os.open(lock_filename, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
+        except FileExistsError:
+            raise ClickException(
+                _(
+                    "{filename}: File is already being edited, the lock file"
+                    " {lock} exists. If no editor is running, remove it."
+                ).format(filename=filename, lock=lock_filename)
+            ) from None
+
+        try:
+            with os.fdopen(fd, "w", encoding="utf-8") as f:
+                f.write(f"PID: {os.getpid()}\nTime: {datetime.now().isoformat()}")
+        except BaseException:
+            # Never leave behind a lock nobody can say whose it is.
+            self._remove_lock_file(lock_filename)
+            raise
+
+        return lock_filename
+
+    def _remove_lock_file(self, lock_filename: str) -> None:
+        """Remove a lock file. One that is gone already is not an error."""
+        with contextlib.suppress(FileNotFoundError):
+            os.unlink(lock_filename)
+
+    @contextlib.contextmanager
+    def _locked(self, filename: str) -> cabc.Iterator[None]:
+        """Hold the lock file of ``filename`` while the block runs, if
+        ``lock_files`` is on. It is removed however the block ends.
+        """
+        if not self.lock_files:
+            yield
+            return
+
+        lock_filename = self._create_lock_file(filename)
+
+        try:
+            yield
+        finally:
+            self._remove_lock_file(lock_filename)
+
+    def _wait(self, process: subprocess.Popen[bytes], editor: str) -> int:
+        """Wait for the editor, reporting its life to ``monitor_process``."""
+        if self.monitor_process is None:
+            return process.wait()
+
+        monitor = _ProcessMonitor(self.monitor_process, process.pid, editor)
+        monitor.start()
+
+        try:
+            return process.wait()
+        finally:
+            monitor.stop()
+
