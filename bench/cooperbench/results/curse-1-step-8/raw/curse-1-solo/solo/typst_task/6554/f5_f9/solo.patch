+/// Checks a requested number of grapheme clusters against the number that is
+/// available and returns it, so that the caller can slice with it.
+fn check_count(count: usize, available: usize) -> StrResult<usize> {
+    if count == 0 {
+        bail!("count must be at least 1");
+    }
+    if count > available {
+        bail!(
+            "not enough characters (requested {count}, but string only has {available})"
+        );
+    }
+    Ok(count)
+}
+
+/// Turns grapheme clusters into an array of strings.
+fn graphemes_to_array(graphemes: &[&str]) -> Value {
+    Value::Array(graphemes.iter().map(|g| Value::Str((*g).into())).collect())
+}
