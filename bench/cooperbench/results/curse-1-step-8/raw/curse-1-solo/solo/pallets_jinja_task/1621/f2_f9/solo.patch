+# Separators other than "/" that split_template_path rejects. Empty on
+# POSIX; on Windows this is the backslash.
+_FOREIGN_SEPARATORS = tuple(
+    sep for sep in (os.path.sep, os.path.altsep) if sep and sep != "/"
+)
+
+
+def _normalize_template_path(template: str) -> str:
+    """Collapse redundant separators and ``.`` and ``..`` segments of a
+    template name with :func:`os.path.normpath`, so ``foo//./bar.html``
+    and ``foo/baz/../bar.html`` both become ``foo/bar.html``.
+
+    The result still uses ``/``, which is what :func:`split_template_path`
+    splits on, even on Windows where ``normpath`` writes backslashes. A
+    name that already contains a backslash there is returned unchanged so
+    that :func:`split_template_path` goes on to reject it as before.
+    """
+    if any(sep in template for sep in _FOREIGN_SEPARATORS):
+        return template
+
+    template = os.path.normpath(template)
+
+    if os.path.sep != "/":
+        template = template.replace(os.path.sep, "/")
+
+    return template
+
+
+def _split_normalized_template_path(template: str) -> t.List[str]:
+    """Normalize a template name, then split and check it with
+    :func:`split_template_path`. A name that is refused is reported as
+    the caller wrote it, not as it looks after normalizing.
+    """
+    try:
+        return split_template_path(_normalize_template_path(template))
+    except TemplateNotFound:
+        raise TemplateNotFound(template) from None
+
