+    def _init_monitor_state(self) -> None:
+        # The environments whose cache this loader keeps fresh. Weak, so
+        # that watching never keeps an environment alive. It stays empty
+        # when auto_reload is off.
+        self._environments: "weakref.WeakSet[Environment]" = weakref.WeakSet()
+        self._monitor_lock = threading.Lock()
+        self._monitor_thread: t.Optional[threading.Thread] = None
+        self._monitor_stop: t.Optional[threading.Event] = None
+        self._monitor_snapshot: t.Dict[str, t.Tuple[int, int]] = {}
+
+    def __getstate__(self) -> t.Dict[str, t.Any]:
+        # Locks, threads and weak sets can't be copied or pickled, and a
+        # copy starts out watching nothing anyway.
+        state = self.__dict__.copy()
+        for name in (
+            "_environments",
+            "_monitor_lock",
+            "_monitor_thread",
+            "_monitor_stop",
+            "_monitor_snapshot",
+        ):
+            state.pop(name, None)
+        return state
+
+    def __setstate__(self, state: t.Dict[str, t.Any]) -> None:
+        self.__dict__.update(state)
+        self._init_monitor_state()
+
+    def _track_environment(self, environment: t.Optional["Environment"]) -> None:
+        """Remember that the environment loads templates through this
+        loader, and make sure the monitor is running.
+        """
+        if environment is None:
+            return
+
+        try:
+            thread = self._monitor_thread
+
+            if (
+                thread is not None
+                and thread.is_alive()
+                and environment in self._environments
+            ):
+                return
+
+            with self._monitor_lock:
+                self._environments.add(environment)
+                self._start_monitor()
+        except TypeError:
+            # Not hashable or not weakly referenceable, so it can't be
+            # tracked. Loading the template doesn't depend on that.
+            pass
+
+    def _start_monitor(self) -> None:
+        # The caller holds the lock.
+        thread = self._monitor_thread
+
+        if thread is not None and thread.is_alive():
+            return
+
+        if self._monitor_stop is None:
+            # Wakes the thread up to end when the loader is collected.
+            self._monitor_stop = threading.Event()
+            weakref.finalize(self, self._monitor_stop.set)
+
+        # Take the baseline before the caller reads any template, so a
+        # change made after that read can't be missed.
+        self._monitor_snapshot = self._scan_search_paths()
+        thread = threading.Thread(
+            target=_monitor_search_paths,
+            args=(weakref.ref(self), self._monitor_stop),
+            name="jinja2-search-path-monitor",
+            daemon=True,
+        )
+        self._monitor_thread = thread
+        thread.start()
+
+    def _scan_search_paths(self) -> t.Dict[str, t.Tuple[int, int]]:
+        """Map the absolute path of every file in the search paths to
+        its modification time and size.
+        """
+        found: t.Dict[str, t.Tuple[int, int]] = {}
+
+        for searchpath in list(self.searchpath):
+            root = os.path.abspath(os.fspath(searchpath))
+
+            for dirpath, _, filenames in os.walk(root, followlinks=self.followlinks):
+                for filename in filenames:
+                    path = os.path.join(dirpath, filename)
+
+                    try:
+                        stat = os.stat(path)
+                    except OSError:
+                        continue
+
+                    found[path] = (stat.st_mtime_ns, stat.st_size)
+
+        return found
+
+    def _poll(self) -> t.Optional[float]:
+        """Look for changes in the search paths once, and invalidate
+        the cached templates of the files that changed.
+
+        Returns the seconds to wait before the next poll, or ``None``
+        when no environment is left to notify and the monitor ends.
+        """
+        started = time.monotonic()
+
+        with self._monitor_lock:
+            if not self._environments:
+                self._monitor_thread = None
+                return None
+
+        before = self._monitor_snapshot
+        after = self._scan_search_paths()
+        self._monitor_snapshot = after
+        changed = sorted(
+            path
+            for path in before.keys() | after.keys()
+            if before.get(path) != after.get(path)
+        )
+
+        if changed:
+            try:
+                self._on_template_changed(changed)
+            except Exception:
+                # A broken cache of one environment must not end the
+                # monitor for all the others.
+                pass
+
+        # Bound the time spent scanning on a big tree to a small share.
+        return max(_POLL_INTERVAL, (time.monotonic() - started) * 20)
+
