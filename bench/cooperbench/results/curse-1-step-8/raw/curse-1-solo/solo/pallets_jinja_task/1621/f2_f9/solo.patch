+def _normalize_template_path(template: str) -> str:
+    """Normalize a template name with :func:`os.path.normpath`, so that
+    redundant separators and ``.`` or ``foo/..`` segments are gone.
+
+    ``normpath`` joins the segments with the OS separator, but
+    :func:`split_template_path` splits on ``/`` and rejects the OS
+    separator inside a segment, so it is turned back into ``/``. That
+    is a no-op where the separator already is ``/``.
+    """
+    return os.path.normpath(template).replace(os.path.sep, "/")
+
+
+def _split_normalized_template_path(template: str) -> t.List[str]:
+    """Normalize the template name, then run the usual security check
+    and split of :func:`split_template_path` on the result.
+
+    The normalization comes first, so ``foo/../test.html`` is
+    ``test.html``, while a name that still climbs out of the search
+    path after it, such as ``foo/../../test.html``, is refused as
+    before. The error names the template as it was asked for.
+    """
+    try:
+        return split_template_path(_normalize_template_path(template))
+    except TemplateNotFound:
+        raise TemplateNotFound(template) from None
+
+
+#: Seconds between two looks at the files of a :class:`FileSystemLoader`
+#: at the least.
+_POLL_INTERVAL = 0.25
+
+
+def _monitor_search_paths(
+    loader_ref: "weakref.ref[FileSystemLoader]", stop: threading.Event
+) -> None:
+    """Body of the monitor thread. It holds the loader only while it
+    polls, never while it sleeps, so the loader can be collected.
+    """
+    delay: t.Optional[float] = _POLL_INTERVAL
+
+    # Waits first, as the loader took the baseline just before it
+    # started the thread. ``stop`` is set when the loader is collected.
+    while delay is not None and not stop.wait(delay):
+        loader = loader_ref()
+
+        if loader is None:
+            return
+
+        delay = loader._poll()
+        del loader
+
+
+def _relative_template_name(root: str, path: str) -> t.Optional[str]:
+    """The template name of the file ``path`` below the directory
+    ``root``, or ``None`` if it isn't below it. Both are absolute.
+    """
+    try:
+        common = os.path.commonpath([os.path.normcase(root), os.path.normcase(path)])
+    except ValueError:
+        # Different drives, or a mix of absolute and relative paths.
+        return None
+
+    if common != os.path.normcase(root):
+        return None
+
+    relative = os.path.relpath(path, root)
+
+    if relative == os.path.curdir:
+        return None
+
+    return relative.replace(os.path.sep, "/")
+
+
+def _remove_from_cache(environment: "Environment", names: t.Set[str]) -> None:
+    """Remove the templates called one of ``names`` from the cache of
+    the environment. A cache key is ``(loader reference, name)``. The
+    loader is left out of the match, since the file system loader may
+    sit inside another loader, and a name is normalized so that
+    ``./foo//test.html`` is found as ``foo/test.html``.
+    """
+    cache = environment.cache
+
+    if cache is None:
+        return
+
+    for _ in range(3):
+        try:
+            keys = list(cache.keys())
+            break
+        except RuntimeError:
+            # A plain dict that changed size during the copy, try again.
+            continue
+    else:
+        return
+
+    for key in keys:
+        try:
+            name = key[1]
+        except (TypeError, IndexError):
+            continue
+
+        if not isinstance(name, str):
+            continue
+
+        if name in names or _normalize_template_path(name) in names:
+            try:
+                del cache[key]
+            except KeyError:
+                pass
+
