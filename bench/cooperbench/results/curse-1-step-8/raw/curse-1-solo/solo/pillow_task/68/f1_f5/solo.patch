+_XMP_ORIENTATION_PATTERNS = (
+    r'tiff:Orientation="([0-9])"',
+    r"<tiff:Orientation>([0-9])</tiff:Orientation>",
+)
+
+
+def _is_xmp_data(value: object) -> bool:
+    """
+    XMP data is text or bytes, or, as written by some tools (macOS QuickActions
+    and QuickLook, for example), a tuple of them.
+    """
+    if isinstance(value, tuple):
+        return all(_is_xmp_data(item) for item in value)
+    return isinstance(value, (str, bytes, bytearray, memoryview))
+
+
+def _remove_xmp_orientation(value: object) -> object:
+    """
+    Return the XMP data without its tiff:Orientation, keeping its type: text stays
+    text, bytes become bytes and a tuple stays a tuple of the same length.
+    """
+    if isinstance(value, tuple):
+        return tuple(_remove_xmp_orientation(item) for item in value)
+    if isinstance(value, str):
+        for pattern in _XMP_ORIENTATION_PATTERNS:
+            value = re.sub(pattern, "", value)
+        return value
+    for pattern in _XMP_ORIENTATION_PATTERNS:
+        value = re.sub(pattern.encode(), b"", cast(bytes, value))
+    return value
+
+
+def _check_logger(logger: object) -> None:
+    if logger is None or callable(logger):
+        return
+    if not callable(getattr(logger, "info", None)):
+        msg = "logger must be a callable or a logging.Logger"
+        raise TypeError(msg)
+
+
+def _log(logger: object, message: str, level: str = "info") -> None:
+    """
+    Send a message to a logger, which is either a standard logger, whose method
+    named by level is called, or a function that takes the message.
+    """
+    if logger is None:
+        return
+    if isinstance(logger, (logging.Logger, logging.LoggerAdapter)) or not callable(
+        logger
+    ):
+        getattr(logger, level)(message)
+    else:
+        logger(message)
+
