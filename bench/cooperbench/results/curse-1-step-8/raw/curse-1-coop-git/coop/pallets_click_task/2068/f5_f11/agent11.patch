+def _process_state(process_id: int) -> str | None:
+    """Return ``"stopped"`` or ``"running"`` for a process, or ``None`` when
+    that cannot be told: on a platform without ``/proc``, or for a process
+    that has ended.
+    """
+    try:
+        with open(f"/proc/{process_id}/stat", "rb") as f:
+            stat = f.read()
+    except (OSError, TypeError, ValueError):
+        return None
+
+    # The state follows the command name, which is in parentheses and may
+    # itself hold spaces and parentheses, so split after the last one.
+    fields = stat.rpartition(b")")[2].split()
+
+    if not fields:
+        return None
+
+    state = fields[0]
+
+    if state in (b"T", b"t"):
+        return "stopped"
+
+    if state in (b"Z", b"X", b"x"):
+        return None
+
+    return "running"
+
+
+class _ProcessMonitor:
+    """Reports the life of a process to a callback from a background
+    thread, so that the thread that waits for the process is not held up.
+    """
+
+    def __init__(self, monitor_process: MonitorProcess, editor_command: str) -> None:
+        import threading
+
+        self.callback, self.poll_interval = self._parse(monitor_process)
+        self.editor_command = editor_command
+        self.process_id = 0
+        self._done = threading.Event()
+        self._thread = threading.Thread(
+            target=self._run, name="click-editor-monitor", daemon=True
+        )
+
+    @staticmethod
+    def _parse(monitor_process: MonitorProcess) -> tuple[MonitorCallback, float]:
+        poll_interval: t.Any = _MONITOR_POLL_INTERVAL
+        callback: t.Any = monitor_process
+
+        if isinstance(monitor_process, cabc.Mapping):
+            callback = monitor_process.get("callback")
+            poll_interval = monitor_process.get("poll_interval", poll_interval)
+
+        if not callable(callback):
+            raise TypeError(
+                "monitor_process must be a callable or a mapping with a"
+                " callable 'callback'."
+            )
+
+        if (
+            isinstance(poll_interval, bool)
+            or not isinstance(poll_interval, (int, float))
+            or not poll_interval > 0
+        ):
+            raise ValueError("'poll_interval' must be a number above zero.")
+
+        return callback, float(poll_interval)
+
+    def start(self, process_id: int) -> None:
+        self.process_id = process_id
+        self._thread.start()
+
+    def stop(self) -> None:
+        """Report that the process has ended, and return once the thread
+        has made its last callback.
+        """
+        self._done.set()
+
+        if self._thread.is_alive():
+            self._thread.join()
+
+    def _run(self) -> None:
+        self._notify("start")
+        suspended = False
+
+        while not self._done.wait(self.poll_interval):
+            state = _process_state(self.process_id)
+
+            if state == "stopped" and not suspended:
+                suspended = True
+                self._notify("suspend")
+            elif state == "running" and suspended:
+                suspended = False
+                self._notify("resume")
+
+        self._notify("terminate")
+
+    def _notify(self, event_type: str) -> None:
+        import warnings
+
+        try:
+            self.callback(
+                event_type, self.process_id, self.editor_command, time.time()
+            )
+        except Exception as e:
+            # A broken callback must not end the monitoring, or the
+            # editing session it only observes. Warning is all it gets.
+            try:
+                warnings.warn(
+                    f"The monitor_process callback failed on the {event_type!r}"
+                    f" event: {e!r}",
+                    UserWarning,
+                    stacklevel=2,
+                )
+            except Exception:
+                # The warning filter turned the warning into an error.
+                pass
+
