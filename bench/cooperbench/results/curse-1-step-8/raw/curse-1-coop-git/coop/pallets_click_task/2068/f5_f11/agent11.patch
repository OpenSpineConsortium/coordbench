+    def _get_lock_filename(self, filename: str) -> str:
+        """The lock file of ``filename``: ``.<name>.lock`` in the same
+        directory, so every process that edits the file looks in the same
+        place.
+        """
+        directory, basename = os.path.split(filename)
+        return os.path.join(directory, f".{basename}.lock")
+
+    def _create_lock_file(self, filename: str) -> str:
+        """Create the lock file of ``filename`` and return its path.
+
+        The file is created with ``O_EXCL``, so the check that no lock
+        exists and the creation are one atomic step and two processes
+        can never both take the lock. It holds the process id and the
+        time, to help someone find out who holds a lock that is left.
+        """
+        from datetime import datetime
+
+        lock_filename = self._get_lock_filename(filename)
+        flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY
+
+        try:
+            fd = os.open(lock_filename, flags, 0o644)
+        except FileExistsError as e:
+            raise ClickException(
+                _(
+                    "{filename}: The file is already being edited, the lock"
+                    " file exists: {lock_filename}"
+                ).format(filename=filename, lock_filename=lock_filename)
+            ) from e
+        except OSError as e:
+            raise ClickException(
+                _("{filename}: Could not create the lock file: {e}").format(
+                    filename=filename, e=e
+                )
+            ) from e
+
+        try:
