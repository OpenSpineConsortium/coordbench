+/// Ensures that a requested number of characters is at least one.
+fn check_count(count: usize) -> StrResult<()> {
+    if count == 0 {
+        bail!("count must be at least 1");
+    }
+    Ok(())
+}
+
+/// Turns the extracted grapheme clusters into an array, failing if there are
+/// fewer of them than were requested.
+fn collect_graphemes(
+    graphemes: Vec<&str>,
+    count: usize,
+    string: &str,
+) -> StrResult<Value> {
+    if graphemes.len() < count {
+        bail!(
+            "not enough characters (requested {count}, but string only has {})",
+            string.graphemes(true).count()
+        );
+    }
+    Ok(Value::Array(graphemes.into_iter().map(|g| Value::Str(g.into())).collect()))
+}
