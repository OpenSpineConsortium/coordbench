+// collectMethodsAllowed records the methods that have a handler on the
+// node in rctx.methodsAllowed, for the Allow header of a 405 response. The
+// list is kept free of duplicates and in the order of the method types, which
+// for the standard methods is alphabetical, so the header never varies from
+// one request to the next. It is only called once a route has matched but its
+// method has not, so a request that is routed costs nothing.
+func (n *node) collectMethodsAllowed(rctx *Context) {
+	for mt, ep := range n.endpoints {
+		if mt == mALL || mt == mSTUB || ep == nil || ep.handler == nil {
+			continue
+		}
+		rctx.addMethodAllowed(mt)
+	}
+}
