diff --git a/cors.go b/cors.go
new file mode 100644
index 0000000..d773c54
--- /dev/null
+++ b/cors.go
@@ -0,0 +1,270 @@
+package chi
+
+import (
+	"net/http"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+// CORSOptions configures the Cross-Origin Resource Sharing headers written
+// by CORS and by Mux#EnableCORSWithOptions.
+//
+// A zero AllowOrigin, an empty AllowHeaders and a zero MaxAge stand for the
+// values of DefaultCORSOptions, so a partly filled struct stays usable. A
+// negative MaxAge leaves Access-Control-Max-Age out of the response.
+type CORSOptions struct {
+	// AllowOrigin is the value of Access-Control-Allow-Origin, "*" by default.
+	AllowOrigin string
+
+	// AllowMethods is the value of Access-Control-Allow-Methods. When empty,
+	// the methods the requested resource has handlers for are used instead.
+	AllowMethods []string
+
+	// AllowHeaders is the value of Access-Control-Allow-Headers.
+	AllowHeaders []string
+
+	// ExposeHeaders is the value of Access-Control-Expose-Headers. Nothing
+	// is exposed when it is empty.
+	ExposeHeaders []string
+
+	// MaxAge is how many seconds a browser may cache a preflight answer.
+	MaxAge int
+
+	// AllowCredentials sets Access-Control-Allow-Credentials to true.
+	AllowCredentials bool
+}
+
+// DefaultCORSOptions returns the options Mux#EnableCORS uses: any origin, the
+// headers most APIs are called with, and a preflight cache of one hour. The
+// allowed methods are left empty so that they follow each resource's routes.
+func DefaultCORSOptions() CORSOptions {
+	return CORSOptions{
+		AllowOrigin:  "*",
+		AllowHeaders: []string{"Accept", "Authorization", "Content-Type", "X-CSRF-Token"},
+		MaxAge:       3600,
+	}
+}
+
+// methodNames maps a method type to its HTTP method name. It is the same map
+// as reverseMethodMap, so methods added by RegisterMethod are found in it.
+var methodNames = reverseMethodMap
+
+// GetMethodName returns the HTTP method name of a method type, such as "GET"
+// for mGET, or an empty string when the type is not a single known method.
+func GetMethodName(method methodTyp) string {
+	return methodNames[method]
+}
+
+// corsFallbackMethods are advertised for a path that no route matches, where
+// there is no resource to ask for its methods.
+var corsFallbackMethods = []string{
+	http.MethodGet, http.MethodHead, http.MethodPost, http.MethodPut,
+	http.MethodPatch, http.MethodDelete, http.MethodOptions,
+}
+
+// CORS returns a middleware that adds Cross-Origin Resource Sharing headers
+// to every response and answers OPTIONS requests itself as preflights, with
+// status 204 and the allowed methods, headers and max age. Without options it
+// uses DefaultCORSOptions.
+func CORS(options ...CORSOptions) func(http.Handler) http.Handler {
+	opts := DefaultCORSOptions()
+	if len(options) > 0 {
+		opts = options[0].withDefaults()
+	}
+
+	return func(next http.Handler) http.Handler {
+		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			setCORSHeaders(w, r, opts)
+			if r.Method != http.MethodOptions {
+				next.ServeHTTP(w, r)
+				return
+			}
+			setPreflightHeaders(w, r, opts)
+			w.WriteHeader(http.StatusNoContent)
+		})
+	}
+}
+
+// withDefaults fills the fields that have no useful zero value.
+func (o CORSOptions) withDefaults() CORSOptions {
+	d := DefaultCORSOptions()
+	if o.AllowOrigin == "" {
+		o.AllowOrigin = d.AllowOrigin
+	}
+	if len(o.AllowHeaders) == 0 {
+		o.AllowHeaders = d.AllowHeaders
+	}
+	if o.MaxAge == 0 {
+		o.MaxAge = d.MaxAge
+	}
+	return o
+}
+
+// setCORSHeaders writes the headers every response carries, preflight or not.
+func setCORSHeaders(w http.ResponseWriter, r *http.Request, opts CORSOptions) {
+	h := w.Header()
+
+	origin := opts.AllowOrigin
+	if origin == "*" && opts.AllowCredentials && r.Header.Get("Origin") != "" {
+		// Browsers refuse "*" together with credentials, so name the caller.
+		origin = r.Header.Get("Origin")
+	}
+	h.Set("Access-Control-Allow-Origin", origin)
+	if origin != "*" {
+		addVary(h, "Origin")
+	}
+
+	if opts.AllowCredentials {
+		h.Set("Access-Control-Allow-Credentials", "true")
+	}
+	if len(opts.ExposeHeaders) > 0 {
+		h.Set("Access-Control-Expose-Headers", strings.Join(opts.ExposeHeaders, ", "))
+	}
+}
+
+// setPreflightHeaders writes the headers only a preflight answer needs.
+func setPreflightHeaders(w http.ResponseWriter, r *http.Request, opts CORSOptions) {
+	h := w.Header()
+
+	methods := opts.AllowMethods
+	if len(methods) == 0 {
+		methods = resourceMethods(r)
+	}
+	h.Set("Access-Control-Allow-Methods", strings.Join(methods, ", "))
+	h.Set("Access-Control-Allow-Headers", strings.Join(opts.AllowHeaders, ", "))
+	if opts.MaxAge > 0 {
+		h.Set("Access-Control-Max-Age", strconv.Itoa(opts.MaxAge))
+	}
+}
+
+// resourceMethods names the methods the requested path has handlers for,
+// always with OPTIONS, since the preflight itself is one. A path no route
+// matches gets corsFallbackMethods.
+func resourceMethods(r *http.Request) []string {
+	var found []methodTyp
+	if rctx := RouteContext(r.Context()); rctx != nil {
+		found = detectMethods(rctx, r)
+	}
+	if len(found) == 0 {
+		return corsFallbackMethods
+	}
+
+	names := make([]string, 0, len(found)+1)
+	hasOptions := false
+	for _, m := range found {
+		hasOptions = hasOptions || m == mOPTIONS
+		names = append(names, GetMethodName(m))
+	}
+	if !hasOptions {
+		names = append(names, http.MethodOptions)
+	}
+	return names
+}
+
+// detectMethods lists, in method order, the methods that have a handler for
+// the request's path. Routing may already have found them (a 405 inside a
+// group); otherwise each method is tried against the root router, without
+// disturbing the request's own routing context.
+func detectMethods(rctx *Context, r *http.Request) []methodTyp {
+	if len(rctx.methodsAllowed) > 0 {
+		return sortedMethods(rctx.methodsAllowed)
+	}
+	if rctx.Routes == nil {
+		return nil
+	}
+
+	path := r.URL.RawPath
+	if path == "" {
+		path = r.URL.Path
+	}
+	if path == "" {
+		path = "/"
+	}
+
+	var found []methodTyp
+	for method, name := range methodNames {
+		if rctx.Routes.Match(NewRouteContext(), name, path) {
+			found = append(found, method)
+		}
+	}
+	return sortedMethods(found)
+}
+
+// sortedMethods returns a sorted copy without repeated methods.
+func sortedMethods(methods []methodTyp) []methodTyp {
+	sorted := append([]methodTyp(nil), methods...)
+	sort.Slice(sorted, func(i, j int) bool { return sorted[i] < sorted[j] })
+
+	unique := sorted[:0]
+	for i, m := range sorted {
+		if i == 0 || m != sorted[i-1] {
+			unique = append(unique, m)
+		}
+	}
+	return unique
+}
+
+// addVary adds a Vary token unless the response already has it.
+func addVary(h http.Header, token string) {
+	for _, v := range h.Values("Vary") {
+		for _, t := range strings.Split(v, ",") {
+			if strings.EqualFold(strings.TrimSpace(t), token) {
+				return
+			}
+		}
+	}
+	h.Add("Vary", token)
+}
+
+// EnableCORS adds the CORS middleware with DefaultCORSOptions to the mux and
+// makes its 405 answers carry an Allow header, so a browser's preflight and
+// a plain method mismatch both learn which methods the resource has.
+func (mx *Mux) EnableCORS() {
+	mx.EnableCORSWithOptions(DefaultCORSOptions())
+}
+
+// EnableCORSWithOptions is EnableCORS with the given options.
+//
+// Unlike Use, it may be called after routes were registered: a mux then runs
+// the middleware for all of its routes, while a mux made by With or Group only
+// wraps the routes registered after the call.
+func (mx *Mux) EnableCORSWithOptions(options CORSOptions) {
+	mx.middlewares = append(mx.middlewares, CORS(options))
+	if !mx.inline && mx.handler != nil {
+		mx.updateRouteHandler()
+	}
+
+	previous := mx.MethodNotAllowedHandler()
+	mx.MethodNotAllowed(func(w http.ResponseWriter, r *http.Request) {
+		setAllowHeader(w, r)
+		previous(w, r)
+	})
+}
+
+// WithCORS returns an inline mux, as With does, that has CORS enabled, with
+// the given options or else DefaultCORSOptions. Routes registered on it answer
+// cross-origin requests; the routes of the mux it was made from do not.
+func (mx *Mux) WithCORS(options ...CORSOptions) Router {
+	im := mx.With().(*Mux)
+	if len(options) > 0 {
+		im.EnableCORSWithOptions(options[0])
+	} else {
+		im.EnableCORS()
+	}
+	return im
+}
+
+// setAllowHeader sets the Allow header of a 405 answer from the methods that
+// routing found for the path, if it found any.
+func setAllowHeader(w http.ResponseWriter, r *http.Request) {
+	rctx := RouteContext(r.Context())
+	if rctx == nil || len(rctx.methodsAllowed) == 0 {
+		return
+	}
+	names := make([]string, 0, len(rctx.methodsAllowed))
+	for _, m := range sortedMethods(rctx.methodsAllowed) {
+		names = append(names, GetMethodName(m))
+	}
+	w.Header().Set("Allow", strings.Join(names, ", "))
+}
