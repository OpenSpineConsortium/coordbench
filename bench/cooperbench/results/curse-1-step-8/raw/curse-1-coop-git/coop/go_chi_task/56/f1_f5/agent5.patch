+// EnableCORS enables Cross-Origin Resource Sharing on the router with the
+// options of DefaultCORSOptions: any origin is allowed, and a preflight
+// OPTIONS request is answered with 204 and the methods that the routes of
+// its path have.
+//
+// It adds the CORS middleware to the middleware stack, and sets the
+// method-not-allowed handler so that a preflight no route answers, and a 405,
+// still carry the CORS headers and the methods that are allowed. Call it
+// before defining the routes, as with Use.
+func (mx *Mux) EnableCORS() {
+	mx.EnableCORSWithOptions(DefaultCORSOptions())
+}
+
+// EnableCORSWithOptions is EnableCORS with the given options in place of
+// DefaultCORSOptions.
+func (mx *Mux) EnableCORSWithOptions(options CORSOptions) {
+	mx.appendMiddleware(CORS(options))
+
+	// The setter below stores the handler on the parent of an inline mux, so
+	// the handler to fall back on is the parent's.
+	target := mx
+	if mx.inline && mx.parent != nil {
+		target = mx.parent
+	}
+	mx.MethodNotAllowed(corsMethodNotAllowedHandler(options, target.methodNotAllowedHandler))
+}
+
+// WithCORS returns an inline router, as With does, with CORS enabled by
+// EnableCORS for the routes defined on it.
+//
+// A preflight request is answered by the method-not-allowed handler of the
+// router the group was made from, since the group has no say in routing, so
+// that handler now answers the preflights of every route of that router.
+func (mx *Mux) WithCORS() Router {
+	im := mx.With().(*Mux)
+	im.EnableCORS()
+	return im
+}
+
+// appendMiddleware is Use for a router that may already have routes: the
+// handler chain is built again, since the routes defined so far are reached
+// through it.
+func (mx *Mux) appendMiddleware(middleware func(http.Handler) http.Handler) {
+	mx.middlewares = append(mx.middlewares, middleware)
+	if !mx.inline && mx.handler != nil {
+		mx.updateRouteHandler()
+	}
+}
+
