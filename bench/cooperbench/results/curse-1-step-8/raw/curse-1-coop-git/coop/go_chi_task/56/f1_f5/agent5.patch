diff --git a/cors.go b/cors.go
new file mode 100644
index 0000000..9e661ee
--- /dev/null
+++ b/cors.go
@@ -0,0 +1,243 @@
+package chi
+
+import (
+	"net/http"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+// CORSOptions configures the Cross-Origin Resource Sharing headers that
+// Mux#EnableCORSWithOptions and the CORS middleware write.
+//
+// A field left empty (or zero) writes no header for it, so an option is
+// switched off by clearing it.
+type CORSOptions struct {
+	// AllowOrigin is the value of Access-Control-Allow-Origin, either "*"
+	// or a single origin such as "https://example.com".
+	AllowOrigin string
+
+	// AllowMethods is the value of Access-Control-Allow-Methods on a
+	// preflight response. When it is empty the methods are detected from
+	// the routes registered for the requested path.
+	AllowMethods []string
+
+	// AllowHeaders is the value of Access-Control-Allow-Headers on a
+	// preflight response. When it is empty the headers the browser asked
+	// for in Access-Control-Request-Headers are allowed.
+	AllowHeaders []string
+
+	// ExposeHeaders is the value of Access-Control-Expose-Headers: the
+	// response headers a browser lets a page read beyond the safelisted ones.
+	ExposeHeaders []string
+
+	// MaxAge is how long, in seconds, a browser may cache a preflight
+	// response (Access-Control-Max-Age). Zero or less writes no header.
+	MaxAge int
+
+	// AllowCredentials writes Access-Control-Allow-Credentials: true.
+	// Browsers refuse a wildcard origin together with credentials, so the
+	// request's own Origin is answered in place of "*" when this is set.
+	AllowCredentials bool
+}
+
+// DefaultCORSOptions returns the options that Mux#EnableCORS uses: any
+// origin, the headers that browsers and JSON APIs commonly send, the
+// methods detected from the routes, and a preflight cache of one hour.
+func DefaultCORSOptions() CORSOptions {
+	return CORSOptions{
+		AllowOrigin: "*",
+		AllowHeaders: []string{
+			"Accept", "Authorization", "Content-Type", "Origin", "X-CSRF-Token", "X-Requested-With",
+		},
+		MaxAge: 3600,
+	}
+}
+
+// CORS returns a middleware that writes the CORS response headers described
+// by options and answers preflight requests itself.
+//
+// A preflight is an OPTIONS request for a path that has routes. It is
+// answered with 204 and the methods those routes have, in
+// Access-Control-Allow-Methods, without reaching the handler. An OPTIONS
+// request that has no Access-Control-Request-Method and whose path has its
+// own OPTIONS route is not a preflight, so it goes on to that route.
+//
+// The methods are found through the routing context of the request, so the
+// middleware knows them only behind a chi router; elsewhere it answers a
+// preflight only if options.AllowMethods names the methods.
+func CORS(options CORSOptions) func(http.Handler) http.Handler {
+	return func(next http.Handler) http.Handler {
+		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			setCORSHeaders(w, r, options)
+
+			if r.Method == http.MethodOptions {
+				if methods, ok := preflightMethods(r, options); ok {
+					writePreflight(w, r, options, methods)
+					return
+				}
+			}
+			next.ServeHTTP(w, r)
+		})
+	}
+}
+
+// corsMethodNotAllowedHandler is the method-not-allowed handler that
+// Mux#EnableCORSWithOptions installs. It is where a preflight ends up when
+// the CORS middleware did not see it first, as with a group made by
+// WithCORS, whose middleware runs only for routes that matched. Any other
+// method gets the 405 of next, or a plain 405 where there is none, with the
+// Allow header that RFC 9110 requires of a 405 response.
+func corsMethodNotAllowedHandler(options CORSOptions, next http.HandlerFunc) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		methods := availableMethods(r)
+		if r.Method == http.MethodOptions && len(methods) > 0 {
+			setCORSHeaders(w, r, options)
+			writePreflight(w, r, options, methods)
+			return
+		}
+
+		if w.Header().Get("Allow") == "" {
+			if allow := methodList(methods); allow != "" {
+				w.Header().Set("Allow", allow)
+			}
+		}
+		if next != nil {
+			next(w, r)
+			return
+		}
+		w.WriteHeader(http.StatusMethodNotAllowed)
+		w.Write(nil)
+	}
+}
+
+// setCORSHeaders writes the headers that every CORS response carries,
+// preflight or not.
+func setCORSHeaders(w http.ResponseWriter, r *http.Request, options CORSOptions) {
+	h := w.Header()
+
+	origin := options.AllowOrigin
+	if origin == "*" && options.AllowCredentials && r.Header.Get("Origin") != "" {
+		origin = r.Header.Get("Origin")
+	}
+	if origin != "" {
+		h.Set("Access-Control-Allow-Origin", origin)
+	}
+	if origin != "*" {
+		addVary(h, "Origin")
+	}
+	if options.AllowCredentials {
+		h.Set("Access-Control-Allow-Credentials", "true")
+	}
+	if len(options.ExposeHeaders) > 0 {
+		h.Set("Access-Control-Expose-Headers", strings.Join(options.ExposeHeaders, ", "))
+	}
+}
+
+// preflightMethods reports whether an OPTIONS request is one the CORS
+// middleware answers itself, and if so the methods the path has routes for.
+func preflightMethods(r *http.Request, options CORSOptions) ([]methodTyp, bool) {
+	methods := availableMethods(r)
+	if len(methods) == 0 {
+		// No route knows the path, or there is no router to ask. Without a
+		// router the methods named in the options can still answer; with
+		// one, an unknown path is the router's 404 to give.
+		return nil, len(options.AllowMethods) > 0 && RouteContext(r.Context()) == nil
+	}
+	if r.Header.Get("Access-Control-Request-Method") != "" {
+		return methods, true
+	}
+	// A plain OPTIONS request goes to the OPTIONS route of the path, if any.
+	for _, m := range methods {
+		if m == mOPTIONS {
+			return methods, false
+		}
+	}
+	return methods, true
+}
+
+// writePreflight answers a preflight request with 204 and the headers that
+// tell the browser what it may send. methods are the ones the path has
+// routes for, used unless the options name the methods.
+func writePreflight(w http.ResponseWriter, r *http.Request, options CORSOptions, methods []methodTyp) {
+	h := w.Header()
+
+	allowMethods := strings.Join(options.AllowMethods, ", ")
+	if allowMethods == "" {
+		allowMethods = methodList(methods)
+	}
+	if allowMethods != "" {
+		h.Set("Access-Control-Allow-Methods", allowMethods)
+	}
+
+	allowHeaders := strings.Join(options.AllowHeaders, ", ")
+	if allowHeaders == "" {
+		allowHeaders = r.Header.Get("Access-Control-Request-Headers")
+		addVary(h, "Access-Control-Request-Headers")
+	}
+	if allowHeaders != "" {
+		h.Set("Access-Control-Allow-Headers", allowHeaders)
+	}
+
+	if options.MaxAge > 0 {
+		h.Set("Access-Control-Max-Age", strconv.Itoa(options.MaxAge))
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
+
+// availableMethods returns the methods that have a route for the path of the
+// request, in a fixed order. It asks the router the request is being served
+// by, with a context of its own so the request's routing state is left as it
+// is, and it asks with the whole request path, so it gives the same answer
+// from any depth of mounted routers.
+func availableMethods(r *http.Request) []methodTyp {
+	rctx := RouteContext(r.Context())
+	if rctx == nil || rctx.Routes == nil {
+		return nil
+	}
+
+	path := r.URL.RawPath
+	if path == "" {
+		path = r.URL.Path
+	}
+	if path == "" {
+		path = "/"
+	}
+
+	var found []methodTyp
+	probe := NewRouteContext()
+	for name, mt := range methodMap {
+		probe.Reset()
+		if rctx.Routes.Match(probe, name, path) {
+			found = append(found, mt)
+		}
+	}
+	sort.Slice(found, func(i, j int) bool { return found[i] < found[j] })
+	return found
+}
+
+// methodList writes methods as the comma separated list that the Allow and
+// Access-Control-Allow-Methods headers carry.
+func methodList(methods []methodTyp) string {
+	names := make([]string, 0, len(methods))
+	for _, m := range methods {
+		if name := GetMethodName(m); name != "" {
+			names = append(names, name)
+		}
+	}
+	return strings.Join(names, ", ")
+}
+
+// addVary adds value to the Vary header unless it is already there, since
+// the middleware and the method-not-allowed handler can both run for one
+// response.
+func addVary(h http.Header, value string) {
+	for _, line := range h.Values("Vary") {
+		for _, v := range strings.Split(line, ",") {
+			if strings.EqualFold(strings.TrimSpace(v), value) {
+				return
+			}
+		}
+	}
+	h.Add("Vary", value)
+}
diff --git a/middleware/allowed_methods.go b/middleware/allowed_methods.go
