@@ -0,0 +1,67 @@
+package middleware
+
+import (
+	"net/http"
+	"strings"
+
+	"github.com/go-chi/chi/v5"
+)
+
+// allowHeaderMethods are the methods SetAllowHeader tries for a path, in the
+// order they are listed in the Allow header.
+var allowHeaderMethods = []string{
+	http.MethodGet,
+	http.MethodHead,
+	http.MethodPost,
+	http.MethodPut,
+	http.MethodPatch,
+	http.MethodDelete,
+	http.MethodConnect,
+	http.MethodOptions,
+	http.MethodTrace,
+}
+
+// SetAllowHeader adds the Allow header for 405 Method Not Allowed responses
+// (RFC 9110, section 15.5.6), listing the methods registered for the
+// requested path.
+//
+// It looks ahead before routing: when the router has no route for the
+// request's method and path, it lists every method that has one in Allow and
+// passes the request on, so the router answers 405 as it would have anyway.
+// Requests the router can serve are passed on untouched, so successful
+// responses never carry the header. The status of the response is not
+// inspected.
+func SetAllowHeader(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		rctx := chi.RouteContext(r.Context())
+		if rctx == nil || rctx.Routes == nil {
+			next.ServeHTTP(w, r)
+			return
+		}
+
+		routePath := rctx.RoutePath
+		if routePath == "" {
+			if r.URL.RawPath != "" {
+				routePath = r.URL.RawPath
+			} else {
+				routePath = r.URL.Path
+			}
+		}
+
+		// Temporary routing contexts to look ahead before routing the request,
+		// since matching updates the state of the context it is given.
+		if !rctx.Routes.Match(chi.NewRouteContext(), r.Method, routePath) {
+			var allowed []string
+			for _, method := range allowHeaderMethods {
+				if method != r.Method && rctx.Routes.Match(chi.NewRouteContext(), method, routePath) {
+					allowed = append(allowed, method)
+				}
+			}
+			if len(allowed) > 0 {
+				w.Header().Set("Allow", strings.Join(allowed, ", "))
+			}
+		}
+
+		next.ServeHTTP(w, r)
+	})
+}
