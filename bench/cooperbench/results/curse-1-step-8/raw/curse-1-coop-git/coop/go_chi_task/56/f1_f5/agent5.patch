+// allowOrder is the order in which the methods of a route are listed in an
+// Allow header, so that the header does not depend on the order the routing
+// tree was walked in. Methods added with RegisterMethod follow, in the order
+// they were registered.
+var allowOrder = []methodTyp{
+	mGET, mHEAD, mPOST, mPUT, mPATCH, mDELETE, mCONNECT, mOPTIONS, mTRACE,
+}
+
+// allowedMethodNames returns the names of the methods given, each once, in
+// the order of allowOrder.
+func allowedMethodNames(methodsAllowed []methodTyp) []string {
+	var set methodTyp
+	for _, m := range methodsAllowed {
+		set |= m
+	}
+
+	names := make([]string, 0, len(methodsAllowed))
+	for _, m := range allowOrder {
+		if set&m != 0 {
+			names = append(names, reverseMethodMap[m])
+		}
+	}
+	// custom methods are single bits above the standard ones
+	for m := mTRACE << 1; m != 0; m <<= 1 {
+		if name, ok := reverseMethodMap[m]; ok && set&m != 0 {
+			names = append(names, name)
+		}
+	}
+	return names
+}
+
 // methodNotAllowedHandler is a helper function to respond with a 405,
-// method not allowed.
-func methodNotAllowedHandler(w http.ResponseWriter, r *http.Request) {
-	w.WriteHeader(405)
-	w.Write(nil)
+// method not allowed, and the Allow header RFC 9110 asks for when the methods
+// the route supports are known. An Allow header set before, by the
+// middleware.SetAllowHeader for one, is left as it is.
+func methodNotAllowedHandler(methodsAllowed ...methodTyp) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		if len(w.Header()["Allow"]) == 0 {
+			for _, name := range allowedMethodNames(methodsAllowed) {
+				w.Header().Add("Allow", name)
+			}
+		}
+		w.WriteHeader(405)
+		w.Write(nil)
+	}
 }
