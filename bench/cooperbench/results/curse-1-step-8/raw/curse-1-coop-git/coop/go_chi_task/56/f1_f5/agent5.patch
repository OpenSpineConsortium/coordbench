index 0000000..864cf1c
--- /dev/null
+++ b/middleware/allowed_methods.go
@@ -0,0 +1,74 @@
+package middleware
+
+import (
+	"net/http"
+
+	"github.com/go-chi/chi/v5"
+)
+
+// allowHeaderMethods are the methods SetAllowHeader asks the router about, in
+// the order they are listed in the Allow header.
+var allowHeaderMethods = []string{
+	http.MethodGet,
+	http.MethodHead,
+	http.MethodPost,
+	http.MethodPut,
+	http.MethodPatch,
+	http.MethodDelete,
+	http.MethodConnect,
+	http.MethodOptions,
+	http.MethodTrace,
+}
+
+// SetAllowHeader adds the Allow header for 405 responses based on
+// registered methods for the requested path.
+//
+// When the router has no handler for the method of the request but has one
+// for the same path under other methods, the Allow header lists those methods
+// before the request is handled, so that the 405 the router answers with
+// carries it. Nothing is added when the method of the request is served, or
+// when the path is not routed at all or an Allow header is set already, by the
+// middleware at another level of the routers for one. The status of the
+// response is never inspected.
+func SetAllowHeader(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		rctx := chi.RouteContext(r.Context())
+		if rctx != nil && rctx.Routes != nil && len(w.Header()["Allow"]) == 0 {
+			path := routePath(rctx, r)
+			method := rctx.RouteMethod
+			if method == "" {
+				method = r.Method
+			}
+
+			// A new context for each question, so that the routing state
+			// of the request being served stays as it is.
+			if !rctx.Routes.Match(chi.NewRouteContext(), method, path) {
+				for _, m := range allowHeaderMethods {
+					if m != method && rctx.Routes.Match(chi.NewRouteContext(), m, path) {
+						w.Header().Add("Allow", m)
+					}
+				}
+			}
+		}
+
+		next.ServeHTTP(w, r)
+	})
+}
+
+// routePath is the path to put to the router, which is always the root one:
+// the routing context holds the router the request came in at. A path set in
+// the context by an earlier middleware is the one the router will use, until
+// the request is routed into a sub-router, where it is relative to that one
+// and the path of the request is the whole.
+func routePath(rctx *chi.Context, r *http.Request) string {
+	if rctx.RoutePath != "" && len(rctx.RoutePatterns) == 0 {
+		return rctx.RoutePath
+	}
+	if r.URL.RawPath != "" {
+		return r.URL.RawPath
+	}
+	if r.URL.Path != "" {
+		return r.URL.Path
+	}
+	return "/"
+}
