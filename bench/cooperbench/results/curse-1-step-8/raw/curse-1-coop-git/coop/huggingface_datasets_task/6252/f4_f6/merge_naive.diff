         else:
             image = PIL.Image.open(BytesIO(bytes_))
         image.load()  # to avoid "Too many open files" errors
+        if image.mode == "CMYK" and self.mode != "CMYK":
+            # Most vision models and viewers expect RGB, so CMYK is converted unless it was asked for explicitly
+            image = image.convert("RGB")
         if self.mode and self.mode != image.mode:
             image = image.convert(self.mode)
+        if self.crop_margin:
+            image = self._crop_margin(image)
         return image
 
+    def _crop_margin(self, image: "PIL.Image.Image") -> "PIL.Image.Image":
+        """Crop `self.crop_margin` pixels from each edge of the image, keeping its center."""
+        margin = self.crop_margin
+        if margin < 0:
+            raise ValueError(f"`crop_margin` must be a non-negative number of pixels, but got {margin}.")
+        width, height = image.size
+        if 2 * margin >= width or 2 * margin >= height:
+            raise ValueError(
+                f"`crop_margin={margin}` is too large for an image of size {width}x{height}: "
+                "it must be smaller than half of the image width and height."
+            )
+        return image.crop((margin, margin, width - margin, height - margin))
+
