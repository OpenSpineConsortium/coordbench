+    def _parse_metadata_value(self, parser: "Parser", token: "Token") -> str:
+        """Parse the ``="value"`` after a metadata name such as ``note``.
+        Only a string literal is accepted, since the value is read from
+        the AST by translation tools and is never evaluated.
+        """
+        if parser.stream.current.type != "assign":
+            parser.fail(
+                f"metadata parameter {token.value!r} requires a value assignment.",
+                token.lineno,
+                exc=TemplateAssertionError,
+            )
+
+        next(parser.stream)
+        starts_with_string = parser.stream.current.type == "string"
+        value = parser.parse_expression()
+
+        # a literal can still be the start of a larger expression, such as
+        # "a" ~ b, which is not a literal either
+        if not (
+            starts_with_string
+            and isinstance(value, nodes.Const)
+            and isinstance(value.value, str)
+        ):
+            parser.fail(
+                f"metadata parameter {token.value!r} must be a string literal.",
+                token.lineno,
+                exc=TemplateAssertionError,
+            )
+
+        return t.cast(str, value.value)
+
