+def _log(
+    logger: Callable[[str], object]
+    | logging.Logger
+    | logging.LoggerAdapter[Any]
+    | None,
+    message: str,
+    *,
+    warning: bool = False,
+) -> None:
+    """
+    Send ``message`` to ``logger``, which is either a standard logger or a callable
+    that takes the message as its only argument. Does nothing if ``logger`` is
+    ``None``.
+    """
+    if logger is None:
+        return
+    if isinstance(logger, (logging.Logger, logging.LoggerAdapter)) or not callable(
+        logger
+    ):
+        # A standard logger, or something that looks like one
+        (logger.warning if warning else logger.info)(message)
+    else:
+        logger(message)
+
