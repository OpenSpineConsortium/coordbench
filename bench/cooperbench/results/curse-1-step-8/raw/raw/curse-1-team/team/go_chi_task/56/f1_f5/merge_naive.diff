+// addMethodsAllowed records on the routing context the methods registered on
+// n, a node whose route matched the request path but not the request method.
+// It runs only while a 405 is being worked out, never on a matched request.
+func (n *node) addMethodsAllowed(rctx *Context) {
+	for m, e := range n.endpoints {
+		if m == mALL || m == mSTUB || e == nil || e.handler == nil {
+			continue
+		}
+		if !hasMethod(rctx.methodsAllowed, m) {
+			rctx.methodsAllowed = append(rctx.methodsAllowed, m)
+		}
+	}
+	sortMethods(rctx.methodsAllowed)
+}
+
+func hasMethod(methods []methodTyp, method methodTyp) bool {
+	for _, m := range methods {
+		if m == method {
+			return true
+		}
+	}
+	return false
+}
+
+// sortMethods puts methods in the order of an Allow header: the standard
+// methods in allowOrder, then the registered ones by the bit they were given.
+func sortMethods(methods []methodTyp) {
+	rank := func(m methodTyp) int {
+		for i, o := range allowOrder {
+			if o == m {
+				return i
+			}
+		}
+		return len(allowOrder)
+	}
+	sort.Slice(methods, func(i, j int) bool {
+		ri, rj := rank(methods[i]), rank(methods[j])
+		if ri != rj {
+			return ri < rj
+		}
+		return methods[i] < methods[j]
+	})
+}
