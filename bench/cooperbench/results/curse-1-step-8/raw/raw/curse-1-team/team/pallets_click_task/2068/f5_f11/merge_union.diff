+    def _get_lock_filename(self, filename: str) -> str:
+        """Return the path of the lock file for ``filename``: the same
+        directory, named ``.{original_filename}.lock``.
+        """
+        directory, base = os.path.split(filename)
+        return os.path.join(directory, f".{base}.lock")
+
+    def _create_lock_file(self, filename: str) -> str:
+        """Create the lock file for ``filename`` and return its path.
+
+        The file is created with ``O_CREAT | O_EXCL``, so the check for an
+        existing lock and the creation are one atomic step, and two
+        processes can never both believe they hold the lock. The file
+        records the process ID and the time for whoever finds it.
+
+        :raises ClickException: if the file is already locked.
+        """
+        import datetime
+
+        lock_filename = self._get_lock_filename(filename)
+
+        try:
+            fd = os.open(lock_filename, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
+        except FileExistsError:
+            raise ClickException(
+                _(
+                    "{filename}: File is already being edited."
+                    " Lock file exists: {lock_filename}"
+                ).format(filename=filename, lock_filename=lock_filename)
+            ) from None
+
+        try:
+            with os.fdopen(fd, "w", encoding="utf-8") as f:
+                f.write(f"PID: {os.getpid()}\n")
+                f.write(f"Time: {datetime.datetime.now().isoformat()}\n")
+        except BaseException:
+            # The lock exists but could not be filled in; do not leave a
+            # lock behind that nobody will remove.
+            self._remove_lock_file(lock_filename)
+            raise
+
+        return lock_filename
+
+    def _remove_lock_file(self, lock_filename: str) -> None:
+        """Remove a lock file. A lock that is already gone, or that cannot
+        be removed, is ignored so that cleanup never hides the error that
+        led to it.
+        """
+        with contextlib.suppress(OSError):
+            os.unlink(lock_filename)
+
