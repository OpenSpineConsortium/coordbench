+_MONITOR_POLL_INTERVAL = 0.1
+
+
+def _monitor_callback(
+    monitor_process: t.Any,
+) -> cabc.Callable[[str, int, str, float], None] | None:
+    """Find the callback in what was passed as ``monitor_process``: the
+    callback itself, or a mapping or an object with a ``callback``
+    entry. Anything else turns monitoring off.
+    """
+    if monitor_process is None or monitor_process is False:
+        return None
+
+    if callable(monitor_process):
+        return monitor_process  # type: ignore[no-any-return]
+
+    if isinstance(monitor_process, cabc.Mapping):
+        callback = monitor_process.get("callback")
+    else:
+        callback = getattr(monitor_process, "callback", None)
+
+    return callback if callable(callback) else None
+
+
+def _process_is_stopped(pid: int) -> bool | None:
+    """Whether the process is stopped by a signal, or ``None`` when the
+    platform cannot say. Windows has no such state, Linux tells it in
+    ``/proc`` and the other POSIX systems through ``ps``.
+    """
+    if WIN:
+        return None
+
+    try:
+        pid = int(pid)
+
+        try:
+            with open(f"/proc/{pid}/stat", "rb") as f:
+                stat = f.read()
+        except FileNotFoundError:
+            stat = b""
+
+        if stat:
+            # The state follows the command, which is in parentheses
+            # and may contain spaces and parentheses itself.
+            state = stat.rpartition(b")")[2].split()[0]
+            return state in (b"T", b"t")
+
+        if os.path.isdir("/proc/self"):
+            # /proc exists, so the process is gone.
+            return None
+
+        import subprocess
+
+        out = subprocess.run(
+            ["ps", "-o", "stat=", "-p", str(pid)],
+            stdout=subprocess.PIPE,
+            stderr=subprocess.DEVNULL,
+            check=False,
+        ).stdout
+        return out.strip().startswith(b"T")
+    except Exception:
+        return None
+
+
+class _ProcessMonitor:
+    """Reports the life of an editor process to a callback from a
+    background thread: ``start`` when the monitor starts, ``suspend`` and
+    ``resume`` when the process is stopped and continued by a signal,
+    where the platform shows it, and ``terminate`` after :meth:`stop`.
+
+    One thread makes every call, so the events arrive in order, and
+    :meth:`stop` returns after the last of them. A callback that raises
+    gets a :exc:`UserWarning` and monitoring goes on.
+    """
+
+    def __init__(
+        self,
+        callback: cabc.Callable[[str, int, str, float], None],
+        process_id: int,
+        editor_command: str,
+    ) -> None:
+        import threading
+
+        self._callback = callback
+        self._process_id = process_id
+        self._editor_command = editor_command
+        self._start_time = time.time()
+        self._end_time = self._start_time
+        self._done = threading.Event()
+        self._thread = threading.Thread(
+            target=self._run, name="click-editor-monitor", daemon=True
+        )
+
+    def start(self) -> None:
+        self._thread.start()
+
+    def stop(self) -> None:
+        self._end_time = time.time()
+        self._done.set()
+        self._thread.join()
+
+    def _notify(self, event_type: str, timestamp: float) -> None:
+        try:
+            self._callback(
+                event_type, self._process_id, self._editor_command, timestamp
+            )
+        except Exception as e:
+            import warnings
+
+            try:
+                warnings.warn(
+                    _(
+                        "Editor process monitor callback failed on"
+                        " {event!r}: {error}"
+                    ).format(event=event_type, error=e),
+                    UserWarning,
+                    stacklevel=2,
+                )
+            except Exception:
+                # Warnings turned into errors must not end monitoring.
+                pass
+
+    def _run(self) -> None:
+        self._notify("start", self._start_time)
+        stopped = False
+
+        while not self._done.wait(_MONITOR_POLL_INTERVAL):
+            now_stopped = _process_is_stopped(self._process_id)
+
+            if now_stopped is None or now_stopped == stopped:
+                continue
+
+            stopped = now_stopped
+            self._notify("suspend" if stopped else "resume", time.time())
+
+        self._notify("terminate", self._end_time)
+
+
