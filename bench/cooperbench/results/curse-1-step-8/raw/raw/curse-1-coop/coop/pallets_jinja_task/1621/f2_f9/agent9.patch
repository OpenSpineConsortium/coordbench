+    def _init_monitoring(self) -> None:
+        # Weak, so a loader never keeps an environment, and with it its
+        # compiled templates, alive. Only filled while auto_reload is on.
+        self._environments: "weakref.WeakSet[Environment]" = weakref.WeakSet()
+        self._monitor: t.Optional[_SearchPathMonitor] = None
+        self._monitor_lock = threading.Lock()
+
+    def __getstate__(self) -> t.Dict[str, t.Any]:
+        # Threads, locks and weak sets can not be pickled or copied;
+        # a copy starts monitoring on its own when it is first used.
+        state = self.__dict__.copy()
+        for name in ("_environments", "_monitor", "_monitor_lock"):
+            state.pop(name, None)
+        return state
+
+    def __setstate__(self, state: t.Dict[str, t.Any]) -> None:
+        self.__dict__.update(state)
+        self._init_monitoring()
+
+    def _watch(self, environment: "Environment") -> None:
+        """Remember the environment and make sure the search paths are
+        being polled.
+        """
+        if not self.auto_reload:
+            return
+
+        monitor = self._monitor
+
+        if (
+            monitor is not None
+            and monitor.running
+            and environment in self._environments
+        ):
+            return
+
+        with self._monitor_lock:
+            self._environments.add(environment)
+
+            if self._monitor is None or not self._monitor.running:
+                self._monitor = _SearchPathMonitor(self, self._poll_interval)
+
+    def _template_names(self, file_path: t.Union[str, os.PathLike]) -> t.Set[str]:
+        """The names a file is found under, one for each search path it
+        is below. The file does not have to exist.
+        """
+        names = set()
+        path = os.fspath(file_path)
+
+        for resolve in (os.path.abspath, os.path.realpath):
+            target = resolve(path)
+
+            for searchpath in self.searchpath:
+                try:
+                    relative = os.path.relpath(target, resolve(searchpath))
+                except ValueError:
+                    # Another drive on Windows.
+                    continue
+
+                parts = relative.split(os.path.sep)
+
+                if os.path.isabs(relative) or parts[0] in (
+                    os.path.pardir,
+                    os.path.curdir,
+                ):
+                    continue
+
+                names.add("/".join(parts))
+
+        return names
+
+    def _on_template_changed(self, file_paths: t.List[str]) -> None:
+        """Remove the templates for these changed files from the cache
+        of every environment using this loader. Called by the monitor
+        thread; also the way to do it by hand, for example in tests.
+
+        :param file_paths: Absolute paths of the files that were
+            modified, deleted or added. A path outside the search paths
+            or one that does not exist is ignored.
+        """
+        names: t.Set[str] = set()
+
+        for file_path in file_paths:
+            names.update(self._template_names(file_path))
+
+        if not names:
+            return
+
+        with self._monitor_lock:
+            environments = list(self._environments)
+
+        for environment in environments:
+            self._invalidate(environment, names)
+
+    def _invalidate(self, environment: "Environment", names: t.Set[str]) -> None:
+        cache = environment.cache
+        loader = environment.loader
+
+        if cache is None or loader is None:
+            return
+
+        for key in list(cache):
+            try:
+                key_loader, name = key
+            except (TypeError, ValueError):
+                continue
+
+            if key_loader() is loader and _canonical_template_name(name) in names:
+                try:
+                    del cache[key]
+                except KeyError:
+                    # Evicted or removed by another thread meanwhile.
+                    pass
 
