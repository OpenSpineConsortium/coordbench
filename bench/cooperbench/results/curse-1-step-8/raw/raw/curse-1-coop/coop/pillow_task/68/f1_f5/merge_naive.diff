+def _exif_log_function(
+    logger: Callable[[str], object] | logging.Logger | None,
+) -> Callable[..., None]:
+    """
+    Return a function ``log(message, level="info")`` that sends a message to
+    ``logger``: a standard logger gets it through the method named by ``level``,
+    any other callable gets the message as its only argument, and ``None`` drops it.
+    """
+
+    def drop(message: str, level: str = "info") -> None:
+        pass
+
+    def to_logger(message: str, level: str = "info") -> None:
+        getattr(logger, level)(message)
+
+    def to_callable(message: str, level: str = "info") -> None:
+        cast(Callable[[str], object], logger)(message)
+
+    if logger is None:
+        return drop
+    if isinstance(logger, (logging.Logger, logging.LoggerAdapter)):
+        return to_logger
+    if callable(logger):
+        return to_callable
+    msg = "logger must be a callable or a logging.Logger"
+    raise TypeError(msg)
+
