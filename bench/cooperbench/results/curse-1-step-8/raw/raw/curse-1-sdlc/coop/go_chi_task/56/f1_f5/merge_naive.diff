 // methodNotAllowedHandler is a helper function to respond with a 405,
-// method not allowed.
-func methodNotAllowedHandler(w http.ResponseWriter, r *http.Request) {
-	w.WriteHeader(405)
-	w.Write(nil)
+// method not allowed, naming the methods that are allowed in the Allow header.
+func methodNotAllowedHandler(methodsAllowed ...methodTyp) func(w http.ResponseWriter, r *http.Request) {
+	return func(w http.ResponseWriter, r *http.Request) {
+		addAllowHeader(w.Header(), methodsAllowed)
+		w.WriteHeader(405)
+		w.Write(nil)
+	}
+}
+
+// addAllowHeader adds each method to the Allow header, one value per method,
+// except those the header already names: the SetAllowHeader middleware may
+// have added them before the router answered.
+func addAllowHeader(h http.Header, methods []methodTyp) {
+	if len(methods) == 0 {
+		return
+	}
+	named := allowedMethodNames(h)
+	for _, m := range methods {
+		name, ok := reverseMethodMap[m]
+		if !ok || named[name] {
+			continue
+		}
+		h.Add("Allow", name)
+		named[name] = true
+	}
+}
+
+// allowedMethodNames returns the methods already listed in the Allow header,
+// whether as separate values or as a comma separated list.
+func allowedMethodNames(h http.Header) map[string]bool {
+	named := make(map[string]bool)
+	for _, v := range h["Allow"] {
+		for _, name := range strings.Split(v, ",") {
+			named[strings.TrimSpace(name)] = true
+		}
+	}
+	return named
+}
+
+// EnableCORS adds the CORS middleware with DefaultCORSOptions to the Mux and
+// installs a method-not-allowed handler that answers preflight requests and
+// lists the allowed methods in the Allow header of a 405.
+func (mx *Mux) EnableCORS() {
+	mx.EnableCORSWithOptions(DefaultCORSOptions())
+}
+
+// EnableCORSWithOptions is EnableCORS with the given options.
+//
+// Unlike Use, it may be called after routes were added to the Mux. It
+// replaces the Mux's method-not-allowed handler with one that sends the
+// CORS headers and then calls the handler it replaced, so a custom handler
+// set with MethodNotAllowed before this call keeps writing the 405.
+func (mx *Mux) EnableCORSWithOptions(options CORSOptions) {
+	mx.middlewares = append(mx.middlewares, CORS(options))
+	if !mx.inline && mx.handler != nil {
+		mx.updateRouteHandler()
+	}
+
+	// As MethodNotAllowed does, an inline mux sets the handler on its parent.
+	owner := mx
+	if mx.inline && mx.parent != nil {
+		owner = mx.parent
+	}
+	mx.MethodNotAllowed(corsMethodNotAllowed(options, owner.methodNotAllowedHandler))
+}
+
+// WithCORS returns an inline Mux, like With and Group, whose routes have
+// CORS enabled with DefaultCORSOptions. A preflight request is answered
+// through the method-not-allowed handler, which the parent Mux shares, so
+// it also answers preflights for the parent's routes.
+func (mx *Mux) WithCORS() Router {
+	im := mx.With().(*Mux)
+	im.EnableCORS()
+	return im
 }
