diff --git a/cors.go b/cors.go
new file mode 100644
index 0000000..2d24de4
--- /dev/null
+++ b/cors.go
@@ -0,0 +1,202 @@
+package chi
+
+import (
+	"net/http"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+// CORSOptions configures the CORS middleware and the Mux#EnableCORS helpers.
+//
+// A zero value is usable: an empty AllowOrigin means "*", an empty
+// AllowMethods lists the methods the router serves for the requested path,
+// an empty AllowHeaders echoes the headers the preflight request asked for,
+// and a zero MaxAge leaves the Access-Control-Max-Age header out.
+type CORSOptions struct {
+	// AllowOrigin is the value of Access-Control-Allow-Origin, "*" by default.
+	AllowOrigin string
+
+	// AllowMethods is the value of Access-Control-Allow-Methods on a
+	// preflight response. When empty, the methods that the router has a
+	// handler for on the requested path are used instead.
+	AllowMethods []string
+
+	// AllowHeaders is the value of Access-Control-Allow-Headers on a
+	// preflight response.
+	AllowHeaders []string
+
+	// ExposeHeaders is the value of Access-Control-Expose-Headers, the
+	// response headers that browsers let scripts read.
+	ExposeHeaders []string
+
+	// MaxAge is the number of seconds a browser may cache a preflight
+	// response (Access-Control-Max-Age). Zero leaves the header out and a
+	// negative value tells the browser not to cache at all.
+	MaxAge int
+
+	// AllowCredentials sets Access-Control-Allow-Credentials to true.
+	AllowCredentials bool
+}
+
+// DefaultCORSOptions returns the options used by Mux#EnableCORS: any origin,
+// the headers APIs commonly receive and a preflight cache of one hour. The
+// allowed methods are left empty so they follow the routes of the router.
+func DefaultCORSOptions() CORSOptions {
+	return CORSOptions{
+		AllowOrigin:  "*",
+		AllowHeaders: []string{"Accept", "Authorization", "Content-Type", "X-CSRF-Token"},
+		MaxAge:       3600,
+	}
+}
+
+// CORS returns a middleware that sets the CORS response headers on every
+// response and answers every OPTIONS request itself, as a preflight, with
+// a 204 and the Access-Control-Allow-* headers, without calling the next
+// handler. A route's own OPTIONS handler therefore never runs behind it.
+func CORS(options CORSOptions) func(http.Handler) http.Handler {
+	return func(next http.Handler) http.Handler {
+		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			if r.Method == http.MethodOptions {
+				servePreflight(w, r, options)
+				return
+			}
+			setCORSHeaders(w, r, options)
+			next.ServeHTTP(w, r)
+		})
+	}
+}
+
+// corsMethodNotAllowed is the method-not-allowed handler that EnableCORS
+// installs. It answers a preflight that reached it (a route registered
+// without an OPTIONS handler), tells the caller which methods the path
+// does serve in the Allow header, and then lets previous, the handler it
+// replaced, write the 405 if there was one.
+func corsMethodNotAllowed(options CORSOptions, previous http.HandlerFunc) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		if r.Method == http.MethodOptions {
+			servePreflight(w, r, options)
+			return
+		}
+		setCORSHeaders(w, r, options)
+		if methods := availableMethods(r); len(methods) > 0 {
+			w.Header().Set("Allow", strings.Join(methods, ", "))
+		}
+		if previous != nil {
+			previous(w, r)
+			return
+		}
+		w.WriteHeader(http.StatusMethodNotAllowed)
+	}
+}
+
+// setCORSHeaders sets the headers that belong on every CORS response.
+func setCORSHeaders(w http.ResponseWriter, r *http.Request, options CORSOptions) {
+	h := w.Header()
+
+	origin := options.AllowOrigin
+	if origin == "" {
+		origin = "*"
+	}
+	// Browsers refuse a wildcard origin on a request with credentials, so
+	// the caller's own origin is echoed back instead.
+	if origin == "*" && options.AllowCredentials {
+		if requested := r.Header.Get("Origin"); requested != "" {
+			origin = requested
+		}
+	}
+	h.Set("Access-Control-Allow-Origin", origin)
+	if origin != "*" {
+		addVary(h, "Origin")
+	}
+
+	if options.AllowCredentials {
+		h.Set("Access-Control-Allow-Credentials", "true")
+	}
+	if len(options.ExposeHeaders) > 0 {
+		h.Set("Access-Control-Expose-Headers", strings.Join(options.ExposeHeaders, ", "))
+	}
+}
+
+// servePreflight answers a preflight request with a 204 and the
+// Access-Control-Allow-* headers.
+func servePreflight(w http.ResponseWriter, r *http.Request, options CORSOptions) {
+	setCORSHeaders(w, r, options)
+	h := w.Header()
+
+	methods := options.AllowMethods
+	if len(methods) == 0 {
+		methods = availableMethods(r)
+	}
+	if len(methods) > 0 {
+		h.Set("Access-Control-Allow-Methods", strings.Join(methods, ", "))
+	}
+
+	if len(options.AllowHeaders) > 0 {
+		h.Set("Access-Control-Allow-Headers", strings.Join(options.AllowHeaders, ", "))
+	} else if requested := r.Header.Get("Access-Control-Request-Headers"); requested != "" {
+		h.Set("Access-Control-Allow-Headers", requested)
+	}
+
+	if options.MaxAge > 0 {
+		h.Set("Access-Control-Max-Age", strconv.Itoa(options.MaxAge))
+	} else if options.MaxAge < 0 {
+		h.Set("Access-Control-Max-Age", "-1")
+	}
+
+	w.WriteHeader(http.StatusNoContent)
+}
+
+// availableMethods lists, in a stable order, the HTTP methods that the
+// router serving r has a handler for on r's path. OPTIONS is always listed,
+// since the CORS middleware answers it. It lists nothing when r did not
+// come through a chi router.
+func availableMethods(r *http.Request) []string {
+	rctx := RouteContext(r.Context())
+	if rctx == nil || rctx.Routes == nil {
+		return nil
+	}
+
+	path := r.URL.RawPath
+	if path == "" {
+		path = r.URL.Path
+	}
+	if path == "" {
+		path = "/"
+	}
+
+	// Match changes the context it is given, so each method gets a clean one.
+	probe := NewRouteContext()
+	var names []string
+	for _, m := range methodTypes() {
+		name := GetMethodName(m)
+		probe.Reset()
+		if m == mOPTIONS || rctx.Routes.Match(probe, name, path) {
+			names = append(names, name)
+		}
+	}
+	return names
+}
+
+// methodTypes returns every method type chi knows, the ones added with
+// RegisterMethod included, in ascending order.
+func methodTypes() []methodTyp {
+	types := make([]methodTyp, 0, len(methodNames))
+	for m := range methodNames {
+		types = append(types, m)
+	}
+	sort.Slice(types, func(i, j int) bool { return types[i] < types[j] })
+	return types
+}
+
+// addVary adds value to the Vary header unless it is already listed.
+func addVary(h http.Header, value string) {
+	for _, v := range h.Values("Vary") {
+		for _, field := range strings.Split(v, ",") {
+			if strings.EqualFold(strings.TrimSpace(field), value) {
+				return
+			}
+		}
+	}
+	h.Add("Vary", value)
+}
