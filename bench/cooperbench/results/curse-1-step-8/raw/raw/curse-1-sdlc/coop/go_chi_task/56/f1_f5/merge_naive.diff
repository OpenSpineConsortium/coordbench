new file mode 100644
index 0000000..887aa0d
--- /dev/null
+++ b/middleware/allowed_methods.go
@@ -0,0 +1,86 @@
+package middleware
+
+import (
+	"net/http"
+
+	"github.com/go-chi/chi/v5"
+)
+
+// allowHeaderMethods are the methods SetAllowHeader tries, in the order it
+// lists them.
+var allowHeaderMethods = []string{
+	http.MethodConnect,
+	http.MethodDelete,
+	http.MethodGet,
+	http.MethodHead,
+	http.MethodOptions,
+	http.MethodPatch,
+	http.MethodPost,
+	http.MethodPut,
+	http.MethodTrace,
+}
+
+// SetAllowHeader adds the Allow header for 405 responses, based on the
+// methods registered for the requested path, as RFC 9110 asks of a server
+// that answers 405 Method Not Allowed.
+//
+// It looks ahead before the request is routed: when the router has no handler
+// for the request's method on the path but has one for other methods, it adds
+// those methods to the Allow header, one value per method. It never looks at
+// the response status, so the header appears exactly when the request's method
+// has no route and some other method does, and never on a response to a
+// request that has a route.
+//
+// chi's default 405 handler adds the same header by itself; this middleware is
+// for apps that set their own MethodNotAllowed handler or want the header on
+// every response the router lets through.
+func SetAllowHeader(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if rctx := chi.RouteContext(r.Context()); rctx != nil && rctx.Routes != nil {
+			addAllowHeader(w.Header(), rctx, r)
+		}
+		next.ServeHTTP(w, r)
+	})
+}
+
+// addAllowHeader adds the methods registered for the request's path to the
+// Allow header, unless the request's own method is one of them.
+func addAllowHeader(h http.Header, rctx *chi.Context, r *http.Request) {
+	routePath := r.URL.RawPath
+	if routePath == "" {
+		routePath = r.URL.Path
+	}
+
+	// A method an earlier middleware chose for routing, as GetHead does, is the
+	// one the router will look up.
+	method := rctx.RouteMethod
+	if method == "" {
+		method = r.Method
+	}
+
+	// Match updates the context it is given, so look ahead with a context of
+	// its own, as GetHead does.
+	tctx := chi.NewRouteContext()
+	if rctx.Routes.Match(tctx, method, routePath) {
+		return
+	}
+
+	for _, m := range allowHeaderMethods {
+		tctx.Reset()
+		if rctx.Routes.Match(tctx, m, routePath) && !hasAllowValue(h, m) {
+			h.Add("Allow", m)
+		}
+	}
+}
+
+// hasAllowValue reports whether the Allow header already has the method as a
+// value of its own, as when the middleware is used on a router and on a group
+// inside it.
+func hasAllowValue(h http.Header, method string) bool {
+	for _, v := range h["Allow"] {
+		if v == method {
+			return true
+		}
+	}
+	return false
+}
