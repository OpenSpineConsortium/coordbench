+def test_exif_transpose_logger_callable() -> None:
+    messages: list[str] = []
+    with Image.open("Tests/images/hopper_orientation_6.jpg") as im:
+        transposed_im = ImageOps.exif_transpose(im, logger=messages.append)
+
+        # Logging does not change the result
+        assert_image_equal(transposed_im, ImageOps.exif_transpose(im))
+        assert 0x0112 not in transposed_im.getexif()
+
+    assert all(isinstance(message, str) for message in messages)
+    text = "\n".join(messages)
+    assert "EXIF orientation tag: 6" in text
+    assert "ROTATE_270" in text
+    assert "Removed EXIF orientation tag" in text
+    assert "image.info['exif']" in text
+    assert messages[-1].startswith("exif_transpose completed in ")
+    assert messages[-1].endswith(" seconds")
+
+
+def test_exif_transpose_logger_no_transformation() -> None:
+    messages: list[str] = []
+    with Image.open("Tests/images/hopper.jpg") as im:
+        transposed_im = ImageOps.exif_transpose(im, logger=messages.append)
+        assert_image_equal(transposed_im, im)
+
+    text = "\n".join(messages)
+    assert "no transformation needed" in text
+    assert "unchanged copy" in text
+    assert "Applying transformation" not in text
+    assert "Removed" not in text
+
+    # Nothing is logged when no logger is given
+    messages.clear()
+    ImageOps.exif_transpose(hopper())
+    assert messages == []
+
+
+def test_exif_transpose_logger_in_place() -> None:
+    messages: list[str] = []
+    with Image.open("Tests/images/orientation_rectangle.jpg") as im:
+        assert im.size == (2, 1)
+
+        result = ImageOps.exif_transpose(im, in_place=True, logger=messages.append)
+        assert result is None
+        assert im.size == (1, 2)
+
+    text = "\n".join(messages)
+    assert "in_place=True" in text
+    assert "ROTATE_90" in text
+    assert "New image size: (1, 2)" in text
+
+
