+
+    # Orientation from "Raw profile type exif" info key
+    messages.clear()
+    with Image.open("Tests/images/exif_imagemagick_orientation.png") as im:
+        ImageOps.exif_transpose(im, logger=messages.append)
+    assert any("image.info['Raw profile type exif']" in m for m in messages)
+
+    # Orientation set directly on Image.Exif changes no info key
+    messages.clear()
+    im = hopper()
+    im.getexif()[0x0112] = 3
+    ImageOps.exif_transpose(im, logger=messages.append)
+    assert any("Removed EXIF orientation tag" in m for m in messages)
+    assert not any("image.info" in m for m in messages)
+
+
+def test_exif_transpose_logger_standard_logger(
+    caplog: pytest.LogCaptureFixture,
+) -> None:
+    logger = logging.getLogger("test_exif_transpose")
+    with caplog.at_level(logging.INFO, logger=logger.name):
+        with Image.open("Tests/images/hopper_orientation_3.jpg") as im:
+            ImageOps.exif_transpose(im, logger=logger)
+
+    assert caplog.records
+    assert {record.name for record in caplog.records} == {logger.name}
+    assert {record.levelno for record in caplog.records} == {logging.INFO}
+    assert "ROTATE_180" in caplog.text
+
+
+def test_exif_transpose_logger_unrecognised_orientation(
+    caplog: pytest.LogCaptureFixture,
+) -> None:
+    im = hopper()
+    im.getexif()[0x0112] = 9
+    logger = logging.getLogger("test_exif_transpose")
+    with caplog.at_level(logging.INFO, logger=logger.name):
+        transposed_im = ImageOps.exif_transpose(im, logger=logger)
+    assert_image_equal(transposed_im, im)
+
+    warnings = [r for r in caplog.records if r.levelno == logging.WARNING]
+    assert len(warnings) == 1
+    assert "Unrecognised EXIF orientation value 9" in warnings[0].getMessage()
+
+
+def test_exif_transpose_logger_error(monkeypatch: pytest.MonkeyPatch) -> None:
+    def fail(image: Image.Image, in_place: bool) -> None:
+        msg = "broken"
+        raise ValueError(msg)
+
+    monkeypatch.setattr(ImageOps, "_exif_transpose", fail)
+
+    messages: list[str] = []
+    with pytest.raises(ValueError, match="broken"):
+        ImageOps.exif_transpose(hopper(), logger=messages.append)
+    assert any("failed with ValueError: broken" in m for m in messages)
+
+
+def test_exif_transpose_logger_invalid() -> None:
