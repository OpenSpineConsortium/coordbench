         return image
 
+    def _crop_margin(self, image: "PIL.Image.Image") -> "PIL.Image.Image":
+        """Remove `crop_margin` pixels from each edge of the image."""
+        margin = self.crop_margin
+        width, height = image.size
+        if 2 * margin >= width or 2 * margin >= height:
+            raise ValueError(
+                f"Cannot crop a margin of {margin} pixels from each edge of an image of size {width}x{height}: "
+                "nothing would be left."
+            )
+        return image.crop((margin, margin, width - margin, height - margin))
