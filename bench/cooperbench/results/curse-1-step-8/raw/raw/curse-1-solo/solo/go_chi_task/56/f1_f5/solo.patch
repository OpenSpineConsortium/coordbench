index 0000000..fed3b81
--- /dev/null
+++ b/middleware/allowed_methods.go
@@ -0,0 +1,74 @@
+package middleware
+
+import (
+	"net/http"
+	"strings"
+
+	"github.com/go-chi/chi/v5"
+)
+
+// allowMethodOrder is the order in which SetAllowHeader lists the methods, so
+// that the header reads the same on every request.
+var allowMethodOrder = []string{
+	http.MethodGet, http.MethodHead, http.MethodPost, http.MethodPut,
+	http.MethodPatch, http.MethodDelete, http.MethodConnect,
+	http.MethodOptions, http.MethodTrace,
+}
+
+// SetAllowHeader adds the Allow header for 405 responses based on
+// registered methods for the requested path.
+//
+// RFC 9110 asks for it on every 405. The router's default 405 handler sets it
+// too, but a custom handler registered with MethodNotAllowed does not, and
+// this middleware covers that case. It looks the path up before the request
+// is routed and never inspects the response, so a request whose method has a
+// handler passes through untouched, and so does one whose path no route
+// matches.
+func SetAllowHeader(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if allowed := allowedMethods(r); len(allowed) > 0 {
+			w.Header().Set("Allow", strings.Join(allowed, ", "))
+		}
+		next.ServeHTTP(w, r)
+	})
+}
+
+// allowedMethods returns the methods that have a handler for the request's
+// path, or nil when the request's own method is one of them.
+func allowedMethods(r *http.Request) []string {
+	rctx := chi.RouteContext(r.Context())
+	if rctx == nil || rctx.Routes == nil {
+		return nil
+	}
+
+	// Look-ahead routing must not disturb the request's own context.
+	path := lookupPath(r, rctx)
+	if rctx.Routes.Match(chi.NewRouteContext(), r.Method, path) {
+		return nil
+	}
+
+	var allowed []string
+	for _, method := range allowMethodOrder {
+		if rctx.Routes.Match(chi.NewRouteContext(), method, path) {
+			allowed = append(allowed, method)
+		}
+	}
+	return allowed
+}
+
+// lookupPath is the path the router sees. Before any sub-router has been
+// entered that is the routing path, which an earlier middleware may have
+// rewritten; inside a sub-router the routing path is relative to it while
+// Routes still starts at the root, so the whole request path is used.
+func lookupPath(r *http.Request, rctx *chi.Context) string {
+	if len(rctx.RoutePatterns) == 0 && rctx.RoutePath != "" {
+		return rctx.RoutePath
+	}
+	if r.URL.RawPath != "" {
+		return r.URL.RawPath
+	}
+	if r.URL.Path == "" {
+		return "/"
+	}
+	return r.URL.Path
+}
