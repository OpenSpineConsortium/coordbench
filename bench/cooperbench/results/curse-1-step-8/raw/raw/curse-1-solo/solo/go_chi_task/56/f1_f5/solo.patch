diff --git a/cors.go b/cors.go
new file mode 100644
index 0000000..06450e8
--- /dev/null
+++ b/cors.go
@@ -0,0 +1,236 @@
+package chi
+
+import (
+	"net/http"
+	"strconv"
+	"strings"
+)
+
+// CORSOptions configures the Cross-Origin Resource Sharing support of
+// CORS, Mux.EnableCORS and Mux.EnableCORSWithOptions.
+type CORSOptions struct {
+	// AllowOrigin is the origin sent in Access-Control-Allow-Origin: one
+	// origin, or "*" for any. Empty means "*". When AllowCredentials is set
+	// and the origin is "*", the request's own Origin is sent instead, since
+	// browsers refuse a wildcard for credentialed requests.
+	AllowOrigin string
+
+	// AllowMethods are the methods named in Access-Control-Allow-Methods of
+	// a preflight response. Empty means the methods the router has registered
+	// for the requested path.
+	AllowMethods []string
+
+	// AllowHeaders are the request headers named in
+	// Access-Control-Allow-Headers of a preflight response. Empty means the
+	// headers the preflight request asks for.
+	AllowHeaders []string
+
+	// ExposeHeaders are the response headers named in
+	// Access-Control-Expose-Headers, which a browser lets a page read.
+	ExposeHeaders []string
+
+	// MaxAge is how many seconds a browser may cache a preflight response.
+	// Zero leaves Access-Control-Max-Age out; -1 asks for no caching.
+	MaxAge int
+
+	// AllowCredentials sets Access-Control-Allow-Credentials to true.
+	AllowCredentials bool
+}
+
+// DefaultCORSOptions returns the options EnableCORS uses: any origin, the
+// headers an API client commonly sends, a one hour preflight cache, and the
+// methods taken from the router.
+func DefaultCORSOptions() CORSOptions {
+	return CORSOptions{
+		AllowOrigin:  "*",
+		AllowHeaders: []string{"Accept", "Authorization", "Content-Type", "X-CSRF-Token"},
+		MaxAge:       3600,
+	}
+}
+
+// CORS returns a middleware that sets the CORS response headers on every
+// response and answers preflight requests itself. A preflight is an OPTIONS
+// request to a path that has routes but no OPTIONS handler: it gets the
+// headers of its options and the status 204, and goes no further. Without
+// options, DefaultCORSOptions are used.
+//
+// The middleware sees the request before it is routed, so use it with
+// Router.Use. Mux.EnableCORS does that and adds the 405 handling.
+func CORS(options ...CORSOptions) func(http.Handler) http.Handler {
+	opts := corsOptions(options)
+	return func(next http.Handler) http.Handler {
+		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			opts.setResponseHeaders(w.Header(), r)
+			if r.Method == http.MethodOptions && opts.preflight(w, r) {
+				return
+			}
+			next.ServeHTTP(w, r)
+		})
+	}
+}
+
+// EnableCORS turns on CORS with DefaultCORSOptions: every response carries
+// the CORS headers, and a preflight OPTIONS request is answered with 204 and
+// the methods registered for its path. Like Use, it must come before the
+// routes are defined.
+func (mx *Mux) EnableCORS() {
+	mx.EnableCORSWithOptions(DefaultCORSOptions())
+}
+
+// EnableCORSWithOptions is EnableCORS with the given options. It adds the
+// CORS middleware and replaces the method not allowed handler by one that
+// also answers a preflight request that reaches it, passing every other 405
+// to the handler that was set before, or to the default one with its Allow
+// header.
+func (mx *Mux) EnableCORSWithOptions(options CORSOptions) {
+	mx.Use(CORS(options))
+	mx.MethodNotAllowed(corsMethodNotAllowedHandler(options, mx.methodNotAllowedHandler))
+}
+
+// WithCORS returns an inline router, like With, whose routes have CORS
+// enabled with the given options, or with DefaultCORSOptions when there are
+// none. As with MethodNotAllowed on any inline router, the 405 handling it
+// adds belongs to the router it was made from.
+func (mx *Mux) WithCORS(options ...CORSOptions) Router {
+	im := mx.With().(*Mux)
+	im.EnableCORSWithOptions(corsOptions(options))
+	return im
+}
+
+func corsOptions(options []CORSOptions) CORSOptions {
+	if len(options) > 0 {
+		return options[0]
+	}
+	return DefaultCORSOptions()
+}
+
+// corsMethodNotAllowedHandler answers a preflight request that was routed to
+// the 405 handler and leaves the other 405 responses to previous, or to the
+// default handler when there is none.
+func corsMethodNotAllowedHandler(opts CORSOptions, previous http.HandlerFunc) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		if r.Method == http.MethodOptions && opts.preflight(w, r) {
+			return
+		}
+		if previous != nil {
+			previous(w, r)
+			return
+		}
+		var allowed []methodTyp
+		if rctx := RouteContext(r.Context()); rctx != nil {
+			allowed = rctx.methodsAllowed
+		}
+		methodNotAllowedHandler(allowed...)(w, r)
+	}
+}
+
+// setResponseHeaders sets the headers every CORS response carries.
+func (o CORSOptions) setResponseHeaders(h http.Header, r *http.Request) {
+	origin := o.AllowOrigin
+	if origin == "" {
+		origin = "*"
+	}
+	if origin == "*" && o.AllowCredentials && r.Header.Get("Origin") != "" {
+		origin = r.Header.Get("Origin")
+		addVary(h, "Origin")
+	}
+	h.Set("Access-Control-Allow-Origin", origin)
+	if o.AllowCredentials {
+		h.Set("Access-Control-Allow-Credentials", "true")
+	}
+	if len(o.ExposeHeaders) > 0 {
+		h.Set("Access-Control-Expose-Headers", strings.Join(o.ExposeHeaders, ", "))
+	}
+}
+
+// preflight answers an OPTIONS request with 204 and the preflight headers,
+// and reports whether it did. It does not when no method is known for the
+// path, which leaves the router to answer 404, nor when the route has an
+// OPTIONS handler of its own; that handler then runs and its response still
+// carries the headers.
+func (o CORSOptions) preflight(w http.ResponseWriter, r *http.Request) bool {
+	known := knownMethods(r)
+	methods := o.AllowMethods
+	if len(methods) == 0 {
+		methods = known
+	}
+	if len(methods) == 0 {
+		return false
+	}
+
+	h := w.Header()
+	h.Set("Access-Control-Allow-Methods", strings.Join(methods, ", "))
+	if len(o.AllowHeaders) > 0 {
+		h.Set("Access-Control-Allow-Headers", strings.Join(o.AllowHeaders, ", "))
+	} else if asked := r.Header.Get("Access-Control-Request-Headers"); asked != "" {
+		h.Set("Access-Control-Allow-Headers", asked)
+		addVary(h, "Access-Control-Request-Headers")
+	}
+	if o.MaxAge != 0 {
+		h.Set("Access-Control-Max-Age", strconv.Itoa(o.MaxAge))
+	}
+
+	for _, m := range known {
+		if m == http.MethodOptions {
+			return false
+		}
+	}
+	w.WriteHeader(http.StatusNoContent)
+	return true
+}
+
+// knownMethods returns the names of the methods the router has a handler for
+// on the request's path, in the order of methodOrder. It asks the router with
+// a context of its own, since the request may not have been routed yet; only
+// when that finds nothing does it fall back to what routing noted.
+func knownMethods(r *http.Request) []string {
+	rctx := RouteContext(r.Context())
+	if rctx == nil {
+		return nil
+	}
+
+	var names []string
+	if rctx.Routes != nil {
+		path := lookupPath(r, rctx)
+		probe := NewRouteContext()
+		for _, m := range methodOrder {
+			probe.Reset()
+			if rctx.Routes.Match(probe, methodNames[m], path) {
+				names = append(names, methodNames[m])
+			}
+		}
+	}
+	if len(names) == 0 {
+		for _, m := range rctx.methodsAllowed {
+			names = append(names, methodNames[m])
+		}
+	}
+	return names
+}
+
+// lookupPath is the path the router sees. Before any sub-router has been
+// entered that is the routing path, which an earlier middleware may have
+// rewritten; inside a sub-router the routing path is relative to it while
+// Routes still starts at the root, so the whole request path is used.
+func lookupPath(r *http.Request, rctx *Context) string {
+	if len(rctx.RoutePatterns) == 0 && rctx.RoutePath != "" {
+		return rctx.RoutePath
+	}
+	if r.URL.RawPath != "" {
+		return r.URL.RawPath
+	}
+	if r.URL.Path == "" {
+		return "/"
+	}
+	return r.URL.Path
+}
+
+// addVary adds a field to Vary unless it is listed already.
+func addVary(h http.Header, field string) {
+	for _, v := range h["Vary"] {
+		if v == field {
+			return
+		}
+	}
+	h.Add("Vary", field)
+}
