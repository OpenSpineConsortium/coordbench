+// method not allowed. RFC 9110 requires such a response to carry an Allow
+// header, so it names methodsAllowed, one value per method, unless a handler
+// further out, such as middleware.SetAllowHeader, has set one already.
+func methodNotAllowedHandler(methodsAllowed ...methodTyp) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
