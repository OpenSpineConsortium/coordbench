+# Matches HTTP and HTTPS web URLs: the scheme, a host (an IPv4 address or a
+# domain name, `localhost` included), an optional port of up to five digits,
+# then an optional path, query string and fragment, which run on to the first
+# whitespace. Domain labels start and end with a letter or digit and may hold
+# hyphens inside; the last label must start with a letter, so that a made-up
+# address such as 999.999.999.999 is not read as a domain name.
+# It does not check that the host exists or that the port is in range.
+_url_ipv4_octet = r"(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])"
+_url_label = r"[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?"
+_url_last_label = r"[a-zA-Z]([a-zA-Z0-9-]*[a-zA-Z0-9])?"
+url = Regex(
+    rf"https?://({_url_ipv4_octet}(\.{_url_ipv4_octet}){{3}}|({_url_label}\.)*{_url_last_label})"
+    r"(:[0-9]{1,5})?"
+    r"([/?#][^\s]*)?"
+)
