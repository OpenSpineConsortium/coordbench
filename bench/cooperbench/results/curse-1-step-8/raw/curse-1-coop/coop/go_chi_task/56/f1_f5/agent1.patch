@@ -480,8 +482,17 @@ func (mx *Mux) updateRouteHandler() {
 }
 
 // methodNotAllowedHandler is a helper function to respond with a 405,
-// method not allowed.
-func methodNotAllowedHandler(w http.ResponseWriter, r *http.Request) {
-	w.WriteHeader(405)
-	w.Write(nil)
+// method not allowed, and an Allow header naming the methods allowed for
+// the route (RFC 9110, section 15.5.6). An Allow header that is already set,
+// by middleware.SetAllowHeader for one, is left as it is.
+func methodNotAllowedHandler(methodsAllowed ...methodTyp) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		if h := w.Header(); len(h["Allow"]) == 0 {
+			for _, name := range allowedMethodNames(methodsAllowed) {
+				h.Add("Allow", name)
+			}
+		}
+		w.WriteHeader(405)
+		w.Write(nil)
+	}
 }
diff --git a/tree.go b/tree.go
index 4189b52..04f28eb 100644
--- a/tree.go
+++ b/tree.go
@@ -59,9 +59,92 @@ func RegisterMethod(method string) {
 	}
 	mt := methodTyp(2 << n)
 	methodMap[method] = mt
+	reverseMethodMap[mt] = method
 	mALL |= mt
 }
 
+// reverseMethodMap converts a method type back to its method name. It is
+// the inverse of methodMap, kept in step with it by RegisterMethod.
+var reverseMethodMap = map[methodTyp]string{
+	mCONNECT: http.MethodConnect,
+	mDELETE:  http.MethodDelete,
+	mGET:     http.MethodGet,
+	mHEAD:    http.MethodHead,
+	mOPTIONS: http.MethodOptions,
+	mPATCH:   http.MethodPatch,
+	mPOST:    http.MethodPost,
+	mPUT:     http.MethodPut,
+	mTRACE:   http.MethodTrace,
+}
+
+// allowOrder is the order in which the methods of an Allow header are
+// listed, so that the header is the same for every request. Methods added
+// by RegisterMethod follow in the order they were registered.
+var allowOrder = []methodTyp{
+	mGET, mHEAD, mPOST, mPUT, mPATCH, mDELETE, mCONNECT, mOPTIONS, mTRACE,
+}
+
+// allowRank gives the place of a method in an Allow header.
+func allowRank(m methodTyp) int {
+	for i, s := range allowOrder {
+		if s == m {
+			return i
+		}
+	}
+	return len(allowOrder)
+}
+
+// allowedMethodNames returns the names of the given method types, each once,
+// in the stable order of allowOrder.
+func allowedMethodNames(methods []methodTyp) []string {
+	sorted := make([]methodTyp, 0, len(methods))
+	for _, m := range methods {
+		if _, ok := reverseMethodMap[m]; ok {
+			sorted = append(sorted, m)
+		}
+	}
+	sort.Slice(sorted, func(i, j int) bool {
+		ri, rj := allowRank(sorted[i]), allowRank(sorted[j])
+		if ri != rj {
+			return ri < rj
+		}
+		return sorted[i] < sorted[j]
+	})
+
+	names := make([]string, 0, len(sorted))
+	for i, m := range sorted {
+		if i > 0 && m == sorted[i-1] {
+			continue
+		}
+		names = append(names, reverseMethodMap[m])
+	}
+	return names
+}
+
+// addMethodsAllowed records the methods registered on a node whose path
+// matched the request while its handler for the request's method did not.
+// mALL and mSTUB are bookkeeping keys, not methods, and a method is listed
+// once however many matching nodes register it.
+func (x *Context) addMethodsAllowed(eps endpoints) {
+	for m, ep := range eps {
+		if m == mALL || m == mSTUB || ep == nil || ep.handler == nil {
+			continue
+		}
+		if !x.hasMethodAllowed(m) {
+			x.methodsAllowed = append(x.methodsAllowed, m)
+		}
+	}
+}
+
+func (x *Context) hasMethodAllowed(m methodTyp) bool {
+	for _, have := range x.methodsAllowed {
+		if have == m {
+			return true
+		}
+	}
+	return false
+}
