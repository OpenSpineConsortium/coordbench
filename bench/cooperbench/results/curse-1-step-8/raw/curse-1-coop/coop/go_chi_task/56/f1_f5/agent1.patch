diff --git a/middleware/allowed_methods.go b/middleware/allowed_methods.go
new file mode 100644
index 0000000..6dfae0c
--- /dev/null
+++ b/middleware/allowed_methods.go
@@ -0,0 +1,100 @@
+package middleware
+
+import (
+	"net/http"
+	"sync"
+
+	"github.com/go-chi/chi/v5"
+)
+
+// allowedMethods are the methods SetAllowHeader looks for, in the order
+// it lists them.
+var allowedMethods = []string{
+	http.MethodGet,
+	http.MethodHead,
+	http.MethodPost,
+	http.MethodPut,
+	http.MethodPatch,
+	http.MethodDelete,
+	http.MethodConnect,
+	http.MethodOptions,
+	http.MethodTrace,
+}
+
+// probeContexts holds the routing contexts SetAllowHeader looks ahead with.
+// Match updates the context it is given, so the request's own context is
+// never used for it.
+var probeContexts = sync.Pool{
+	New: func() interface{} { return chi.NewRouteContext() },
+}
+
+// SetAllowHeader adds the Allow header for 405 responses based on
+// registered methods for the requested path.
+//
+// When the router has no route for the request's method on its path, the
+// middleware looks up which of the standard methods the router does have a
+// route for, and lists them in the Allow header, one value for each, in a
+// stable order. Its answer is set before the next handler runs, so it holds
+// for the router's own 405 response and for one from a handler set with
+// MethodNotAllowed alike. A request that has a route for its method gets no
+// Allow header from it, and neither does one whose path matches no route.
+// The status code of the response is never looked at.
+func SetAllowHeader(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if rctx := chi.RouteContext(r.Context()); rctx != nil && rctx.Routes != nil {
+			addAllowHeader(w.Header(), rctx, r)
+		}
+		next.ServeHTTP(w, r)
+	})
+}
+
+// addAllowHeader sets the Allow header when the request's method has no
+// route on the request's path but others do.
+func addAllowHeader(header http.Header, rctx *chi.Context, r *http.Request) {
+	if len(header["Allow"]) > 0 {
+		return
+	}
+
+	method := r.Method
+	if rctx.RouteMethod != "" {
+		method = rctx.RouteMethod
+	}
+	path := lookupPath(rctx, r)
+
+	probe := probeContexts.Get().(*chi.Context)
+	defer probeContexts.Put(probe)
+
+	if matches(rctx.Routes, probe, method, path) {
+		return
+	}
+	for _, m := range allowedMethods {
+		if matches(rctx.Routes, probe, m, path) {
+			header.Add("Allow", m)
+		}
+	}
+}
+
+// matches reports whether routes has a handler for the method and path,
+// leaving the probe context clean for the next look-up.
+func matches(routes chi.Routes, probe *chi.Context, method, path string) bool {
+	probe.Reset()
+	return routes.Match(probe, method, path)
+}
+
+// lookupPath is the path the router is searched with at this point of the
+// request: the routing path another middleware has set at the top of the
+// router, else the URL's own. Inside a sub-router the routing context holds
+// the part of the path left for the sub-router, while its Routes is still the
+// router the request came in at, so the URL's path is the one that fits it.
+func lookupPath(rctx *chi.Context, r *http.Request) string {
+	if rctx.RoutePath != "" && len(rctx.RoutePatterns) == 0 {
+		return rctx.RoutePath
+	}
+	if r.URL.RawPath != "" {
+		return r.URL.RawPath
+	}
+	if r.URL.Path == "" {
+		return "/"
+	}
+	return r.URL.Path
+}
