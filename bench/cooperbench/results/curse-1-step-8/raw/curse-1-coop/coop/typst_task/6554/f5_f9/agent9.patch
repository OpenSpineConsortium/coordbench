+/// Fails if a requested number of characters is not at least one.
+fn check_count(count: usize) -> StrResult<()> {
+    if count == 0 {
+        bail!("count must be at least 1");
+    }
+    Ok(())
+}
+
+/// The error message when fewer characters exist than were requested.
+#[cold]
+fn not_enough_characters(requested: usize, available: usize) -> EcoString {
+    eco_format!(
+        "not enough characters (requested {requested}, but string only has {available})"
+    )
+}
+
+/// Turns grapheme clusters into an array of strings.
+fn clusters_to_array(clusters: Vec<&str>) -> Value {
+    Value::Array(clusters.into_iter().map(|s| Value::Str(s.into())).collect())
+}
