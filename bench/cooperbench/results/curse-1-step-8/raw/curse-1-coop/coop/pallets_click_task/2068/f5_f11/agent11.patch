+# How often the monitor looks at the editor's state, in seconds. The
+# start and the end of the process are reported without waiting for it.
+_MONITOR_POLL_INTERVAL = 0.1
+
+_MonitorCallback = cabc.Callable[[str, int, str, float], None]
+
+
+def _resolve_monitor_callback(monitor_process: t.Any) -> _MonitorCallback | None:
+    """Get the callback out of what was passed as ``monitor_process``:
+    the callback itself, or a mapping or an object with a ``callback``
+    entry or attribute. ``None``, ``False`` and ``True`` name no callback,
+    so nothing is monitored.
+    """
+    if monitor_process is None or isinstance(monitor_process, bool):
+        return None
+
+    if callable(monitor_process):
+        return t.cast("_MonitorCallback", monitor_process)
+
+    if isinstance(monitor_process, cabc.Mapping):
+        callback = monitor_process.get("callback")
+    else:
+        callback = getattr(monitor_process, "callback", None)
+
+    if callable(callback):
+        return t.cast("_MonitorCallback", callback)
+
+    raise TypeError(
+        "monitor_process must be a callable, or have a callable 'callback'."
+    )
+
+
+def _read_process_state(pid: int) -> str | None:
+    """The one letter state of a process, as ``ps`` shows it, such as
+    ``R`` for running or ``T`` for stopped by a signal. ``None`` if it
+    cannot be told, because the process is gone or the platform has
+    no way to ask.
+    """
+    if WIN:
+        return None
+
+    if os.path.isdir("/proc/self"):
+        try:
+            with open(f"/proc/{pid}/stat", "rb") as f:
+                # The command name comes first, in parentheses, and may
+                # hold spaces and parentheses. The state follows the last.
+                return f.read().rsplit(b")", 1)[1].split()[0].decode()
+        except (OSError, IndexError):
+            return None
+
+    import subprocess
+
+    try:
+        out = subprocess.run(
+            ["ps", "-o", "stat=", "-p", str(pid)],
+            capture_output=True,
+            text=True,
+            timeout=5,
+        ).stdout.strip()
+    except (OSError, subprocess.SubprocessError):
+        return None
+
+    return out[:1] or None
+
+
+class _ProcessMonitor:
+    """Tells a callback about the life of a process from a background
+    thread: ``start`` for the process that was just started, ``suspend``
+    and ``resume`` when it is stopped by a signal and continued, and
+    ``terminate`` after it ended. The thread never waits on the process
+    itself, so whoever started it still collects its exit code.
+    """
+
+    def __init__(
+        self,
+        pid: int,
+        command: str,
+        callback: _MonitorCallback,
+        has_exited: cabc.Callable[[], bool],
+    ) -> None:
+        import threading
+
+        self.pid = pid
+        self.command = command
+        self.callback = callback
+        self.has_exited = has_exited
+        self._done = threading.Event()
+        self._started_at = time.time()
+        self._ended_at: float | None = None
+        self._thread = threading.Thread(
+            target=self._run, name=f"click-monitor-{pid}", daemon=True
+        )
+
+    def start(self) -> None:
+        self._thread.start()
+
+    def stop(self) -> None:
+        """Stop watching and wait for the callbacks still due. Call it
+        once the process has been waited for. If it has not ended, as
+        when the wait was interrupted, no ``terminate`` is reported.
+        """
+        if self.has_exited():
+            self._ended_at = time.time()
+
+        self._done.set()
+        self._thread.join()
+
+    def _notify(self, event_type: str, timestamp: float | None = None) -> None:
+        if timestamp is None:
+            timestamp = time.time()
+
+        try:
+            self.callback(event_type, self.pid, self.command, timestamp)
+        except Exception as e:
+            import warnings
+
+            try:
+                warnings.warn(
+                    f"The process monitor callback raised an exception for"
+                    f" {event_type!r}: {type(e).__name__}: {e}",
+                    UserWarning,
+                    stacklevel=2,
+                )
+            except Exception:
+                # Warnings turned into errors cannot reach the thread
+                # that started the editor. Keep monitoring.
+                pass
+
+    def _run(self) -> None:
+        self._notify("start", self._started_at)
+        suspended = False
+
+        while not self._done.wait(_MONITOR_POLL_INTERVAL):
+            state = _read_process_state(self.pid)
+
+            # Gone, or ended and not yet collected: not a state change.
+            if state is None or state == "Z":
+                continue
+
+            if (state in ("T", "t")) != suspended:
+                suspended = not suspended
+                self._notify("suspend" if suspended else "resume")
+
+        if self._ended_at is not None:
+            self._notify("terminate", self._ended_at)
+
+
+@contextlib.contextmanager
+def _monitored(
+    process: t.Any, command: str, callback: _MonitorCallback | None
+) -> cabc.Iterator[None]:
+    """Report the events of the started ``process`` to ``callback`` for as
+    long as the block runs. Does nothing when there is no callback.
+    """
+    if callback is None:
+        yield
+        return
+
+    monitor = _ProcessMonitor(
+        process.pid, command, callback, lambda: process.poll() is not None
+    )
+    monitor.start()
+
+    try:
+        yield
+    finally:
+        monitor.stop()
+
+
 class Editor:
+    # Told about the editor process's start, suspension, resumption and
+    # termination. Set by the caller after creating the editor; it is
+    # either a callback or something that holds one, see
+    # _resolve_monitor_callback.
+    monitor_process: t.Any = None
+
     def __init__(
         self,
         editor: str | None = None,
@@ -515,9 +690,13 @@ class Editor:
