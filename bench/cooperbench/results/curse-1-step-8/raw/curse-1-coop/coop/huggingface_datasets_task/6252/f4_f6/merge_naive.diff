+def _crop_margin(image: "PIL.Image.Image", margin: int) -> "PIL.Image.Image":
+    """Crop `margin` pixels from each edge of the image, keeping its center.
+
+    A non-positive margin, or one that would leave nothing of the image, returns the image unchanged.
+    """
+    width, height = image.size
+    if margin <= 0 or 2 * margin >= width or 2 * margin >= height:
+        return image
+    return image.crop((margin, margin, width - margin, height - margin))
