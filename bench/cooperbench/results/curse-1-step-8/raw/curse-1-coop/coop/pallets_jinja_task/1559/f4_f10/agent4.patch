+    def _parse_metadata_value(self, parser: "Parser", name_token: "Token") -> str:
+        """Parse the ``= "string"`` that follows a metadata parameter name
+        (``note``, ``created`` or ``modified``) and return the string.
+        """
+        name = name_token.value
+
+        if parser.stream.current.type != "assign":
+            parser.fail(
+                f"metadata parameter '{name}' requires a value assignment.",
+                name_token.lineno,
+                exc=TemplateAssertionError,
+            )
+
+        next(parser.stream)
+        expr = parser.parse_expression()
+        value = expr.value if isinstance(expr, nodes.Const) else None
+
+        if not isinstance(value, str):
+            parser.fail(
+                f"metadata parameter '{name}' must be a string literal.",
+                name_token.lineno,
+                exc=TemplateAssertionError,
+            )
+
+        return value
+
