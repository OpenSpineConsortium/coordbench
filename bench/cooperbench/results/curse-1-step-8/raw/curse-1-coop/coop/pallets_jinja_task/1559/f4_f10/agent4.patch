+    def _parse_metadata_value(self, parser: "Parser", name_token: "Token") -> str:
+        """Parse the ``= "value"`` after a metadata parameter name. Only a
+        string literal is accepted, since the value is stored as it is
+        written and is never evaluated.
+        """
+        name = name_token.value
+
+        if parser.stream.current.type != "assign":
+            parser.fail(
+                f"metadata parameter {name!r} requires a value assignment.",
+                name_token.lineno,
+                exc=TemplateAssertionError,
+            )
+
+        next(parser.stream)
+        value_lineno = parser.stream.current.lineno
+        value: t.Optional[nodes.Expr] = None
+
+        # only a string token can start a literal; anything else is not
+        # parsed, so the error names the parameter and not a stray token.
+        if parser.stream.current.type == "string":
+            value = parser.parse_expression()
+
+        if isinstance(value, nodes.Const) and isinstance(value.value, str):
+            return value.value
+
+        parser.fail(
+            f"metadata parameter {name!r} must be a string literal.",
+            value_lineno,
+            exc=TemplateAssertionError,
+        )
+
