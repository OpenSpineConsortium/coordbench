     def __init__(self, environment: Environment) -> None:
         super().__init__(environment)
         environment.globals["_"] = _gettext_alias
+        # Versions are keyed by the MD5 hash of the message, so that
+        # very long messages cost no more to store or look up than short
+        # ones. Identical hashes are treated as the same message.
+        self._translation_versions: t.Dict[str, str] = {}
         environment.extend(
