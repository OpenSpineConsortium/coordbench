@@ -264,8 +269,38 @@ class InternationalizationExtension(Extension):
             uninstall_gettext_translations=self._uninstall,
             extract_translations=self._extract,
             newstyle_gettext=False,
+            set_translation_version=self._set_translation_version,
+            get_translation_version=self._get_translation_version,
+            compare_translation_versions=self._compare_translation_versions,
+            translation_version_control=True,
         )
 
+    @staticmethod
+    def _version_key(message: str) -> str:
+        return hashlib.md5(message.encode("utf-8")).hexdigest()
+
+    def _set_translation_version(self, message: str, version: str) -> None:
+        """Store ``version`` for ``message``, replacing any earlier one."""
+        self._translation_versions[self._version_key(message)] = version
+
+    def _get_translation_version(self, message: str) -> t.Optional[str]:
+        """Return the version stored for ``message``, or ``None``."""
+        return self._translation_versions.get(self._version_key(message))
+
+    def _compare_translation_versions(self, message1: str, message2: str) -> bool:
+        """Return ``True`` if both messages have the same version set.
+
+        A message with no version never compares equal, not even to
+        another message with no version.
+        """
+        version1 = self._get_translation_version(message1)
+        version2 = self._get_translation_version(message2)
+
+        if version1 is None or version2 is None:
+            return False
+
+        return version1 == version2
+
