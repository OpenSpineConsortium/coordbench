+# Matches web URLs with an http or https scheme, such as
+# https://user@docs.example.com:8080/a/b.html?q=1&r=2#top. A host is a domain
+# name whose labels do not start or end with a hyphen and whose last label
+# starts with a letter (so "1.2.3.4.5" is no domain), "localhost" or an IPv4
+# address. Path, query and fragment take the characters RFC 3986 allows, with a
+# "%" only in a percent-encoding; that keeps spaces, quotes and backslashes out,
+# so a generated URL is also safe inside a JSON string. IPv6 hosts and
+# internationalized domain names are not matched.
+url = Regex(
+    r"https?://"
+    # Optional user and password
+    r"(([A-Za-z0-9\-._~!$&'()*+,;=]|%[0-9A-Fa-f]{2})+"
+    r"(:([A-Za-z0-9\-._~!$&'()*+,;=:]|%[0-9A-Fa-f]{2})*)?@)?"
+    # Host: domain name, localhost or IPv4 address
+    r"(([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?"
+    r"|localhost"
+    r"|((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\.){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9]))"
+    # Optional port, 1 to 65535
+    r"(:([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?"
+    # Optional path, query and fragment
+    r"(/([A-Za-z0-9\-._~!$&'()*+,;=:@/]|%[0-9A-Fa-f]{2})*)?"
+    r"(\?([A-Za-z0-9\-._~!$&'()*+,;=:@/?]|%[0-9A-Fa-f]{2})*)?"
+    r"(#([A-Za-z0-9\-._~!$&'()*+,;=:@/?]|%[0-9A-Fa-f]{2})*)?"
+)
