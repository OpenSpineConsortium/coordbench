new file mode 100644
index 0000000..24a9364
--- /dev/null
+++ b/middleware/allowed_methods.go
@@ -0,0 +1,67 @@
+package middleware
+
+import (
+	"net/http"
+
+	"github.com/go-chi/chi/v5"
+)
+
+// allowedMethodOrder is the order in which SetAllowHeader lists methods, so
+// the header reads the same on every request.
+var allowedMethodOrder = []string{
+	http.MethodGet,
+	http.MethodHead,
+	http.MethodPost,
+	http.MethodPut,
+	http.MethodPatch,
+	http.MethodDelete,
+	http.MethodConnect,
+	http.MethodOptions,
+	http.MethodTrace,
+}
+
+// SetAllowHeader adds the Allow header for 405 responses based on
+// registered methods for the requested path.
+//
+// When the request's method does not match its path, each standard method
+// the path does match is added to Allow, one value each in a fixed order,
+// e.g. "GET" then "HEAD". The response's status code is never inspected,
+// and nothing is added when the request's method matches, so a 2xx
+// response carries no Allow header. The path is matched against the
+// router the request entered, mounted routers included, by the URL's path.
+func SetAllowHeader(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if rctx := chi.RouteContext(r.Context()); rctx != nil && rctx.Routes != nil {
+			addAllowHeader(w, r, rctx.Routes)
+		}
+		next.ServeHTTP(w, r)
+	})
+}
+
+// addAllowHeader adds to w's Allow header the standard methods that routes
+// serves for the request's path, unless the request's own method is one or
+// Allow is already set.
+func addAllowHeader(w http.ResponseWriter, r *http.Request, routes chi.Routes) {
+	// An outer router's SetAllowHeader has listed the methods already.
+	if len(w.Header()["Allow"]) > 0 {
+		return
+	}
+
+	path := r.URL.RawPath
+	if path == "" {
+		path = r.URL.Path
+	}
+
+	// One scratch context serves every Match, since a match leaves its
+	// parameters and flags behind in the context it is given.
+	tctx := chi.NewRouteContext()
+	if routes.Match(tctx, r.Method, path) {
+		return
+	}
+	for _, method := range allowedMethodOrder {
+		tctx.Reset()
+		if routes.Match(tctx, method, path) {
+			w.Header().Add("Allow", method)
+		}
+	}
+}
