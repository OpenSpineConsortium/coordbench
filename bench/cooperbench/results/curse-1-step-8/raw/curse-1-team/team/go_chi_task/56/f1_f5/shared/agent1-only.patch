 // methodNotAllowedHandler is a helper function to respond with a 405,
-// method not allowed.
-func methodNotAllowedHandler(w http.ResponseWriter, r *http.Request) {
-	w.WriteHeader(405)
-	w.Write(nil)
+// method not allowed. It sets the Allow header to methodsAllowed first, as
+// RFC 9110 requires, one value for each method and in the order given. An
+// Allow header that is already set, such as middleware.SetAllowHeader's,
+// is left as it is, so the methods are never listed twice.
+func methodNotAllowedHandler(methodsAllowed ...methodTyp) func(w http.ResponseWriter, r *http.Request) {
+	return func(w http.ResponseWriter, r *http.Request) {
+		if len(w.Header()["Allow"]) == 0 {
+			for _, m := range methodsAllowed {
+				w.Header().Add("Allow", reverseMethodMap[m])
+			}
+		}
+		w.WriteHeader(405)
+		w.Write(nil)
+	}
 }
