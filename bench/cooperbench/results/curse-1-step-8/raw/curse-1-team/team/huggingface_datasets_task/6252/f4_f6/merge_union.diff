         image.load()  # to avoid "Too many open files" errors
         if self.mode and self.mode != image.mode:
             image = image.convert(self.mode)
+        # Most vision models and viewers expect RGB, so a CMYK image that no mode was requested for
+        # is converted to RGB here; a user who asked for CMYK explicitly keeps it.
+        if image.mode == "CMYK" and self.mode != "CMYK":
