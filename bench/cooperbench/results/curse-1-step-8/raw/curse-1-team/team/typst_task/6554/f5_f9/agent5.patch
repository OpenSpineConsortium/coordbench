+/// Splits the string into grapheme clusters, checking that at least `count`
+/// of them are there and that `count` is at least one.
+fn clusters_for_count(text: &str, count: usize) -> StrResult<Vec<&str>> {
+    if count == 0 {
+        return Err(count_too_small());
+    }
+    let clusters: Vec<&str> = text.graphemes(true).collect();
+    if clusters.len() < count {
+        return Err(not_enough_characters(count, clusters.len()));
+    }
+    Ok(clusters)
+}
+
+/// Turns grapheme clusters into an array value of strings.
+fn cluster_array(clusters: &[&str]) -> Value {
+    Value::Array(clusters.iter().map(|&cluster| cluster.into_value()).collect())
+}
+
+/// The error message when the requested count is not positive.
+#[cold]
+fn count_too_small() -> EcoString {
+    "count must be at least 1".into()
+}
+
+/// The error message when the string has fewer characters than requested.
+#[cold]
+fn not_enough_characters(requested: usize, available: usize) -> EcoString {
+    eco_format!(
+        "not enough characters (requested {}, but string only has {})",
+        requested,
+        available
+    )
+}
