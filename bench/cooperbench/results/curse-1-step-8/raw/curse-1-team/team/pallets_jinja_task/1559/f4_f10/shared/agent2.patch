+    @staticmethod
+    def _translation_key(message: str) -> str:
+        """The storage key of a message: the MD5 hash of its UTF-8 bytes.
+
+        Two messages with the same hash count as the same message, which
+        is acceptable for version tracking.  The hash is not used for
+        security.
+        """
+        return hashlib.md5(message.encode("utf-8")).hexdigest()
+
+    def _set_translation_version(self, message: str, version: str) -> None:
+        """Store ``version`` for ``message``, replacing any earlier one."""
+        self._translation_versions[self._translation_key(message)] = version
+
+    def _get_translation_version(self, message: str) -> t.Optional[str]:
+        """Return the version stored for ``message``, or ``None``."""
+        return self._translation_versions.get(self._translation_key(message))
+
+    def _compare_translation_versions(self, message1: str, message2: str) -> bool:
+        """Return ``True`` if both messages have the same version.
+
+        A message without a version never matches, not even another
+        message without one.
+        """
+        version1 = self._get_translation_version(message1)
+        version2 = self._get_translation_version(message2)
+        if version1 is None or version2 is None:
+            return False
+        return version1 == version2
