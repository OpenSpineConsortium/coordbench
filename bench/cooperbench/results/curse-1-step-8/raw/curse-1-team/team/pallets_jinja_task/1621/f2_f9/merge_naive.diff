+    def _template_names(self, file_path: t.Union[str, os.PathLike]) -> t.Set[str]:
+        """The names a file in the search paths is loaded as, one for
+        each search path that contains it.
+        """
+        path = os.path.abspath(os.fspath(file_path))
+        real_path = os.path.realpath(path)
+        names: t.Set[str] = set()
+
+        for searchpath in self.searchpath:
+            root = os.path.abspath(searchpath)
+            name = _relative_template_name(root, path)
+
+            if name is None:
+                # the file or the search path may be reached by a link
+                name = _relative_template_name(os.path.realpath(root), real_path)
+
+            if name is not None:
+                names.add(name)
+
+        return names
+
+    def _is_cached_template(self, key: t.Any, names: t.Set[str]) -> bool:
+        """Whether a key of an environment's cache is a template of this
+        loader with one of the names.
+        """
+        try:
+            loader_ref, name = key
+
+            if loader_ref() is not self:
+                return False
+
+            # "./a.html" and "a.html" are loaded from the same file
+            name = os.path.normpath(name).replace(os.path.sep, "/")
+            return "/".join(split_template_path(name)) in names
+        except (TypeError, ValueError, TemplateNotFound):
+            return False
+
+    def _on_template_changed(self, file_paths: t.List[str]) -> None:
+        """Remove the templates for files that were added, changed or
+        removed from the cache of every environment that uses this
+        loader. Paths that are not a template of this loader are
+        ignored. The polling thread calls this, and tests can call it
+        directly to invalidate the cache without waiting for a poll.
+
+        :param file_paths: Absolute paths of the files that changed.
+        """
+        names: t.Set[str] = set()
+
+        for file_path in file_paths:
+            names.update(self._template_names(file_path))
+
+        if not names:
+            return
+
+        for environment in list(self._environments):
+            cache = environment.cache
+
+            if cache is None:
+                continue
+
+            for key in list(cache.keys()):
+                if self._is_cached_template(key, names):
+                    try:
+                        del cache[key]
+                    except KeyError:
