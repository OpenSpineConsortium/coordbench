+    def _get_lock_filename(self, filename: str) -> str:
+        """The lock file for ``filename``, ``.<name>.lock`` beside it."""
+        directory, name = os.path.split(filename)
+        return os.path.join(directory, f".{name}.lock")
+
+    def _create_lock_file(self, filename: str) -> str:
+        """Create the lock file for ``filename`` and return its path.
+
+        The file is made with ``O_EXCL``, so of two processes that ask at
+        the same moment exactly one succeeds. It holds the process ID and
+        the time, for whoever finds it left behind.
+
+        :raises ClickException: if the file is locked already or the
+            lock file cannot be made.
+        """
+        import datetime
+
+        lock_filename = self._get_lock_filename(filename)
+
+        try:
+            fd = os.open(lock_filename, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
+        except FileExistsError as e:
+            raise ClickException(
+                _(
+                    "{filename}: The file is already being edited."
+                    " Lock file exists: {lock_filename}"
+                ).format(filename=filename, lock_filename=lock_filename)
+            ) from e
+        except OSError as e:
+            raise ClickException(
+                _("{filename}: Could not create lock file: {e}").format(
+                    filename=filename, e=e
+                )
+            ) from e
+
+        try:
+            with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as f:
+                f.write(
+                    f"PID: {os.getpid()}\nTime: {datetime.datetime.now().isoformat()}"
+                )
+        except BaseException:
+            # Do not leave behind an empty lock file nobody can tell the
+            # owner of.
+            self._remove_lock_file(lock_filename)
+            raise
+
+        return lock_filename
+
+    def _remove_lock_file(self, lock_filename: str) -> None:
+        """Remove a lock file; one already gone is not an error."""
+        with contextlib.suppress(OSError):
+            os.unlink(lock_filename)
+
+    @contextlib.contextmanager
+    def _locked(self, filename: str) -> cabc.Iterator[None]:
+        """Hold the lock file for ``filename`` while editing, if locking
+        is on. The lock file goes even if the editor fails or the edit
+        is interrupted.
+        """
+        if not self.lock_files:
+            yield
+            return
+
+        lock_filename = self._create_lock_file(filename)
+
+        try:
+            yield
+        finally:
+            self._remove_lock_file(lock_filename)
+
+    def _wait_for_editor(self, c: subprocess.Popen[bytes], editor: str) -> int:
+        """Wait for the editor to exit, reporting its life to the
+        ``monitor_process`` callback on the way, if there is one.
+        """
+        if self.monitor_process is None:
+            return c.wait()
+
+        monitor = _ProcessMonitor(c.pid, editor, self.monitor_process)
+        monitor.start()
+
+        try:
+            return c.wait()
+        finally:
+            monitor.stop()
+
