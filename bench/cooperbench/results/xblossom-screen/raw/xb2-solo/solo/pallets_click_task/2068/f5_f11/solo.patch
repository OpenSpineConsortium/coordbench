+MonitorCallback = cabc.Callable[[str, int, str, float], None]
+
+
+def _process_is_stopped(pid: int) -> bool | None:
+    """Tell whether the process is stopped by a signal, as by Ctrl+Z or
+    ``SIGSTOP``. Return ``None`` where that cannot be told, which is
+    always the case on Windows, so the caller keeps what it knew.
+    """
+    if WIN:
+        return None
+
+    if os.path.isdir("/proc/self"):
+        try:
+            with open(f"/proc/{pid}/stat", "rb") as f:
+                stat = f.read()
+        except OSError:
+            return None
+
+        # The state follows the command name, which is in parentheses
+        # and may itself contain spaces and parentheses.
+        fields = stat.rpartition(b")")[2].split()
+        return bool(fields) and fields[0] in (b"T", b"t")
+
+    import subprocess
+
+    try:
+        out = subprocess.run(
+            ["ps", "-o", "stat=", "-p", str(pid)],
+            stdout=subprocess.PIPE,
+            stderr=subprocess.DEVNULL,
+            check=True,
+        ).stdout
+    except (OSError, subprocess.SubprocessError):
+        return None
+
+    return out.strip().startswith(b"T")
+
+
+class _ProcessMonitor:
+    """Reports the life of an editor process to a callback from a
+    background thread: ``"start"`` once the thread runs, ``"suspend"``
+    and ``"resume"`` as the process is stopped and continued, and
+    ``"terminate"`` after :meth:`stop`. One thread reports them all, so
+    the callback sees them in order and never from two threads at once.
+    """
+
+    def __init__(
+        self,
+        pid: int,
+        editor: str,
+        callback: MonitorCallback,
+        interval: float = 0.1,
+    ) -> None:
+        import threading
+
+        self.pid = pid
+        self.editor = editor
+        self.callback = callback
+        self.interval = interval
+        self._done = threading.Event()
+        self._thread = threading.Thread(
+            target=self._run, name="click-editor-monitor", daemon=True
+        )
+
+    def start(self) -> None:
+        self._thread.start()
+
+    def stop(self) -> None:
+        """Tell the thread the process has ended and wait until it has
+        reported that.
+        """
+        self._done.set()
+        self._thread.join()
+
+    def _emit(self, event_type: str) -> None:
+        try:
+            self.callback(event_type, self.pid, self.editor, time.time())
+        except Exception as e:
+            import warnings
+
+            warnings.warn(
+                _("Editor monitor callback failed on {event_type!r}: {e!r}").format(
+                    event_type=event_type, e=e
+                ),
+                UserWarning,
+                stacklevel=2,
+            )
+
+    def _run(self) -> None:
+        self._emit("start")
+        suspended = False
+
+        while not self._done.wait(self.interval):
+            stopped = _process_is_stopped(self.pid)
+
+            if stopped is None or stopped == suspended:
+                continue
+
+            suspended = stopped
+            self._emit("suspend" if suspended else "resume")
+
+        self._emit("terminate")
+
+
