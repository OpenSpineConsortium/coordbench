+// reverseMethodMap is methodMap read the other way, so that the methods a
+// route allows can be named in an Allow header.
+var reverseMethodMap = map[methodTyp]string{
+	mCONNECT: http.MethodConnect,
+	mDELETE:  http.MethodDelete,
+	mGET:     http.MethodGet,
+	mHEAD:    http.MethodHead,
+	mOPTIONS: http.MethodOptions,
+	mPATCH:   http.MethodPatch,
+	mPOST:    http.MethodPost,
+	mPUT:     http.MethodPut,
+	mTRACE:   http.MethodTrace,
+}
+
+// methodNames is the map the CORS headers read the method names from. It is
+// reverseMethodMap itself, so a method added by RegisterMethod is named in both.
+var methodNames = reverseMethodMap
+
+// GetMethodName returns the HTTP method name of a method type, or an empty
+// string when the type names no method that chi knows.
+func GetMethodName(method methodTyp) string {
+	return methodNames[method]
+}
+
+// methodOrder is the order in which methods are listed in an Allow header, the
+// order of net/http's method constants. Methods added by RegisterMethod follow
+// in the order they were registered.
+var methodOrder = [...]methodTyp{mGET, mHEAD, mPOST, mPUT, mPATCH, mDELETE, mCONNECT, mOPTIONS, mTRACE}
+
+// methodRank is the position of a method in the Allow header's order.
+func methodRank(method methodTyp) int {
+	for i, m := range methodOrder {
+		if m == method {
+			return i
+		}
+	}
+	return len(methodOrder) + bits.TrailingZeros(uint(method))
+}
+
+// allowedMethodNames returns the names of methods in a stable order, each
+// once, leaving out any type that names no method.
+func allowedMethodNames(methods []methodTyp) []string {
+	sorted := append([]methodTyp(nil), methods...)
+	sort.Slice(sorted, func(i, j int) bool { return methodRank(sorted[i]) < methodRank(sorted[j]) })
+
+	names := make([]string, 0, len(sorted))
+	for _, m := range sorted {
+		name := GetMethodName(m)
+		if name == "" || (len(names) > 0 && names[len(names)-1] == name) {
+			continue
+		}
+		names = append(names, name)
+	}
+	return names
+}
