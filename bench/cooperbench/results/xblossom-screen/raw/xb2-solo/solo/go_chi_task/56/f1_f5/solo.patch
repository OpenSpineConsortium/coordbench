-// method not allowed.
-func methodNotAllowedHandler(w http.ResponseWriter, r *http.Request) {
-	w.WriteHeader(405)
-	w.Write(nil)
+// methodNotAllowedHandler returns a handler that responds with a 405, method
+// not allowed, and names methodsAllowed in the Allow header as RFC 9110
+// requires. An Allow header that is already there, set by the
+// middleware.SetAllowHeader middleware for example, is left as it is.
+func methodNotAllowedHandler(methodsAllowed ...methodTyp) func(w http.ResponseWriter, r *http.Request) {
+	return func(w http.ResponseWriter, r *http.Request) {
+		setAllowHeader(w.Header(), methodsAllowed)
+		w.WriteHeader(405)
+		w.Write(nil)
+	}
+}
+
+// setAllowHeader adds one Allow value for each of methods, in a stable order,
+// unless the header already has values.
+func setAllowHeader(header http.Header, methods []methodTyp) {
+	if len(header["Allow"]) > 0 {
+		return
+	}
+	for _, name := range allowedMethodNames(methods) {
+		header.Add("Allow", name)
+	}
 }
