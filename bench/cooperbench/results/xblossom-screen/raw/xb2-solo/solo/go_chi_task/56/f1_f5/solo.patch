diff --git a/cors.go b/cors.go
new file mode 100644
index 0000000..01ea24d
--- /dev/null
+++ b/cors.go
@@ -0,0 +1,163 @@
+package chi
+
+import (
+	"net/http"
+	"strconv"
+	"strings"
+)
+
+// CORS response headers, as the Fetch standard names them.
+const (
+	headerAllowOrigin      = "Access-Control-Allow-Origin"
+	headerAllowCredentials = "Access-Control-Allow-Credentials"
+	headerExposeHeaders    = "Access-Control-Expose-Headers"
+	headerAllowMethods     = "Access-Control-Allow-Methods"
+	headerAllowHeaders     = "Access-Control-Allow-Headers"
+	headerMaxAge           = "Access-Control-Max-Age"
+)
+
+// CORSOptions configures Cross-Origin Resource Sharing (CORS) for a router,
+// see EnableCORSWithOptions. DefaultCORSOptions has the defaults.
+type CORSOptions struct {
+	// AllowOrigin is sent as Access-Control-Allow-Origin on every response:
+	// "*" for any origin, or the one origin that may call the API. Empty sends
+	// no such header.
+	AllowOrigin string
+
+	// AllowMethods is sent as Access-Control-Allow-Methods in answer to a
+	// preflight request. Empty, the default, sends the methods that the route
+	// asked about is registered for, found by the router.
+	AllowMethods []string
+
+	// AllowHeaders is sent as Access-Control-Allow-Headers in answer to a
+	// preflight request: the request headers a browser may send.
+	AllowHeaders []string
+
+	// ExposeHeaders is sent as Access-Control-Expose-Headers on every
+	// response: the response headers a browser may show to the calling script.
+	ExposeHeaders []string
+
+	// MaxAge is sent as Access-Control-Max-Age, the seconds a browser may keep
+	// the answer to a preflight request. Zero sends no such header.
+	MaxAge int
+
+	// AllowCredentials sends Access-Control-Allow-Credentials: true on every
+	// response. Browsers refuse that together with an AllowOrigin of "*".
+	AllowCredentials bool
+}
+
+// DefaultCORSOptions returns the options EnableCORS uses: any origin, the
+// request headers APIs commonly take, and a preflight answer that browsers may
+// keep for an hour.
+func DefaultCORSOptions() CORSOptions {
+	return CORSOptions{
+		AllowOrigin:  "*",
+		AllowHeaders: []string{"Accept", "Authorization", "Content-Type", "X-CSRF-Token"},
+		MaxAge:       3600,
+	}
+}
+
+// CORS returns a middleware that sets the CORS headers of options on every
+// response, or of DefaultCORSOptions when none are given. On an OPTIONS
+// request it also sets the headers that answer a preflight request.
+//
+// The middleware does not answer a preflight request by itself: it cannot know
+// which methods the route allows before the route is found. The router's 405
+// handler does, which is what Mux.EnableCORS installs beside the middleware,
+// so use that unless you answer OPTIONS requests with handlers of your own.
+func CORS(options ...CORSOptions) func(http.Handler) http.Handler {
+	return newCORS(corsOptionsOrDefault(options)).middleware
+}
+
+func corsOptionsOrDefault(options []CORSOptions) CORSOptions {
+	if len(options) > 0 {
+		return options[0]
+	}
+	return DefaultCORSOptions()
+}
+
+// corsPolicy is a CORSOptions turned into the header values it sends, once, so
+// that a request only copies them.
+type corsPolicy struct {
+	// simple are sent on every response, preflight are added to the answer of
+	// an OPTIONS request.
+	simple, preflight corsHeaders
+
+	// allowMethods is the configured Access-Control-Allow-Methods, if any.
+	allowMethods string
+}
+
+type corsHeaders [][2]string
+
+func (hs corsHeaders) set(header http.Header) {
+	for _, h := range hs {
+		header.Set(h[0], h[1])
+	}
+}
+
+func newCORS(o CORSOptions) *corsPolicy {
+	p := &corsPolicy{allowMethods: strings.Join(o.AllowMethods, ", ")}
+	if o.AllowOrigin != "" {
+		p.simple = append(p.simple, [2]string{headerAllowOrigin, o.AllowOrigin})
+	}
+	if o.AllowCredentials {
+		p.simple = append(p.simple, [2]string{headerAllowCredentials, "true"})
+	}
+	if len(o.ExposeHeaders) > 0 {
+		p.simple = append(p.simple, [2]string{headerExposeHeaders, strings.Join(o.ExposeHeaders, ", ")})
+	}
+	if p.allowMethods != "" {
+		p.preflight = append(p.preflight, [2]string{headerAllowMethods, p.allowMethods})
+	}
+	if len(o.AllowHeaders) > 0 {
+		p.preflight = append(p.preflight, [2]string{headerAllowHeaders, strings.Join(o.AllowHeaders, ", ")})
+	}
+	if o.MaxAge > 0 {
+		p.preflight = append(p.preflight, [2]string{headerMaxAge, strconv.Itoa(o.MaxAge)})
+	}
+	return p
+}
+
+// middleware sets the CORS headers before the request is routed, so that
+// every response has them, errors and 404s included.
+func (p *corsPolicy) middleware(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		p.simple.set(w.Header())
+		if r.Method == http.MethodOptions {
+			p.preflight.set(w.Header())
+		}
+		next.ServeHTTP(w, r)
+	})
+}
+
+// methodNotAllowed returns the 405 handler of a router with CORS enabled.
+// An OPTIONS request that reaches it asks about a route that has no OPTIONS
+// handler, which is a preflight request: it is answered with 204 and the
+// methods the route has. Any other request gets the 405 that next, the handler
+// that was set before, or else the default handler sends.
+func (p *corsPolicy) methodNotAllowed(next http.HandlerFunc) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		var methods []methodTyp
+		if rctx := RouteContext(r.Context()); rctx != nil {
+			methods = rctx.methodsAllowed
+		}
+
+		if r.Method != http.MethodOptions {
+			handler := next
+			if handler == nil {
+				handler = methodNotAllowedHandler(methods...)
+			}
+			handler(w, r)
+			return
+		}
+
+		// The route answers OPTIONS now, so it allows it as well.
+		allowed := append(append([]methodTyp(nil), methods...), mOPTIONS)
+		header := w.Header()
+		if p.allowMethods == "" {
+			header.Set(headerAllowMethods, strings.Join(allowedMethodNames(allowed), ", "))
+		}
+		setAllowHeader(header, allowed)
+		w.WriteHeader(http.StatusNoContent)
+	}
+}
