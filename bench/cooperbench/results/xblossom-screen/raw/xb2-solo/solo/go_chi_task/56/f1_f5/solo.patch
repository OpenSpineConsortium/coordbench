@@ -0,0 +1,88 @@
+package middleware
+
+import (
+	"net/http"
+	"sync"
+
+	"github.com/go-chi/chi/v5"
+)
+
+// allowHeaderMethods are the methods SetAllowHeader tries, in the order they
+// are listed in the Allow header.
+var allowHeaderMethods = []string{
+	http.MethodGet,
+	http.MethodHead,
+	http.MethodPost,
+	http.MethodPut,
+	http.MethodPatch,
+	http.MethodDelete,
+	http.MethodConnect,
+	http.MethodOptions,
+	http.MethodTrace,
+}
+
+// allowHeaderContexts holds the routing contexts SetAllowHeader matches with.
+// Matching updates the context it is given, so the request's own context is
+// never used for it.
+var allowHeaderContexts = sync.Pool{
+	New: func() interface{} { return chi.NewRouteContext() },
+}
+
+// SetAllowHeader adds the Allow header for 405 responses based on
+// registered methods for the requested path.
+//
+// When no route accepts the request's method but the path is routed for other
+// methods, the middleware adds one Allow value for each of those methods, in
+// the order GET, HEAD, POST, PUT, PATCH, DELETE, CONNECT, OPTIONS, TRACE,
+// before calling the next handler. It never looks at the response, so a
+// request that a route accepts gets no Allow header. The router sets the same
+// header on its own 405 responses; this middleware is for the apps that answer
+// a 405 with a handler of their own.
+func SetAllowHeader(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if rctx := chi.RouteContext(r.Context()); rctx != nil && rctx.Routes != nil {
+			addAllowHeader(w.Header(), rctx, r)
+		}
+		next.ServeHTTP(w, r)
+	})
+}
+
+// addAllowHeader adds the methods the router has a route for, on the path of
+// r, to header, unless the router has a route for the method of r or header
+// has Allow values already, from this middleware on an outer router for one.
+func addAllowHeader(header http.Header, rctx *chi.Context, r *http.Request) {
+	if len(header["Allow"]) > 0 {
+		return
+	}
+	routes := rctx.Routes
+	path := allowHeaderPath(rctx, r)
+
+	mctx := allowHeaderContexts.Get().(*chi.Context)
+	defer allowHeaderContexts.Put(mctx)
+
+	mctx.Reset()
+	if routes.Match(mctx, r.Method, path) {
+		return
+	}
+	for _, method := range allowHeaderMethods {
+		mctx.Reset()
+		if routes.Match(mctx, method, path) {
+			header.Add("Allow", method)
+		}
+	}
+}
+
+// allowHeaderPath is the path the router matches r against. Routes is the
+// outermost router, so inside a subrouter only the full request path fits it.
+func allowHeaderPath(rctx *chi.Context, r *http.Request) string {
+	if rctx.RoutePath != "" && len(rctx.RoutePatterns) == 0 {
+		return rctx.RoutePath
+	}
+	if r.URL.RawPath != "" {
+		return r.URL.RawPath
+	}
+	if r.URL.Path == "" {
+		return "/"
+	}
+	return r.URL.Path
+}
