+// EnableCORS enables Cross-Origin Resource Sharing on the Mux with the options
+// of DefaultCORSOptions: every response carries the CORS headers, and a
+// preflight OPTIONS request to a route that has no OPTIONS handler is answered
+// with 204 and the methods the route has in Access-Control-Allow-Methods.
+//
+// Like Use, it must be called before the routes are defined.
+func (mx *Mux) EnableCORS() {
+	mx.EnableCORSWithOptions(DefaultCORSOptions())
+}
+
+// EnableCORSWithOptions is EnableCORS with options of your own, see CORSOptions.
+//
+// It adds the CORS middleware and sets the Mux's 405 handler to one that
+// answers a preflight request. A handler set with MethodNotAllowed before is
+// kept for the 405 responses; one set after replaces it, and with it the
+// preflight answer. On an inline Mux, a group, the handler lands on the parent
+// Mux, as MethodNotAllowed does there.
+func (mx *Mux) EnableCORSWithOptions(options CORSOptions) {
+	cors := newCORS(options)
+	mx.Use(cors.middleware)
+	mx.MethodNotAllowed(cors.methodNotAllowed(mx.methodNotAllowedHandler))
+}
+
+// WithCORS creates a new inline Mux, as With does, with CORS enabled by
+// EnableCORS, or by EnableCORSWithOptions when options are given. The CORS
+// headers are sent on the responses of the routes defined on the returned
+// Router.
+func (mx *Mux) WithCORS(options ...CORSOptions) Router {
+	im := mx.With().(*Mux)
+	im.EnableCORSWithOptions(corsOptionsOrDefault(options))
+	return im
+}
