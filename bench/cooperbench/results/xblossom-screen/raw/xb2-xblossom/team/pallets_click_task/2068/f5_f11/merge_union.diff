+def _process_state(pid: int) -> str | None:
+    """Return the one-letter state of a process as the operating system
+    reports it (``T`` and ``t`` mean stopped), or ``None`` when it cannot
+    be told. Windows has no such state, so there it is always ``None``.
+    """
+    if WIN:
+        return None
+
+    if sys.platform.startswith("linux"):
+        try:
+            with open(f"/proc/{pid}/stat", "rb") as f:
+                data = f.read()
+        except OSError:
+            return None
+
+        # The command name comes first, in parentheses, and may hold
+        # spaces and parentheses itself, so the state is what follows
+        # the last closing one.
+        return data[data.rfind(b")") + 2 :][:1].decode("ascii", "replace") or None
+
+    import subprocess
+
+    try:
+        out = subprocess.run(
+            ["ps", "-o", "stat=", "-p", str(pid)],
+            capture_output=True,
+            text=True,
+            check=False,
+        ).stdout.strip()
+    except OSError:
+        return None
+
+    return out[:1] or None
+
+
+def _find_callback(
+    monitor_process: t.Any,
+) -> cabc.Callable[[str, int, str, float], None] | None:
+    """Get the callback out of what was passed as ``monitor_process``: a
+    callable, or an object or mapping with a ``callback`` in it. ``None``
+    and booleans carry no callback, so there is nobody to tell.
+    """
+    if monitor_process is None or isinstance(monitor_process, bool):
+        return None
+
+    if callable(monitor_process):
+        return monitor_process  # type: ignore[no-any-return]
+
+    if isinstance(monitor_process, cabc.Mapping):
+        callback = monitor_process.get("callback")
+    else:
+        callback = getattr(monitor_process, "callback", None)
+
+    if callback is None:
+        return None
+
+    if not callable(callback):
+        raise TypeError("The 'callback' of 'monitor_process' must be callable.")
+
+    return callback  # type: ignore[no-any-return]
+
+
+class _ProcessMonitor:
+    """Tells a callback about the life of one editor process from a
+    background thread, while the thread that started the editor blocks
+    waiting for it. The callback gets the event (``"start"``,
+    ``"suspend"``, ``"resume"`` or ``"terminate"``), the process id, the
+    editor command and the time of the event, and one that raises only
+    costs a :class:`UserWarning`: monitoring goes on with the next event.
+
+    Suspension is found by polling the process state, so it is only
+    reported where :func:`_process_state` can tell it.
+    """
+
+    def __init__(
+        self,
+        callback: cabc.Callable[[str, int, str, float], None],
+        pid: int,
+        editor_command: str,
+    ) -> None:
+        import threading
+
+        self.callback = callback
+        self.pid = pid
+        self.editor_command = editor_command
+        # Reading /proc is cheap, running ps is not.
+        self.interval = 0.1 if sys.platform.startswith("linux") else 0.5
+        self._ended = threading.Event()
+        self._ended_at = 0.0
+        self._thread = threading.Thread(
+            target=self._run, name="click-editor-monitor", daemon=True
+        )
+
+    def start(self) -> None:
+        self._thread.start()
+
+    def stop(self) -> None:
+        """Call once the editor has exited: the thread reports its end and
+        is joined, so every callback has returned when this does.
+        """
+        self._ended_at = time.time()
+        self._ended.set()
+        self._thread.join()
+
+    def _emit(self, event_type: str, timestamp: float | None = None) -> None:
+        import warnings
+
+        if timestamp is None:
+            timestamp = time.time()
+
+        try:
+            self.callback(event_type, self.pid, self.editor_command, timestamp)
+        except Exception as e:
+            warnings.warn(
+                f"The monitor_process callback raised {e!r} on the"
+                f" {event_type!r} event of the editor.",
+                UserWarning,
+                stacklevel=2,
+            )
+
+    def _run(self) -> None:
+        self._emit("start")
+        suspended = False
+
+        while not self._ended.wait(self.interval):
+            state = _process_state(self.pid)
+
+            if state is None:
+                continue
+
+            if (state in "Tt") != suspended:
+                suspended = not suspended
+                self._emit("suspend" if suspended else "resume")
+
+        self._emit("terminate", self._ended_at)
+
