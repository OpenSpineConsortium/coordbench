+    def _get_lock_filename(self, filename: str) -> str:
+        """Return the path of the lock file for ``filename``: a hidden
+        ``.<name>.lock`` file in the same directory as the file.
+        """
+        directory, basename = os.path.split(filename)
+        return os.path.join(directory, f".{basename}.lock")
+
+    def _create_lock_file(self, filename: str) -> str:
+        """Create the lock file for ``filename`` and return its path.
+
+        The file is created with ``O_CREAT | O_EXCL``, so the check for
+        an existing lock and the creation are one atomic step and two
+        processes can never both succeed. The lock records the process
+        ID and the time, to help whoever has to look at a stale lock.
+
+        :raises ClickException: if a lock file already exists, or if it
+            cannot be created.
+        """
+        import datetime
+
+        lock_filename = self._get_lock_filename(filename)
+
+        try:
+            fd = os.open(lock_filename, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
+        except FileExistsError:
+            raise ClickException(
+                _(
+                    "Lock file {lock_filename} already exists: {filename} is"
+                    " already being edited by another process."
+                ).format(lock_filename=lock_filename, filename=filename)
+            ) from None
+        except OSError as e:
+            raise ClickException(
+                _("Could not create lock file {lock_filename}: {e}").format(
+                    lock_filename=lock_filename, e=e
+                )
+            ) from e
+
+        try:
+            with os.fdopen(fd, "w", encoding="utf-8") as f:
+                f.write(f"PID: {os.getpid()}\n")
+                f.write(f"Time: {datetime.datetime.now().isoformat()}\n")
+        except BaseException:
+            # A lock that could not be filled in is still ours to remove.
+            self._remove_lock_file(lock_filename)
+            raise
+
+        return lock_filename
+
+    def _remove_lock_file(self, lock_filename: str) -> None:
+        """Remove a lock file made by :meth:`_create_lock_file`. A lock
+        that is already gone is not an error.
+        """
+        try:
+            os.unlink(lock_filename)
+        except OSError:
