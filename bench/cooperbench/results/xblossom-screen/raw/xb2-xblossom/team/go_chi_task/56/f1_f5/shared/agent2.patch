+// methodNames maps the method types chi knows from the start to their HTTP
+// method names, for headers such as Access-Control-Allow-Methods.
+var methodNames = map[methodTyp]string{
+	mCONNECT: http.MethodConnect,
+	mDELETE:  http.MethodDelete,
+	mGET:     http.MethodGet,
+	mHEAD:    http.MethodHead,
+	mOPTIONS: http.MethodOptions,
+	mPATCH:   http.MethodPatch,
+	mPOST:    http.MethodPost,
+	mPUT:     http.MethodPut,
+	mTRACE:   http.MethodTrace,
+}
+
+// GetMethodName returns the HTTP method name of a method type, for example
+// "GET" for mGET. It also knows the methods added by RegisterMethod. It
+// returns an empty string for a type that is no single method, such as mALL.
+func GetMethodName(method methodTyp) string {
+	if name, ok := methodNames[method]; ok {
+		return name
+	}
+	return methodTypString(method)
+}
