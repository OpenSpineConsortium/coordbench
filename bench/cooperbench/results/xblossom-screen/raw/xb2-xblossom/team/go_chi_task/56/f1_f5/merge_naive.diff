index 0000000..80f1cb1
--- /dev/null
+++ b/middleware/allowed_methods.go
@@ -0,0 +1,74 @@
+package middleware
+
+import (
+	"net/http"
+
+	"github.com/go-chi/chi/v5"
+)
+
+// allowHeaderMethods are the methods SetAllowHeader asks the router about, in
+// the order their names are written to the Allow header.
+var allowHeaderMethods = []string{
+	http.MethodGet,
+	http.MethodHead,
+	http.MethodPost,
+	http.MethodPut,
+	http.MethodPatch,
+	http.MethodDelete,
+	http.MethodConnect,
+	http.MethodOptions,
+	http.MethodTrace,
+}
+
+// SetAllowHeader adds the Allow header for 405 responses based on the
+// methods registered for the requested path (RFC 9110, section 15.5.6).
+//
+// When the router has no handler for the request's method but has one for the
+// same path under other methods, those methods are added to the Allow header
+// in a stable order. Nothing is added when the request's method is routed, so
+// successful responses carry no Allow header, nor when the path matches no
+// route at all, which is a 404. The response status is never inspected.
+func SetAllowHeader(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		rctx := chi.RouteContext(r.Context())
+		if rctx == nil || rctx.Routes == nil {
+			next.ServeHTTP(w, r)
+			return
+		}
+
+		method := rctx.RouteMethod
+		if method == "" {
+			method = r.Method
+		}
+		path := allowHeaderPath(r, rctx)
+
+		// A routing context of its own for each look-ahead, so that the
+		// request's own context is left as it is.
+		if !rctx.Routes.Match(chi.NewRouteContext(), method, path) {
+			for _, m := range allowHeaderMethods {
+				if m != method && rctx.Routes.Match(chi.NewRouteContext(), m, path) {
+					w.Header().Add("Allow", m)
+				}
+			}
+		}
+
+		next.ServeHTTP(w, r)
+	})
+}
+
+// allowHeaderPath returns the path the router will route the request by,
+// as Mux#routeHTTP chooses it.
+func allowHeaderPath(r *http.Request, rctx *chi.Context) string {
+	path := rctx.RoutePath
+	if path == "" {
+		if r.URL.RawPath != "" {
+			path = r.URL.RawPath
+		} else {
+			path = r.URL.Path
+		}
+		if path == "" {
+			path = "/"
+		}
+	}
+	return path
+}
