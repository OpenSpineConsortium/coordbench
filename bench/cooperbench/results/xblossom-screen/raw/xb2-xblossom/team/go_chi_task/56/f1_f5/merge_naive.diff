-	w.WriteHeader(405)
-	w.Write(nil)
+// method not allowed. It sets the Allow header with the methods allowed for
+// the route, as RFC 9110 requires of a 405 response, and none when it is
+// given none. A method that the Allow header lists already, as it does when
+// middleware.SetAllowHeader ran first, is not listed twice.
+func methodNotAllowedHandler(methodsAllowed ...methodTyp) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		header := w.Header()
+		for _, m := range methodsAllowed {
+			if name := reverseMethodMap[m]; !allowListed(header["Allow"], name) {
+				header.Add("Allow", name)
+			}
+		}
+		w.WriteHeader(405)
+		w.Write(nil)
+	}
+}
+
+// allowListed reports whether the method is one of those the values of an
+// Allow header list, each value being a comma separated list of methods.
+func allowListed(values []string, method string) bool {
+	for _, v := range values {
+		for _, listed := range strings.Split(v, ",") {
+			if strings.TrimSpace(listed) == method {
+				return true
+			}
+		}
+	}
+	return false
 }
