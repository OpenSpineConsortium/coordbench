 	return ""
 }
 
+// methodNames maps the standard method types to the names that go in headers
+// such as Allow and Access-Control-Allow-Methods.
+var methodNames = map[methodTyp]string{
+	mCONNECT: http.MethodConnect,
+	mDELETE:  http.MethodDelete,
+	mGET:     http.MethodGet,
+	mHEAD:    http.MethodHead,
+	mOPTIONS: http.MethodOptions,
+	mPATCH:   http.MethodPatch,
+	mPOST:    http.MethodPost,
+	mPUT:     http.MethodPut,
+	mTRACE:   http.MethodTrace,
+}
+
+// GetMethodName returns the name of an HTTP method type, such as "GET", or
+// an empty string if the type is not a single method. Methods added with
+// RegisterMethod are found too.
+func GetMethodName(method methodTyp) string {
+	if name, ok := methodNames[method]; ok {
+		return name
+	}
+	return methodTypString(method)
+}
