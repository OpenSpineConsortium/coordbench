+++ b/middleware/allowed_methods.go
@@ -0,0 +1,70 @@
+package middleware
+
+import (
+	"net/http"
+
+	"github.com/go-chi/chi/v5"
+)
+
+// allowOrder is the order in which SetAllowHeader lists the methods it tries,
+// the same as chi's own 405 response, so the header is stable from one
+// response to the next.
+var allowOrder = []string{
+	http.MethodGet,
+	http.MethodHead,
+	http.MethodPost,
+	http.MethodPut,
+	http.MethodPatch,
+	http.MethodDelete,
+	http.MethodConnect,
+	http.MethodOptions,
+	http.MethodTrace,
+}
+
+// SetAllowHeader adds the Allow header for 405 responses based on
+// registered methods for the requested path.
+//
+// RFC 9110 asks for an Allow header on every 405 response. chi's default
+// 405 responder sets it already; use this middleware when you set your own
+// with Mux#MethodNotAllowed, or want the header set in front of the other
+// middleware. It asks the router whether the request's method has a route
+// and, if not, which of the standard methods do, and lists those in the Allow
+// header before it calls the next handler. It never looks at the response, so
+// a request whose method has a route, or whose path has none, gets no header.
+// Only the 405 path pays for the extra matching.
+func SetAllowHeader(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		// An Allow header set already, by this middleware ahead of a
+		// sub-router that uses it too, is not set a second time.
+		rctx := chi.RouteContext(r.Context())
+		if rctx != nil && rctx.Routes != nil && len(w.Header()["Allow"]) == 0 {
+			path := routingPath(r, rctx)
+			scratch := chi.NewRouteContext()
+			if !rctx.Routes.Match(scratch, r.Method, path) {
+				for _, method := range allowOrder {
+					scratch.Reset()
+					if rctx.Routes.Match(scratch, method, path) {
+						w.Header().Add("Allow", method)
+					}
+				}
+			}
+		}
+		next.ServeHTTP(w, r)
+	})
+}
+
+// routingPath is the path the router would search for the request, as
+// Mux#routeHTTP picks it. Inside a sub-router, whose RoutePath is relative to
+// its mount point, it is the whole path, since Routes is the root router.
+func routingPath(r *http.Request, rctx *chi.Context) string {
+	if rctx.RoutePath != "" && len(rctx.RoutePatterns) == 0 {
+		return rctx.RoutePath
+	}
+	if r.URL.RawPath != "" {
+		return r.URL.RawPath
+	}
+	if r.URL.Path == "" {
+		return "/"
+	}
+	return r.URL.Path
+}
