+def _resolve_monitor_callback(
+    monitor_process: t.Any,
+) -> t.Callable[[str, int, str, float], t.Any] | None:
+    """Turn the ``monitor_process`` argument of :func:`click.edit` into a
+    callback, or ``None`` when monitoring is off.
+
+    Besides a plain callable, a mapping with a ``"callback"`` key or an
+    object with a ``callback`` attribute is accepted as a configuration
+    object. ``True`` turns monitoring on without a callback.
+    """
+    if not monitor_process:
+        return None
+
+    if callable(monitor_process):
+        return monitor_process  # type: ignore[no-any-return]
+
+    if isinstance(monitor_process, cabc.Mapping):
+        callback = monitor_process.get("callback")
+    else:
+        callback = getattr(monitor_process, "callback", None)
+
+    if callback is None and monitor_process is True:
+        return None
+
+    if not callable(callback):
+        raise TypeError(
+            "monitor_process must be a callable or a configuration object"
+            " with a callable 'callback'."
+        )
+
+    return callback  # type: ignore[no-any-return]
+
+
+def _is_process_stopped(pid: t.Any) -> bool | None:
+    """Whether the process is suspended, or ``None`` if that cannot be
+    told on this platform or the process is gone.
+    """
+    if WIN or not isinstance(pid, int):
+        return None
+
+    try:
+        with open(f"/proc/{pid}/stat", "rb") as f:
+            stat = f.read()
+    except FileNotFoundError:
+        return None
+    except OSError:
+        return _is_process_stopped_ps(pid)
+
+    # The state is the field after the command name, which is in
+    # parentheses and may itself contain spaces and parentheses.
+    state = stat[stat.rfind(b")") + 2 : stat.rfind(b")") + 3]
+    return state in (b"T", b"t")
+
+
+def _is_process_stopped_ps(pid: int) -> bool | None:
+    # For POSIX systems without /proc, such as macOS.
+    import subprocess
+
+    try:
+        out = subprocess.run(
+            ["ps", "-o", "stat=", "-p", str(pid)],
+            stdout=subprocess.PIPE,
+            stderr=subprocess.DEVNULL,
+            check=False,
+        ).stdout.decode("ascii", "replace")
+    except OSError:
+        return None
+
+    out = out.strip()
+    return out.startswith("T") if out else None
+
+
+class _ProcessMonitor:
+    """Watches an editor process from a background thread and reports
+    its lifecycle to a callback.
+
+    The callback is called as ``callback(event_type, process_id,
+    editor_command, timestamp)`` with ``"start"`` when monitoring begins,
+    ``"suspend"`` and ``"resume"`` when the process is stopped and
+    continued (where the platform lets us tell), and ``"terminate"``
+    once :meth:`stop` is called after the process has ended. All events
+    come from the one thread, in order, and :meth:`stop` returns after
+    the last one, so the caller sees every event before it moves on.
+
+    An exception raised by the callback is turned into a
+    :exc:`UserWarning` and monitoring goes on.
+    """
+
+    poll_interval = 0.1
+
+    def __init__(
+        self,
+        callback: t.Callable[[str, int, str, float], t.Any] | None,
+        pid: int,
+        command: str,
+    ) -> None:
+        self.callback = callback
+        self.pid = pid
+        self.command = command
+        self._done = threading.Event()
+        self._thread = threading.Thread(
+            target=self._run, name="click-editor-monitor", daemon=True
+        )
+
+    def start(self) -> None:
+        self._thread.start()
+
+    def stop(self) -> None:
+        self._done.set()
+        self._thread.join()
+
+    def _emit(self, event_type: str) -> None:
+        if self.callback is None:
+            return
+
+        try:
+            self.callback(event_type, self.pid, self.command, time.time())
+        except Exception as e:
+            try:
+                warnings.warn(
+                    f"Editor process monitor callback failed for"
+                    f" {event_type!r}: {e!r}",
+                    UserWarning,
+                    stacklevel=2,
+                )
+            except Exception:
+                # A warning turned into an error must not end monitoring.
+                pass
+
+    def _run(self) -> None:
+        self._emit("start")
+        suspended = False
+
+        while not self._done.wait(self.poll_interval):
+            stopped = _is_process_stopped(self.pid)
+
+            if stopped is None or stopped == suspended:
+                continue
+
+            suspended = stopped
+            self._emit("suspend" if suspended else "resume")
+
+        self._emit("terminate")
+
+
