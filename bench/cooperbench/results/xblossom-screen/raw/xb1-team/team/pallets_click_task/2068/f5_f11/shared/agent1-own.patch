+    def _get_lock_filename(self, filename: str) -> str:
+        """Return the path of the lock file for ``filename``: the same
+        directory, named ``.<filename>.lock``.
+        """
+        directory, base = os.path.split(filename)
+        return os.path.join(directory, f".{base}.lock")
+
+    def _create_lock_file(self, filename: str) -> str:
+        """Create the lock file for ``filename`` and return its path.
+
+        The file is created with ``O_CREAT | O_EXCL`` so that the check
+        for an existing lock and its creation are one atomic step, and
+        two processes can never both believe they hold the lock. It
+        records the process id and the time, to help anyone who finds a
+        stale lock.
+        """
+        lock_filename = self._get_lock_filename(filename)
+
+        try:
+            fd = os.open(lock_filename, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
+        except OSError as e:
+            if e.errno == errno.EEXIST:
+                raise ClickException(
+                    _(
+                        "{filename}: File is already being edited."
+                        " Lock file exists: {lock_file}"
+                    ).format(filename=filename, lock_file=lock_filename)
+                ) from e
+
+            raise ClickException(
+                _("{filename}: Could not create lock file {lock_file}: {e}").format(
+                    filename=filename, lock_file=lock_filename, e=e
+                )
+            ) from e
+
+        try:
+            with os.fdopen(fd, "w", encoding="utf-8") as f:
+                f.write(f"PID: {os.getpid()}\n")
+                f.write(f"Time: {datetime.datetime.now().isoformat()}\n")
+        except BaseException:
+            # The lock was created but cannot be completed, so do not
+            # leave a half-written lock behind.
+            self._remove_lock_file(lock_filename)
+            raise
+
+        return lock_filename
+
+    def _remove_lock_file(self, lock_filename: str) -> None:
+        """Remove a lock file made by :meth:`_create_lock_file`. A lock
+        that is already gone is not an error.
+        """
+        try:
+            os.unlink(lock_filename)
+        except OSError:
+            pass
+
