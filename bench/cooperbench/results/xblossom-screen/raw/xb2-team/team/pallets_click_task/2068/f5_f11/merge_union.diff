+    def _get_lock_filename(self, filename: str) -> str:
+        """Return the path of the lock file for ``filename``: the name
+        ``.{filename}.lock`` in the same directory as the file.
+        """
+        directory, basename = os.path.split(filename)
+        return os.path.join(directory, f".{basename}.lock")
+
+    def _create_lock_file(self, filename: str) -> str:
+        """Create the lock file for ``filename`` and return its path.
+
+        The file is created in one step with ``O_EXCL``, so of two
+        processes racing for the lock exactly one succeeds and the other
+        is told the file is being edited. The lock records the process
+        ID and the time, to help debugging a lock that was left behind.
+        """
+        import datetime
+
+        lock_filename = self._get_lock_filename(filename)
+        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
+
+        try:
+            fd = os.open(lock_filename, flags, 0o644)
+        except FileExistsError:
+            raise ClickException(
+                _(
+                    "{filename}: File is already being edited"
+                    " (lock file {lock} exists)."
+                ).format(filename=filename, lock=lock_filename)
+            ) from None
+        except OSError as e:
+            raise ClickException(
+                _("{filename}: Could not create lock file: {e}").format(
+                    filename=filename, e=e
+                )
+            ) from e
+
+        try:
+            with os.fdopen(fd, "w", encoding="utf-8") as f:
+                f.write(
+                    f"PID: {os.getpid()}\n"
+                    f"Time: {datetime.datetime.now().isoformat()}\n"
+                )
+        except BaseException:
+            # The lock must not outlive a failed write, or the file would
+            # stay locked with nobody to unlock it.
+            self._remove_lock_file(lock_filename)
+            raise
+
+        return lock_filename
+
+    def _remove_lock_file(self, lock_filename: str) -> None:
+        """Remove a lock file. A lock that is already gone is not an error,
+        so that cleanup never hides the error that led to it.
+        """
+        with contextlib.suppress(OSError):
+            os.unlink(lock_filename)
+
+    @contextlib.contextmanager
+    def _locked(self, filename: str) -> cabc.Iterator[None]:
+        """Hold the lock file for ``filename`` if ``lock_files`` is on,
+        and release it however the block ends.
+        """
+        if not self.lock_files:
+            yield
+            return
+
+        lock_filename = self._create_lock_file(filename)
+
+        try:
+            yield
+        finally:
+            self._remove_lock_file(lock_filename)
+
