+MonitorCallback = cabc.Callable[[str, int, str, float], None]
+
+
+def _resolve_monitor(monitor_process: t.Any) -> tuple[MonitorCallback, float]:
+    """Split the ``monitor_process`` argument of :func:`edit` into the
+    callback and the polling interval in seconds. It is either the
+    callback itself, or a mapping or object with a ``callback`` and an
+    optional ``poll_interval``.
+    """
+    interval = 0.1
+
+    if callable(monitor_process):
+        return monitor_process, interval
+
+    if isinstance(monitor_process, cabc.Mapping):
+        callback = monitor_process.get("callback")
+        interval = monitor_process.get("poll_interval", interval)
+    else:
+        callback = getattr(monitor_process, "callback", None)
+        interval = getattr(monitor_process, "poll_interval", interval)
+
+    if not callable(callback):
+        raise TypeError(
+            "'monitor_process' must be a callable or have a callable 'callback'."
+        )
+
+    if not isinstance(interval, (int, float)) or interval <= 0:
+        raise ValueError("'poll_interval' must be a positive number of seconds.")
+
+    return callback, interval
+
+
+def _process_state(pid: int) -> str | None:
+    """The one-letter state of a process as the kernel reports it, or
+    ``None`` where it cannot be read. Only Linux's ``/proc`` is read, so
+    "suspend" and "resume" events are not reported on other platforms.
+    """
+    try:
+        with open(f"/proc/{pid}/stat", "rb") as f:
+            stat = f.read()
+    except OSError:
+        return None
+
+    # The name of the command is in parentheses and may contain spaces
+    # or parentheses, so the state is the first field after the last one.
+    fields = stat.rpartition(b")")[2].split()
+    return fields[0].decode("ascii", "replace") if fields else None
+
+
+class _ProcessMonitor:
+    """Tells a callback about the life of an editor process from a
+    background thread: ``"start"`` once the process exists,
+    ``"suspend"`` and ``"resume"`` while it is stopped and continued
+    where the platform shows that, and ``"terminate"`` after it ends.
+
+    The thread only watches; the caller still waits for the process
+    itself. The callback gets the event type, the process id, the editor
+    command and the time of the event as in :func:`time.time`. A callback
+    that raises is reported as a :class:`UserWarning` and the monitoring
+    goes on.
+    """
+
+    def __init__(
+        self,
+        callback: MonitorCallback,
+        pid: int,
+        editor_command: str,
+        poll_interval: float = 0.1,
+    ) -> None:
+        self.callback = callback
+        self.pid = pid
+        self.editor_command = editor_command
+        self.poll_interval = poll_interval
+        self._finished = threading.Event()
+        self._thread = threading.Thread(
+            target=self._run, name="click-editor-monitor", daemon=True
+        )
+
+    def start(self) -> None:
+        self._thread.start()
+
+    def stop(self) -> None:
+        """Tell the thread the process has ended and wait until it has
+        reported that.
+        """
+        self._finished.set()
+        self._thread.join()
+
+    def _run(self) -> None:
+        self._emit("start")
+        suspended = False
+
+        while not self._finished.wait(self.poll_interval):
+            stopped = _process_state(self.pid) == "T"
+
+            if stopped != suspended:
+                suspended = stopped
+                self._emit("suspend" if suspended else "resume")
+
+        self._emit("terminate")
+
+    def _emit(self, event_type: str) -> None:
+        try:
+            self.callback(event_type, self.pid, self.editor_command, time.time())
+        except Exception as e:
+            message = (
+                f"The editor process monitor failed on {event_type!r}:"
+                f" {type(e).__name__}: {e}"
+            )
+
+            try:
+                warnings.warn(message, UserWarning)
+            except Exception:
+                # Warnings turned into errors have nowhere to go from
+                # this thread, and the events that follow still matter.
+                pass
+
+
