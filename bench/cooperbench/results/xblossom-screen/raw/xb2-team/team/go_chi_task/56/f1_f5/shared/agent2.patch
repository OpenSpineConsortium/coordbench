+// EnableCORS enables CORS on the Mux with DefaultCORSOptions. It adds the CORS
+// middleware to the stack, so like Use it must be called before routes are
+// defined, and makes the Mux answer preflight requests. See
+// EnableCORSWithOptions.
+func (mx *Mux) EnableCORS() {
+	mx.EnableCORSWithOptions(DefaultCORSOptions())
+}
+
+// EnableCORSWithOptions enables CORS on the Mux with the given options.
+//
+// It adds the CORS middleware to the stack, so like Use it must be called
+// before routes are defined. A preflight request, an OPTIONS request to a
+// resource that has no handler for OPTIONS of its own, ends in the Mux's
+// method-not-allowed handler, which this call replaces to answer it with 204
+// and the methods the resource serves in Access-Control-Allow-Methods. Any
+// other request that ends there gets the 405 it got before, from the handler
+// set by MethodNotAllowed if there is one, now with an Allow header that lists
+// the methods the resource serves.
+func (mx *Mux) EnableCORSWithOptions(options CORSOptions) {
+	mx.Use(CORS(options))
+
+	custom := mx.methodNotAllowedHandler
+	mx.MethodNotAllowed(func(w http.ResponseWriter, r *http.Request) {
+		allowed := servedMethodNames(r)
+		if len(allowed) > 0 {
+			w.Header().Set("Allow", strings.Join(allowed, ", "))
+		}
+
+		switch {
+		case r.Method == http.MethodOptions:
+			writeCORSPreflight(w, r, options, allowed)
+		case custom != nil:
+			custom(w, r)
+		default:
+			w.WriteHeader(http.StatusMethodNotAllowed)
+		}
+	})
+}
+
+// WithCORS returns an inline Router, as With does, on which CORS is enabled
+// with DefaultCORSOptions: the routes defined on it carry the CORS headers.
+func (mx *Mux) WithCORS() Router {
+	im := mx.With().(*Mux)
+	im.EnableCORS()
+	return im
+}
+
