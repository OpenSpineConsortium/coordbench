diff --git a/middleware/allowed_methods.go b/middleware/allowed_methods.go
new file mode 100644
index 0000000..269b68a
--- /dev/null
+++ b/middleware/allowed_methods.go
@@ -0,0 +1,85 @@
+package middleware
+
+import (
+	"net/http"
+	"strings"
+
+	"github.com/go-chi/chi/v5"
+)
+
+// allowedMethods is the order in which SetAllowHeader lists the methods it
+// finds, so that the same routes always give the same header.
+var allowedMethods = []string{
+	http.MethodGet,
+	http.MethodHead,
+	http.MethodPost,
+	http.MethodPut,
+	http.MethodPatch,
+	http.MethodDelete,
+	http.MethodConnect,
+	http.MethodOptions,
+	http.MethodTrace,
+}
+
+// SetAllowHeader adds the Allow header for 405 responses based on
+// registered methods for the requested path.
+//
+// RFC 9110 requires a 405 Method Not Allowed response to name the methods
+// the resource supports. When the request's method has no route for the
+// path but another standard method has, the middleware adds those methods
+// to the Allow header before it calls the next handler, which then answers
+// with the 405. Requests that match a route are passed on untouched, so
+// the cost falls only on requests that would be answered with a 405.
+func SetAllowHeader(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		rctx := chi.RouteContext(r.Context())
+		if rctx == nil || rctx.Routes == nil {
+			next.ServeHTTP(w, r)
+			return
+		}
+
+		method := rctx.RouteMethod
+		if method == "" {
+			method = r.Method
+		}
+		path := requestPath(r)
+
+		// Match records its findings in the context it is given, so each
+		// look-ahead gets a temporary one and the request's own is left alone.
+		if !rctx.Routes.Match(chi.NewRouteContext(), method, path) {
+			for _, m := range allowedMethods {
+				if m != method && !hasAllowed(w.Header(), m) &&
+					rctx.Routes.Match(chi.NewRouteContext(), m, path) {
+					w.Header().Add("Allow", m)
+				}
+			}
+		}
+
+		next.ServeHTTP(w, r)
+	})
+}
+
+// requestPath returns the path the router matches the request on, which is
+// the escaped one when the request has it.
+func requestPath(r *http.Request) string {
+	if r.URL.RawPath != "" {
+		return r.URL.RawPath
+	}
+	if r.URL.Path != "" {
+		return r.URL.Path
+	}
+	return "/"
+}
+
+// hasAllowed reports whether the Allow header already lists the method, as
+// it does when SetAllowHeader runs on a router and on its subrouter.
+func hasAllowed(header http.Header, method string) bool {
+	for _, value := range header["Allow"] {
+		for _, item := range strings.Split(value, ",") {
+			if strings.TrimSpace(item) == method {
+				return true
+			}
+		}
+	}
+	return false
+}
