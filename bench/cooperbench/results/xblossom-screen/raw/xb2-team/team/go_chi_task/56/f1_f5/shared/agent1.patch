 // methodNotAllowedHandler is a helper function to respond with a 405,
-// method not allowed.
-func methodNotAllowedHandler(w http.ResponseWriter, r *http.Request) {
-	w.WriteHeader(405)
-	w.Write(nil)
+// method not allowed, with an Allow header that lists methodsAllowed.
+func methodNotAllowedHandler(methodsAllowed ...methodTyp) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		header := w.Header()
+		for _, name := range allowedMethodNames(methodsAllowed) {
+			if !headerHasToken(header, "Allow", name) {
+				header.Add("Allow", name)
+			}
+		}
+		w.WriteHeader(405)
+		w.Write(nil)
+	}
+}
+
+// headerHasToken reports whether one of the values of the header key lists
+// token among its comma separated items. A middleware such as
+// middleware.SetAllowHeader may have set the Allow header already, and the
+// 405 responder must not repeat its methods.
+func headerHasToken(header http.Header, key, token string) bool {
+	for _, value := range header[key] {
+		for _, item := range strings.Split(value, ",") {
+			if strings.TrimSpace(item) == token {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// allowOrder is the order in which the standard methods are listed in an
+// Allow header, so that the same routes always give the same header.
+var allowOrder = []methodTyp{
+	mGET, mHEAD, mPOST, mPUT, mPATCH, mDELETE, mCONNECT, mOPTIONS, mTRACE,
+}
+
+// allowedMethodNames returns the names of the given methods, each once, the
+// standard ones in allowOrder and then the ones added with RegisterMethod in
+// the order they were registered.
+func allowedMethodNames(methods []methodTyp) []string {
+	var present methodTyp
+	for _, m := range methods {
+		present |= m
+	}
+
+	names := make([]string, 0, len(methods))
+	for _, m := range allowOrder {
+		if present&m != 0 {
+			names = append(names, reverseMethodMap[m])
+			present &^= m
+		}
+	}
+	for m := methodTyp(1); present != 0 && m != 0; m <<= 1 {
+		if present&m == 0 {
+			continue
+		}
+		present &^= m
+		if name, ok := reverseMethodMap[m]; ok {
+			names = append(names, name)
+		}
+	}
+	return names
 }
