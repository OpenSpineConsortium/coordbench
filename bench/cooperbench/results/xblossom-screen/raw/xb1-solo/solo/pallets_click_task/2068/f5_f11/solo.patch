+def _process_is_stopped(pid: int) -> bool | None:
+    """Whether the process is stopped (suspended by a signal such as
+    SIGTSTP), or ``None`` when that cannot be told.
+
+    Only systems with ``/proc`` answer; elsewhere a monitor reports no
+    suspend or resume events, which the callback interface allows.
+    """
+    try:
+        with open(f"/proc/{pid}/stat", "rb") as f:
+            stat = f.read()
+    except OSError:
+        return None
+
+    # The command name comes first, in parentheses, and may itself hold
+    # spaces or parentheses, so the state is the field after the last one.
+    fields = stat.rpartition(b")")[2].split()
+
+    if not fields:
+        return None
+
+    return fields[0] in (b"T", b"t")
+
+
+class _ProcessMonitor:
+    """Reports the life of an editor process to a callback.
+
+    The callback is called as ``callback(event_type, process_id,
+    editor_command, timestamp)`` from a thread of the monitor's own, so
+    the thread that waits for the editor is never held up by it. The
+    events come in order: ``"start"`` first, ``"suspend"`` and
+    ``"resume"`` as the process is stopped and continued, and
+    ``"terminate"`` last, before :meth:`stop` returns.
+
+    A callback that raises gets a :class:`UserWarning` and no more; the
+    events after it are still delivered.
+    """
+
+    poll_interval = 0.1
+
+    def __init__(
+        self,
+        callback: cabc.Callable[[str, int, str, float], None],
+        process: t.Any,
+        editor_command: str,
+    ) -> None:
+        self._callback = callback
+        self._process = process
+        self._editor_command = editor_command
+        self._done = threading.Event()
+        self._thread = threading.Thread(
+            target=self._run, name="click-editor-monitor", daemon=True
+        )
+
+    def start(self) -> None:
+        self._thread.start()
+
+    def stop(self) -> None:
+        """Report the termination and wait until it is reported."""
+        self._done.set()
+        self._thread.join()
+
+    def _run(self) -> None:
+        self._notify("start")
+        stopped = False
+
+        while not self._done.wait(self.poll_interval):
+            stopped = self._watch_for_suspension(stopped)
+
+        self._notify("terminate")
+
+    def _watch_for_suspension(self, was_stopped: bool) -> bool:
+        # A process that has ended and been reaped must not be looked up
+        # again, since its id may belong to another process by now.
+        if self._process.poll() is not None:
+            return was_stopped
+
+        stopped = _process_is_stopped(self._process.pid)
+
+        if stopped is None or stopped == was_stopped:
+            return was_stopped
+
+        self._notify("suspend" if stopped else "resume")
+        return stopped
+
+    def _notify(self, event_type: str) -> None:
+        try:
+            self._callback(
+                event_type, self._process.pid, self._editor_command, time.time()
+            )
+        except Exception as e:
+            # Warnings may be configured as errors; that must not end the
+            # monitoring either.
+            with contextlib.suppress(Exception):
+                warnings.warn(
+                    f"The editor process monitor callback failed on"
+                    f" {event_type!r}: {e!r}",
+                    UserWarning,
+                    stacklevel=2,
+                )
+
+
