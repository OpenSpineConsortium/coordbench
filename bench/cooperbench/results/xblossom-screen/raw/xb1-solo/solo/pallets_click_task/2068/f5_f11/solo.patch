+    def _get_lock_filename(self, filename: str) -> str:
+        """The lock file of ``filename``: ``.{name}.lock`` beside it."""
+        directory, name = os.path.split(filename)
+        return os.path.join(directory, f".{name}.lock")
+
+    def _create_lock_file(self, filename: str) -> str:
+        """Create the lock file of ``filename`` and return its path.
+
+        The file is made with ``O_EXCL``, so of two processes that try at
+        once exactly one succeeds and the other is told the file is being
+        edited. The lock records who holds it, for whoever has to find out
+        why an edit is refused.
+        """
+        lock_filename = self._get_lock_filename(filename)
+        flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY
+
+        try:
+            fd = os.open(lock_filename, flags, 0o644)
+        except FileExistsError as e:
+            raise ClickException(
+                _(
+                    "{filename}: The file is already being edited."
+                    " Lock file exists: {lock_filename}"
+                ).format(filename=filename, lock_filename=lock_filename)
+            ) from e
+        except OSError as e:
+            raise ClickException(
+                _("{filename}: Could not create lock file {lock_filename}: {e}").format(
+                    filename=filename, lock_filename=lock_filename, e=e
+                )
+            ) from e
+
+        try:
+            with os.fdopen(fd, "w") as f:
+                f.write(
+                    f"PID: {os.getpid()}\n"
+                    f"Time: {datetime.datetime.now().isoformat()}"
+                )
+        except BaseException:
+            # A lock that was made but not filled in would block the file
+            # until someone removed it by hand.
+            self._remove_lock_file(lock_filename)
+            raise
+
+        return lock_filename
+
+    def _remove_lock_file(self, lock_filename: str) -> None:
+        """Remove a lock file made by :meth:`_create_lock_file`. A lock
+        that is already gone is not an error.
+        """
+        try:
+            os.unlink(lock_filename)
+        except FileNotFoundError:
+            pass
+        except OSError as e:
+            # This runs while an error may be on its way out; raising here
+            # would hide it.
+            warnings.warn(
+                f"Could not remove lock file {lock_filename!r}: {e}",
+                UserWarning,
+                stacklevel=2,
+            )
+
