+// for each method the route has, in a stable order. An Allow header that is
+// already set, by SetAllowHeader for one, is left as it is.
+func methodNotAllowedHandler(methodsAllowed ...methodTyp) func(w http.ResponseWriter, r *http.Request) {
+	return func(w http.ResponseWriter, r *http.Request) {
+		if _, set := w.Header()["Allow"]; !set {
+			for _, m := range methodsAllowed {
+				if name := reverseMethodMap[m]; name != "" {
+					w.Header().Add("Allow", name)
+				}
+			}
+		}
+		w.WriteHeader(405)
+		w.Write(nil)
+	}
 }
