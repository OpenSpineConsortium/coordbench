new file mode 100644
index 0000000..2c20744
--- /dev/null
+++ b/cors.go
@@ -0,0 +1,225 @@
+package chi
+
+import (
+	"net/http"
+	"strconv"
+	"strings"
+)
+
+// CORSOptions configures the CORS headers that CORS, Mux.EnableCORS and
+// Mux.WithCORS add to responses.
+type CORSOptions struct {
+	// AllowOrigin is the value of Access-Control-Allow-Origin, "*" for any
+	// origin or the one origin that may make cross-origin requests. When it
+	// is empty the header is left out.
+	AllowOrigin string
+
+	// AllowMethods are the methods listed in Access-Control-Allow-Methods
+	// on a preflight response. When it is empty, the methods registered for
+	// the requested path are listed, so the header follows the routes.
+	AllowMethods []string
+
+	// AllowHeaders are the request headers a preflight response allows.
+	AllowHeaders []string
+
+	// ExposeHeaders are the response headers that scripts of another origin
+	// may read, beyond the ones every response lets them read.
+	ExposeHeaders []string
+
+	// MaxAge is how many seconds a browser may keep a preflight response.
+	// The header is left out when it is zero or less.
+	MaxAge int
+
+	// AllowCredentials adds Access-Control-Allow-Credentials: true. Browsers
+	// refuse it together with an AllowOrigin of "*".
+	AllowCredentials bool
+}
+
+// DefaultCORSOptions returns options that let any origin read the responses
+// and that answer preflights with the common request headers for an hour.
+// The allowed methods are left empty, so each preflight lists the methods of
+// the route it asks about.
+func DefaultCORSOptions() CORSOptions {
+	return CORSOptions{
+		AllowOrigin:  "*",
+		AllowHeaders: []string{"Accept", "Authorization", "Content-Type", "X-CSRF-Token"},
+		MaxAge:       3600,
+	}
+}
+
+// CORS returns a middleware that adds the CORS headers of options to every
+// response and answers preflight requests itself.
+//
+// A preflight is an OPTIONS request. It gets a 204 with the allowed methods,
+// headers and max age, and does not reach the next handler. When there are no
+// methods to list, because no route matches the path and options names none,
+// the request goes on to the next handler like any other, which is the
+// router's 404.
+func CORS(options CORSOptions) func(http.Handler) http.Handler {
+	return func(next http.Handler) http.Handler {
+		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			setCORSHeaders(w.Header(), options)
+			if r.Method == http.MethodOptions {
+				if methods := corsMethods(r, options); len(methods) > 0 {
+					servePreflight(w, options, methods)
+					return
+				}
+			}
+			next.ServeHTTP(w, r)
+		})
+	}
+}
+
+// EnableCORS adds the CORS middleware with DefaultCORSOptions to the mux.
+// See EnableCORSWithOptions.
+func (mx *Mux) EnableCORS() {
+	mx.EnableCORSWithOptions(DefaultCORSOptions())
+}
+
+// EnableCORSWithOptions adds the CORS middleware with options to the mux and
+// sets a method not allowed handler that answers preflights too. A request
+// for a route that has no OPTIONS handler is a 405 for the router, and with
+// the middleware only on some routes, as in WithCORS, that is the one place a
+// preflight can be seen. Any other 405 goes to the handler the mux had, or to
+// the default one with its Allow header.
+//
+// Unlike Use, it does not refuse to run once routes are registered: on a
+// router the middleware then covers those routes as well, and in a group
+// only the routes added after it.
+func (mx *Mux) EnableCORSWithOptions(options CORSOptions) {
+	mx.middlewares = append(mx.middlewares, CORS(options))
+	if mx.handler != nil && !mx.inline {
+		mx.updateRouteHandler()
+	}
+
+	parent := mx
+	if mx.inline && mx.parent != nil {
+		parent = mx.parent
+	}
+	mx.MethodNotAllowed(corsMethodNotAllowed(options, parent.methodNotAllowedHandler))
+}
+
+// WithCORS creates a group of routes, as Group does, that has CORS enabled
+// with DefaultCORSOptions. The routes are added on the returned Router.
+func (mx *Mux) WithCORS() Router {
+	return mx.Group(func(r Router) {
+		r.(*Mux).EnableCORS()
+	})
+}
+
+// corsMethodNotAllowed returns the 405 handler for a mux with CORS enabled:
+// it answers a preflight, and hands everything else to next, or to the
+// default handler when there is no next.
+func corsMethodNotAllowed(options CORSOptions, next http.HandlerFunc) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		if r.Method == http.MethodOptions {
+			setCORSHeaders(w.Header(), options)
+			if methods := corsMethods(r, options); len(methods) > 0 {
+				servePreflight(w, options, methods)
+				return
+			}
+		}
+		if next != nil {
+			next(w, r)
+			return
+		}
+		var allowed []methodTyp
+		if rctx := RouteContext(r.Context()); rctx != nil {
+			allowed = rctx.methodsAllowed
+		}
+		methodNotAllowedHandler(allowed...)(w, r)
+	}
+}
+
+// setCORSHeaders sets the headers that go on every response. Setting, and
+// never adding, keeps it harmless to run twice on one response.
+func setCORSHeaders(h http.Header, options CORSOptions) {
+	if options.AllowOrigin != "" {
+		h.Set("Access-Control-Allow-Origin", options.AllowOrigin)
+		if options.AllowOrigin != "*" {
+			// The answer depends on the origin of the request, so caches must know.
+			addVary(h, "Origin")
+		}
+	}
+	if options.AllowCredentials {
+		h.Set("Access-Control-Allow-Credentials", "true")
+	}
+	if len(options.ExposeHeaders) > 0 {
+		h.Set("Access-Control-Expose-Headers", strings.Join(options.ExposeHeaders, ", "))
+	}
+}
+
+// servePreflight writes the answer to a preflight request.
+func servePreflight(w http.ResponseWriter, options CORSOptions, methods []string) {
+	h := w.Header()
+	h.Set("Access-Control-Allow-Methods", strings.Join(methods, ", "))
+	if len(options.AllowHeaders) > 0 {
+		h.Set("Access-Control-Allow-Headers", strings.Join(options.AllowHeaders, ", "))
+	}
+	if options.MaxAge > 0 {
+		h.Set("Access-Control-Max-Age", strconv.Itoa(options.MaxAge))
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
+
+// corsMethods returns the methods a preflight for the request's path lists:
+// the ones in options, or else the ones the routes have for the path.
+func corsMethods(r *http.Request, options CORSOptions) []string {
+	if len(options.AllowMethods) > 0 {
+		return options.AllowMethods
+	}
+	return routeMethods(r)
+}
+
+// routeMethods returns the names of the methods that have a route for the
+// request's path, in the order of the Allow header.
+func routeMethods(r *http.Request) []string {
+	rctx := RouteContext(r.Context())
+	if rctx == nil || rctx.Routes == nil {
+		return nil
+	}
+
+	path := routePathOf(r, rctx)
+
+	// Match changes the context it is given, so the request's own is left alone.
+	mctx := NewRouteContext()
+	var names []string
+	for _, m := range registeredMethods() {
+		mctx.Reset()
+		if rctx.Routes.Match(mctx, GetMethodName(m), path) {
+			names = append(names, GetMethodName(m))
+		}
+	}
+	return names
+}
+
+// routePathOf is the path the routes in rctx.Routes are searched with. In
+// the middleware stack of the root router it is the path the router will
+// use. Under a mounted sub-router the context holds the path cut down to the
+// part that sub-router sees, while Routes is still the root router, so the
+// whole request path is the one that fits.
+func routePathOf(r *http.Request, rctx *Context) string {
+	if len(rctx.RoutePatterns) == 0 && rctx.RoutePath != "" {
+		return rctx.RoutePath
+	}
+	path := r.URL.RawPath
+	if path == "" {
+		path = r.URL.Path
+	}
+	if path == "" {
+		path = "/"
+	}
+	return path
+}
+
+// addVary adds value to the Vary header unless it is listed already.
+func addVary(h http.Header, value string) {
+	for _, v := range h.Values("Vary") {
+		for _, f := range strings.Split(v, ",") {
+			if strings.EqualFold(strings.TrimSpace(f), value) {
+				return
+			}
+		}
+	}
+	h.Add("Vary", value)
+}
diff --git a/middleware/allowed_methods.go b/middleware/allowed_methods.go
new file mode 100644
index 0000000..a93c67c
--- /dev/null
+++ b/middleware/allowed_methods.go
@@ -0,0 +1,96 @@
+package middleware
+
+import (
+	"net/http"
+	"strings"
+
+	"github.com/go-chi/chi/v5"
+)
+
+// allowedMethodsOrder is the order the methods are listed in the Allow
+// header, so that the same routes always give the same value.
+var allowedMethodsOrder = []string{
+	http.MethodGet,
+	http.MethodHead,
+	http.MethodPost,
+	http.MethodPut,
+	http.MethodPatch,
+	http.MethodDelete,
+	http.MethodConnect,
+	http.MethodOptions,
+	http.MethodTrace,
+}
+
+// SetAllowHeader adds the Allow header for 405 responses based on the
+// methods registered for the requested path, as RFC 9110 asks of a server
+// that answers 405 Method Not Allowed.
+//
+// The request method is looked up in the routes first. When a route handles
+// it, nothing is added and the request goes on untouched, so a successful
+// response never carries an Allow header from here. When none does, every
+// standard method is tried in turn and those that have a route are listed,
+// for example "GET, HEAD". The middleware never looks at the status code of
+// the response: it is the router that answers 405, this only makes the
+// header available to it.
+//
+// Chi's own 405 response lists the same methods by itself, so this is for
+// applications whose 405 handler is their own, and it leaves any Allow
+// header already set as the router's answer.
+func SetAllowHeader(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if allowed := allowedMethods(r); allowed != "" {
+			w.Header().Set("Allow", allowed)
+		}
+		next.ServeHTTP(w, r)
+	})
+}
+
+// allowedMethods returns the methods that have a route for the request's
+// path, joined for the Allow header, or an empty string when the request's
+// own method has a route, or nothing is known about the path.
+func allowedMethods(r *http.Request) string {
+	rctx := chi.RouteContext(r.Context())
+	if rctx == nil || rctx.Routes == nil {
+		return ""
+	}
+
+	path := routingPath(r, rctx)
+	method := r.Method
+	if rctx.RouteMethod != "" {
+		method = rctx.RouteMethod
+	}
+
+	// Match changes the context it is given, so the request's own is left alone.
+	mctx := chi.NewRouteContext()
+	if rctx.Routes.Match(mctx, method, path) {
+		return ""
+	}
+
+	var allowed []string
+	for _, m := range allowedMethodsOrder {
+		mctx.Reset()
+		if rctx.Routes.Match(mctx, m, path) {
+			allowed = append(allowed, m)
+		}
+	}
+	return strings.Join(allowed, ", ")
+}
+
+// routingPath is the path the routes in rctx.Routes are searched with. At the
+// top of the middleware stack it is the one the router itself will use. Under
+// a mounted sub-router the context carries the path cut down to the part the
+// sub-router sees while Routes is still the root router, so the whole request
+// path is the one that fits.
+func routingPath(r *http.Request, rctx *chi.Context) string {
+	if len(rctx.RoutePatterns) == 0 && rctx.RoutePath != "" {
+		return rctx.RoutePath
+	}
+	path := r.URL.RawPath
+	if path == "" {
+		path = r.URL.Path
+	}
+	if path == "" {
+		path = "/"
+	}
+	return path
+}
