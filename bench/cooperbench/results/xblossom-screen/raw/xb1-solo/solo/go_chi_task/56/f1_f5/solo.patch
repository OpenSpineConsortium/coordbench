+
+// allowMethod adds m to the allowed methods unless it is there already,
+// keeping the list in the order of methodLess.
+func (x *Context) allowMethod(m methodTyp) {
+	i := 0
+	for ; i < len(x.methodsAllowed); i++ {
+		if x.methodsAllowed[i] == m {
+			return
+		}
+		if methodLess(m, x.methodsAllowed[i]) {
+			break
+		}
+	}
+	x.methodsAllowed = append(x.methodsAllowed, 0)
+	copy(x.methodsAllowed[i+1:], x.methodsAllowed[i:])
+	x.methodsAllowed[i] = m
+}
