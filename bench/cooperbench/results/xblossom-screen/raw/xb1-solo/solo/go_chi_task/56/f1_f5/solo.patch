@@ -43,6 +43,70 @@ var methodMap = map[string]methodTyp{
 	http.MethodTrace:   mTRACE,
 }
 
+// reverseMethodMap maps a method type back to its name. It is the inverse of
+// methodMap and RegisterMethod keeps the two in step.
+var reverseMethodMap = map[methodTyp]string{
+	mCONNECT: http.MethodConnect,
+	mDELETE:  http.MethodDelete,
+	mGET:     http.MethodGet,
+	mHEAD:    http.MethodHead,
+	mOPTIONS: http.MethodOptions,
+	mPATCH:   http.MethodPatch,
+	mPOST:    http.MethodPost,
+	mPUT:     http.MethodPut,
+	mTRACE:   http.MethodTrace,
+}
+
+// methodNames is the table GetMethodName reads, used when a method type has
+// to be written out as a header value (Allow, Access-Control-Allow-Methods).
+// It is the same map as reverseMethodMap, so a method added by
+// RegisterMethod is known to both.
+var methodNames = reverseMethodMap
+
+// methodOrder is the order in which methods are listed in the headers chi
+// writes: the common read and write methods first, as the RFC lists them,
+// so that the same routes always give the same header. Methods added by
+// RegisterMethod come after these, in the order they were registered.
+var methodOrder = []methodTyp{
+	mGET, mHEAD, mPOST, mPUT, mPATCH, mDELETE, mCONNECT, mOPTIONS, mTRACE,
+}
+
+// GetMethodName returns the name of an HTTP method type, such as "GET", or
+// an empty string for a type chi does not know.
+func GetMethodName(method methodTyp) string {
+	return methodNames[method]
+}
+
+// methodLess reports whether method a is listed before method b.
+func methodLess(a, b methodTyp) bool {
+	ra, rb := methodRank(a), methodRank(b)
+	if ra != rb {
+		return ra < rb
+	}
+	return a < b
+}
+
+// methodRank is the position of m in methodOrder, or one past the end for a
+// method that RegisterMethod added.
+func methodRank(m methodTyp) int {
+	for i, o := range methodOrder {
+		if o == m {
+			return i
+		}
+	}
+	return len(methodOrder)
+}
+
+// registeredMethods returns every method chi can route, in methodLess order.
+func registeredMethods() []methodTyp {
+	ms := make([]methodTyp, 0, len(reverseMethodMap))
+	for m := range reverseMethodMap {
+		ms = append(ms, m)
+	}
+	sort.Slice(ms, func(i, j int) bool { return methodLess(ms[i], ms[j]) })
+	return ms
+}
+
