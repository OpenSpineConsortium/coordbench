+    def _get_lock_filename(self, filename: str) -> str:
+        """Return the path of the lock file for ``filename``: a hidden
+        file named ``.<name>.lock`` in the same directory.
+        """
+        directory, name = os.path.split(filename)
+        return os.path.join(directory, f".{name}.lock")
+
+    def _create_lock_file(self, filename: str) -> str:
+        """Create the lock file for ``filename`` and return its path.
+
+        The file is made with ``O_CREAT | O_EXCL``, so the operating
+        system lets exactly one of several processes create it and no
+        check-then-create race is left. It holds the process ID and the
+        time, to help whoever finds a lock that is stuck.
+
+        :raises ClickException: if the lock file exists, because
+            another edit of the file is under way, or cannot be made.
+        """
+        from datetime import datetime
+
+        lock_filename = self._get_lock_filename(filename)
+
+        try:
+            fd = os.open(lock_filename, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
+        except FileExistsError:
+            raise ClickException(
+                _(
+                    "{filename}: The file is already being edited."
+                    " Lock file: {lock_filename}"
+                ).format(filename=filename, lock_filename=lock_filename)
+            ) from None
+        except OSError as e:
+            raise ClickException(
+                _("{filename}: Could not create lock file {lock_filename}: {e}").format(
+                    filename=filename, lock_filename=lock_filename, e=e
+                )
+            ) from e
+
+        try:
+            with os.fdopen(fd, "w", encoding="utf-8") as f:
+                f.write(f"PID: {os.getpid()}\nTime: {datetime.now().isoformat()}")
+        except BaseException:
+            # A lock with nothing in it would still block everyone else.
+            self._remove_lock_file(lock_filename)
+            raise
+
+        return lock_filename
+
+    def _remove_lock_file(self, lock_filename: str) -> None:
+        """Remove a lock file. One that is gone already, or that cannot
+        be removed, is not an error: this runs while an earlier error
+        may be on its way up, and must not hide it.
+        """
+        with contextlib.suppress(OSError):
+            os.unlink(lock_filename)
+
 
