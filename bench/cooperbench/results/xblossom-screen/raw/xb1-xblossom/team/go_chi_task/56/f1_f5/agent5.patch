@@ -773,6 +773,29 @@ func methodTypString(method methodTyp) string {
 	return ""
 }
 
+// methodNames maps the standard method types to their HTTP method names.
+var methodNames = map[methodTyp]string{
+	mCONNECT: http.MethodConnect,
+	mDELETE:  http.MethodDelete,
+	mGET:     http.MethodGet,
+	mHEAD:    http.MethodHead,
+	mOPTIONS: http.MethodOptions,
+	mPATCH:   http.MethodPatch,
+	mPOST:    http.MethodPost,
+	mPUT:     http.MethodPut,
+	mTRACE:   http.MethodTrace,
+}
+
+// GetMethodName returns the HTTP method name of a method type, such as "GET"
+// for mGET, for the headers that list methods. It knows the methods added with
+// RegisterMethod too, and returns "" for a type that is none of them.
+func GetMethodName(method methodTyp) string {
+	if name, ok := methodNames[method]; ok {
+		return name
+	}
+	return methodTypString(method)
+}
