@@ -345,6 +345,34 @@ func (mx *Mux) Middlewares() Middlewares {
 	return mx.middlewares
 }
 
+// EnableCORS adds the CORS middleware with DefaultCORSOptions to the Mux, so
+// that every response carries the CORS headers and preflight requests are
+// answered with the methods that the resource handles. Like Use, it must be
+// called before routes are defined.
+func (mx *Mux) EnableCORS() {
+	mx.EnableCORSWithOptions(DefaultCORSOptions())
+}
+
+// EnableCORSWithOptions is EnableCORS with the given options.
+//
+// It also sets the Mux's method not allowed handler: a request for a method
+// that the resource lacks gets a 405 with an Allow header that lists the ones
+// it has, and a preflight request that routing could not match gets its 204.
+// A handler set with MethodNotAllowed before this call is kept for the 405.
+func (mx *Mux) EnableCORSWithOptions(options CORSOptions) {
+	policy := newCORSPolicy(options)
+	mx.Use(policy.middleware)
+	mx.MethodNotAllowed(policy.methodNotAllowed(mx.methodNotAllowedHandler))
+}
+
+// WithCORS adds CORS support like EnableCORS to an inline group of routes and
+// returns the group's router.
+func (mx *Mux) WithCORS() Router {
+	return mx.Group(func(r Router) {
+		r.(*Mux).EnableCORS()
+	})
+}
+
 // Match searches the routing tree for a handler that matches the method/path.
 // It's similar to routing a http request, but without executing the handler
