index 0000000..5fdb26d
--- /dev/null
+++ b/middleware/allowed_methods.go
@@ -0,0 +1,87 @@
+package middleware
+
+import (
+	"net/http"
+	"sync"
+
+	"github.com/go-chi/chi/v5"
+)
+
+// allowHeaderMethods are the methods SetAllowHeader asks the router about, in
+// the order the Allow header names them. It is the order net/http declares the
+// standard methods in, and the order the router uses for its own 405 answers.
+var allowHeaderMethods = [...]string{
+	http.MethodGet,
+	http.MethodHead,
+	http.MethodPost,
+	http.MethodPut,
+	http.MethodPatch,
+	http.MethodDelete,
+	http.MethodConnect,
+	http.MethodOptions,
+	http.MethodTrace,
+}
+
+// lookAheadContexts holds the routing contexts SetAllowHeader searches with,
+// so that looking ahead costs a request no allocation.
+var lookAheadContexts = sync.Pool{
+	New: func() interface{} { return chi.NewRouteContext() },
+}
+
+// SetAllowHeader adds the Allow header for 405 responses based on the
+// registered methods for the requested path.
+//
+// When the router has a route for the request path but none for the request
+// method, the header lists the methods it does have, as RFC 9110 asks of a
+// 405 Method Not Allowed response (section 15.5.6). A request whose method
+// the router serves, or whose path it does not know, gets no Allow header.
+// The middleware looks at the routes before the request is routed and never
+// at the response, so it adds nothing to a request that is served.
+func SetAllowHeader(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if rctx := chi.RouteContext(r.Context()); rctx != nil && rctx.Routes != nil {
+			addAllowHeader(w.Header(), rctx, r)
+		}
+		next.ServeHTTP(w, r)
+	})
+}
+
+// addAllowHeader names in h the methods the router has a route for at the
+// request path, unless it has one for the method the request will be routed
+// with.
+func addAllowHeader(h http.Header, rctx *chi.Context, r *http.Request) {
+	routePath := rctx.RoutePath
+	if routePath == "" {
+		if r.URL.RawPath != "" {
+			routePath = r.URL.RawPath
+		} else {
+			routePath = r.URL.Path
+		}
+	}
+
+	// A middleware before this one, GetHead for one, may have changed the
+	// method the request is routed with.
+	method := rctx.RouteMethod
+	if method == "" {
+		method = r.Method
+	}
+
+	tctx := lookAheadContexts.Get().(*chi.Context)
+	defer lookAheadContexts.Put(tctx)
+
+	if matches(rctx.Routes, tctx, method, routePath) {
+		return
+	}
+	for _, m := range allowHeaderMethods {
+		if m != method && matches(rctx.Routes, tctx, m, routePath) {
+			h.Add("Allow", m)
+		}
+	}
+}
+
+// matches reports whether routes has a handler for method at path. Matching
+// changes the routing context it is given, so it starts from a clean one.
+func matches(routes chi.Routes, tctx *chi.Context, method, path string) bool {
+	tctx.Reset()
+	return routes.Match(tctx, method, path)
+}
