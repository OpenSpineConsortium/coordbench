-// method not allowed.
-func methodNotAllowedHandler(w http.ResponseWriter, r *http.Request) {
-	w.WriteHeader(405)
-	w.Write(nil)
+// method not allowed, with an Allow header naming methodsAllowed (RFC 9110,
+// section 15.5.6). A method the header already names, put there by the
+// SetAllowHeader middleware for one, is not named a second time.
+func methodNotAllowedHandler(methodsAllowed ...methodTyp) func(w http.ResponseWriter, r *http.Request) {
+	return func(w http.ResponseWriter, r *http.Request) {
+		for _, m := range methodsAllowed {
+			if name, ok := reverseMethodMap[m]; ok && !allowHeaderNames(w.Header(), name) {
+				w.Header().Add("Allow", name)
+			}
+		}
+		w.WriteHeader(405)
+		w.Write(nil)
+	}
