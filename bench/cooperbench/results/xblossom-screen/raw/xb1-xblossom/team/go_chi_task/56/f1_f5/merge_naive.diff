+// allowHeaderNames reports whether the Allow header of h already names method.
+func allowHeaderNames(h http.Header, method string) bool {
+	for _, v := range h["Allow"] {
+		for _, name := range strings.Split(v, ",") {
+			if strings.TrimSpace(name) == method {
+				return true
+			}
+		}
+	}
+	return false
 }
