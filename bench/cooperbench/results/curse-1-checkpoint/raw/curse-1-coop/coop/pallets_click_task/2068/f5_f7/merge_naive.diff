+    def _create_lock_file(self, filename: str) -> str:
+        """Create the lock file for ``filename`` and return its path.
+
+        The file is made with ``O_CREAT | O_EXCL``, so the check for an
+        existing lock and the creation are one atomic step and two
+        processes can never both take the lock. It records the process
+        ID and the time, to help whoever finds a stale lock.
