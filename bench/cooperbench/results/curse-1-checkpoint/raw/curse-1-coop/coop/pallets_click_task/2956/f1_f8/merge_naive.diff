+    def shell_complete(self, ctx: Context, incomplete: str) -> list[CompletionItem]:
+        """Return the completions for the incomplete value. A
+        ``shell_complete`` function given during init always wins; then,
+        if ``auto_complete`` is enabled, the completion is picked from the
+        option's name and type (:meth:`_smart_complete`); otherwise the
+        :attr:`type` provides it, as for any parameter.
+
+        :param ctx: Invocation context for this command.
+        :param incomplete: Value being completed. May be empty.
+
+        .. versionchanged:: 8.3
+            Added ``auto_complete`` support.
+        """
+        if self.auto_complete and self._custom_shell_complete is None:
+            return self._smart_complete(ctx, incomplete)
+
+        return super().shell_complete(ctx, incomplete)
+
+    def _smart_complete(self, ctx: Context, incomplete: str) -> list[CompletionItem]:
+        """Complete the value from the option's type, its name and what the
+        environment holds. Choices complete as they do without
+        ``auto_complete``; otherwise the first pattern of the registry
+        that the name matches decides, and a name that matches none falls
+        back to the completion of the option's type, so the result is
+        never worse than without ``auto_complete``.
+
+        :param ctx: Invocation context for this command.
+        :param incomplete: Value being completed. May be empty.
+        """
+        if not isinstance(self.type, types.Choice):
+            words = set((self.name or "").lower().split("_"))
+
+            for patterns, complete in _AUTO_COMPLETERS:
+                if words & patterns:
+                    return complete(incomplete)
+
+        return self.type.shell_complete(ctx, self, incomplete)
+
