+    /// Pick the first or, if `from_back` is set, the last grapheme cluster,
+    /// restricted to those matching the named character class if there is one.
+    ///
+    /// An empty string is reported before the pattern is looked at, so the
+    /// error does not depend on it.
+    fn pick_cluster(&self, from_back: bool, pattern: Option<&str>) -> StrResult<&str> {
+        if self.0.is_empty() {
+            return Err(string_is_empty());
+        }
+        let class = pattern.map(CharClass::parse).transpose()?;
+
+        let mut clusters = self.0.graphemes(true);
+        let picked = match (class, from_back) {
+            (None, false) => clusters.next(),
+            (None, true) => clusters.next_back(),
+            (Some(class), false) => clusters.find(|c| class.matches_cluster(c)),
+            (Some(class), true) => clusters.rfind(|c| class.matches_cluster(c)),
+        };
+
+        picked.ok_or_else(|| match class {
+            Some(class) => no_character_matches(class),
+            None => string_is_empty(),
+        })
+    }
 }
 
