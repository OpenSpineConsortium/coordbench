+/// The error message when no grapheme cluster matches a character class.
+#[cold]
+fn no_character_matches(class: CharClass) -> EcoString {
+    eco_format!("no character matches pattern \"{}\"", class.name())
+}
+
+/// The error message when a character class name is unknown.
+#[cold]
+fn unknown_char_class(name: &str) -> EcoString {
+    eco_format!(
+        "unknown pattern \"{}\" (expected one of {})",
+        name,
+        CharClass::ALL
+            .iter()
+            .map(|class| eco_format!("\"{}\"", class.name()))
+            .collect::<Vec<_>>()
+            .join(", "),
+    )
+}
+
+/// A built-in character class that `str.first` and `str.last` can search for.
+#[derive(Debug, Copy, Clone, Eq, PartialEq)]
+enum CharClass {
+    /// Alphabetic characters.
+    Alpha,
+    /// Numeric characters.
+    Numeric,
+    /// Alphabetic or numeric characters.
+    Alphanumeric,
+    /// Uppercase characters.
+    Uppercase,
+    /// Lowercase characters.
+    Lowercase,
+    /// Whitespace characters.
+    Whitespace,
+}
+
+impl CharClass {
+    /// All classes, in the order they are listed in error messages.
+    const ALL: [Self; 6] = [
+        Self::Alpha,
+        Self::Numeric,
+        Self::Alphanumeric,
+        Self::Uppercase,
+        Self::Lowercase,
+        Self::Whitespace,
+    ];
+
+    /// Look up a class by the name callers pass as the `pattern` argument.
+    fn parse(name: &str) -> StrResult<Self> {
+        Self::ALL
+            .into_iter()
+            .find(|class| class.name() == name)
+            .ok_or_else(|| unknown_char_class(name))
+    }
+
+    /// The name of the class as callers write it.
+    fn name(self) -> &'static str {
+        match self {
+            Self::Alpha => "alpha",
+            Self::Numeric => "numeric",
+            Self::Alphanumeric => "alphanumeric",
+            Self::Uppercase => "uppercase",
+            Self::Lowercase => "lowercase",
+            Self::Whitespace => "whitespace",
+        }
+    }
+
+    /// Whether a single character belongs to the class.
+    fn matches(self, c: char) -> bool {
+        match self {
+            Self::Alpha => c.is_alphabetic(),
+            Self::Numeric => c.is_numeric(),
+            Self::Alphanumeric => c.is_alphanumeric(),
+            Self::Uppercase => c.is_uppercase(),
+            Self::Lowercase => c.is_lowercase(),
+            Self::Whitespace => c.is_whitespace(),
+        }
+    }
+
+    /// Whether a grapheme cluster belongs to the class, judged by its leading
+    /// codepoint.
+    fn matches_cluster(self, cluster: &str) -> bool {
+        cluster.chars().next().is_some_and(|c| self.matches(c))
+    }
+}
