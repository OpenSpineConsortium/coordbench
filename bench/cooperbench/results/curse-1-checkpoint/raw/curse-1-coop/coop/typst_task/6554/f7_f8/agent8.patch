+/// Converts a grapheme cluster to the case named by `case`, which is one of
+/// `"upper"`, `"lower"` and `"title"`. Without a case, the cluster is kept.
+fn convert_case(grapheme: &str, case: Option<&str>) -> StrResult<Str> {
+    Ok(match case {
+        None => grapheme.into(),
+        Some("upper") => grapheme.to_uppercase().into(),
+        Some("lower") => grapheme.to_lowercase().into(),
+        Some("title") => {
+            let mut chars = grapheme.chars();
+            let mut title = EcoString::new();
+            if let Some(first) = chars.next() {
+                title.extend(first.to_uppercase());
+                title.push_str(&chars.as_str().to_lowercase());
+            }
+            title.into()
+        }
+        Some(other) => bail!("unknown case option \"{}\"", other),
+    })
+}
