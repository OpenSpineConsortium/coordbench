+def _palette_colors(im):
+    mode = im.im.getpalettemode()
+    step = len(mode)
+    data = im.im.getpalette(mode, mode)
+    count = im.getextrema()[1] + 1
+    return [tuple(data[i : i + step]) for i in range(0, count * step, step)]
+
+
+def _brightness(color):
+    red, green, blue = color[:3]
+    return 299 * red + 587 * green + 114 * blue
+
+
+@pytest.mark.parametrize("mode", ("RGB", "RGBA"))
+@pytest.mark.parametrize("sort_palette", ("brightness", "rgb"))
+def test_quantize_sort_palette(mode, sort_palette):
+    image = hopper().convert(mode)
+    plain = image.quantize(16)
+    converted = image.quantize(16, sort_palette=sort_palette)
+
+    assert_image(converted, "P", converted.size)
+
+    # the palette is ordered, and the image looks the same as without sorting
+    key = _brightness if sort_palette == "brightness" else None
+    colors = _palette_colors(converted)
+    assert colors == sorted(colors, key=key)
+    assert list(converted.convert(mode).getdata()) == list(
+        plain.convert(mode).getdata()
+    )
+
+    # the same colors, in a different order
+    assert sorted(colors) == sorted(_palette_colors(plain))
+    assert colors != _palette_colors(plain)
+
+
+def test_quantize_sort_palette_brightness_order():
+    image = Image.new("RGB", (3, 1))
+    image.putdata([(255, 0, 0), (0, 0, 255), (0, 255, 0)])
+
+    converted = image.quantize(3, sort_palette="brightness")
+
+    # blue is darkest, then red, then green
+    assert _palette_colors(converted) == [(0, 0, 255), (255, 0, 0), (0, 255, 0)]
+    assert list(converted.getdata()) == [1, 0, 2]
+
+
+def test_quantize_sort_palette_rgb_order():
+    image = Image.new("RGB", (3, 1))
+    image.putdata([(0, 255, 0), (255, 0, 0), (0, 0, 255)])
+
+    converted = image.quantize(3, sort_palette="rgb")
+
+    assert _palette_colors(converted) == [(0, 0, 255), (0, 255, 0), (255, 0, 0)]
+    assert list(converted.getdata()) == [1, 2, 0]
+
+
+def test_quantize_sort_palette_none():
+    image = hopper()
+    converted = image.quantize(16, sort_palette=None)
+
+    assert list(converted.getdata()) == list(image.quantize(16).getdata())
+    assert converted.getpalette() == image.quantize(16).getpalette()
+
+
+def test_quantize_sort_palette_invalid():
+    with pytest.raises(ValueError):
+        hopper().quantize(sort_palette="invalid")
+
+
+def test_quantize_sort_palette_with_palette():
+    image = hopper()
+    with Image.open("Tests/images/caption_6_33_22.png") as palette:
+        palette = palette.convert("P")
+
+    converted = image.quantize(palette=palette, sort_palette="brightness")
+
+    # a given palette is used as it is
+    assert converted.palette.palette == palette.palette.palette
+
+
