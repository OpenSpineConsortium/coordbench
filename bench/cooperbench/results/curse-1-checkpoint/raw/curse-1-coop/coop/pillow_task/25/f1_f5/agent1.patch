index c2e850c36..7afe789c6 100644
--- a/Tests/test_image.py
+++ b/Tests/test_image.py
@@ -258,6 +258,22 @@ class TestImage:
             assert im.readonly
             im.save(temp_file)
 
+    def test_readonly_save_frombuffer(self, tmp_path: Path) -> None:
+        # Saving an image from a buffer should not disconnect it from the buffer
+        buffer = bytearray([255])
+        im = Image.frombuffer("L", (1, 1), buffer, "raw", "L", 0, 1)
+        assert im.readonly
+        assert im.getpixel((0, 0)) == 255
+
+        buffer[0] = 128
+        assert im.getpixel((0, 0)) == 128
+
+        im.save(tmp_path / "temp.bmp")
+        assert im.readonly
+
+        buffer[0] = 64
+        assert im.getpixel((0, 0)) == 64
+
     def test_dump(self, tmp_path: Path) -> None:
         im = Image.new("L", (10, 10))
         im._dump(str(tmp_path / "temp_L.ppm"))
