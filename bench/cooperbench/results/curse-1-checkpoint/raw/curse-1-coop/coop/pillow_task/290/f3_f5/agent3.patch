diff --git a/Tests/test_image_quantize.py b/Tests/test_image_quantize.py
index bd9db362c..1929c8707 100644
--- a/Tests/test_image_quantize.py
+++ b/Tests/test_image_quantize.py
@@ -85,3 +85,146 @@ def test_transparent_colors_equal():
     converted = im.quantize()
     converted_px = converted.load()
     assert converted_px[0, 0] == converted_px[0, 1]
+
+
+def palette_colors(im):
+    """The colors of the palette that the pixels of im use, in palette order."""
+    channels = len(im.palette.mode)
+    data = im.palette.palette
+    used = im.getextrema()[1] + 1
+    return [tuple(data[i * channels : (i + 1) * channels]) for i in range(used)]
+
+
+def brightness(color):
+    return 299 * color[0] + 587 * color[1] + 114 * color[2]
+
+
+@pytest.mark.parametrize("method", (Image.MEDIANCUT, Image.FASTOCTREE))
+def test_sort_palette_brightness(method):
+    image = hopper()
+    unsorted = image.quantize(16, method)
+    converted = image.quantize(16, method, sort_palette="brightness")
+
+    assert_image(converted, "P", converted.size)
+    colors = palette_colors(converted)
+    assert len(colors) == 16
+    assert [brightness(c) for c in colors] == sorted(brightness(c) for c in colors)
+    # same colors as without sorting, and the pixels still show them
+    assert sorted(colors) == sorted(palette_colors(unsorted))
+    assert converted.convert("RGB").tobytes() == unsorted.convert("RGB").tobytes()
+
+
+@pytest.mark.parametrize("method", (Image.MEDIANCUT, Image.FASTOCTREE))
+def test_sort_palette_rgb(method):
+    image = hopper()
+    unsorted = image.quantize(16, method)
+    converted = image.quantize(16, method, sort_palette="rgb")
+
+    assert_image(converted, "P", converted.size)
+    colors = palette_colors(converted)
+    assert colors == sorted(colors)
+    assert sorted(colors) == sorted(palette_colors(unsorted))
+    assert converted.convert("RGB").tobytes() == unsorted.convert("RGB").tobytes()
+
+
+def test_sort_palette_none_keeps_order():
+    image = hopper()
+    default = image.quantize(16)
+    converted = image.quantize(16, sort_palette=None)
+
+    assert converted.tobytes() == default.tobytes()
+    assert converted.palette.palette == default.palette.palette
+
+
+def test_sort_palette_is_deterministic():
+    image = hopper()
+    first = image.quantize(32, sort_palette="brightness")
+    second = image.quantize(32, sort_palette="brightness")
+
+    assert first.tobytes() == second.tobytes()
+    assert first.palette.palette == second.palette.palette
+
+
+def test_sort_palette_brightness_ties_go_by_rgb():
+    # (10, 40, 10) and (11, 9, 167) are equally bright, so the lower RGB value
+    # comes first whichever of them the quantizer made first
+    image = Image.new("RGB", (4, 1))
+    image.putdata([(11, 9, 167), (10, 40, 10), (0, 0, 0), (11, 9, 167)])
+
+    converted = image.quantize(3, sort_palette="brightness")
+    assert palette_colors(converted) == [(0, 0, 0), (10, 40, 10), (11, 9, 167)]
+    assert list(converted.getdata()) == [2, 1, 0, 2]
+
+
+def test_sort_palette_only_used_colors():
+    image = Image.new("RGB", (3, 1))
+    image.putdata([(200, 0, 0), (0, 0, 200), (0, 200, 0)])
+    unsorted = image.quantize(256)
+    converted = image.quantize(256, sort_palette="brightness")
+
+    # the filler after the three colors that are used is left alone
+    assert converted.palette.palette[9:] == unsorted.palette.palette[9:]
+    assert palette_colors(converted) == [(0, 0, 200), (200, 0, 0), (0, 200, 0)]
+    assert converted.convert("RGB").tobytes() == image.tobytes()
+
+
+def test_sort_palette_rgba():
+    image = Image.new("RGBA", (4, 1))
+    image.putdata(
+        [(200, 0, 0, 255), (0, 0, 200, 128), (10, 10, 10, 0), (200, 0, 0, 255)]
+    )
+    unsorted = image.quantize(3, Image.FASTOCTREE)
+    converted = image.quantize(3, Image.FASTOCTREE, sort_palette="rgb")
+
+    assert converted.palette.mode == "RGBA"
+    colors = palette_colors(converted)
+    assert colors == sorted(colors)
+    assert converted.convert("RGBA").tobytes() == unsorted.convert("RGBA").tobytes()
+    assert converted.convert("RGBA").tobytes() == image.tobytes()
+
+
+def test_sort_palette_libimagequant():
+    image = hopper()
+    try:
+        converted = image.quantize(100, Image.LIBIMAGEQUANT, sort_palette="brightness")
+    except ValueError as ex:  # pragma: no cover
+        if "dependency" in str(ex).lower():
+            pytest.skip("libimagequant support not available")
+        else:
+            raise
+
+    colors = palette_colors(converted)
+    assert [brightness(c) for c in colors] == sorted(brightness(c) for c in colors)
+    assert_image_similar(converted.convert("RGB"), image, 15)
+
+
+def test_sort_palette_saved_file(tmp_path):
+    image = hopper()
+    converted = image.quantize(16, sort_palette="brightness")
+
+    out = str(tmp_path / "temp.png")
+    converted.save(out)
+    with Image.open(out) as reloaded:
+        assert reloaded.convert("RGB").tobytes() == converted.convert("RGB").tobytes()
+        colors = palette_colors(reloaded)
+    assert [brightness(c) for c in colors] == sorted(brightness(c) for c in colors)
+
+
+def test_sort_palette_invalid():
+    image = hopper()
+    for sort_palette in ("hue", "", "BRIGHTNESS", 1, True, ["rgb"]):
+        with pytest.raises(ValueError):
+            image.quantize(sort_palette=sort_palette)
+
+    # also when the palette of another image is used
+    with pytest.raises(ValueError):
+        image.quantize(palette=hopper("P"), sort_palette="hue")
+
+
+def test_sort_palette_ignored_with_palette():
+    image = hopper()
+    palette = hopper("P")
+
+    converted = image.quantize(palette=palette, sort_palette="brightness")
+    assert converted.palette.palette == palette.palette.palette
+    assert converted.tobytes() == image.quantize(palette=palette).tobytes()
