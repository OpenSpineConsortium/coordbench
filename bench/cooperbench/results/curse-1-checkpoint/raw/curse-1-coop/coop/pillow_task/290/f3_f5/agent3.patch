+
+    def _sort_quantized_palette(self, sort_palette):
+        """
+        Reorders the palette of an image that quantize() just made, and
+        remaps the pixels so that they still show the same colors.
 
+        :param sort_palette: ``"brightness"`` or ``"rgb"``, see :py:meth:`quantize`.
+        :returns: A new image
+        """
+        from . import ImagePalette
+
+        mode = self.palette.mode
+        channels = len(mode)
+        data = bytes(self.palette.palette)
+        colors = [tuple(data[i : i + channels]) for i in range(0, len(data), channels)]
+
+        # The palette has room for 256 colors, of which the image uses those up
+        # to its highest index. The rest is filler and stays where it is.
+        used = self.getextrema()[1] + 1
+
+        if sort_palette == "brightness":
+
+            def key(i):
+                r, g, b = colors[i][:3]
+                return (299 * r + 587 * g + 114 * b, colors[i])
+
+        else:
+
+            def key(i):
+                return colors[i]
+
+        order = sorted(range(used), key=key)
+
+        # order[new] is the old index of the color that moves to index new
+        lut = list(range(256))
+        for new, old in enumerate(order):
+            lut[old] = new
+        im = self.point(lut)
+
+        colors = [colors[old] for old in order] + colors[used:]
+        im.im.putpalette("RGB", b"".join(bytes(color[:3]) for color in colors))
+        if mode == "RGBA":
+            im.im.putpalettealphas(bytes(color[3] for color in colors))
+        im.palette = ImagePalette.ImagePalette(
+            mode, b"".join(bytes(color) for color in colors)
+        )
         return im
 
     def copy(self):
