+    def set_custom_decoding_criteria(self, custom_criteria: Optional[callable] = None):
+        """Set a custom criteria that decides which columns require decoding.
+
+        By default a column requires decoding when its feature type (or a feature type nested in it) has a
+        ``decode_example`` method and its ``decode`` attribute is on. With a custom criteria, the function is called
