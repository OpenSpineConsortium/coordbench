--- a/outlines/types/__init__.py
+++ b/outlines/types/__init__.py
@@ -68,3 +68,11 @@ email = Regex(
 isbn = Regex(
     r"(?:ISBN(?:-1[03])?:? )?(?=[0-9X]{10}$|(?=(?:[0-9]+[- ]){3})[- 0-9X]{13}$|97[89][0-9]{10}$|(?=(?:[0-9]+[- ]){4})[- 0-9]{17}$)(?:97[89][- ]?)?[0-9]{1,5}[- ]?[0-9]+[- ]?[0-9]+[- ]?[0-9X]"
 )
+
+# Matches a 16-digit credit card number written in one of three ways: with no
+# separator ("1234567890123456"), with a space between each group of four
+# digits ("1234 5678 9012 3456") or with a hyphen between each group of four
+# digits ("1234-5678-9012-3456"). The separator is either a space or a hyphen
+# and is never mixed, so "1234-5678 9012-3456" does not match. Only the format
+# is checked: the Luhn checksum and the issuer's prefix are not.
+credit_card = Regex(r"([0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{4}|[0-9]{4} [0-9]{4} [0-9]{4} [0-9]{4}|[0-9]{16})")
