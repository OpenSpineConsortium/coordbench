+    def _mark_corners(self) -> None:
+        """
+        Sets the top-left and bottom-right pixels to red, so that a saved
+        image can be recognised as processed. Red is converted to the
+        image's mode; P and PA images get the colour added to their palette.
+        """
+        if self.width < 1 or self.height < 1:
+            return
+
+        red: Any = (255, 0, 0)
+        if self.mode not in ("P", "PA", "RGB"):
+            red = new("RGB", (1, 1), red).convert(self.mode).getpixel((0, 0))
+        self.putpixel((0, 0), red)
+        self.putpixel((self.width - 1, self.height - 1), red)
+
