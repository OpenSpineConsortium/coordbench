+    def test_readonly_save_other_filename(self, tmp_path: Path) -> None:
+        temp_file = tmp_path / "temp.bmp"
+        shutil.copy("Tests/images/rgb32bf-rgba.bmp", temp_file)
+
+        with Image.open(temp_file) as im:
+            assert im.readonly
+            im.save(tmp_path / "other.bmp")
+            assert im.readonly
+
+    def test_frombuffer_save(self, tmp_path: Path) -> None:
+        buffer = bytearray(b"\xff")
+        im = Image.frombuffer("L", (1, 1), buffer, "raw", "L", 0, 1)
+        assert im.readonly
+        assert im.getdata()[0] == 255
+
+        buffer[0] = 128
+        assert im.getdata()[0] == 128
+
+        im.save(tmp_path / "temp.bmp")
+        assert im.readonly
+
+        # The image still reflects changes to the buffer after saving
+        buffer[0] = 64
+        assert im.getdata()[0] == 64
+
