+class TestMarkCorners:
+    @pytest.mark.parametrize("ext", (".png", ".bmp", ".tif", ".gif", ".ppm"))
+    def test_rgb(self, tmp_path: Path, ext: str) -> None:
+        im = Image.new("RGB", (8, 6), "white")
+        out = tmp_path / f"marked{ext}"
+
+        im.save(out, mark_corners=True)
+
+        with Image.open(out) as reloaded:
+            reloaded = reloaded.convert("RGB")
+            assert reloaded.getpixel((0, 0)) == (255, 0, 0)
+            assert reloaded.getpixel((7, 5)) == (255, 0, 0)
+            # Nothing else is touched
+            assert reloaded.getpixel((7, 0)) == (255, 255, 255)
+            assert reloaded.getpixel((0, 5)) == (255, 255, 255)
+            assert reloaded.getpixel((3, 3)) == (255, 255, 255)
+
+    def test_default_leaves_image_alone(self, tmp_path: Path) -> None:
+        im = Image.new("RGB", (4, 4), "white")
+        out = tmp_path / "plain.png"
+
+        im.save(out)
+        im.save(tmp_path / "false.png", mark_corners=False)
+
+        assert im.getpixel((0, 0)) == (255, 255, 255)
+        with Image.open(out) as reloaded:
+            assert reloaded.getpixel((0, 0)) == (255, 255, 255)
+            assert reloaded.getpixel((3, 3)) == (255, 255, 255)
+        with Image.open(tmp_path / "false.png") as reloaded:
+            assert reloaded.getpixel((0, 0)) == (255, 255, 255)
+
+    def test_file_object_and_format(self) -> None:
+        im = Image.new("RGB", (3, 3), "blue")
+        b = io.BytesIO()
+
+        im.save(b, "PNG", mark_corners=True)
+
+        b.seek(0)
+        with Image.open(b) as reloaded:
+            assert reloaded.getpixel((0, 0)) == (255, 0, 0)
+            assert reloaded.getpixel((2, 2)) == (255, 0, 0)
+            assert reloaded.getpixel((1, 1)) == (0, 0, 255)
+
+    def test_option_is_not_passed_to_the_writer(self) -> None:
+        im = Image.new("RGB", (3, 3))
+
+        im.save(io.BytesIO(), "PNG", mark_corners=True)
+
+        assert not hasattr(im, "encoderinfo")
+
+    def test_one_pixel(self, tmp_path: Path) -> None:
+        im = Image.new("RGB", (1, 1), "white")
+        out = tmp_path / "one.png"
+
+        im.save(out, mark_corners=True)
+
+        with Image.open(out) as reloaded:
+            assert reloaded.getpixel((0, 0)) == (255, 0, 0)
+
+    def test_empty_image(self) -> None:
+        # An empty image has no corners to mark, and cannot be saved anyway
+        im = Image.new("RGB", (0, 0))
+
+        im._mark_corners()
+
+    @pytest.mark.parametrize(
+        ("mode", "expected"),
+        (
+            ("L", 76),
+            ("LA", (76, 255)),
+            ("RGBA", (255, 0, 0, 255)),
+            ("CMYK", (0, 255, 255, 0)),
+        ),
+    )
+    def test_modes(self, tmp_path: Path, mode: str, expected: Any) -> None:
+        im = Image.new(mode, (5, 4))
+        out = tmp_path / ("modes.tif" if mode == "CMYK" else "modes.png")
+
+        im.save(out, mark_corners=True)
+
+        with Image.open(out) as reloaded:
+            assert reloaded.getpixel((0, 0)) == expected
+            assert reloaded.getpixel((4, 3)) == expected
+
+    def test_palette_image_keeps_its_palette(self, tmp_path: Path) -> None:
+        im = Image.new("P", (3, 3))
+        im.putpalette((0, 0, 0, 0, 255, 0))
+        out = tmp_path / "palette.png"
+
+        im.save(out, mark_corners=True)
+
+        with Image.open(out) as reloaded:
+            rgb = reloaded.convert("RGB")
+            assert rgb.getpixel((0, 0)) == (255, 0, 0)
+            assert rgb.getpixel((2, 2)) == (255, 0, 0)
+            assert rgb.getpixel((1, 1)) == (0, 0, 0)
+
+    def test_marks_the_saved_image(self) -> None:
+        im = Image.new("RGB", (3, 3), "white")
+
+        im.save(io.BytesIO(), "PNG", mark_corners=True)
+
+        assert im.getpixel((0, 0)) == (255, 0, 0)
+        assert im.getpixel((2, 2)) == (255, 0, 0)
+
+    def test_file_backed_image(self, tmp_path: Path) -> None:
+        out = tmp_path / "marked.png"
+
+        with Image.open("Tests/images/hopper.png") as im:
+            im.save(out, mark_corners=True)
+
+        with Image.open(out) as reloaded:
+            assert reloaded.getpixel((0, 0)) == (255, 0, 0)
+            assert reloaded.getpixel((127, 127)) == (255, 0, 0)
+            with Image.open("Tests/images/hopper.png") as original:
+                assert reloaded.getpixel((64, 64)) == original.getpixel((64, 64))
