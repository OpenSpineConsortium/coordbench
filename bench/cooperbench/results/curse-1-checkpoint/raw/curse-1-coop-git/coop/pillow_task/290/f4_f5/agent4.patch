+
+
+def test_lightness_factor_keeps_alpha():
+    image = Image.new("RGBA", (2, 1), (100, 120, 140, 50))
+    image.putpixel((1, 0), (200, 40, 20, 255))
+    plain = image.quantize()
+
+    converted = image.quantize(lightness_factor=1.25)
+
+    assert converted.convert("RGBA").getchannel("A").tobytes() == (
+        plain.convert("RGBA").getchannel("A").tobytes()
+    )
+    assert converted.convert("RGBA").getpixel((0, 0)) == (
+        _scaled(100, 1.25),
+        _scaled(120, 1.25),
+        _scaled(140, 1.25),
+        50,
+    )
+    assert converted.convert("RGBA").getpixel((1, 0)) == (
+        _scaled(200, 1.25),
+        _scaled(40, 1.25),
+        _scaled(20, 1.25),
+        255,
