+
+def test_lightness_factor_with_palette_keeps_its_length():
+    palette = Image.new("P", (1, 1))
+    palette.putpalette((10, 20, 30, 200, 100, 50))
+
+    converted = Image.new("RGB", (1, 1), (10, 20, 30)).quantize(
+        palette=palette, lightness_factor=2
+    )
+
+    assert len(converted.palette.palette) == len(palette.palette.palette)
+    assert list(converted.palette.palette) == [20, 40, 60, 255, 200, 100]
+
+
+@pytest.mark.parametrize(
+    "method", (Image.MEDIANCUT, Image.MAXCOVERAGE, Image.FASTOCTREE)
+)
+def test_lightness_factor_methods(method):
