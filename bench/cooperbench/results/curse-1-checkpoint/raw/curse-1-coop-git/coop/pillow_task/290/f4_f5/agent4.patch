+
+def test_lightness_factor_with_palette():
+    image = hopper()
+    with Image.open("Tests/images/caption_6_33_22.png") as palette:
+        palette = palette.convert("P")
+    palette_before = palette.getpalette()
+    plain = image.quantize(dither=0, palette=palette)
+
+    converted = image.quantize(dither=0, palette=palette, lightness_factor=1.5)
+
+    assert converted.getpalette() == [_scaled(v, 1.5) for v in plain.getpalette()]
+    assert converted.tobytes() == plain.tobytes()
+    # the palette image given is left as it was
+    assert palette.getpalette() == palette_before
