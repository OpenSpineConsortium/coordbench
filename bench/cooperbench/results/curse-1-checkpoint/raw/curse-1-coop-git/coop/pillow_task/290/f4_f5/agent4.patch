+def _mean_square_error(quantized, image):
+    a_bytes = quantized.convert(image.mode).tobytes()
+    b_bytes = image.tobytes()
+    return sum((x - y) ** 2 for x, y in zip(a_bytes, b_bytes)) / len(a_bytes)
+
+
+def _color_count(image):
+    return len(image.getcolors(256))
+
+
+def test_quantize_error_threshold_none_is_default():
+    image = hopper()
+    converted = image.quantize(64, error_threshold=None)
+    assert converted.tobytes() == image.quantize(64).tobytes()
+
+
+def test_quantize_error_threshold_uses_fewer_colors():
+    image = hopper()
+    converted = image.quantize(256, error_threshold=500)
+
+    assert_image(converted, "P", converted.size)
+    assert _color_count(converted) < _color_count(image.quantize(256))
+    assert _mean_square_error(converted, image) <= 500
+
+
+def test_quantize_error_threshold_unreachable_uses_all_colors():
+    image = hopper()
+    expected = image.quantize(32)
+
+    for threshold in (0, 0.0, -1):
+        converted = image.quantize(32, error_threshold=threshold)
+        assert converted.tobytes() == expected.tobytes()
+        assert converted.getpalette() == expected.getpalette()
+
+
+def test_quantize_error_threshold_tighter_means_more_colors():
+    image = hopper()
+    counts = [
+        _color_count(image.quantize(256, error_threshold=threshold))
+        for threshold in (2000, 500, 100, 20)
+    ]
+    assert counts == sorted(counts)
+    assert counts[0] < counts[-1]
+
+
+def test_quantize_error_threshold_is_minimal():
+    image = hopper()
+    threshold = 200
+    converted = image.quantize(256, error_threshold=threshold)
+    count = _color_count(converted)
+
+    assert _mean_square_error(converted, image) <= threshold
+    assert count > 1
+    # One color fewer is over the threshold, otherwise the search stopped early.
+    assert _mean_square_error(image.quantize(count - 1), image) > threshold
+
+
+def test_quantize_error_threshold_flat_image():
+    image = Image.new("RGB", (8, 8), (10, 120, 200))
+    converted = image.quantize(256, error_threshold=1)
+
+    assert _color_count(converted) == 1
+    assert converted.convert("RGB").getpixel((0, 0)) == (10, 120, 200)
+
+
+@pytest.mark.parametrize(
