+def _scaled(value, factor):
+    return min(255, int(value * factor))
+
+
+def test_lightness_factor_default_changes_nothing():
+    image = hopper()
+    plain = image.quantize()
+
+    assert image.quantize(lightness_factor=1.0).getpalette() == plain.getpalette()
+    assert image.quantize(lightness_factor=1).tobytes() == plain.tobytes()
+
+
+@pytest.mark.parametrize("factor", (0.5, 0.9, 1.1, 1.5, 2.0))
+def test_lightness_factor_scales_palette(factor):
+    image = hopper()
+    plain = image.quantize()
+
+    converted = image.quantize(lightness_factor=factor)
+
+    assert_image(converted, "P", converted.size)
+    assert converted.getpalette() == [_scaled(v, factor) for v in plain.getpalette()]
+    assert list(converted.palette.palette) == converted.getpalette()
+    # the pixels still point at the same palette entries
+    assert converted.tobytes() == plain.tobytes()
+
+
+def test_lightness_factor_brighter_and_darker():
+    image = hopper()
+    plain = image.quantize().convert("L")
+
+    brighter = image.quantize(lightness_factor=1.2).convert("L")
+    darker = image.quantize(lightness_factor=0.8).convert("L")
+
+    assert sum(brighter.getdata()) > sum(plain.getdata()) > sum(darker.getdata())
+
+
+def test_lightness_factor_clamps_to_valid_range():
+    image = Image.new("RGB", (2, 1))
+    image.putpixel((0, 0), (10, 100, 200))
+    image.putpixel((1, 0), (0, 0, 0))
+
+    very_bright = image.quantize(2, lightness_factor=1000)
+    colors = {very_bright.convert("RGB").getpixel((x, 0)) for x in range(2)}
+    assert colors == {(255, 255, 255), (0, 0, 0)}
+    assert max(very_bright.getpalette()) == 255
+
+    very_dark = image.quantize(2, lightness_factor=0.0001)
+    assert set(very_dark.convert("RGB").getdata()) == {(0, 0, 0)}
+
+
+@pytest.mark.parametrize("factor", (0, -1, -0.5, float("-inf"), float("nan")))
+def test_lightness_factor_must_be_positive(factor):
+    image = hopper()
+
+    with pytest.raises(ValueError):
