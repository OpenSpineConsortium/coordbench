+def _lighten_palette(im, lightness_factor):
+    """
+    Multiply the red, green and blue values of every palette entry of the "P"
+    image ``im`` by ``lightness_factor``, in place.
+
+    Values are truncated to integers and limited to 255. Alpha values, if the
+    palette has them, are left alone. Only the palette changes, never the pixel
+    data, so the image gains no new colors.
+    """
+    from . import ImagePalette
+
+    # A zero stays zero even for an infinite factor, where 0 * inf is not a number.
+    table = bytes(
+        0 if value == 0 else int(min(value * lightness_factor, 255.0))
+        for value in range(256)
+    )
+
+    mode = im.im.getpalettemode()
+    step = len(mode)
+    data = im.im.getpalette(mode, mode)
+    scaled = bytearray(data)
+    for channel in range(3):
+        scaled[channel::step] = data[channel::step].translate(table)
+
+    if mode == "RGBA":
+        rgb = bytearray(len(scaled) // 4 * 3)
+        for channel in range(3):
+            rgb[channel::3] = scaled[channel::4]
+        im.im.putpalette("RGB", bytes(rgb))
+        im.im.putpalettealphas(bytes(scaled[3::4]))
+    else:
+        im.im.putpalette("RGB", bytes(scaled))
+
+    # The palette object keeps the number of entries it had.
+    old = im.palette
+    if old is not None and old.palette:
+        scaled = scaled[: len(old.palette) // len(old.mode) * step]
+    im.palette = ImagePalette.ImagePalette(mode, bytes(scaled))
+
+
