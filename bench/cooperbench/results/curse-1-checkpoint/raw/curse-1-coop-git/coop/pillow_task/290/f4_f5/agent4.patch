+
+    converted = image.quantize(256, error_threshold=500)
+
+    assert converted.palette.mode == "RGBA"
+    assert _color_count(converted) < 256
+    assert _mean_square_error(converted, image) <= 500
+
+
+def test_quantize_error_threshold_grayscale():
+    image = hopper("L")
+    converted = image.quantize(256, error_threshold=100)
+
+    assert _color_count(converted) < 256
+    assert _mean_square_error(converted, image) <= 100
+
+
+def test_quantize_error_threshold_ignored_with_palette():
+    image = hopper()
+    palette = hopper("P")
+
+    converted = image.quantize(palette=palette, error_threshold=0)
+    expected = image.quantize(palette=palette)
+
+    assert converted.tobytes() == expected.tobytes()
