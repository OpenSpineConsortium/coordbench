+    with pytest.raises(ValueError):
+        image.quantize(palette=hopper("P"), lightness_factor=factor)
+
+
+def test_lightness_factor_no_upper_bound():
+    converted = hopper().quantize(lightness_factor=float("inf"))
+
+    assert set(converted.getpalette()) <= {0, 255}
+
+
+def test_lightness_factor_adds_no_colors():
+    image = hopper()
+    plain = image.quantize(16)
+
+    converted = image.quantize(16, lightness_factor=1.3)
+
+    assert len(converted.getcolors()) == len(plain.getcolors())
