+        if mode == "RGBA":
+            im.im.putpalettealphas(bytes(new_data[3::4]))
+        palette_size = len(self.palette.palette)
+        im.palette = ImagePalette.ImagePalette(mode, bytes(new_data[:palette_size]))
         return im
 
