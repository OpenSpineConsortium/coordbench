+    def _sorted_palette_image(self, sort_palette, count):
+        """
+        Orders the first ``count`` entries of the palette by the method
+        ``sort_palette`` and rewrites the pixels to follow their colors, so
+        that the image looks the same. Entries after ``count`` stay where they
+        are.
+
+        :param sort_palette: A key of ``_PALETTE_SORT_KEYS``.
+        :param count: The number of palette entries to order.
+        :returns: A new "P" image, or this one when the order does not change.
+        """
+        from . import ImagePalette
+
+        mode = self.im.getpalettemode()
+        size = len(mode)
+        data = bytes(self.im.getpalette(mode, mode))
+        colors_data = [data[i * size : (i + 1) * size] for i in range(count)]
+        colors = [tuple(entry) for entry in colors_data]
+
+        key = _PALETTE_SORT_KEYS[sort_palette]
+        order = sorted(range(count), key=lambda i: key(colors[i]))
+        if order == list(range(count)):
+            return self
+
+        # order[new] is the old index of the color now at position new
+        lut = list(range(256))
+        new_data = bytearray(data)
+        for new, old in enumerate(order):
+            lut[old] = new
+            new_data[new * size : (new + 1) * size] = colors_data[old]
+
+        im = self.point(lut)
+        # The core palette keeps RGB apart from the alpha of an RGBA palette
+        rgb = bytes(b for i, b in enumerate(new_data) if size == 3 or i % 4 != 3)
