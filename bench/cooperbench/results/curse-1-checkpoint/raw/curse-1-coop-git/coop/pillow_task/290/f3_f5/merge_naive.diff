+    def _sort_palette(self, sort_palette, size=None):
+        """
+        Returns a copy of this "P" image whose palette is ordered by
+        ``sort_palette`` (``"brightness"`` or ``"rgb"``, see :py:meth:`quantize`),
+        with every pixel remapped so that the colors of the image do not change.
+
+        :param size: The number of leading palette entries that are sorted. By
+           default the entries that the image uses are sorted and come first, and
+           the unused ones follow in their old order, since they are padding.
+        """
+        from . import ImagePalette
+
+        mode = self.im.getpalettemode()
+        step = len(mode)
+        data = self.im.getpalette(mode, mode)
+        entries = [bytes(data[i : i + step]) for i in range(0, len(data), step)]
+
+        if sort_palette == "brightness":
+            # the weights that convert("L") uses
+            def key(entry):
+                return entry[0] * 299 + entry[1] * 587 + entry[2] * 114
+
+        else:
+
+            def key(entry):
+                return tuple(entry)
+
+        if size is None:
+            candidates = [i for i, count in enumerate(self.histogram()) if count]
+        else:
+            candidates = range(min(size, len(entries)))
+        order = sorted(candidates, key=lambda i: key(entries[i]))
+        sorted_indexes = set(order)
+        order += [i for i in range(len(entries)) if i not in sorted_indexes]
+
+        # new_index[old] is where the color that was at old now is
+        new_index = list(range(256))
+        for new, old in enumerate(order):
+            new_index[old] = new
+
+        sorted_im = self.point(new_index)
+        # the core takes the colors as RGB, and the alpha of each separately
+        sorted_im.im.putpalette("RGB", b"".join(entries[i][:3] for i in order))
+        if mode == "RGBA":
+            sorted_im.im.putpalettealphas(bytes(entries[i][3] for i in order))
+        sorted_im.palette = ImagePalette.ImagePalette(
+            mode, sorted_im.im.getpalette(mode, mode)
+        )
+        return sorted_im
+
