+/// A built-in class of characters that `first` and `last` can search for.
+#[derive(Debug, Copy, Clone, Eq, PartialEq)]
+enum GraphemeClass {
+    Alpha,
+    Numeric,
+    Alphanumeric,
+    Uppercase,
+    Lowercase,
+    Whitespace,
+}
+
+impl GraphemeClass {
+    /// Looks up a class by the name the user wrote.
+    fn parse(name: &str) -> StrResult<Self> {
+        Ok(match name {
+            "alpha" => Self::Alpha,
+            "numeric" => Self::Numeric,
+            "alphanumeric" => Self::Alphanumeric,
+            "uppercase" => Self::Uppercase,
+            "lowercase" => Self::Lowercase,
+            "whitespace" => Self::Whitespace,
+            _ => bail!(
+                "unknown pattern \"{}\" (expected \"alpha\", \"numeric\", \
+                 \"alphanumeric\", \"uppercase\", \"lowercase\" or \"whitespace\")",
+                name
+            ),
+        })
+    }
+
+    /// Whether a character belongs to the class.
+    fn matches(self, c: char) -> bool {
+        match self {
+            Self::Alpha => c.is_alphabetic(),
+            Self::Numeric => c.is_numeric(),
+            Self::Alphanumeric => c.is_alphanumeric(),
+            Self::Uppercase => c.is_uppercase(),
+            Self::Lowercase => c.is_lowercase(),
+            Self::Whitespace => c.is_whitespace(),
+        }
+    }
+}
+
+/// Picks the first (or, from the back, the last) grapheme cluster of a string,
+/// restricted to those whose first character is in the named class, if any.
+///
+/// The emptiness check comes before the pattern is looked at, so that an empty
+/// string always reports that it is empty.
+fn pick_grapheme<'a>(
+    text: &'a str,
+    pattern: Option<&str>,
+    from_back: bool,
+) -> StrResult<&'a str> {
+    if text.is_empty() {
+        return Err(string_is_empty());
+    }
+
+    let mut graphemes = text.graphemes(true);
+    let Some(name) = pattern else {
+        let found = if from_back { graphemes.next_back() } else { graphemes.next() };
+        return found.ok_or_else(string_is_empty);
+    };
+
+    let class = GraphemeClass::parse(name)?;
+    let is_match = |g: &&str| g.chars().next().is_some_and(|c| class.matches(c));
+    let found = if from_back {
+        graphemes.rev().find(is_match)
+    } else {
+        graphemes.find(is_match)
+    };
+    found.ok_or_else(|| eco_format!("no character matches pattern \"{}\"", name))
+}
