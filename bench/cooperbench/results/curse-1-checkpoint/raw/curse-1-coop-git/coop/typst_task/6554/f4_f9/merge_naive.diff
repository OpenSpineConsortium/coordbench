+/// Checks that the `repeat` argument of `first` and `last` is at least one.
+fn check_repeat(repeat: usize) -> StrResult<()> {
+    if repeat == 0 {
+        bail!("repeat must be at least 1");
+    }
+    Ok(())
+}
+
+/// The error when `first` or `last` is asked for more grapheme clusters than
+/// the string has. An empty string keeps the plain "string is empty" error.
+#[cold]
+fn too_few_characters(text: &str, requested: usize) -> EcoString {
+    let available = text.graphemes(true).count();
+    if available == 0 {
+        return string_is_empty();
+    }
+    eco_format!(
+        "not enough characters (requested {requested}, but string only has {available})"
+    )
+}
