+    def _build_command(self, editor: str, filename: str) -> str:
+        """Build the shell command line that opens ``filename``.
+
+        Without ``escape_shell`` the editor is used as written, since it
+        is often a command line of its own such as ``code --wait``, and
+        the filename is wrapped in double quotes. With it, every word of
+        the editor and the filename are quoted for the shell, so a
+        semicolon, pipe or backtick in either is taken literally and
+        never starts another command.
+        """
+        if not self.escape_shell:
+            return f'{editor} "{filename}"'
+
+        import shlex
+
+        try:
+            words = shlex.split(editor)
+        except ValueError:
+            # An unbalanced quote: keep the whole string as one word.
+            words = [editor]
+
+        quoted = " ".join(shlex.quote(word) for word in words)
+        return f"{quoted} {shlex.quote(filename)}"
+
