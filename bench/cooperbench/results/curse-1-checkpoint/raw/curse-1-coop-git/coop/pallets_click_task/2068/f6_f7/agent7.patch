+# Process priority levels accepted by ``Editor(process_priority=...)``,
+# mapped to the Unix nice value and to the Windows priority class that
+# stand for them. The Windows values are the documented flags written out
+# as numbers, since the ``subprocess`` constants only exist on Windows.
+_UNIX_NICE_VALUES = {
+    "low": 19,
+    "below_normal": 10,
+    "normal": 0,
+    "above_normal": -5,
+    "high": -10,
+}
+_WIN_PRIORITY_CLASSES = {
+    "low": 0x00000040,  # IDLE_PRIORITY_CLASS
+    "below_normal": 0x00004000,  # BELOW_NORMAL_PRIORITY_CLASS
+    "normal": 0x00000020,  # NORMAL_PRIORITY_CLASS
+    "above_normal": 0x00008000,  # ABOVE_NORMAL_PRIORITY_CLASS
+    "high": 0x00000080,  # HIGH_PRIORITY_CLASS
+}
+
+
+def _set_unix_priority(nice_value: int) -> None:
+    """Give the calling process the nice value ``nice_value``. Runs in the
+    child between ``fork`` and ``exec``, so it must never raise: a failure
+    (such as asking for a higher priority without the privilege for it)
+    leaves the editor running at the priority it inherited.
+    """
+    try:
+        if hasattr(os, "setpriority"):
+            os.setpriority(os.PRIO_PROCESS, 0, nice_value)
+        else:
+            os.nice(nice_value - os.nice(0))
+    except Exception:
+        pass
+
