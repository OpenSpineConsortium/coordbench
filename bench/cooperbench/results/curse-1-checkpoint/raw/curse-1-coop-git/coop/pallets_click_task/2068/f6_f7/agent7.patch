+        # An editor may carry arguments ("code --wait"), so each word is
+        # quoted on its own. A value that is itself an executable, such as a
+        # path with a space in it, is one word.
+        if os.path.isfile(editor) and os.access(editor, os.X_OK):
+            words = [editor]
+        else:
+            try:
+                words = shlex.split(editor)
+            except ValueError:
+                words = [editor]
+
+        quoted = [shlex.quote(word) for word in words]
+        quoted.append(shlex.quote(filename))
+        return " ".join(quoted)
