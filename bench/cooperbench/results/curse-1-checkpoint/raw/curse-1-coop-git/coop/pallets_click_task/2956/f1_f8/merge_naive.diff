+    _SMART_COMPLETERS: t.ClassVar[tuple[tuple[tuple[str, ...], str], ...]] = (
+        (("user",), "_complete_usernames"),
+        (("branch",), "_complete_git_branches"),
+        (("file", "path"), "_complete_files"),
