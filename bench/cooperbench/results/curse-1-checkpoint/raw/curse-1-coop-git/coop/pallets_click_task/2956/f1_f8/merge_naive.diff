+    def _record_option_change(
+        self, name: str, value: t.Any, source: ParameterSource | None
+    ) -> None:
+        """Append a value of a parameter to its history, when tracking
+        is enabled. An entry after the first also keeps the value it
+        replaced as ``previous_value``.
+
+        :param name: The name of the parameter.
+        :param value: The value the parameter now has.
+        :param source: Where the value came from.
+        """
+        if not self._track_changes:
+            return
+
+        history = self._option_history.setdefault(name, [])
+        entry: dict[str, t.Any] = {
+            "value": value,
+            "source": source,
+            "timestamp": datetime.now().timestamp(),
+        }
+
+        if history:
+            entry["previous_value"] = history[-1]["value"]
+
+        history.append(entry)
+
+    def _resolve_option_name(self, name: str) -> str:
+        """Turn an option flag such as ``--count`` or ``-c`` into the
+        name of the parameter that declares it. Anything that is not a
+        known flag is returned as it was given.
+        """
+        if name in self._option_history or not name.startswith("-"):
+            return name
+
+        for param in self.command.get_params(self):
+            if isinstance(param, Option) and name in (
+                *param.opts,
+                *param.secondary_opts,
+            ):
+                return param.name or name
+
+        return name
+
+    def get_option_history(self, name: str) -> list[dict[str, t.Any]] | None:
+        """Get the history of the values an option has had, which lets
+        you see where the current value came from. Tracking is enabled
+        with ``track_changes=True`` on the command.
+
+        Each entry is a dict with the ``value``, the ``source`` as a
+        :class:`~click.core.ParameterSource`, and the ``timestamp`` in
+        seconds since the epoch, as :func:`time.time` gives it. An entry
+        that replaced an earlier value also has it as ``previous_value``.
+
+        :param name: The name of the parameter, such as ``count``, or
+            one of the option's flags, such as ``--count`` or ``-c``.
+        :return: The entries, oldest first, which is an empty list if
+            the option is unknown or has no history, or ``None`` if the
+            command does not track changes.
+
+        .. versionadded:: 8.2.2
+        """
+        if not self._track_changes:
+            return None
+
+        return list(self._option_history.get(self._resolve_option_name(name), ()))
+
 
