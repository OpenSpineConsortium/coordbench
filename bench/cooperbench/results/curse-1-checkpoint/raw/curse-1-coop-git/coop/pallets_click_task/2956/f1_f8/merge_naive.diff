+
+    def _smart_completer(self) -> cabc.Callable[[str], list[CompletionItem]] | None:
+        """Find the strategy that fits this option's name, or ``None``."""
+        decls = [self.name or "", *self.opts]
+        words = " ".join(decls).lower().replace("-", " ").replace("_", " ").split()
+
+        for keywords, method_name in self._SMART_COMPLETERS:
+            if any(word.startswith(keywords) for word in words):
+                return t.cast(
+                    "cabc.Callable[[str], list[CompletionItem]]",
+                    getattr(self, method_name),
+                )
+
+        return None
+
+    def _smart_complete(self, ctx: Context, incomplete: str) -> list[CompletionItem]:
+        """Complete the option's value from its name and the environment
+        when ``auto_complete`` is enabled.
+
+        The name picks the strategy: user names for ``user``, git
+        branches for ``branch``, paths for ``file`` and ``path``,
+        directories for ``dir`` and environment variable names for
+        ``env``. A name that fits none falls back to the completion of
+        the option's type, which is what happens without
+        ``auto_complete``. Returns an empty list when ``auto_complete``
+        is off.
+
+        :param ctx: Invocation context for this command.
+        :param incomplete: Value being completed. May be empty.
+        """
+        if not self.auto_complete:
+            return []
+
+        completer = self._smart_completer()
+
+        if completer is None:
+            return self.type.shell_complete(ctx, self, incomplete)
+
+        return completer(incomplete)
+
+    def _complete_usernames(self, incomplete: str) -> list[CompletionItem]:
+        from click.shell_completion import CompletionItem
+
+        try:
+            import pwd
+
+            names = {entry.pw_name for entry in pwd.getpwall()}
+        except (ImportError, KeyError):
+            # No password database, as on Windows: offer the current user.
+            import getpass
+
+            try:
+                names = {getpass.getuser()}
+            except (OSError, KeyError, ImportError):
+                return []
+
+        return [CompletionItem(n) for n in sorted(names) if n.startswith(incomplete)]
+
+    def _complete_git_branches(self, incomplete: str) -> list[CompletionItem]:
+        import subprocess
+
+        from click.shell_completion import CompletionItem
+
+        try:
+            result = subprocess.run(
+                ["git", "branch", "-a", "--format=%(refname:short)"],
+                capture_output=True,
+                text=True,
+                check=True,
+                timeout=5,
+            )
+        except (OSError, subprocess.SubprocessError):
+            # Git is missing, or the working directory is not a repository.
+            return []
+
+        names: dict[str, None] = {}
+
+        for line in result.stdout.splitlines():
+            name = line.strip()
+
+            # A detached HEAD is listed as "(HEAD detached at ...)".
+            if name and not name.startswith("(") and name.startswith(incomplete):
+                names[name] = None
+
+        return [CompletionItem(name) for name in names]
+
+    def _complete_files(self, incomplete: str) -> list[CompletionItem]:
+        from click.shell_completion import CompletionItem
+
+        return [CompletionItem(incomplete, type="file")]
+
+    def _complete_directories(self, incomplete: str) -> list[CompletionItem]:
+        from click.shell_completion import CompletionItem
+
+        return [CompletionItem(incomplete, type="dir")]
+
