+    def set_custom_decoding_criteria(self, custom_criteria: Optional[callable] = None):
+        """Set a custom rule that decides which columns require decoding.
+
+        The rule is a function that takes a feature and returns whether it requires decoding. It is asked about
+        each column's feature, and then about the features nested in it. A :obj:`bool` it returns replaces the default
+        rule for that feature (whether it has a ``decode_example`` method and its ``decode`` attribute is on);
+        returning ``None`` leaves the feature to the default rule. The decoding flags of all the columns are
+        recomputed at once, and columns set afterwards follow the same rule. The rule is kept by :meth:`copy`
+        and by pickling.
+
+        Args:
+            custom_criteria (:obj:`callable`, optional): The rule. ``None`` removes any custom rule and restores the
+                default behavior.
+
+        Example::
+
+            >>> from datasets import Features, Image, Value
+            >>> features = Features({"image": Image(), "text": Value("string")})
+            >>> features.set_custom_decoding_criteria(lambda feature: False if isinstance(feature, Image) else None)
+            >>> features._column_requires_decoding
+            {'image': False, 'text': False}
+            >>> features.set_custom_decoding_criteria(None)
+            >>> features._column_requires_decoding
+            {'image': True, 'text': False}
+        """
+        if custom_criteria is not None and not callable(custom_criteria):
+            raise TypeError(f"custom_criteria must be callable or None, got {type(custom_criteria).__name__}")
+        self._custom_decoding_criteria = custom_criteria
+        self._column_requires_decoding = {
+            col: require_decoding(feature, custom_criteria=custom_criteria) for col, feature in self.items()
+        }
 
