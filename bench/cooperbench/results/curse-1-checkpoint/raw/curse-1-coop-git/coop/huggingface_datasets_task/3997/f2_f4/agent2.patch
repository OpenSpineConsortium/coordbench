+    def update(self, iterable=None, **kwds):
+        """Update the features, adding new columns and replacing the ones that already exist.
+
+        On top of what :meth:`dict.update` accepts, ``iterable`` can be:
+
+        - a JSON string (or bytes) holding either an object mapping column names to features, or a list of such
+          objects. The features use the serialized form of :meth:`Features.to_dict`, with a ``"_type"`` key
+          (e.g. ``'{"a": {"dtype": "int32", "id": null, "_type": "Value"}}'``).
+        - a list (or any iterable) of mappings or JSON strings, to apply several updates in one batch. The updates
+          are applied in order, so a later one wins over an earlier one for the same column.
+        - a mapping or an iterable of ``(column_name, feature)`` pairs, as before.
+
+        Values given in their serialized form (a dict with a ``"_type"`` key) are turned into feature objects;
+        any other value is stored as it is. Keyword arguments are applied last.
+
+        The whole batch is parsed before any column is written, so an invalid input raises an error and leaves
+        the features unchanged. Every column is written with ``self[column_name] = feature``, which keeps the
+        record of which columns need decoding in sync.
+
+        Args:
+            iterable: The update(s) to apply, see above.
+            **kwds: Columns to add or replace, as ``column_name=feature``.
+
+        Raises:
+            ValueError: If a JSON string is invalid, does not hold an object or a list of objects, or if an item
+                cannot be read as a column name with its feature.
+        """
+        updates = []
+        if iterable is not None:
+            updates.extend(self._items_to_update(iterable))
+        updates.extend(kwds.items())
+        for column_name, feature in updates:
+            self[column_name] = feature
+
+    @classmethod
+    def _items_to_update(cls, update) -> List[Tuple[str, FeatureType]]:
+        """Flatten whatever ``update`` accepts into a list of ``(column_name, feature)`` pairs, in order."""
+        if isinstance(update, (str, bytes, bytearray)):
+            update = cls._load_json(update)
+        if hasattr(update, "keys"):
+            return [(key, cls._feature_from_serialized(update[key])) for key in update.keys()]
+        items = []
+        for position, element in enumerate(update):
+            if isinstance(element, (str, bytes, bytearray)):
+                element = cls._load_json(element)
+            if hasattr(element, "keys"):
+                items.extend(cls._items_to_update(element))
+                continue
+            try:
+                column_name, feature = element
+            except (TypeError, ValueError):
+                raise ValueError(
+                    f"Features.update expects a mapping, a JSON string or (column_name, feature) pairs, "
+                    f"but item #{position} is {element!r}"
+                ) from None
+            items.append((column_name, cls._feature_from_serialized(feature)))
+        return items
+
+    @staticmethod
+    def _load_json(text: Union[str, bytes, bytearray]):
+        try:
+            loaded = json.loads(text)
+        except ValueError as err:  # json.JSONDecodeError and UnicodeDecodeError are both ValueErrors
+            raise ValueError(f"Features.update got a string that is not valid JSON: {err}") from err
+        if not isinstance(loaded, (dict, list)):
+            raise ValueError(
+                f"Features.update expects JSON holding an object or a list of objects, got {type(loaded).__name__}"
+            )
+        return loaded
+
+    @classmethod
+    def _feature_from_serialized(cls, value):
+        """Turn the serialized form of a feature (a dict with a ``"_type"`` key) into feature objects.
+
+        Anything else, including feature objects and plain nested dicts, is returned unchanged.
+        """
+        if isinstance(value, list):
+            converted = [cls._feature_from_serialized(sub_value) for sub_value in value]
+            return value if all(new is old for new, old in zip(converted, value)) else converted
+        if not isinstance(value, dict):
+            return value
+        if isinstance(value.get("_type"), str):
+            try:
+                return generate_from_dict(copy.deepcopy(value))  # generate_from_dict pops "_type" in place
+            except (KeyError, TypeError) as err:
+                raise ValueError(f"Features.update cannot build a feature from {value!r}: {err!r}") from err
+        converted = {key: cls._feature_from_serialized(sub_value) for key, sub_value in value.items()}
+        return value if all(converted[key] is sub_value for key, sub_value in value.items()) else converted
 
