+# Matches a 16-digit credit card number written with no separator, with spaces
+# between the four groups of four digits, or with hyphens between them. The
+# separator must be the same throughout, so the pattern lists the three forms
+# as alternatives instead of using a back-reference, which regex-guided
+# generation does not support. This checks the shape of the number only, not
+# its Luhn checksum or its issuer.
+credit_card = Regex(r"(?:[0-9]{4}-){3}[0-9]{4}|(?:[0-9]{4} ){3}[0-9]{4}|[0-9]{16}")
+
 # Matches any ISBN number. Note that this is not completely correct as not all
 # 10 or 13 digits numbers are valid ISBNs. See https://en.wikipedia.org/wiki/ISBN
 # Taken from O'Reilly's Regular Expression Cookbook:
@@ -68,3 +76,18 @@ email = Regex(
 isbn = Regex(
     r"(?:ISBN(?:-1[03])?:? )?(?=[0-9X]{10}$|(?=(?:[0-9]+[- ]){3})[- 0-9X]{13}$|97[89][0-9]{10}$|(?=(?:[0-9]+[- ]){4})[- 0-9]{17}$)(?:97[89][- ]?)?[0-9]{1,5}[- ]?[0-9]+[- ]?[0-9]+[- ]?[0-9X]"
 )
+
+# Matches HTTP and HTTPS web URLs: a scheme, a host (a dotted domain name whose
+# last label starts with a letter, an IPv4 address with every octet at most
+# 255, or localhost), an optional port, and an optional path, query string and
+# fragment that run to the end with no whitespace. Like the email pattern above,
+# a bare name such as "http://example" is refused; unlike a full RFC 3986
+# grammar, it does not read user information or IPv6 hosts.
+url = Regex(
+    r"https?://"
+    r"(?:(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?\.)+[a-zA-Z](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?"
+    r"|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])"
+    r"|localhost)"
+    r"(?::[0-9]{1,5})?"
+    r"(?:[/?#][^\s]*)?"
+)
