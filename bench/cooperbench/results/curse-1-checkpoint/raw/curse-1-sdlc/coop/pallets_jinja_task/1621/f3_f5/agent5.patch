+def validate_template_path(template: str) -> None:
+    """Check a template path for characters and forms that no loader
+    should accept, and raise :exc:`TemplateNotFound` if it finds one.
+
+    A path is rejected if it:
+
+    -   is empty or ``None``,
+    -   contains a null byte,
+    -   is absolute, starting with ``/`` or ``\\``,
+    -   starts with a Windows drive letter such as ``C:``,
+    -   contains an ASCII control character other than tab, newline and
+        carriage return.
+
+    Anything else, including ``..`` segments, is left to
+    :func:`split_template_path`.
+    """
+    if not template:
+        raise TemplateNotFound(template)
+
+    if "\x00" in template:
+        raise TemplateNotFound(template)
+
+    if template[0] in ("/", "\\"):
+        raise TemplateNotFound(template)
+
+    if _drive_letter_re.match(template):
+        raise TemplateNotFound(template)
+
+    for char in template:
+        if ord(char) < 32 and char not in "\t\n\r":
+            raise TemplateNotFound(template)
+
