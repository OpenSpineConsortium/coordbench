+class ConditionalI18nExtension(Extension):
+    """Adds a ``{% ctrans %}`` tag that translates a block only while a
+    runtime condition holds, and renders a mandatory fallback otherwise.
+
+    .. code-block:: html+jinja
+
+        {% ctrans use_i18n, count=items|length %}
+            {{ count }} item
+        {% pluralize %}
+            {{ count }} items
+        {% fallback %}
+            {{ count }} item(s)
+        {% endctrans %}
+
+    The condition is any expression. It is evaluated each time the tag
+    renders, after it was parsed and before anything is translated. If
+    it is true, the singular (or, with ``pluralize``, the plural) block
+    goes through ``gettext`` or ``ngettext`` exactly as in a ``trans``
+    tag. If it is false, the ``fallback`` block is rendered as it is,
+    with its variables filled in, and no translation function is
+    called. The ``fallback`` block is required, and it comes last.
+
+    Variables are declared as in ``trans``: ``{{ name }}`` in a block
+    uses the variable ``name``, and ``name=expression`` in the tag
+    header sets it. Commas between the parts of the header are optional,
+    and ``trimmed`` or ``notrimmed`` apply to every block, the fallback
+    included.
+
+    The tag calls the ``gettext`` and ``ngettext`` functions of the
+    environment, so the :class:`InternationalizationExtension` must be
+    loaded too, to install them.
+    """
+
+    tags = {"ctrans"}
+
+    def parse(self, parser: "Parser") -> t.Union[nodes.Node, t.List[nodes.Node]]:
+        """Parse a conditional translatable tag."""
+        lineno = next(parser.stream).lineno
+        condition = parser.parse_expression()
+        num_called_num = False
+
+        # find all the variables referenced.  Additionally a variable can be
+        # defined in the body of the ctrans block too, but this is checked at
+        # a later state.
+        plural_expr: t.Optional[nodes.Expr] = None
+        plural_expr_assignment: t.Optional[nodes.Assign] = None
+        variables: t.Dict[str, nodes.Expr] = {}
+        trimmed = None
+        while True:
+            # commas separate the parts of the header, but are optional
+            while parser.stream.skip_if("comma"):
+                pass
+
+            if parser.stream.current.type == "block_end":
+                break
+
+            # skip colon for python compatibility
+            if parser.stream.skip_if("colon"):
+                break
+
+            token = parser.stream.expect("name")
+            if token.value in variables:
+                parser.fail(
+                    f"translatable variable {token.value!r} defined twice.",
+                    token.lineno,
+                    exc=TemplateAssertionError,
+                )
+
+            # expressions
+            if parser.stream.current.type == "assign":
+                next(parser.stream)
+                variables[token.value] = var = parser.parse_expression()
+            elif trimmed is None and token.value in ("trimmed", "notrimmed"):
+                trimmed = token.value == "trimmed"
+                continue
+            else:
+                variables[token.value] = var = nodes.Name(token.value, "load")
+
+            if plural_expr is None:
+                if isinstance(var, nodes.Call):
+                    plural_expr = nodes.Name("_trans", "load")
+                    variables[token.value] = plural_expr
+                    plural_expr_assignment = nodes.Assign(
+                        nodes.Name("_trans", "store"), var
+                    )
+                else:
+                    plural_expr = var
+                num_called_num = token.value == "num"
+
+        parser.stream.expect("block_end")
+
+        plural = None
+        have_plural = False
+        referenced: t.List[str] = []
+
+        # now parse until pluralize or fallback
+        singular_names, singular = self._parse_block(parser, "singular")
+        if singular_names:
+            referenced.extend(singular_names)
+            if plural_expr is None:
+                plural_expr = nodes.Name(singular_names[0], "load")
+                num_called_num = singular_names[0] == "num"
+
+        # if we have a pluralize block, we parse that too
+        if parser.stream.current.test("name:pluralize"):
+            have_plural = True
+            next(parser.stream)
+            if parser.stream.current.type != "block_end":
+                token = parser.stream.expect("name")
+                if token.value not in variables:
+                    parser.fail(
+                        f"unknown variable {token.value!r} for pluralization",
+                        token.lineno,
+                        exc=TemplateAssertionError,
+                    )
+                plural_expr = variables[token.value]
+                num_called_num = token.value == "num"
+            parser.stream.expect("block_end")
+            plural_names, plural = self._parse_block(parser, "plural")
+            referenced.extend(plural_names)
+
+        # the fallback block is what renders when the condition is false,
+        # so a conditional translation is never without one
+        if not parser.stream.current.test("name:fallback"):
+            parser.fail("expected 'fallback' block")
+
+        next(parser.stream)
+        parser.stream.expect("block_end")
+        fallback_names, fallback = self._parse_block(parser, "fallback")
+        next(parser.stream)
+
+        # register free names as simple name expressions.  The translated
+        # blocks and the fallback each get the names they use, so a name
+        # that only one of them uses is not looked up for the other.
+        translated_variables = dict(variables)
+        for name in referenced:
+            if name not in translated_variables:
+                translated_variables[name] = nodes.Name(name, "load")
+
+        fallback_variables: t.Dict[str, nodes.Expr] = {}
+        for name in fallback_names:
+            if name in variables:
+                fallback_variables[name] = variables[name]
+            else:
+                fallback_variables[name] = nodes.Name(name, "load")
+
+        if not have_plural:
+            plural_expr = None
+        elif plural_expr is None:
+            parser.fail("pluralize without variables", lineno)
+
+        if trimmed is None:
+            trimmed = self.environment.policies.get("ext.i18n.trimmed", False)
+        if trimmed:
+            singular = self._trim_whitespace(singular)
+            if plural is not None:
+                plural = self._trim_whitespace(plural)
+            fallback = self._trim_whitespace(fallback)
+
+        node = self._make_conditional_node(
+            condition,
+            singular,
+            plural,
+            translated_variables,
+            plural_expr,
+            num_called_num and have_plural,
+            fallback,
+            fallback_variables,
+        )
+        node.set_lineno(lineno)
+        if plural_expr_assignment is not None:
+            plural_expr_assignment.set_lineno(lineno)
+            return [plural_expr_assignment, node]
+        else:
+            return node
+
+    def _trim_whitespace(self, string: str, _ws_re: t.Pattern[str] = _ws_re) -> str:
+        return _ws_re.sub(" ", string.strip())
+
+    def _parse_block(self, parser: "Parser", section: str) -> t.Tuple[t.List[str], str]:
+        """Parse the text of one section of the tag, ``"singular"``,
+        ``"plural"`` or ``"fallback"``, up to the tag that ends it.
+
+        The stream is left on the name of that tag: ``pluralize`` or
+        ``fallback`` for a section that a later one may follow, and
+        ``endctrans`` for any.
+        """
+        referenced = []
+        buf = []
+
+        while True:
+            if parser.stream.current.type == "data":
+                buf.append(parser.stream.current.value.replace("%", "%%"))
+                next(parser.stream)
+            elif parser.stream.current.type == "variable_begin":
+                next(parser.stream)
+                name = parser.stream.expect("name").value
+                referenced.append(name)
+                buf.append(f"%({name})s")
+                parser.stream.expect("variable_end")
+            elif parser.stream.current.type == "block_begin":
+                next(parser.stream)
+                if parser.stream.current.test("name:endctrans"):
+                    break
+                elif parser.stream.current.test("name:pluralize"):
+                    if section == "singular":
+                        break
+                    if section == "plural":
+                        parser.fail(
+                            "a translatable section can have only one pluralize "
+                            "section"
+                        )
+                    parser.fail("the pluralize section must come before 'fallback'")
+                elif parser.stream.current.test("name:fallback"):
+                    if section != "fallback":
+                        break
+                    parser.fail(
+                        "a conditional translation block can have only one "
+                        "fallback section"
+                    )
+                parser.fail(
+                    "control structures in translatable sections are not allowed"
+                )
+            elif parser.stream.eos:
+                parser.fail("unclosed conditional translation block")
+            else:
+                raise RuntimeError("internal parser error")
+
+        return referenced, concat(buf)
+
+    def _make_conditional_node(
+        self,
+        condition: nodes.Expr,
+        singular: str,
+        plural: t.Optional[str],
+        variables: t.Dict[str, nodes.Expr],
+        plural_expr: t.Optional[nodes.Expr],
+        num_called_num: bool,
+        fallback: str,
+        fallback_variables: t.Dict[str, nodes.Expr],
+    ) -> nodes.If:
+        """Generates an ``If`` node that translates the singular or
+        plural text when the condition is true, and renders the
+        fallback text when it is false.
+        """
+        newstyle = getattr(self.environment, "newstyle_gettext", False)
+        node: nodes.Expr
+
+        # The text is a format string only if variables are filled in. Old
+        # style gettext does not format it otherwise, so a literal percent
+        # sign must not stay escaped.
+        if not variables and not newstyle:
+            singular = singular.replace("%%", "%")
+            if plural:
+                plural = plural.replace("%%", "%")
+
+        # singular only:
+        if plural_expr is None:
+            gettext = nodes.Name("gettext", "load")
+            node = nodes.Call(gettext, [nodes.Const(singular)], [], None, None)
+
+        # singular and plural
+        else:
+            ngettext = nodes.Name("ngettext", "load")
+            node = nodes.Call(
+                ngettext,
+                [nodes.Const(singular), nodes.Const(plural), plural_expr],
+                [],
+                None,
+                None,
+            )
+
+        # in case newstyle gettext is used, the method is powerful
+        # enough to handle the variable expansion and autoescape
+        # handling itself
+        if newstyle:
+            for key, value in variables.items():
+                # the function adds that later anyways in case num was
+                # called num, so just skip it.
+                if num_called_num and key == "num":
+                    continue
+                node.kwargs.append(nodes.Keyword(key, value))
+
+        # otherwise do that here
+        else:
+            # mark the return value as safe if we are in an
+            # environment with autoescaping turned on
+            node = nodes.MarkSafeIfAutoescape(node)
+            if variables:
+                node = nodes.Mod(node, self._make_dict(variables))
+
+        # The fallback is never translated, so it is formatted here in
+        # either style. Its text is the template author's, which is safe,
+        # while the variables are escaped by the formatting.
+        fallback_node: nodes.Expr
+        if fallback_variables:
+            fallback_node = nodes.Mod(
+                nodes.MarkSafeIfAutoescape(nodes.Const(fallback)),
+                self._make_dict(fallback_variables),
+            )
+        else:
+            fallback_node = nodes.MarkSafeIfAutoescape(
+                nodes.Const(fallback.replace("%%", "%"))
+            )
+
+        return nodes.If(
+            condition,
+            [nodes.Output([node])],
+            [],
+            [nodes.Output([fallback_node])],
+        )
+
+    @staticmethod
+    def _make_dict(variables: t.Dict[str, nodes.Expr]) -> nodes.Dict:
+        return nodes.Dict(
+            [nodes.Pair(nodes.Const(key), value) for key, value in variables.items()]
+        )
+
+
 def extract_from_ast(
     ast: nodes.Template,
     gettext_functions: t.Sequence[str] = GETTEXT_FUNCTIONS,
@@ -852,3 +1221,4 @@ i18n = InternationalizationExtension
 do = ExprStmtExtension
 loopcontrols = LoopControlExtension
 debug = DebugExtension
+conditional_i18n = ConditionalI18nExtension
