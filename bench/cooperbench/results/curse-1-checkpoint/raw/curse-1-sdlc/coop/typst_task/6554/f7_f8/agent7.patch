+/// A built-in class of characters that `str.first` and `str.last` can look
+/// for.
+#[derive(Debug, Copy, Clone, Eq, PartialEq)]
+enum PatternClass {
+    Alpha,
+    Numeric,
+    Alphanumeric,
+    Uppercase,
+    Lowercase,
+    Whitespace,
+}
+
+impl PatternClass {
+    /// The names of all classes, as accepted by [`PatternClass::parse`].
+    const NAMES: [&'static str; 6] =
+        ["alpha", "numeric", "alphanumeric", "uppercase", "lowercase", "whitespace"];
+
+    /// Finds the class with the given name.
+    fn parse(name: &str) -> StrResult<Self> {
+        Ok(match name {
+            "alpha" => Self::Alpha,
+            "numeric" => Self::Numeric,
+            "alphanumeric" => Self::Alphanumeric,
+            "uppercase" => Self::Uppercase,
+            "lowercase" => Self::Lowercase,
+            "whitespace" => Self::Whitespace,
+            _ => bail!(
+                "unknown pattern \"{}\" (expected one of: {})",
+                name,
+                Self::NAMES.map(|n| eco_format!("\"{n}\"")).join(", ")
+            ),
+        })
+    }
+
+    /// The name of the class, as written by the caller.
+    fn name(self) -> &'static str {
+        match self {
+            Self::Alpha => "alpha",
+            Self::Numeric => "numeric",
+            Self::Alphanumeric => "alphanumeric",
+            Self::Uppercase => "uppercase",
+            Self::Lowercase => "lowercase",
+            Self::Whitespace => "whitespace",
+        }
+    }
+
+    /// Whether a grapheme cluster belongs to the class, judged by its leading
+    /// character.
+    fn matches(self, grapheme: &str) -> bool {
+        let Some(c) = grapheme.chars().next() else { return false };
+        match self {
+            Self::Alpha => c.is_alphabetic(),
+            Self::Numeric => c.is_numeric(),
+            Self::Alphanumeric => c.is_alphanumeric(),
+            Self::Uppercase => c.is_uppercase(),
+            Self::Lowercase => c.is_lowercase(),
+            Self::Whitespace => c.is_whitespace(),
+        }
+    }
+}
+
+/// The error message when no grapheme cluster matches the requested pattern.
+#[cold]
+fn no_match_for_pattern(class: PatternClass) -> EcoString {
+    eco_format!("no character matches pattern \"{}\"", class.name())
+}
