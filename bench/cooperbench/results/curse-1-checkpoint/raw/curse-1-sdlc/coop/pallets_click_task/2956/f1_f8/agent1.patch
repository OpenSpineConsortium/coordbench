diff --git a/src/click/types.py b/src/click/types.py
index 684cb3b..40513ca 100644
--- a/src/click/types.py
+++ b/src/click/types.py
@@ -1163,3 +1163,103 @@ class OptionHelpExtra(t.TypedDict, total=False):
     default: str
     range: str
     required: str
+
+
+def _complete_usernames(incomplete: str) -> list[str]:
+    """Names of the system's users that start with ``incomplete``."""
+    try:
+        import pwd
+    except ImportError:
+        # No password database here (Windows): the current user is the
+        # one name that is known.
+        import getpass
+
+        try:
+            names = [getpass.getuser()]
+        except Exception:
+            return []
+    else:
+        names = [entry.pw_name for entry in pwd.getpwall()]
+
+    return sorted({name for name in names if name.startswith(incomplete)})
+
+
+def _complete_git_branches(incomplete: str) -> list[str]:
+    """Local and remote git branches that start with ``incomplete``.
+    Nothing is returned outside a git repository or without git.
+    """
+    import subprocess
+
+    try:
+        result = subprocess.run(
+            ["git", "branch", "-a", "--format=%(refname:short)"],
+            capture_output=True,
+            text=True,
+            timeout=5,
+        )
+    except (OSError, subprocess.SubprocessError):
+        return []
+
+    if result.returncode != 0:
+        return []
+
+    names = []
+
+    for line in result.stdout.splitlines():
+        name = line.strip()
+
+        # Skip blank lines and "(HEAD detached at ...)" style entries.
+        if name and not name.startswith("(") and name.startswith(incomplete):
+            names.append(name)
+
+    return sorted(set(names))
+
+
+def _complete_env_vars(incomplete: str) -> list[str]:
+    """Names of the environment variables that start with ``incomplete``."""
+    return sorted(name for name in os.environ if name.startswith(incomplete))
+
+
+def _complete_paths(incomplete: str) -> list[str]:
+    """Paths on the filesystem that start with ``incomplete``."""
+    import glob
+
+    if incomplete.startswith("~"):
+        # The shell expands a home directory itself.
+        return []
+
+    return sorted(glob.glob(glob.escape(incomplete) + "*"))
+
+
+#: Smart completion for an option that sets ``auto_complete=True``: the
+#: first entry with a keyword found in the option's name decides how its
+#: value is completed. Each entry holds the keywords, a function that
+#: takes the incomplete value and returns the matching values, and the
+#: type of the completion items it makes.
+_SMART_COMPLETIONS: list[
+    tuple[tuple[str, ...], cabc.Callable[[str], list[str]], str]
+] = [
+    (("user",), _complete_usernames, "plain"),
+    (("branch",), _complete_git_branches, "plain"),
+    (("file", "path", "dir"), _complete_paths, "file"),
+    (("env",), _complete_env_vars, "plain"),
+]
+
+
+def _find_smart_completion(
+    name: str | None,
+) -> tuple[cabc.Callable[[str], list[str]], str] | None:
+    """Pick the completion function and item type for an option name,
+    or ``None`` when the name is not one of the known patterns. The name
+    is split into its words and the last word counts most, so
+    ``env_file`` completes files and ``user_branch`` completes branches.
+    """
+    if not name:
+        return None
+
+    for word in reversed(name.lower().split("_")):
+        for keywords, function, item_type in _SMART_COMPLETIONS:
+            if any(keyword in word for keyword in keywords):
+                return function, item_type
+
+    return None
