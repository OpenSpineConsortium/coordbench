+    def shell_complete(self, ctx: Context, incomplete: str) -> list[CompletionItem]:
+        """Return a list of completions for the incomplete value. A
+        ``shell_complete`` function given during init always wins. Else
+        if ``auto_complete`` is enabled the completions come from
+        :meth:`_smart_complete`, otherwise from the :attr:`type`.
+
+        :param ctx: Invocation context for this command.
+        :param incomplete: Value being completed. May be empty.
+        """
+        if self.auto_complete and self._custom_shell_complete is None:
+            return self._smart_complete(ctx, incomplete)
+
+        return super().shell_complete(ctx, incomplete)
+
+    def _smart_complete(self, ctx: Context, incomplete: str) -> list[CompletionItem]:
+        """Complete the value from the option's type and name.
+
+        A flag takes no value, so nothing is completed. For a plain
+        string the option's name picks a strategy, see
+        ``types._SMART_COMPLETIONS``. Any other type, and a string
+        whose name is not known, completes as its type does: the
+        choices of a :class:`Choice`, the paths of a :class:`Path` or
+        :class:`File`.
+
+        :param ctx: Invocation context for this command.
+        :param incomplete: Value being completed. May be empty.
+        """
+        from .shell_completion import CompletionItem
+
+        if self.is_flag or self.count:
+            return []
+
+        # Only a plain string is guessed from its name. Any other type
+        # knows better what it takes, a Choice or a Path completes
+        # itself and a number has nothing to complete.
+        if isinstance(self.type, types.StringParamType):
+            strategy = types._find_smart_completion(self.name)
+
+            if strategy is not None:
+                function, item_type = strategy
+                values = function(incomplete)
+
+                if not values and item_type == "file":
+                    # Leave the paths to the shell, which knows more.
+                    return [CompletionItem(incomplete, type="file")]
+
+                return [CompletionItem(value, type=item_type) for value in values]
+
+        return self.type.shell_complete(ctx, self, incomplete)
+
