+    def get_option_history(self, name: str) -> list[dict[str, t.Any]] | None:
+        """Get the history of the values an option received while the
+        command line was processed. Each entry is a dict with the keys
+        ``"value"`` (the value after type conversion), ``"source"`` (a
+        member of :class:`~click.core.ParameterSource`) and
+        ``"timestamp"`` (seconds since the epoch, from
+        :func:`time.time`). An entry that replaces an earlier value also
+        has the key ``"previous_value"``. Entries are ordered oldest
+        first.
+
+        History is only kept for commands created with
+        ``track_changes=True``.
+
+        :param name: The name of the parameter, such as ``"count"``, or
+            one of its option flags, such as ``"--count"`` or ``"-c"``.
+        :return: ``None`` if the command does not track changes,
+            otherwise a list of entries, which is empty if the option
+            has no history or does not exist.
+
+        .. versionadded:: 8.3
+        """
+        if not self._track_changes:
+            return None
+
+        name = self._resolve_option_name(name)
+        return list(self._option_history.get(name, ()))
+
+    def _resolve_option_name(self, name: str) -> str:
+        """Turn an option flag such as ``--count`` into the name of the
+        parameter that declares it. Anything that is not a declared flag
+        is returned as it was given.
+        """
+        for param in self.command.params:
+            if name in param.opts or name in param.secondary_opts:
+                return param.name  # type: ignore[return-value]
+
+        return name
+
+    def _record_option_change(
+        self, name: str, value: t.Any, source: ParameterSource | None
+    ) -> None:
+        """Append an entry to the history of a parameter if the command
+        tracks changes. Does nothing otherwise.
+        """
+        if not self._track_changes:
+            return
+
+        # Imported here so that ``import click`` stays light for the
+        # commands that never track changes.
+        import time
+
+        history = self._option_history.setdefault(name, [])
+        entry: dict[str, t.Any] = {
+            "value": value,
+            "source": source,
+            "timestamp": time.time(),
+        }
+
+        if history:
+            entry["previous_value"] = history[-1]["value"]
+
+        history.append(entry)
+
 
