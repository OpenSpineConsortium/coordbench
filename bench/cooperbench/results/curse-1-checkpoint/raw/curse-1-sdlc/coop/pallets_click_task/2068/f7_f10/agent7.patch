+def _quote_editor(editor: str) -> str:
+    """Quote each word of an editor command for the shell.
+
+    An editor setting such as ``code --wait`` is a command with
+    arguments, so it is split into words and each word is quoted. A
+    setting that names a single existing file, spaces and all, is quoted
+    as one word instead. Text that cannot be split, such as an unbalanced
+    quote, is quoted whole.
+    """
+    import shlex
+
+    if os.path.isfile(editor):
+        return shlex.quote(editor)
+
+    try:
+        words = shlex.split(editor)
+    except ValueError:
+        return shlex.quote(editor)
+
+    return " ".join(shlex.quote(word) for word in words)
+
