+def _lighten_palette(im, factor):
+    """
+    Scale the colors of a palette image's palette by ``factor``, in place.
+
+    Only the color channels change; the alpha channel of an "RGBA" palette is
+    left alone. Each channel is clamped to 0-255, and the pixel data is never
+    touched, so the image gains no colors and needs no re-quantization.
+
+    :param im: A "P" image whose core image holds the palette.
+    :param factor: A number greater than 0.
+    """
+    from . import ImagePalette
+
+    mode = im.im.getpalettemode()
+    data = im.im.getpalette(mode, mode)
+    step = len(mode)
+
+    # One lookup for the 256 possible channel values, rather than a multiply
+    # for every palette entry. Zero is mapped on its own, since 0 * inf is nan.
+    lookup = bytes(
+        int(min(255.0, value * factor)) if value else 0 for value in range(256)
+    )
+    colors = bytearray(len(data) // step * 3)
+    for channel in range(3):
+        colors[channel::3] = data[channel::step].translate(lookup)
+
+    # Setting the colors resets the alpha values, so they are put back
+    im.im.putpalette("RGB", bytes(colors))
+    if mode == "RGBA":
+        im.im.putpalettealphas(data[3::step])
+    im.palette = ImagePalette.ImagePalette(mode, im.im.getpalette(mode, mode))
+
