+def test_quantize_error_threshold():
+    image = hopper()
+
+    # A loose threshold needs fewer colors than a tight one
+    loose = image.quantize(256, error_threshold=500)
+    tight = image.quantize(256, error_threshold=50)
+    assert_image(loose, "P", loose.size)
+    assert len(loose.getcolors()) < len(tight.getcolors()) < 256
+
+    # and each stays within its own threshold
+    assert mean_square_error(loose.convert("RGB"), image) <= 500
+    assert mean_square_error(tight.convert("RGB"), image) <= 50
+
+
+def test_quantize_error_threshold_is_minimal():
+    image = hopper()
+    threshold = 100
+
+    converted = image.quantize(256, error_threshold=threshold)
+    count = len(converted.getcolors())
+    assert mean_square_error(converted.convert("RGB"), image) <= threshold
+
+    # one color fewer is not enough
+    fewer = image.quantize(count - 1)
+    assert mean_square_error(fewer.convert("RGB"), image) > threshold
+
+
