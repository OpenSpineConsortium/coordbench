+    def _quantize_to_threshold(self, colors, method, kmeans, error_threshold):
+        """
+        Quantizes to the fewest colors, at most ``colors``, whose mean square
+        error is within ``error_threshold``, and returns the core image.
+
+        More colors seldom raise the error, so the count is found by bisection,
+        which quantizes about log2(colors) times, not ``colors`` times. Each
+        candidate that is kept has met the threshold when it was measured, so
+        the result never exceeds it unless even ``colors`` colors do.
+        """
+        if 0 in self.size:
+            return self.im.quantize(colors, method, kmeans)
+
+        mode = self.mode if self.mode in ("L", "RGB", "RGBA") else "RGB"
+        original = self if self.mode == mode else self.convert(mode)
+
+        def attempt(count):
+            quantized = self.im.quantize(count, method, kmeans)
+            error = _mean_square_error(original, self._new(quantized.convert(mode)))
+            return quantized, error
+
+        best, error = attempt(colors)
+        if error > error_threshold:
+            return best
+
+        # libimagequant takes no fewer than two colors
+        low = 2 if method == LIBIMAGEQUANT else 1
+        high = colors  # the count that `best` has, and that is known to pass
+        while low < high:
+            middle = (low + high) // 2
+            candidate, error = attempt(middle)
+            if error <= error_threshold:
+                best, high = candidate, middle
+            else:
+                low = middle + 1
+        return best
+
