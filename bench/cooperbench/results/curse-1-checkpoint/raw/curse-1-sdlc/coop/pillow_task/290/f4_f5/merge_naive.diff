+def _mean_square_error(image1, image2):
+    """
+    The mean of the squared differences between the values of two images of
+    the same mode and size, over every pixel and channel.
+    """
+    from . import ImageChops, ImageStat
+
+    stat = ImageStat.Stat(ImageChops.difference(image1, image2))
+    return sum(stat.sum2) / (stat.count[0] * len(stat.count))
