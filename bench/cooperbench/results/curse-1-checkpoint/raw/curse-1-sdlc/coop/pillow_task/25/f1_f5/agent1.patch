+    def _mark_corners(self) -> None:
+        """
+        Sets the top-left and bottom-right pixels to red, in place. Used by
+        :py:meth:`~PIL.Image.Image.save` for its ``mark_corners`` option.
+        """
+        width, height = self.size
+        if not width or not height:
+            return
+        red: float | tuple[int, ...] | None
+        if self.mode in ("P", "PA"):
+            # putpixel() finds this colour in the palette, or adds it
+            red = (255, 0, 0)
+        else:
+            # the nearest colour that this mode can hold
+            red = new("RGB", (1, 1), (255, 0, 0)).convert(self.mode).getpixel((0, 0))
+        assert red is not None
+        self.putpixel((0, 0), red)
+        self.putpixel((width - 1, height - 1), red)
+
