+def _lighten_palette(im, factor):
+    """
+    Multiply the color channels of a palette image's palette by ``factor``,
+    clamping to 0-255 and leaving alpha as it is. Only the palette changes,
+    never the pixel data, so no color is added and nothing is re-quantized.
+
+    An image keeps its palette twice, in the core, which draws the pixels, and
+    in ``im.palette``, which plugins save. They can differ (the palette of a
+    reference image need not match), so each is adjusted from its own colors.
+
+    :param im: A "P" image.
+    :param factor: A number greater than 0. 1.0 changes nothing.
+    """
+    if factor == 1.0:
+        return
+
+    # 0 stays 0 even when factor is infinite, where 0 * factor would be NaN
+    table = bytearray(256)
+    for value in range(1, 256):
+        scaled = value * factor
+        table[value] = 255 if scaled >= 255 else int(scaled)
+    table = bytes(table)
+
+    from . import ImagePalette
+
+    mode = im.im.getpalettemode()
+    data = _lighten_colors(im.im.getpalette(mode, mode), mode, table)
+    if mode == "RGBA":
+        # the core takes the colors and the alphas of a palette separately
+        rgb = bytearray(len(data) // 4 * 3)
+        for channel in range(3):
+            rgb[channel::3] = data[channel::4]
+        im.im.putpalette("RGB", bytes(rgb))
+        im.im.putpalettealphas(data[3::4])
+    else:
+        im.im.putpalette(mode, data)
+
+    if im.palette and im.palette.palette:
+        mode = im.palette.mode
+        data = _lighten_colors(im.palette.palette, mode, table)
+        im.palette = ImagePalette.ImagePalette(mode, data)
+
+
+def _lighten_colors(data, mode, table):
+    """Map every channel of ``data``, a palette in ``mode``, but alpha through
+    ``table``, a 256 byte translation table. Returns bytes."""
+    data = bytearray(data)
+    channels = len(mode)
+    alpha = mode.find("A")
+    for channel in range(channels):
+        if channel != alpha:
+            data[channel::channels] = data[channel::channels].translate(table)
+    return bytes(data)
+
