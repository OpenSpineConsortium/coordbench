+def _sort_quantized_palette(im, mode, palette_data, sort_palette):
+    """
+    Reorder the colors a quantization made in the "P" mode image ``im`` and
+    remap its pixels to the new order, so that it looks the same.
+
+    :param im: The quantized image, whose core image is changed in place.
+    :param mode: The mode of the palette, "RGB" or "RGBA".
+    :param palette_data: The palette as bytes, every entry ``len(mode)`` bytes.
+    :param sort_palette: "brightness" or "rgb".
+    :returns: The new palette as bytes.
+    """
+    size = len(mode)
+
+    def key(index):
+        red, green, blue = palette_data[index * size : index * size + 3]
+        if sort_palette == "brightness":
+            # ITU-R 601 luma, the weights Image.convert("L") uses, in integers
+            return (299 * red + 587 * green + 114 * blue, red, green, blue)
+        return (red, green, blue)
+
+    # The colors the image uses come first, sorted. The rest is the
+    # quantizer's padding up to 256 entries, which keeps its order behind them.
+    # sorted() is stable, so colors that tie keep the quantizer's order.
+    used = [index for index, count in enumerate(im.histogram()) if count]
+    unused = [index for index in range(len(palette_data) // size) if index not in used]
+    order = sorted(used, key=key) + unused
+    if order == sorted(order):
+        return palette_data
+
+    lookup = list(range(256))
+    sorted_palette = bytearray(palette_data)
+    for new_index, old_index in enumerate(order):
+        lookup[old_index] = new_index
+        sorted_palette[new_index * size : (new_index + 1) * size] = palette_data[
+            old_index * size : (old_index + 1) * size
+        ]
+    sorted_palette = bytes(sorted_palette)
+
+    # the core's point() maps every pixel through the table, palette kept
+    im.im = im.im.point(lookup, None)
+    if mode == "RGBA":
+        # the core takes a palette as RGB, and its alpha values after it
+        rgb = bytes(v for i, v in enumerate(sorted_palette) if i % 4 != 3)
+        im.im.putpalette("RGB", rgb)
+        im.im.putpalettealphas(sorted_palette[3::4])
+    else:
+        im.im.putpalette(mode, sorted_palette)
+    return sorted_palette
+
