+def _quote_command(editor: str, filename: str) -> str:
+    """Build the shell command that runs ``editor`` on ``filename`` with
+    every shell metacharacter made literal.
+
+    The editor string may carry its own arguments (``code --wait``), so it
+    is split the way the shell would split it and each word is quoted on
+    its own. A string that cannot be split, such as one with an unbalanced
+    quote, is quoted whole so that it still cannot run anything else.
+    """
+    import shlex
+
+    try:
+        words = shlex.split(editor)
+    except ValueError:
+        words = [editor]
+
+    return " ".join(shlex.quote(word) for word in (*words, filename))
+
+
