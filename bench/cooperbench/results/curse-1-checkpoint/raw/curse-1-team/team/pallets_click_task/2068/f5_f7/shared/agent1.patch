+    def _get_lock_filename(self, filename: str) -> str:
+        """Return the path of the lock file for ``filename``: the same
+        directory, named ``.{basename}.lock``.
+        """
+        directory, basename = os.path.split(filename)
+        return os.path.join(directory, f".{basename}.lock")
+
+    def _create_lock_file(self, filename: str) -> str:
+        """Create the lock file for ``filename`` and return its path.
+
+        The file is created with ``O_CREAT | O_EXCL``, which the
+        operating system makes atomic, so of two processes that race for
+        the lock exactly one wins. The other gets a
+        :exc:`ClickException`. The lock records the process id and the
+        time, to help whoever has to look at a stale lock.
+        """
+        import datetime
+
+        lock_filename = self._get_lock_filename(filename)
+
+        try:
+            fd = os.open(lock_filename, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
+        except FileExistsError as e:
+            raise ClickException(
+                _(
+                    "{filename}: File is already being edited"
+                    " (lock file {lock_filename} exists)"
+                ).format(filename=filename, lock_filename=lock_filename)
+            ) from e
+        except OSError as e:
+            raise ClickException(
+                _("{filename}: Could not create lock file: {e}").format(
+                    filename=filename, e=e
+                )
+            ) from e
+
+        try:
+            with os.fdopen(fd, "w", encoding="utf-8") as f:
+                f.write(f"PID: {os.getpid()}\n")
+                f.write(f"Time: {datetime.datetime.now().isoformat()}\n")
+        except BaseException:
+            # Do not leave an empty lock behind that would block every
+            # later edit of the file.
+            self._remove_lock_file(lock_filename)
+            raise
+
+        return lock_filename
+
+    def _remove_lock_file(self, lock_filename: str) -> None:
+        """Remove a lock file made by :meth:`_create_lock_file`. A lock
+        that is already gone, or that cannot be removed, is not an error,
+        so cleanup never hides the exception that led to it.
+        """
+        with contextlib.suppress(OSError):
+            os.unlink(lock_filename)
+
