+# On-disk blobs written by `Cache` start with a 4-byte magic string and a 1-byte codec selector, followed by the
+# (possibly compressed) pickle:
+#
+#   bytes 0-3 : b"DSPC"
+#   byte  4   : 0x00 = no compression, 0x01 = gzip, 0x02 = zlib
+#   byte  5.. : payload
+#
+# A blob without the magic string was written before this format existed and is read as it always was.
+_DISK_MAGIC = b"DSPC"
+_DISK_HEADER_SIZE = len(_DISK_MAGIC) + 1
+
+_CODEC_IDS = {None: 0x00, "gzip": 0x01, "zlib": 0x02}
+_COMPRESSORS = {
+    0x00: lambda data: data,
+    0x01: lambda data: gzip.compress(data, mtime=0),  # a fixed mtime keeps equal values byte-identical on disk
+    0x02: zlib.compress,
+}
+_DECOMPRESSORS = {
+    0x00: lambda data: data,
+    0x01: gzip.decompress,
+    0x02: zlib.decompress,
+}
+
+
+def _check_codec(codec: Optional[str]) -> None:
+    if codec not in _CODEC_IDS:
+        raise ValueError(f"Unsupported compression codec {codec!r}, expected one of 'gzip', 'zlib' or None.")
+
+
+def _encode_disk_value(value: Any, codec: Optional[str] = None) -> bytes:
+    """Pickle `value`, compress it with `codec` and prepend the magic header."""
+    _check_codec(codec)
+    codec_id = _CODEC_IDS[codec]
+    payload = _COMPRESSORS[codec_id](pickle.dumps(value, protocol=pickle.HIGHEST_PROTOCOL))
+    return _DISK_MAGIC + bytes([codec_id]) + payload
+
+
+def _decode_disk_value(blob: Any) -> Any:
+    """Inverse of `_encode_disk_value`; a value without the magic header is a legacy entry and is returned as it was
+    read, except that legacy raw pickle bytes are unpickled.
+
+    Raises:
+        ValueError: If the header names a codec this version does not know.
+    """
+    if not isinstance(blob, (bytes, bytearray)):
+        # Entries written before the header existed were stored as Python objects, which DiskCache unpickles itself.
+        return blob
+
+    if bytes(blob[: len(_DISK_MAGIC)]) != _DISK_MAGIC:
+        try:
+            return pickle.loads(blob)
+        except Exception:
+            # Not a pickle: the cached value was itself a `bytes` object.
+            return blob
+
+    codec_id = blob[len(_DISK_MAGIC)] if len(blob) >= _DISK_HEADER_SIZE else None
+    if codec_id not in _DECOMPRESSORS:
+        raise ValueError(f"Unknown compression codec byte {codec_id!r} in on-disk cache entry.")
+    return pickle.loads(_DECOMPRESSORS[codec_id](bytes(blob[_DISK_HEADER_SIZE:])))
+
 
