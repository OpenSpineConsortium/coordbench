+_EMAIL_RE = re.compile(
+    r'[A-Za-z0-9._%+-]+'  # local part
+    r'@'
+    r'(?P<domain>(?:[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?\.)+[A-Za-z]{2,})'  # domain with a top level domain
+)
