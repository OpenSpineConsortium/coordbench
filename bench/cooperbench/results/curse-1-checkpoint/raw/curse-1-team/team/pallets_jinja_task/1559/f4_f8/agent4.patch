+class ConditionalI18nExtension(Extension):
+    """Adds a ``ctrans`` tag that translates only when a runtime
+    condition is true and otherwise renders fallback content.
+
+    .. code-block:: jinja
+
+        {% ctrans use_i18n, count trimmed %}
+            One item
+        {% pluralize %}
+            {{ count }} items
+        {% fallback %}
+            {{ count }} item(s)
+        {% endctrans %}
+
+    The condition is any expression. The variables, ``trimmed`` and
+    ``notrimmed`` work as in the ``trans`` tag of the
+    :class:`InternationalizationExtension`, and commas between the parts
+    of the header are optional. ``trimmed`` or ``notrimmed`` applies to
+    every block of the tag, including the fallback. The ``fallback``
+    block is required. It is rendered as written, with its variables
+    substituted, and is never passed to ``gettext``.
+
+    The extension uses the ``gettext`` and ``ngettext`` functions of the
+    environment, so it is meant to be used together with the ``i18n``
+    extension, which installs them.
+    """
+
+    tags = {"ctrans"}
+
+    def parse(self, parser: "Parser") -> t.Union[nodes.Node, t.List[nodes.Node]]:
+        """Parse a conditional translatable tag."""
+        lineno = next(parser.stream).lineno
+        # commas are optional separators anywhere in the header
+        while parser.stream.skip_if("comma"):
+            pass
+        condition = parser.parse_expression()
+        num_called_num = False
+
+        # find all the variables referenced.  Additionally a variable can be
+        # defined in the body of the ctrans block too, but this is checked at
+        # a later state.
+        plural_expr: t.Optional[nodes.Expr] = None
+        variables: t.Dict[str, nodes.Expr] = {}
+        trimmed = None
+        while parser.stream.current.type != "block_end":
+            # commas are optional separators anywhere in the header
+            if parser.stream.skip_if("comma"):
+                continue
+
+            # skip colon for python compatibility
+            if parser.stream.skip_if("colon"):
+                break
+
+            token = parser.stream.expect("name")
+            if token.value in variables:
+                parser.fail(
+                    f"translatable variable {token.value!r} defined twice.",
+                    token.lineno,
+                    exc=TemplateAssertionError,
+                )
+
+            # expressions
+            if parser.stream.current.type == "assign":
+                next(parser.stream)
+                variables[token.value] = var = parser.parse_expression()
+            elif trimmed is None and token.value in ("trimmed", "notrimmed"):
+                trimmed = token.value == "trimmed"
+                continue
+            else:
+                variables[token.value] = var = nodes.Name(token.value, "load")
+
+            if plural_expr is None:
+                plural_expr = var
+                num_called_num = token.value == "num"
+
+        parser.stream.expect("block_end")
+
+        plural = None
+        have_plural = False
+        referenced = set()
+
+        # now parse until pluralize, fallback or endctrans
+        singular_names, singular = self._parse_block(parser, True)
+        if singular_names:
+            referenced.update(singular_names)
+            if plural_expr is None:
+                plural_expr = nodes.Name(singular_names[0], "load")
+                num_called_num = singular_names[0] == "num"
+
+        # if we have a pluralize block, we parse that too
+        if parser.stream.current.test("name:pluralize"):
+            have_plural = True
+            next(parser.stream)
+            if parser.stream.current.type != "block_end":
+                token = parser.stream.expect("name")
+                if token.value not in variables:
+                    parser.fail(
+                        f"unknown variable {token.value!r} for pluralization",
+                        token.lineno,
+                        exc=TemplateAssertionError,
+                    )
+                plural_expr = variables[token.value]
+                num_called_num = token.value == "num"
+            parser.stream.expect("block_end")
+            plural_names, plural = self._parse_block(parser, False)
+            referenced.update(plural_names)
+
+        # the fallback block is what makes the translation conditional,
+        # so a tag without one is an error
+        if not parser.stream.current.test("name:fallback"):
+            parser.fail("expected 'fallback' block before 'endctrans'")
+
+        next(parser.stream)
+        parser.stream.expect("block_end")
+        fallback_names, fallback = self._parse_block(parser, False)
+        if not parser.stream.current.test("name:endctrans"):
+            parser.fail("a conditional translation can have only one fallback section")
+
+        # skip endctrans, the block end is left to the parser
+        next(parser.stream)
+
+        # register free names as simple name expressions
+        for name in referenced:
+            if name not in variables:
+                variables[name] = nodes.Name(name, "load")
+
+        # the fallback uses its own variables: only the ones its text
+        # names, so a value is not computed when nothing shows it
+        fallback_variables = {
+            name: variables[name] if name in variables else nodes.Name(name, "load")
+            for name in fallback_names
+        }
+
+        if not have_plural:
+            plural_expr = None
+        elif plural_expr is None:
+            parser.fail("pluralize without variables", lineno)
+
+        # a call that gives the plural count is computed once, before the
+        # translation, and its result used for both the count and the
+        # variable of the same value
+        plural_expr_assignment: t.Optional[nodes.Assign] = None
+        if isinstance(plural_expr, nodes.Call):
+            plural_expr_assignment = nodes.Assign(
+                nodes.Name("_trans", "store"), plural_expr
+            )
+            variables = {
+                key: nodes.Name("_trans", "load") if value is plural_expr else value
+                for key, value in variables.items()
+            }
+            plural_expr = nodes.Name("_trans", "load")
+
+        if trimmed is None:
+            trimmed = self.environment.policies.get("ext.i18n.trimmed", False)
+        if trimmed:
+            singular = self._trim_whitespace(singular)
+            if plural:
+                plural = self._trim_whitespace(plural)
+            fallback = self._trim_whitespace(fallback)
+
+        node = self._make_conditional_node(
+            condition,
+            singular,
+            plural,
+            fallback,
+            variables,
+            fallback_variables,
+            plural_expr,
+            num_called_num and have_plural,
+            plural_expr_assignment,
+        )
+        node.set_lineno(lineno)
+        return node
+
+    def _trim_whitespace(self, string: str, _ws_re: t.Pattern[str] = _ws_re) -> str:
+        return _ws_re.sub(" ", string.strip())
+
+    def _parse_block(
+        self, parser: "Parser", allow_pluralize: bool
+    ) -> t.Tuple[t.List[str], str]:
+        """Parse until the next ``pluralize``, ``fallback`` or
+        ``endctrans`` tag, which is left as the current token.
+        """
+        referenced = []
+        buf = []
+
+        while True:
+            if parser.stream.current.type == "data":
+                buf.append(parser.stream.current.value.replace("%", "%%"))
+                next(parser.stream)
+            elif parser.stream.current.type == "variable_begin":
+                next(parser.stream)
+                name = parser.stream.expect("name").value
+                referenced.append(name)
+                buf.append(f"%({name})s")
+                parser.stream.expect("variable_end")
+            elif parser.stream.current.type == "block_begin":
+                next(parser.stream)
+                if parser.stream.current.test_any("name:endctrans", "name:fallback"):
+                    break
+                elif parser.stream.current.test("name:pluralize"):
+                    if allow_pluralize:
+                        break
+                    parser.fail(
+                        "a conditional translation can have only one pluralize"
+                        " section, and it must come before the fallback section"
+                    )
+                parser.fail(
+                    "control structures in translatable sections are not allowed"
+                )
+            elif parser.stream.eos:
+                parser.fail("unclosed conditional translation block")
+            else:
+                raise RuntimeError("internal parser error")
+
+        return referenced, concat(buf)
+
+    def _make_conditional_node(
+        self,
+        condition: nodes.Expr,
+        singular: str,
+        plural: t.Optional[str],
+        fallback: str,
+        variables: t.Dict[str, nodes.Expr],
+        fallback_variables: t.Dict[str, nodes.Expr],
+        plural_expr: t.Optional[nodes.Expr],
+        num_called_num: bool,
+        plural_expr_assignment: t.Optional[nodes.Assign] = None,
+    ) -> nodes.If:
+        """Generates an ``If`` node that renders the translation when
+        the condition is true and the fallback otherwise.
+        """
+        newstyle = getattr(self.environment, "newstyle_gettext", False)
+        node: nodes.Expr
+
+        # no variables?  no need to escape for old style gettext
+        # invocations, which only format when there are vars.
+        if not variables and not newstyle:
+            singular = singular.replace("%%", "%")
+            if plural:
+                plural = plural.replace("%%", "%")
+
+        # singular only:
+        if plural_expr is None:
+            gettext = nodes.Name("gettext", "load")
+            node = nodes.Call(gettext, [nodes.Const(singular)], [], None, None)
+
+        # singular and plural
+        else:
+            ngettext = nodes.Name("ngettext", "load")
+            node = nodes.Call(
+                ngettext,
+                [nodes.Const(singular), nodes.Const(plural), plural_expr],
+                [],
+                None,
+                None,
+            )
+
+        # in case newstyle gettext is used, the method is powerful
+        # enough to handle the variable expansion and autoescape
+        # handling itself
+        if newstyle:
+            for key, value in variables.items():
+                # the function adds that later anyways in case num was
+                # called num, so just skip it.
+                if num_called_num and key == "num":
+                    continue
+                node.kwargs.append(nodes.Keyword(key, value))
+
+        # otherwise do that here
+        else:
+            # mark the return value as safe if we are in an
+            # environment with autoescaping turned on
+            node = nodes.MarkSafeIfAutoescape(node)
+            if variables:
+                node = nodes.Mod(node, self._make_dict(variables))
+
+        translated: t.List[nodes.Node] = []
+        if plural_expr_assignment is not None:
+            translated.append(plural_expr_assignment)
+        translated.append(nodes.Output([node]))
+
+        # the fallback is never translated, so the formatting is done
+        # here whatever the style of gettext
+        if not fallback_variables:
+            fallback = fallback.replace("%%", "%")
+        node = nodes.MarkSafeIfAutoescape(nodes.Const(fallback))
+        if fallback_variables:
+            node = nodes.Mod(node, self._make_dict(fallback_variables))
+
+        return nodes.If(condition, translated, [], [nodes.Output([node])])
+
+    def _make_dict(self, variables: t.Dict[str, nodes.Expr]) -> nodes.Dict:
+        return nodes.Dict(
+            [nodes.Pair(nodes.Const(key), value) for key, value in variables.items()]
+        )
+
+
 def extract_from_ast(
     ast: nodes.Template,
     gettext_functions: t.Sequence[str] = GETTEXT_FUNCTIONS,
@@ -852,3 +1196,4 @@ i18n = InternationalizationExtension
