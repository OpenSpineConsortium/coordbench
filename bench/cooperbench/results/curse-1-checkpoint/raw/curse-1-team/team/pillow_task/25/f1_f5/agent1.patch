+    def _mark_corners(self) -> None:
+        """
+        Sets the top-left and bottom-right pixels to red, or to the closest
+        equivalent in modes that have no red. See the ``mark_corners`` option
+        of :py:meth:`~PIL.Image.Image.save`.
+        """
+        if not self.width or not self.height:
+            return
+
+        red: Any = (255, 0, 0)
+        if self.mode in ("P", "PA"):
+            index = self._palette_index_of_red()
+            red = (index, 255) if self.mode == "PA" else index
+        elif self.mode != "RGB":
+            red = new("RGB", (1, 1), red).convert(self.mode).getpixel((0, 0))
+
+        self.putpixel((0, 0), red)
+        self.putpixel((self.width - 1, self.height - 1), red)
+
+    def _palette_index_of_red(self) -> int:
+        self.load()
+        try:
+            assert self.palette is not None
+            return self.palette.getcolor((255, 0, 0), self)
+        except ValueError:
+            # The palette is full, or holds raw data that cannot take a new
+            # colour: use the entry already there that is closest to red
+            palette = self.getpalette("RGB") or [0, 0, 0]
+            distances = [
+                (255 - r) ** 2 + g**2 + b**2
+                for r, g, b in zip(palette[0::3], palette[1::3], palette[2::3])
+            ]
+            return distances.index(min(distances))
+
     def remap_palette(
