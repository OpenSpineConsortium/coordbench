+def test_lightness_factor_default():
+    image = hopper()
+    expected = image.quantize()
+
+    for converted in (image.quantize(lightness_factor=1.0), image.quantize()):
+        assert converted.tobytes() == expected.tobytes()
+        assert converted.getpalette() == expected.getpalette()
+
+
+def test_lightness_factor_brighter_and_darker():
+    image = hopper()
+    original = image.quantize()
+    brighter = image.quantize(lightness_factor=1.5)
+    darker = image.quantize(lightness_factor=0.5)
+
+    # Only the palette changes, so the indexes of the pixels stay the same
+    assert_image(brighter, "P", original.size)
+    assert brighter.tobytes() == original.tobytes()
+    assert darker.tobytes() == original.tobytes()
+
+    for before, after_bright, after_dark in zip(
+        original.getpalette(), brighter.getpalette(), darker.getpalette()
+    ):
+        assert after_bright == min(255, int(before * 1.5))
+        assert after_dark == int(before * 0.5)
+
+    assert sum(brighter.getpalette()) > sum(original.getpalette())
+    assert sum(darker.getpalette()) < sum(original.getpalette())
+
+    # The color count is not changed, and the image really is brighter
+    assert len(brighter.getcolors()) == len(original.getcolors())
+    assert sum(brighter.convert("L").getdata()) > sum(original.convert("L").getdata())
+
+
+def test_lightness_factor_clamps():
+    image = hopper()
+    original = image.quantize()
+
+    for factor in (1000, float("inf")):
+        converted = image.quantize(lightness_factor=factor)
+        for before, after in zip(original.getpalette(), converted.getpalette()):
+            assert after == (0 if before == 0 else 255)
+
+    converted = image.quantize(lightness_factor=1e-9)
+    assert set(converted.getpalette()) == {0}
+
+
+@pytest.mark.parametrize("factor", (0, -1, -0.5, float("nan")))
+def test_lightness_factor_invalid(factor):
+    image = hopper()
+    with pytest.raises(ValueError):
+        image.quantize(lightness_factor=factor)
+
+    # The factor is checked whichever way the image is quantized
+    with pytest.raises(ValueError):
+        image.quantize(palette=hopper("P"), lightness_factor=factor)
+    with pytest.raises(ValueError):
+        image.quantize(100, Image.FASTOCTREE, lightness_factor=factor)
+
+
+def test_lightness_factor_with_palette():
+    image = hopper()
+    with Image.open("Tests/images/caption_6_33_22.png") as palette:
+        palette = palette.convert("P")
+
+    original = image.quantize(dither=0, palette=palette)
+    converted = image.quantize(dither=0, palette=palette, lightness_factor=0.5)
+
+    assert_image(converted, "P", original.size)
+    assert converted.tobytes() == original.tobytes()
+    assert converted.getpalette() == [int(v * 0.5) for v in original.getpalette()]
+    # The reference palette is left alone
+    assert palette.palette.palette != converted.palette.palette
+
+    # The palette's own copy and the image's palette agree
+    assert converted.convert("RGB").getpixel((0, 0)) == tuple(
+        converted.getpalette()[converted.getpixel((0, 0)) * 3 :][:3]
+    )
+
+
+def test_lightness_factor_rgba_keeps_alpha():
+    image = hopper("RGBA")
+    image.putalpha(Image.linear_gradient("L").resize(image.size))
+
+    original = image.quantize()
+    converted = image.quantize(lightness_factor=0.5)
+
+    mode, before = _palette_channels(original)
+    assert mode == "RGBA"
+    _, after = _palette_channels(converted)
+
+    assert after[3::4] == before[3::4]
+    for band in range(3):
+        assert list(after[band::4]) == [int(v * 0.5) for v in before[band::4]]
+
+    # Pixels read the adjusted palette, with the same alpha as before
+    original_px = original.convert("RGBA").getdata()
+    converted_px = converted.convert("RGBA").getdata()
+    for (r, g, b, a), (r2, g2, b2, a2) in zip(original_px, converted_px):
+        assert (int(r * 0.5), int(g * 0.5), int(b * 0.5), a) == (r2, g2, b2, a2)
+
+
+def test_lightness_factor_image_palette_in_sync(tmp_path):
+    converted = hopper().quantize(16, lightness_factor=1.2)
+
+    # The palette that the image keeps and the one that the pixels are drawn
+    # with must be the same, or a saved file would use the old colors
+    assert list(converted.palette.palette) == converted.getpalette()
+
+    out = str(tmp_path / "out.png")
+    converted.save(out)
+    with Image.open(out) as reloaded:
+        assert reloaded.convert("RGB").tobytes() == converted.convert("RGB").tobytes()
+
+
+def _palette_colors(im, count):
+    palette = im.getpalette()
+    return [tuple(palette[i * 3 : i * 3 + 3]) for i in range(count)]
+
+
+def _brightness(color):
+    return 0.299 * color[0] + 0.587 * color[1] + 0.114 * color[2]
+
+
+def test_sort_palette_default_keeps_order():
+    image = hopper()
+    default = image.quantize(16)
+    assert default.tobytes() == image.quantize(16, sort_palette=None).tobytes()
+    assert default.getpalette() == image.quantize(16, sort_palette=None).getpalette()
+
+
+@pytest.mark.parametrize(
+    "method", (Image.MEDIANCUT, Image.MAXCOVERAGE, Image.FASTOCTREE)
+)
+def test_sort_palette_brightness(method):
+    image = hopper()
+    unsorted = image.quantize(16, method)
+    converted = image.quantize(16, method, sort_palette="brightness")
+    assert_image(converted, "P", converted.size)
+
+    colors = _palette_colors(converted, 16)
+    brightness = [_brightness(color) for color in colors]
+    assert brightness == sorted(brightness)
+
+    # The same colors in a new order, and the image looks the same
+    assert sorted(colors) == sorted(_palette_colors(unsorted, 16))
+    assert converted.convert("RGB").tobytes() == unsorted.convert("RGB").tobytes()
+
+
+def test_sort_palette_rgb():
+    image = hopper()
+    unsorted = image.quantize(16)
+    converted = image.quantize(16, sort_palette="rgb")
+
+    colors = _palette_colors(converted, 16)
+    assert colors == sorted(colors)
+    assert converted.convert("RGB").tobytes() == unsorted.convert("RGB").tobytes()
+
+
+def test_sort_palette_rgba():
+    image = hopper("RGBA")
+    image.putalpha(Image.linear_gradient("L").resize(image.size))
+    unsorted = image.quantize(16)
+    converted = image.quantize(16, sort_palette="brightness")
+
+    assert converted.palette.mode == "RGBA"
+    palette = converted.im.getpalette("RGBA", "RGBA")
+    colors = [tuple(palette[i * 4 : i * 4 + 4]) for i in range(16)]
+    brightness = [_brightness(color) for color in colors]
+    assert brightness == sorted(brightness)
+    assert converted.convert("RGBA").tobytes() == unsorted.convert("RGBA").tobytes()
+
+
+def test_sort_palette_few_colors():
+    # Unused entries at the end of the palette are not sorted in among the colors
+    image = Image.new("RGB", (2, 1), (200, 200, 200))
+    image.putpixel((1, 0), (10, 20, 30))
+
+    converted = image.quantize(256, sort_palette="brightness")
+
+    assert converted.getpalette()[:6] == [10, 20, 30, 200, 200, 200]
+    assert list(converted.getdata()) == [1, 0]
+    assert converted.convert("RGB").tobytes() == image.tobytes()
+
+
+def test_sort_palette_with_palette():
+    image = hopper()
+    with Image.open("Tests/images/caption_6_33_22.png") as palette:
+        palette = palette.convert("P")
+
+    unsorted = image.quantize(dither=0, palette=palette)
+    converted = image.quantize(dither=0, palette=palette, sort_palette="brightness")
+
+    assert_image(converted, "P", converted.size)
+    assert converted.convert("RGB").tobytes() == unsorted.convert("RGB").tobytes()
+    used = max(converted.getdata()) + 1
+    colors = _palette_colors(converted, used)
+    brightness = [_brightness(color) for color in colors]
+    assert brightness == sorted(brightness)
+
+
+def test_sort_palette_invalid():
+    image = hopper()
+    with pytest.raises(ValueError):
+        image.quantize(16, sort_palette="hue")
+    with pytest.raises(ValueError):
+        image.quantize(16, sort_palette=True)
+
+
+def test_sort_palette_after_lightness_factor():
+    image = hopper()
+    converted = image.quantize(16, lightness_factor=0.5, sort_palette="brightness")
+
+    colors = _palette_colors(converted, 16)
+    brightness = [_brightness(color) for color in colors]
+    assert brightness == sorted(brightness)
+
+    # The same image as without sorting, with the same darker colors
+    darker = image.quantize(16, lightness_factor=0.5)
+    assert converted.convert("RGB").tobytes() == darker.convert("RGB").tobytes()
