+    def _quantize_error(self, quantized):
+        """
+        Mean square error per channel between this image and its quantized
+        version, with channel values from 0 to 255. The comparison is made in
+        "RGBA" for an "RGBA" image and in "RGB" for any other.
+        """
+        from . import ImageChops
+
+        mode = "RGBA" if self.mode == "RGBA" else "RGB"
+        difference = ImageChops.difference(self.convert(mode), quantized.convert(mode))
+        samples = self.width * self.height * len(mode)
+        if not samples:
+            return 0.0
+
+        # The histogram lists the 256 values of each channel one after the other.
+        squares = sum(
+            (index % 256) ** 2 * count
+            for index, count in enumerate(difference.histogram())
+        )
+        return squares / samples
+
+    def _quantize_to_threshold(self, colors, method, kmeans, error_threshold):
+        if not 1 <= colors <= 256:
+            raise ValueError("bad number of colors")
+
+        # More colors lower the error, nearly always, so look for the fewest
+        # that meet the threshold by bisection. Only a result that was measured
+        # to meet it is returned, whatever the error does in between.
+        candidates = {}
+
+        def quantized(count):
+            if count not in candidates:
+                candidates[count] = self._new(self.im.quantize(count, method, kmeans))
+            return candidates[count]
+
+        best = None
+        low, high = 1, colors
+        while low <= high:
+            middle = (low + high) // 2
+            candidate = quantized(middle)
+            if self._quantize_error(candidate) <= error_threshold:
+                best = candidate
+                high = middle - 1
+            else:
+                low = middle + 1
+
+        # No count met the threshold: use as many colors as allowed.
+        return best if best is not None else quantized(colors)
+
