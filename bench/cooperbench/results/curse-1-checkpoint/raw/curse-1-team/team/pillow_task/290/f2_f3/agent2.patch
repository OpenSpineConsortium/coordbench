+
+
+def palette_colors(im, count):
+    palette = im.getpalette()
+    return [tuple(palette[i : i + 3]) for i in range(0, count * 3, 3)]
+
+
+def brightness(color):
+    red, green, blue = color
+    return 0.299 * red + 0.587 * green + 0.114 * blue
+
+
+@pytest.mark.parametrize("method", (None, Image.MEDIANCUT, Image.FASTOCTREE))
+def test_sort_palette_brightness(method):
+    image = hopper()
+    unsorted = image.quantize(16, method)
+    converted = image.quantize(16, method, sort_palette="brightness")
+
+    assert_image(converted, "P", converted.size)
+    colors = palette_colors(converted, 16)
+    assert [brightness(color) for color in colors] == sorted(
+        brightness(color) for color in colors
+    )
+
+    # the same colors, so each pixel still looks as it did
+    assert sorted(colors) == sorted(palette_colors(unsorted, 16))
+    assert converted.convert("RGB").tobytes() == unsorted.convert("RGB").tobytes()
+
+
+@pytest.mark.parametrize("method", (None, Image.MEDIANCUT, Image.FASTOCTREE))
+def test_sort_palette_rgb(method):
+    image = hopper()
+    unsorted = image.quantize(16, method)
+    converted = image.quantize(16, method, sort_palette="rgb")
+
+    assert_image(converted, "P", converted.size)
+    colors = palette_colors(converted, 16)
+    assert colors == sorted(colors)
+
+    assert sorted(colors) == sorted(palette_colors(unsorted, 16))
+    assert converted.convert("RGB").tobytes() == unsorted.convert("RGB").tobytes()
+
+
+def test_sort_palette_full_palette():
+    image = hopper()
+    converted = image.quantize(sort_palette="brightness")
+
+    colors = palette_colors(converted, 256)
+    assert [brightness(color) for color in colors] == sorted(
+        brightness(color) for color in colors
+    )
+    unsorted = image.quantize()
+    assert converted.convert("RGB").tobytes() == unsorted.convert("RGB").tobytes()
+
+
+def test_sort_palette_default_order():
+    image = hopper()
+    default = image.quantize(16)
+
+    converted = image.quantize(16, sort_palette=None)
+    assert converted.tobytes() == default.tobytes()
+    assert converted.getpalette() == default.getpalette()
+
+
+def test_sort_palette_invalid():
+    image = hopper()
+    for sort_palette in ("unknown", "Brightness", "", 1, ["rgb"]):
+        with pytest.raises(ValueError):
+            image.quantize(16, sort_palette=sort_palette)
+
+    # also when the palette of another image is used instead
+    with pytest.raises(ValueError):
+        image.quantize(palette=hopper("P"), sort_palette="unknown")
+
+
+def test_sort_palette_fewer_colors_than_asked():
+    image = Image.new("RGB", (3, 1))
+    image.putdata([(200, 200, 200), (10, 20, 30), (100, 0, 0)])
+
+    converted = image.quantize(16, sort_palette="brightness")
+
+    assert converted.getpalette()[:9] == [10, 20, 30, 100, 0, 0, 200, 200, 200]
+    assert list(converted.getdata()) == [2, 0, 1]
+    # the padding is not sorted in among the colors
+    assert converted.getpalette()[9:] == [0] * (768 - 9)
+    assert converted.convert("RGB").tobytes() == image.tobytes()
+
+    converted = image.quantize(16, sort_palette="rgb")
+
+    assert converted.getpalette()[:9] == [10, 20, 30, 100, 0, 0, 200, 200, 200]
+    assert list(converted.getdata()) == [2, 0, 1]
+
+
+def test_sort_palette_orders_differ():
+    image = Image.new("RGB", (2, 1))
+    image.putdata([(255, 0, 0), (0, 255, 0)])
+
+    # green is brighter than red, but red comes first by value
+    brightness_sorted = image.quantize(2, sort_palette="brightness")
+    assert brightness_sorted.getpalette()[:6] == [255, 0, 0, 0, 255, 0]
+
+    rgb_sorted = image.quantize(2, sort_palette="rgb")
+    assert rgb_sorted.getpalette()[:6] == [0, 255, 0, 255, 0, 0]
+
+
+def test_sort_palette_rgba():
+    image = hopper("RGBA")
+    image.putalpha(Image.linear_gradient("L").resize(image.size))
+    unsorted = image.quantize(16)
+
+    for sort_palette in ("brightness", "rgb"):
+        converted = image.quantize(16, sort_palette=sort_palette)
+
+        assert_image(converted, "P", converted.size)
+        assert converted.im.getpalettemode() == "RGBA"
+
+        palette = converted.im.getpalette("RGBA", "RGBA")
+        colors = [tuple(palette[i : i + 4]) for i in range(0, 16 * 4, 4)]
+        assert len({color[3] for color in colors}) > 1
+        if sort_palette == "brightness":
+            keys = [brightness(color[:3]) for color in colors]
+        else:
+            keys = colors
+        assert keys == sorted(keys)
+
+        # each pixel kept its color, and its alpha with it
+        assert converted.convert("RGBA").tobytes() == unsorted.convert("RGBA").tobytes()
+
+
+def test_sort_palette_ignored_with_palette():
+    image = hopper()
+    palette = hopper("P")
+
+    converted = image.quantize(palette=palette, sort_palette="brightness")
+
+    assert converted.getpalette() == palette.getpalette()
+    assert converted.tobytes() == image.quantize(palette=palette).tobytes()
+
+
+def test_max_colors_default_matches_colors():
+    image = hopper()
+    default = image.quantize(100)
+    explicit = image.quantize(100, max_colors=100)
+
+    assert explicit.tobytes() == default.tobytes()
+    assert explicit.getpalette() == default.getpalette()
+
+
+def test_max_colors_lowers_target():
+    image = hopper()
+    converted = image.quantize(colors=100, max_colors=50)
+
+    assert_image(converted, "P", converted.size)
+    assert len(converted.getcolors()) <= 50
+    assert_image_similar(converted.convert("RGB"), image, 30)
+
+    # The limit gives the same result as asking for that many colors directly
+    assert converted.tobytes() == image.quantize(50).tobytes()
+
+
+def test_max_colors_does_not_raise_target():
+    image = hopper()
+    converted = image.quantize(colors=20, max_colors=200)
+
+    assert len(converted.getcolors()) <= 20
+
+
+@pytest.mark.parametrize(
+    "method", (Image.MEDIANCUT, Image.MAXCOVERAGE, Image.FASTOCTREE)
+)
+def test_max_colors_methods(method):
+    converted = hopper().quantize(colors=64, method=method, max_colors=16)
+
+    assert_image(converted, "P", converted.size)
+    assert len(converted.getcolors()) <= 16
+
+
+def test_max_colors_rgba():
+    converted = hopper("RGBA").quantize(colors=100, max_colors=30)
+
+    assert len(converted.getcolors()) <= 30
+
+
+def test_max_colors_invalid():
+    image = hopper()
+    with pytest.raises(ValueError):
+        image.quantize(colors=100, max_colors=0)
+    with pytest.raises(ValueError):
+        image.quantize(colors=100, max_colors=-1)
+
+
+def test_max_colors_ignored_with_palette():
+    image = hopper()
+    palette = hopper("P")
+
+    converted = image.quantize(palette=palette, max_colors=2)
+    assert converted.palette.palette == palette.palette.palette
+
+
+def test_max_colors_with_sort_palette():
+    image = hopper()
+    converted = image.quantize(colors=64, max_colors=16, sort_palette="brightness")
+
+    assert len(converted.getcolors()) <= 16
+    unsorted = image.quantize(colors=64, max_colors=16)
+    assert converted.convert("RGB").tobytes() == unsorted.convert("RGB").tobytes()
