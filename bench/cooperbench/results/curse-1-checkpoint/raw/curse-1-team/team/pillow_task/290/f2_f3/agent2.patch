+    def _sort_palette(self, sort_palette):
+        """
+        Orders the palette of a quantized 'P' image, and renumbers the pixels
+        to match, so that every pixel keeps the color it had.
+
+        :param sort_palette: ``"brightness"`` or ``"rgb"``, as for
+           :py:meth:`~PIL.Image.Image.quantize`.
+        :returns: A new image
+        """
+        from . import ImagePalette
+
+        mode = self.im.getpalettemode()
+        size = len(mode)
+        palette_bytes = self.im.getpalette(mode, mode)
+
+        # The quantizer fills the palette from the start and pads the rest with
+        # zeros, so only the entries up to the highest index in use are colors.
+        used = self.getextrema()[1] + 1
+        colors = [palette_bytes[i : i + size] for i in range(0, used * size, size)]
+
+        def brightness(index):
+            red, green, blue = colors[index][:3]
+            return 0.299 * red + 0.587 * green + 0.114 * blue
+
+        # Colors compare one byte at a time: red, green, blue, then alpha
+        key = brightness if sort_palette == "brightness" else colors.__getitem__
+        order = sorted(range(used), key=key)
+
+        # old index -> new index, for the pixels
+        lookup = list(range(256))
+        for new_index, old_index in enumerate(order):
+            lookup[old_index] = new_index
+        sorted_im = self.point(lookup)
+
+        padding = palette_bytes[used * size :]
+        palette_bytes = b"".join(colors[index] for index in order) + padding
+        # The core image takes its palette without alpha, then the alpha apart
+        sorted_im.im.putpalette("RGBX" if size == 4 else "RGB", palette_bytes)
+        if mode == "RGBA":
+            sorted_im.im.putpalettealphas(palette_bytes[3::4])
+        sorted_im.palette = ImagePalette.ImagePalette(mode, palette_bytes)
+
+        return sorted_im
+
