+
+        mode = self.im.getpalettemode()
+        size = len(mode)
+        data = self.im.getpalette(mode, mode)
+
+        histogram = self.histogram()
+        used = max((i for i, count in enumerate(histogram) if count), default=-1) + 1
+        entries = [tuple(data[i * size : (i + 1) * size]) for i in range(used)]
+
+        key = _PALETTE_SORT_KEYS[sort_palette]
+        order = sorted(range(used), key=lambda i: key(entries[i]))
+
