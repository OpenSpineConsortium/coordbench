-            .graphemes(true)
+    pub fn first(
+        &self,
+        /// A string of characters to strip from the start of the string before
+        /// the first grapheme cluster is extracted.
+        #[named]
+        strip: Option<Str>,
+        /// A default value to return if the string is empty.
+        #[named]
+        default: Option<Str>,
+    ) -> StrResult<Str> {
+        let text = match &strip {
+            Some(set) => self.as_str().trim_start_matches(|c| set.as_str().contains(c)),
+            None => self.0.as_str(),
+        };
+        text.graphemes(true)
             .next()
             .map(Into::into)
+            .or(default)
             .ok_or_else(string_is_empty)
     }
 
