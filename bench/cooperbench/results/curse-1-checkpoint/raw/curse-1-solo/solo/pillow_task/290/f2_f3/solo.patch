+    def _sorted_palette(self, sort_palette):
+        """
+        Returns a copy of this 'P' image whose palette entries are ordered by
+        the named key in ``_PALETTE_SORT_KEYS``, with the pixels renumbered so
+        that every pixel keeps its color. The entries the image uses come first,
+        in sorted order; the unused ones follow in their old order, so the
+        quantizer's empty padding never lands among the real colors.
+        """
+        from . import ImagePalette
+
+        mode = self.palette.mode
+        size = len(mode)
+        data = self.palette.palette
+        entries = [tuple(data[i : i + size]) for i in range(0, len(data), size)]
+
+        used = sorted(index for _, index in self.getcolors())
+        unused = [i for i in range(len(entries)) if i not in used]
+        key = _PALETTE_SORT_KEYS[sort_palette]
+        order = sorted(used, key=lambda i: key(entries[i])) + unused
+
+        # order[new] is the old index; the lookup table goes the other way
+        lut = list(range(256))
+        for new, old in enumerate(order):
+            lut[old] = new
+
+        sorted_im = self.point(lut)
+        colors = [entries[old] for old in order]
+        sorted_im.im.putpalette("RGB", bytes(v for color in colors for v in color[:3]))
+        if mode == "RGBA":
+            sorted_im.im.putpalettealphas(bytes(color[3] for color in colors))
+        sorted_im.palette = ImagePalette.ImagePalette(
+            mode, bytes(v for color in colors for v in color)
+        )
+        return sorted_im
