+    def _mark_corners(self) -> Callable[[], None]:
+        """
+        Sets the top-left and bottom-right pixels to red, for the
+        ``mark_corners`` option of :py:meth:`~PIL.Image.Image.save`.
+
+        :returns: A function that puts the two pixels back as they were, unless
+           the image has been reloaded in the meantime (as a seek does).
+        """
+        from . import ImageColor
+
+        width, height = self.size
+        if not width or not height:
+            return lambda: None
+
+        red: int | tuple[int, ...]
+        if self.mode == "CMYK":
+            red = (0, 255, 255, 0)
+        elif self.mode == "1":
+            # No colour fits in a bilevel image: white shows on the usual black
+            red = 255
+        else:
+            red = ImageColor.getcolor("red", self.mode)
+
+        corners = [(0, 0), (width - 1, height - 1)]
+        original = [self.getpixel(xy) for xy in corners]
+        for xy in corners:
+            # a readonly image is copied here, and it is the copy that is saved
+            self.putpixel(xy, red)
+        marked = self.im
+
+        def unmark() -> None:
+            if self.im is marked:
+                for xy, value in zip(corners, original):
+                    self.putpixel(xy, value)
+
+        return unmark
+
