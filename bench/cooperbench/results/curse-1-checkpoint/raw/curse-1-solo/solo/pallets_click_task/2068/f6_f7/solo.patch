+# The priority names the editor accepts, mapped to what each one means on
+# the two kinds of platform. On Unix-like systems it is the amount added to
+# the process's niceness (a higher niceness means less CPU), so the setting
+# is relative to the process that launches the editor. On Windows it is the
+# value of the matching ``*_PRIORITY_CLASS`` process creation flag, written
+# out because ``subprocess`` only defines those constants on Windows.
+_PRIORITY_NICE_INCREMENT: dict[str, int] = {
+    "low": 19,
+    "below_normal": 10,
+    "normal": 0,
+    "above_normal": -5,
+    "high": -10,
+}
+_PRIORITY_WINDOWS_FLAG: dict[str, int] = {
+    "low": 0x00000040,  # IDLE_PRIORITY_CLASS
+    "below_normal": 0x00004000,  # BELOW_NORMAL_PRIORITY_CLASS
+    "normal": 0x00000020,  # NORMAL_PRIORITY_CLASS
+    "above_normal": 0x00008000,  # ABOVE_NORMAL_PRIORITY_CLASS
+    "high": 0x00000080,  # HIGH_PRIORITY_CLASS
+}
+
+
+def _shell_quote(arg: str) -> str:
+    """Quote one argument so the shell reads it as a single literal word."""
+    if WIN:
+        # cmd.exe does not understand POSIX quoting, and a file name
+        # cannot contain a double quote there, so wrapping in double
+        # quotes keeps ``&``, ``|`` and spaces literal.
+        return '"' + arg.replace('"', '""') + '"'
+
+    import shlex
+
+    return shlex.quote(arg)
+
+
+def _split_editor(editor: str) -> list[str]:
+    """Split an editor setting such as ``code --wait`` into its words."""
+    import shlex
+
+    try:
+        words = shlex.split(editor, posix=not WIN)
+    except ValueError:
+        # Unbalanced quotes: keep the whole setting as one word, which the
+        # shell then fails to find instead of running part of it.
+        return [editor]
+
+    if WIN:
+        # Without POSIX rules the quotes stay in the words; they are put
+        # back when the words are quoted again.
+        words = [w[1:-1] if len(w) > 1 and w[0] == w[-1] == '"' else w for w in words]
+
+    return words or [editor]
+
