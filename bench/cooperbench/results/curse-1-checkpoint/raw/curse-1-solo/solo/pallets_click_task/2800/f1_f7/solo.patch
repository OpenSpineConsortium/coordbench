@@ -606,10 +630,37 @@ class Context:
         """Invoke all close callbacks registered with
         :meth:`call_on_close`, and exit all context managers entered
         with :meth:`with_resource`.
+
+        If :attr:`validate_nesting` is enabled and a child context made
+        from this one is still open, the callbacks and context managers
+        still run, so no resource is left behind, and then
+        :exc:`RuntimeError` is raised naming the open children.
+
+        .. versionchanged:: 8.2
+            Raises :exc:`RuntimeError` for open children when
+            :attr:`validate_nesting` is enabled.
         """
-        self._exit_stack.close()
-        # In case the context is reused, create a new exit stack.
-        self._exit_stack = ExitStack()
+        try:
+            self._exit_stack.close()
+            # In case the context is reused, create a new exit stack.
+            self._exit_stack = ExitStack()
+        finally:
+            # A closed context is no longer a parent's open child, even
+            # when one of its callbacks failed.
+            if self.parent is not None:
+                self.parent._open_children.pop(id(self), None)
+
+        if self.validate_nesting and self._open_children:
+            names = ", ".join(
+                repr(child.info_name or child.command.name or "<unnamed>")
+                for child in self._open_children.values()
+            )
+            raise RuntimeError(
+                f"Cannot close the context for"
+                f" {self.info_name or self.command.name or '<unnamed>'!r}"
+                f" while {len(self._open_children)} child context(s) are"
+                f" still open: {names}."
+            )
 
