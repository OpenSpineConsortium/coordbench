--- a/outlines/types/__init__.py
+++ b/outlines/types/__init__.py
@@ -68,3 +68,27 @@ email = Regex(
 isbn = Regex(
     r"(?:ISBN(?:-1[03])?:? )?(?=[0-9X]{10}$|(?=(?:[0-9]+[- ]){3})[- 0-9X]{13}$|97[89][0-9]{10}$|(?=(?:[0-9]+[- ]){4})[- 0-9]{17}$)(?:97[89][- ]?)?[0-9]{1,5}[- ]?[0-9]+[- ]?[0-9]+[- ]?[0-9X]"
 )
+
+# Matches HTTP and HTTPS web URLs: a scheme, a host, then an optional port,
+# path, query and fragment. The host is either a domain name (dot-separated
+# labels of letters, digits and inner hyphens, ending in a top-level domain
+# that starts with a letter, so short domains such as `a.co` match) or an IPv4
+# address whose four octets are at most 255. Neither `localhost` nor a host
+# with a user name is accepted. The path, query and fragment take any
+# character but whitespace, which keeps `?` and `#` in their own parts.
+url = Regex(
+    r"https?://"
+    r"(([a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?\.)+[a-zA-Z]([a-zA-Z0-9-]*[a-zA-Z0-9])?"
+    r"|((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])\.){3}"
+    r"(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9]))"
+    r"(:[0-9]{1,5})?"
+    r"(/[^\s?#]*)?"
+    r"(\?[^\s#]*)?"
+    r"(#[^\s]*)?"
+)
+
+# Matches a 16-digit credit card number written as four groups of four digits.
+# The groups are either joined with no separator, with a single space between
+# each pair, or with a single hyphen between each pair; mixing separators is
+# refused. Only the format is checked, not the Luhn checksum or the issuer.
+credit_card = Regex(r"[0-9]{16}|([0-9]{4}-){3}[0-9]{4}|([0-9]{4} ){3}[0-9]{4}")
