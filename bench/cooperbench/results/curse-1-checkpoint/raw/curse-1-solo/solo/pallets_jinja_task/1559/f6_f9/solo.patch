+    def bind(self, environment: Environment) -> "Extension":
+        """Bind a copy of this extension to another environment, such as
+        an overlay.  The copy gets a cache of its own, since the default
+        copy would share the dict and list of this one.
+        """
+        rv = super().bind(environment)
+        t.cast(InternationalizationExtension, rv)._init_cache()
+        return rv
+
+    def _init_cache(self) -> None:
+        """Create an empty translation cache sized by the environment's
+        ``i18n_cache_size``.
+        """
+        self._cache: t.Dict[str, str] = {}
+        # Keys from least to most recently used.
+        self._cache_order: t.List[str] = []
+        self._cache_size = 128
+        self._cache_lock = threading.RLock()
+        self._update_cache_size()
+
+    def _update_cache_size(self) -> None:
+        """Read the capacity from ``environment.i18n_cache_size`` and
+        evict the oldest entries if the cache now holds more than that.
+        A size of zero or less turns the cache off.
+        """
+        size = getattr(self.environment, "i18n_cache_size", 128)
+
+        with self._cache_lock:
+            self._cache_size = max(0, int(size))
+            self._evict_excess()
+
+    def _evict_excess(self) -> None:
+        while len(self._cache_order) > self._cache_size:
+            del self._cache[self._cache_order.pop(0)]
+
+    def _get_from_cache(self, key: str) -> t.Optional[str]:
+        """Return the cached result for ``key``, or ``None`` if there is
+        none, and mark the entry as the most recently used.
+        """
+        with self._cache_lock:
+            if key not in self._cache:
+                return None
+
+            self._cache_order.remove(key)
+            self._cache_order.append(key)
+            return self._cache[key]
+
+    def _put_in_cache(self, key: str, value: str) -> None:
+        """Store ``value`` under ``key`` as the most recently used entry,
+        evicting the least recently used ones beyond the capacity.
+        """
+        with self._cache_lock:
+            if self._cache_size <= 0:
+                return
+
+            if key in self._cache:
+                self._cache_order.remove(key)
+
+            self._cache[key] = value
+            self._cache_order.append(key)
+            self._evict_excess()
+
+    def clear_cache(self) -> None:
+        """Remove all cached translation results."""
+        with self._cache_lock:
+            self._cache.clear()
+            self._cache_order.clear()
 
