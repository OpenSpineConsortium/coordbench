+class ConditionalI18nExtension(Extension):
+    """A ``{% ctrans %}`` tag that translates a block only when a
+    runtime condition holds, and renders fallback content otherwise.
+
+    .. code-block:: html+jinja
+
+        {% ctrans use_i18n %}
+            Hello, {{ name }}!
+        {% fallback %}
+            Hi, {{ name }}!
+        {% endctrans %}
+
+    The tag takes the condition, then the same variables and
+    ``trimmed`` or ``notrimmed`` modifier as ``{% trans %}``, with
+    optional commas between all of them. Plural forms work as they do
+    for ``{% trans %}``, with ``{% pluralize %}`` after the singular
+    section. The ``{% fallback %}`` section is required and comes last.
+
+    .. code-block:: html+jinja
+
+        {% ctrans use_i18n, count=items|length, trimmed %}
+            {{ count }} item
+        {% pluralize %}
+            {{ count }} items
+        {% fallback %}
+            {{ count }} item(s)
+        {% endctrans %}
+
+    When the condition is true the singular or plural section goes
+    through the environment's ``gettext`` or ``ngettext``, so it needs
+    the same setup as the :class:`InternationalizationExtension`. When
+    it is false the fallback section is rendered as it is written, with
+    the variables filled in and no translation lookup. ``trimmed`` and
+    ``notrimmed`` apply to every section including the fallback, and
+    default to the ``ext.i18n.trimmed`` policy.
+    """
+
+    tags = {"ctrans"}
+
+    def parse(self, parser: "Parser") -> nodes.Node:
+        """Parse a conditional translatable tag."""
+        lineno = next(parser.stream).lineno
+        condition = parser.parse_expression()
+        num_called_num = False
+
+        # Find all the variables referenced, as the trans tag does.
+        # ``variables`` is what the translation passes on, and
+        # ``declared`` is what the header wrote, which differs only
+        # where a call was stored in _trans to run it once.
+        plural_expr: t.Optional[nodes.Expr] = None
+        plural_expr_assignment: t.Optional[nodes.Assign] = None
+        variables: t.Dict[str, nodes.Expr] = {}
+        declared: t.Dict[str, nodes.Expr] = {}
+        trimmed = None
+
+        while parser.stream.current.type != "block_end":
+            # commas only separate, so they may appear anywhere
+            if parser.stream.skip_if("comma"):
+                continue
+
+            # skip colon for python compatibility
+            if parser.stream.skip_if("colon"):
+                break
+
+            token = parser.stream.expect("name")
+            if token.value in variables:
+                parser.fail(
+                    f"translatable variable {token.value!r} defined twice.",
+                    token.lineno,
+                    exc=TemplateAssertionError,
+                )
+
+            # expressions
+            if parser.stream.current.type == "assign":
+                next(parser.stream)
+                variables[token.value] = var = parser.parse_expression()
+            elif trimmed is None and token.value in ("trimmed", "notrimmed"):
+                trimmed = token.value == "trimmed"
+                continue
+            else:
+                variables[token.value] = var = nodes.Name(token.value, "load")
+
+            declared[token.value] = var
+
+            if plural_expr is None:
+                if isinstance(var, nodes.Call):
+                    plural_expr = nodes.Name("_trans", "load")
+                    variables[token.value] = plural_expr
+                    plural_expr_assignment = nodes.Assign(
+                        nodes.Name("_trans", "store"), var
+                    )
+                else:
+                    plural_expr = var
+                num_called_num = token.value == "num"
+
+        parser.stream.expect("block_end")
+
+        plural = None
+        have_plural = False
+        referenced: t.Dict[str, None] = {}
+
+        # now parse until pluralize, fallback or endctrans
+        singular_names, singular = self._parse_block(parser, True)
+        referenced.update(dict.fromkeys(singular_names))
+
+        if singular_names and plural_expr is None:
+            plural_expr = nodes.Name(singular_names[0], "load")
+            num_called_num = singular_names[0] == "num"
+
+        # if we have a pluralize block, we parse that too
+        if parser.stream.current.test("name:pluralize"):
+            have_plural = True
+            next(parser.stream)
+            if parser.stream.current.type != "block_end":
+                token = parser.stream.expect("name")
+                if token.value not in variables:
+                    parser.fail(
+                        f"unknown variable {token.value!r} for pluralization",
+                        token.lineno,
+                        exc=TemplateAssertionError,
+                    )
+                plural_expr = variables[token.value]
+                num_called_num = token.value == "num"
+            parser.stream.expect("block_end")
+            plural_names, plural = self._parse_block(parser, False)
+            referenced.update(dict.fromkeys(plural_names))
+
+        # the fallback is mandatory, since nothing else says what to
+        # render when the condition does not hold
+        if not parser.stream.current.test("name:fallback"):
+            parser.fail("expected 'fallback' block", lineno)
+
+        next(parser.stream)
+        parser.stream.expect("block_end")
+        fallback_names, fallback = self._parse_block(parser, False)
+
+        if not parser.stream.current.test("name:endctrans"):
+            parser.fail("a conditional translation can have only one fallback section")
+
+        next(parser.stream)
+
+        # register free names as simple name expressions, for the
+        # translation and for the fallback each by what it references
+        for name in referenced:
+            if name not in variables:
+                variables[name] = nodes.Name(name, "load")
+
+        fallback_variables: t.Dict[str, nodes.Expr] = {}
+
+        for name in dict.fromkeys(fallback_names):
+            fallback_variables[name] = declared.get(name, nodes.Name(name, "load"))
+
+        if not have_plural:
+            plural_expr = None
+        elif plural_expr is None:
+            parser.fail("pluralize without variables", lineno)
+
+        if trimmed is None:
+            trimmed = self.environment.policies.get("ext.i18n.trimmed", False)
+        if trimmed:
+            singular = self._trim_whitespace(singular)
+            if plural:
+                plural = self._trim_whitespace(plural)
+            fallback = self._trim_whitespace(fallback)
+
+        node = self._make_conditional_node(
+            condition,
+            singular,
+            plural,
+            fallback,
+            variables,
+            fallback_variables,
+            plural_expr,
+            plural_expr_assignment,
+            num_called_num and have_plural,
+        )
+        node.set_lineno(lineno)
+        return node
+
+    def _trim_whitespace(self, string: str, _ws_re: t.Pattern[str] = _ws_re) -> str:
+        return _ws_re.sub(" ", string.strip())
+
+    def _parse_block(
+        self, parser: "Parser", allow_pluralize: bool
+    ) -> t.Tuple[t.List[str], str]:
+        """Parse until the next pluralize, fallback or endctrans tag,
+        leaving the stream at the name of that tag.
+        """
+        referenced = []
+        buf = []
+
+        while True:
+            if parser.stream.current.type == "data":
+                buf.append(parser.stream.current.value.replace("%", "%%"))
+                next(parser.stream)
+            elif parser.stream.current.type == "variable_begin":
+                next(parser.stream)
+                name = parser.stream.expect("name").value
+                referenced.append(name)
+                buf.append(f"%({name})s")
+                parser.stream.expect("variable_end")
+            elif parser.stream.current.type == "block_begin":
+                next(parser.stream)
+                if parser.stream.current.test_any("name:endctrans", "name:fallback"):
+                    break
+                elif parser.stream.current.test("name:pluralize"):
+                    if allow_pluralize:
+                        break
+                    parser.fail(
+                        "a translatable section can have only one pluralize"
+                        " section, and it comes before the fallback section"
+                    )
+                parser.fail(
+                    "control structures in translatable sections are not allowed"
+                )
+            elif parser.stream.eos:
+                parser.fail("unclosed conditional translation block")
+            else:
+                raise RuntimeError("internal parser error")
+
+        return referenced, concat(buf)
+
+    def _make_conditional_node(
+        self,
+        condition: nodes.Expr,
+        singular: str,
+        plural: t.Optional[str],
+        fallback: str,
+        variables: t.Dict[str, nodes.Expr],
+        fallback_variables: t.Dict[str, nodes.Expr],
+        plural_expr: t.Optional[nodes.Expr],
+        plural_expr_assignment: t.Optional[nodes.Assign],
+        num_called_num: bool,
+    ) -> nodes.If:
+        """Generates an ``If`` node that translates when the condition
+        holds and renders the fallback otherwise.
+        """
+        # the i18n extension sets this, but this one may be used alone
+        newstyle = getattr(self.environment, "newstyle_gettext", False)
+        node: nodes.Expr
+
+        # old style gettext only formats when there are variables, so
+        # only then does the text keep its escaped percent signs
+        if not variables and not newstyle:
+            singular = singular.replace("%%", "%")
+            if plural:
+                plural = plural.replace("%%", "%")
+
+        # singular only:
+        if plural_expr is None:
+            gettext = nodes.Name("gettext", "load")
+            node = nodes.Call(gettext, [nodes.Const(singular)], [], None, None)
+
+        # singular and plural
+        else:
+            ngettext = nodes.Name("ngettext", "load")
+            node = nodes.Call(
+                ngettext,
+                [nodes.Const(singular), nodes.Const(plural), plural_expr],
+                [],
+                None,
+                None,
+            )
+
+        # in case newstyle gettext is used, the method is powerful
+        # enough to handle the variable expansion and autoescape
+        # handling itself
+        if newstyle:
+            for key, value in variables.items():
+                # the function adds that later anyways in case num was
+                # called num, so just skip it.
+                if num_called_num and key == "num":
+                    continue
+                node.kwargs.append(nodes.Keyword(key, value))
+
+        # otherwise do that here
+        else:
+            # mark the return value as safe if we are in an
+            # environment with autoescaping turned on
+            node = nodes.MarkSafeIfAutoescape(node)
+            if variables:
+                node = nodes.Mod(
+                    node,
+                    nodes.Dict(
+                        [
+                            nodes.Pair(nodes.Const(key), value)
+                            for key, value in variables.items()
+                        ]
+                    ),
+                )
+
+        # the translation runs only when the condition holds, so a call
+        # stored for pluralization does too
+        translated: t.List[nodes.Node] = [nodes.Output([node])]
+        if plural_expr_assignment is not None:
+            translated.insert(0, plural_expr_assignment)
+
+        # the fallback is formatted the same way whatever the style, as
+        # no gettext function does it for us here
+        fallback_node: nodes.Expr
+        if fallback_variables:
+            fallback_node = nodes.Mod(
+                nodes.MarkSafeIfAutoescape(nodes.Const(fallback)),
+                nodes.Dict(
+                    [
+                        nodes.Pair(nodes.Const(key), value)
+                        for key, value in fallback_variables.items()
+                    ]
+                ),
+            )
+        else:
+            fallback_node = nodes.MarkSafeIfAutoescape(
+                nodes.Const(fallback.replace("%%", "%"))
+            )
+
+        return nodes.If(condition, translated, [], [nodes.Output([fallback_node])])
+
+
 def extract_from_ast(
     ast: nodes.Template,
     gettext_functions: t.Sequence[str] = GETTEXT_FUNCTIONS,
@@ -852,3 +1180,4 @@ i18n = InternationalizationExtension
