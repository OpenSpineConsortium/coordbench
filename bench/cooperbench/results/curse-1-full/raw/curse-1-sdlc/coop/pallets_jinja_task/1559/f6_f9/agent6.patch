+    def bind(self, environment: Environment) -> "Extension":
+        # The base class copies the instance dict, which would make an
+        # overlay share the cache of the environment it was made from.
+        # Every environment keeps its own cache, so start a new one.
+        rv = t.cast("InternationalizationExtension", super().bind(environment))
+        rv._init_cache()
+        return rv
+
+    def __getstate__(self) -> t.Dict[str, t.Any]:
+        # A lock cannot be copied, so leave it out and make a new one.
+        state = self.__dict__.copy()
+        state.pop("_cache_lock", None)
+        return state
+
+    def __setstate__(self, state: t.Dict[str, t.Any]) -> None:
+        self.__dict__.update(state)
+        self._cache_lock = threading.Lock()
+
+    def _init_cache(self) -> None:
+        """Set up an empty translation cache, sized by the environment's
+        ``i18n_cache_size``.
+        """
+        self._cache: t.Dict[str, str] = {}
+        self._cache_order: t.List[str] = []
+        self._cache_lock = threading.Lock()
+        self._cache_size = self._configured_cache_size()
+
+    def _configured_cache_size(self) -> int:
+        size = getattr(self.environment, "i18n_cache_size", 128)
+
+        try:
+            return max(int(size), 0)
+        except (TypeError, ValueError):
+            return 128
+
+    def _update_cache_size(self) -> None:
+        """Read ``environment.i18n_cache_size`` again and, if the cache
+        is now larger than allowed, drop the least recently used entries.
+        """
+        size = self._configured_cache_size()
+
+        with self._cache_lock:
+            self._cache_size = size
+            self._evict_over_size()
+
+    def _evict_over_size(self) -> None:
+        # The caller holds the lock. The oldest entry is first.
+        while len(self._cache_order) > self._cache_size:
+            self._cache.pop(self._cache_order.pop(0), None)
+
+    def _get_from_cache(self, key: str) -> t.Optional[str]:
+        """Return the cached translation for ``key`` and mark it as the
+        most recently used, or return ``None`` if it is not cached.
+        """
+        with self._cache_lock:
+            if key not in self._cache:
+                return None
+
+            self._cache_order.remove(key)
+            self._cache_order.append(key)
+            return self._cache[key]
+
+    def _put_in_cache(self, key: str, value: str) -> None:
+        """Store a translation as the most recently used entry, dropping
+        the least recently used ones to stay within the cache size. A
+        size of 0 turns the cache off.
+        """
+        with self._cache_lock:
+            if self._cache_size <= 0:
+                return
+
+            if key in self._cache:
+                self._cache_order.remove(key)
+
+            self._cache[key] = value
+            self._cache_order.append(key)
+            self._evict_over_size()
+
+    def clear_cache(self) -> None:
+        """Remove every entry from the translation cache."""
+        with self._cache_lock:
+            self._cache.clear()
+            self._cache_order.clear()
 
