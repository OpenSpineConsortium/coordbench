+/// Validates the `repeat` argument of `first` and `last` against the string
+/// and returns it as a count of grapheme clusters, which is at least one and
+/// at most the number of grapheme clusters in the string.
+fn check_repeat(s: &str, repeat: i64) -> StrResult<usize> {
+    if repeat < 1 {
+        bail!("repeat must be at least 1");
+    }
+
+    let total = s.graphemes(true).count();
+    if total == 0 && repeat == 1 {
+        return Err(string_is_empty());
+    }
+    if repeat as u64 > total as u64 {
+        bail!(
+            "not enough characters (requested {repeat}, but string only has {total})"
+        );
+    }
+    Ok(repeat as usize)
+}
