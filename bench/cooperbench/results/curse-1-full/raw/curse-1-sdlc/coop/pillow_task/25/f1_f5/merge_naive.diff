+    def _opened_from(self, filename: str | bytes) -> bool:
+        # Only images read from a file have a filename. An image made by
+        # frombuffer() has none, so saving it must not detach it from its buffer.
+        opened = getattr(self, "filename", "")
+        if not opened or not filename:
+            return False
+        if opened == filename:
+            return True
+        try:
+            return os.path.samefile(opened, filename)
+        except OSError:
+            return False
+
