+
+
+def palette_colors(image, count):
+    mode = image.im.getpalettemode()
+    width = len(mode)
+    palette = image.im.getpalette(mode, mode)
+    return [tuple(palette[i : i + width]) for i in range(0, count * width, width)]
+
+
+def brightness(color):
+    return 299 * color[0] + 587 * color[1] + 114 * color[2]
+
+
+@pytest.mark.parametrize("mode", ("RGB", "RGBA"))
+@pytest.mark.parametrize("sort_palette", ("brightness", "rgb"))
+@pytest.mark.parametrize("colors", (16, 100, 256))
+def test_sort_palette(mode, sort_palette, colors):
+    image = hopper(mode)
+    unsorted = image.quantize(colors)
+    converted = image.quantize(colors, sort_palette=sort_palette)
+
+    assert_image(converted, "P", converted.size)
+    # the same colors in the same places, whatever the order of the palette
+    assert converted.convert(mode).tobytes() == unsorted.convert(mode).tobytes()
+    assert len(converted.getcolors()) == len(unsorted.getcolors())
+
+    sorted_colors = palette_colors(converted, colors)
+    assert sorted(sorted_colors) == sorted(palette_colors(unsorted, colors))
+    if sort_palette == "brightness":
+        keys = [brightness(color) for color in sorted_colors]
+        assert keys == sorted(keys)
+    else:
+        assert sorted_colors == sorted(sorted_colors)
+
+    # the python side of the palette agrees with the image
+    mode = converted.im.getpalettemode()
+    assert converted.palette.mode == mode
+    assert converted.palette.palette == converted.im.getpalette(mode, mode)
+
+
+def test_sort_palette_none():
+    image = hopper()
+    expected = image.quantize()
+    converted = image.quantize(sort_palette=None)
+
+    assert converted.tobytes() == expected.tobytes()
+    assert converted.palette.palette == expected.palette.palette
+
+
+def test_sort_palette_known_colors():
+    image = Image.new("RGB", (4, 1))
+    # the two orders differ: green is brighter than red, but has less red
+    colors = [(200, 0, 0), (0, 0, 120), (0, 255, 0), (255, 255, 255)]
+    image.putdata(colors)
+
+    by_rgb = image.quantize(4, sort_palette="rgb")
+    assert palette_colors(by_rgb, 4) == sorted(colors)
+
+    by_brightness = image.quantize(4, sort_palette="brightness")
+    assert palette_colors(by_brightness, 4) == [
+        (0, 0, 120),
+        (200, 0, 0),
+        (0, 255, 0),
+        (255, 255, 255),
+    ]
+
+    # each pixel points at the place its color moved to
+    for converted in (by_rgb, by_brightness):
+        assert tuple(converted.convert("RGB").getdata()) == tuple(colors)
+
+
+def test_sort_palette_keeps_equal_colors_in_order():
+    image = Image.new("RGB", (2, 1), (10, 20, 30))
+    image.putpixel((1, 0), (30, 20, 10))
+
+    converted = image.quantize(2, sort_palette="rgb")
+    assert palette_colors(converted, 2) == [(10, 20, 30), (30, 20, 10)]
+    assert converted.getpixel((0, 0)) == 0
+    assert converted.getpixel((1, 0)) == 1
+
+
+def test_sort_palette_alpha_follows_color():
+    image = Image.new("RGBA", (3, 1))
+    colors = [(200, 10, 10, 255), (10, 10, 10, 128), (100, 100, 100, 0)]
+    image.putdata(colors)
+
+    converted = image.quantize(3, method=Image.FASTOCTREE, sort_palette="brightness")
+    assert palette_colors(converted, 3) == [
+        (10, 10, 10, 128),
+        (200, 10, 10, 255),
+        (100, 100, 100, 0),
+    ]
+    assert tuple(converted.convert("RGBA").getdata()) == tuple(colors)
+
+
+@pytest.mark.parametrize("sort_palette", ("brightness", "rgb"))
+def test_sort_palette_with_palette(sort_palette):
+    image = hopper()
+    with Image.open("Tests/images/caption_6_33_22.png") as palette:
+        palette = palette.convert("P")
+
+    unsorted = image.quantize(dither=0, palette=palette)
+    converted = image.quantize(dither=0, palette=palette, sort_palette=sort_palette)
+
+    assert_image(converted, "P", converted.size)
+    assert converted.convert("RGB").tobytes() == unsorted.convert("RGB").tobytes()
+    assert converted.palette.palette != unsorted.palette.palette
+
+    count = len(palette.palette.palette) // 3
+    sorted_colors = palette_colors(converted, count)
+    if sort_palette == "brightness":
+        keys = [brightness(color) for color in sorted_colors]
+        assert keys == sorted(keys)
+    else:
+        assert sorted_colors == sorted(sorted_colors)
+
+
+@pytest.mark.parametrize("sort_palette", ("size", "", "BRIGHTNESS", 1, ["rgb"]))
+def test_sort_palette_invalid(sort_palette):
+    with pytest.raises(ValueError):
+        hopper().quantize(sort_palette=sort_palette)
+
+
+def test_max_colors_quantize():
+    image = hopper()
+
+    # max_colors below colors is the upper limit
+    converted = image.quantize(colors=100, max_colors=50)
+    assert_image(converted, "P", converted.size)
+    assert len(converted.getcolors()) <= 50
+    assert_image_similar(converted.convert("RGB"), image, 30)
+
+    # max_colors above colors does not raise the target
+    converted = image.quantize(colors=50, max_colors=100)
+    assert len(converted.getcolors()) <= 50
+
+    # max_colors equal to colors, or not given, is the previous behaviour
+    default = image.quantize(colors=64)
+    assert len(default.getcolors()) == 64
+    for given in (64, None):
+        converted = image.quantize(colors=64, max_colors=given)
+        assert converted.tobytes() == default.tobytes()
+        assert converted.getpalette() == default.getpalette()
+
+
+def test_max_colors_quantize_methods():
+    image = hopper()
+    for method in (Image.MEDIANCUT, Image.MAXCOVERAGE, Image.FASTOCTREE):
+        converted = image.quantize(colors=100, method=method, max_colors=40)
+        assert len(converted.getcolors()) <= 40
+
+    converted = hopper("RGBA").quantize(colors=100, max_colors=30)
+    assert len(converted.getcolors()) <= 30
+
+
+def test_max_colors_quantize_palette():
+    # a given palette fixes the colors, so max_colors has nothing to limit
+    image = hopper()
+    palette = hopper("P")
+    assert (
+        image.quantize(palette=palette, max_colors=10).tobytes()
+        == image.quantize(palette=palette).tobytes()
+    )
+
+
+def test_sort_palette_with_max_colors():
+    image = hopper()
+    converted = image.quantize(colors=100, max_colors=40, sort_palette="brightness")
+    unsorted = image.quantize(colors=100, max_colors=40)
+
+    assert len(converted.getcolors()) == len(unsorted.getcolors())
+    assert converted.convert("RGB").tobytes() == unsorted.convert("RGB").tobytes()
+
+    # only the 40 colors that were asked for are sorted, so the pixels stay in them
+    keys = [brightness(color) for color in palette_colors(converted, 40)]
+    assert keys == sorted(keys)
+    assert max(index for _, index in converted.getcolors()) < 40
