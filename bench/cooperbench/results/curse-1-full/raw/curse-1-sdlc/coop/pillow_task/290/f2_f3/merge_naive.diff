+    def _sort_palette(self, how, size):
+        """
+        Reorders the first ``size`` entries of this "P" image's palette, in
+        the order that the key named ``how`` gives, and rewrites the pixels so
+        that the image looks the same.
+
+        :param how: A key of :py:data:`_PALETTE_SORT_KEYS`.
+        :param size: How many palette entries, counted from the first, to sort.
+        :returns: A new image.
+        """
+        from . import ImagePalette
+
+        mode = self.im.getpalettemode()
+        width = len(mode)
+        data = self.im.getpalette(mode, mode)
+        colors = [tuple(data[i : i + width]) for i in range(0, len(data), width)]
+        size = max(0, min(size, 256, len(colors)))
+
+        key = _PALETTE_SORT_KEYS[how]
+        order = sorted(range(size), key=lambda i: key(colors[i]))
+        order += range(size, len(colors))
+
+        # order[new] is the old position of the color now at position new;
+        # pixels move the other way, from the old position to the new one
+        lookup = list(range(256))
+        for new, old in enumerate(order):
+            if old < 256:
+                lookup[old] = new
+
+        new_data = b"".join(bytes(colors[old]) for old in order)
+        new_im = self._new(self.im.point(lookup, None))
+        if mode == "RGBA":
+            # the core takes the colors first and the alpha values after them
+            rgb = b"".join(bytes(colors[old][:3]) for old in order)
+            new_im.im.putpalette("RGB", rgb)
+            new_im.im.putpalettealphas(bytes(colors[old][3] for old in order))
+        else:
+            new_im.im.putpalette(mode, new_data)
+        new_im.palette = ImagePalette.ImagePalette(mode, new_data)
+        return new_im
