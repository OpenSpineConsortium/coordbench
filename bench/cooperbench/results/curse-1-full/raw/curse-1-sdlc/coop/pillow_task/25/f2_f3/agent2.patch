+    @pytest.mark.parametrize("preserve_readonly", (False, True))
+    def test_readonly_save_preserve_readonly(
+        self, tmp_path: Path, preserve_readonly: bool
+    ) -> None:
+        temp_file = tmp_path / "temp.bmp"
+        data = bytearray(b"\xff")
+        im = Image.frombuffer("L", (1, 1), data)
+        assert im.readonly
+
+        im.save(temp_file, preserve_readonly=preserve_readonly)
+
+        # The saved file holds the pixel at the time of saving
+        with Image.open(temp_file) as reloaded:
+            assert reloaded.getpixel((0, 0)) == 255
+
+        # The image only still reflects the buffer if it stayed readonly
+        assert im.readonly == preserve_readonly
+        data[0] = 64
+        assert im.getpixel((0, 0)) == (64 if preserve_readonly else 255)
+
+        # and a later save writes the buffer's current state
+        if preserve_readonly:
+            im.save(temp_file, preserve_readonly=True)
+            with Image.open(temp_file) as reloaded:
+                assert reloaded.getpixel((0, 0)) == 64
+
+    def test_readonly_save_preserve_readonly_getdata(self, tmp_path: Path) -> None:
+        numpy = pytest.importorskip("numpy", reason="NumPy not installed")
+
+        im_data = numpy.array([[255]], dtype=numpy.uint8)
+        im = Image.frombuffer(mode="L", size=(1, 1), data=im_data)
+
+        im.save(tmp_path / "temp.bmp", preserve_readonly=True)
+
+        im_data[:, :] = numpy.array([[64]], dtype=numpy.uint8)
+        assert im.getdata()[0] == 64
+
