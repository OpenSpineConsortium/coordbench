+    def test_save_dry_run_writes_nothing(self, tmp_path: Path, ext: str) -> None:
+        if ext == ".webp" and not features.check("webp"):
+            pytest.skip("WebP support not available")
+        temp_file = tmp_path / f"temp{ext}"
+
+        hopper().save(temp_file, dry_run=True)
