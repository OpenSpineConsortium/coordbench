+
+    def test_save_dry_run_keeps_existing_file(self, tmp_path: Path) -> None:
+        temp_file = tmp_path / "temp.png"
+        temp_file.write_bytes(b"original")
+
+        hopper().save(temp_file, dry_run=True)
+        assert temp_file.read_bytes() == b"original"
+
+        # The file would have been appended to, but is left alone all the same
+        hopper().save(temp_file, format="TIFF", append=True, dry_run=True)
+        assert temp_file.read_bytes() == b"original"
+
+    def test_save_dry_run_file_object(self) -> None:
