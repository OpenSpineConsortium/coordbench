+class IsHash(DirtyEquals[str]):
+    """
+    A class that checks if a value is a string shaped like the hexadecimal digest of a cryptographic hash.
+    """
+
+    # the length in hexadecimal characters of each supported digest
+    hash_lengths = {
+        'md5': 32,
+        'sha1': 40,
+        'sha224': 56,
+        'sha256': 64,
+        'sha384': 96,
+        'sha512': 128,
+    }
+    hex_digits = frozenset('0123456789abcdefABCDEF')
+
+    def __init__(self, algorithm: str):
+        """
+        Args:
+            algorithm: The hash algorithm whose digest format to check, one of `md5`, `sha1`, `sha224`,
+                `sha256`, `sha384` and `sha512`. The name is not case sensitive, and a hyphen or underscore
+                is ignored, so `'SHA-256'` and `'sha256'` are the same algorithm.
+
+        Only the format is checked: the length and the hexadecimal characters of the digest for the algorithm,
+        not that the digest is the hash of anything.
+
+        ```py title="IsHash"
+        from dirty_equals import IsHash
+
+        assert 'd41d8cd98f00b204e9800998ecf8427e' == IsHash('md5')
+        assert 'da39a3ee5e6b4b0d3255bfef95601890afd80709' == IsHash('sha1')
+        assert 'E3B0C44298FC1C149AFBF4C8996FB92427AE41E4649B934CA495991B7852B855' == IsHash('SHA-256')
+        assert 'd41d8cd98f00b204e9800998ecf8427e' != IsHash('sha256')
+        assert 'z41d8cd98f00b204e9800998ecf8427e' != IsHash('md5')
+        assert 123 != IsHash('md5')
+        ```
+        """
+        if not isinstance(algorithm, str):
+            raise TypeError(f'algorithm must be a string, got {type(algorithm).__name__}')
+        name = algorithm.lower().replace('-', '').replace('_', '')
+        if name not in self.hash_lengths:
+            supported = ', '.join(self.hash_lengths)
+            raise ValueError(f'Unsupported hash algorithm {algorithm!r}, must be one of: {supported}')
+        self.algorithm = algorithm
+        self.length = self.hash_lengths[name]
+        super().__init__(algorithm)
+
+    def equals(self, other: Any) -> bool:
+        return isinstance(other, str) and len(other) == self.length and self.hex_digits.issuperset(other)
