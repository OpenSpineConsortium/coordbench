+class IsMac(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid MAC address, optionally checking the format it is written in.
+    """
+
+    def __init__(self, format: Literal[None, 'colon', 'hyphen', 'dot', 'compact'] = None):
+        """
+        Args:
+            format: The format the MAC address must be written in, if omitted, all formats are accepted.
+                One of `'colon'` (`00:1B:44:11:3A:B7`), `'hyphen'` (`00-1B-44-11-3A-B7`),
+                `'dot'` (`001B.4411.3AB7`) or `'compact'` (`001b44113ab7`).
+
+        The check is case-insensitive, and the separators may not be mixed.
+
+        ```py title="IsMac"
+        from dirty_equals import IsMac
+
+        assert '00:1B:44:11:3A:B7' == IsMac
+        assert '00-1B-44-11-3A-B7' == IsMac
+        assert '001B.4411.3AB7' == IsMac
+        assert '001b44113ab7' == IsMac
+        assert '00:1b:44:11:3a:b7' == IsMac('colon')
+        assert '00-1B-44-11-3A-B7' != IsMac('colon')
+        assert '001b44113ab7' == IsMac('compact')
+        assert '00:1B:44:11:3A' != IsMac
+        assert 'foobar' != IsMac
+        ```
+        """
+        if format is not None and format not in _MAC_PATTERNS:
+            raise ValueError(f'invalid MAC address format {format!r}, expected one of {", ".join(_MAC_PATTERNS)}')
+        self.format = format
+        super().__init__(format or plain_repr('*'))
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        if self.format is None:
+            patterns = _MAC_PATTERNS.values()
+        else:
+            patterns = (_MAC_PATTERNS[self.format],)
+        return any(pattern.fullmatch(other) for pattern in patterns)
