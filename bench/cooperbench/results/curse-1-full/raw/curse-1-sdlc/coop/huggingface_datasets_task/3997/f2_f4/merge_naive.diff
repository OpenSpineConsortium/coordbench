+
+    @staticmethod
+    def _is_pair(item) -> bool:
+        # A (column_name, feature) pair has a string key and a feature; a batch of two JSON strings has two
+        # strings, and a batch of mappings or of pairs has no string first.
+        return len(item) == 2 and isinstance(item[0], str) and not isinstance(item[1], (str, bytes, bytearray))
+
+    @staticmethod
+    def _pairs_from_json(text):
+        if isinstance(text, (bytes, bytearray)):
+            text = bytes(text).decode("utf-8")
+        obj = json.loads(text)
+        if isinstance(obj, dict):
+            obj = [obj]
+        if not isinstance(obj, list) or not all(isinstance(item, dict) for item in obj):
+            raise TypeError("A JSON string given to Features.update must hold an object or a list of objects.")
