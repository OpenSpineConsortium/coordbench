+    def update(self, iterable=None, **kwds):
+        """
+        Update the features, like :meth:`dict.update`, and keep the decoding bookkeeping in sync.
+
+        Beyond a mapping, an iterable of ``(column_name, feature)`` pairs and keyword arguments, it accepts:
+
+        - a JSON string (or bytes) holding an object, as dumped by :meth:`Features.to_dict`: its values are
+          rebuilt into features by :func:`generate_from_dict`, and a bare string value such as ``"int32"``
+          stands for ``Value("int32")``;
+        - a batch: a list or tuple whose items are each any of the above (a mapping, a JSON string, or a
+          ``(column_name, feature)`` pair), applied in order, so a later item wins over an earlier one.
+
+        The whole input is read before any column is changed, so an input that cannot be read, such as a
+        malformed JSON string in the middle of a batch, leaves the features as they were. Every column is set
+        through ``__setitem__``, which is what keeps ``_column_requires_decoding`` right.
+
+        Args:
+            iterable (optional): a mapping, an iterable of pairs, a JSON string or a batch of these.
+            **kwds: columns to set, applied after ``iterable``.
+
+        Example::
+            >>> features = Features({"a": Value("int32")})
+            >>> features.update('{"b": {"dtype": "string", "id": null, "_type": "Value"}}')
+            >>> features.update([{"c": Value("bool")}, ("d", Value("float32"))], e=Value("int8"))
+        """
+        pairs = [] if iterable is None else list(self._update_pairs(iterable))
+        pairs.extend(kwds.items())
+        for column_name, feature in pairs:
+            self[column_name] = feature
+
+    @classmethod
+    def _update_pairs(cls, source):
+        """Yield the ``(column_name, feature)`` pairs that one input of :meth:`update` stands for."""
+        if isinstance(source, (str, bytes, bytearray)):
+            yield from cls._pairs_from_json(source)
+        elif hasattr(source, "keys"):
+            for column_name in source.keys():
+                yield column_name, source[column_name]
+        elif isinstance(source, (list, tuple)) and cls._is_pair(source):
+            yield source[0], source[1]
+        elif isinstance(source, Iterable):
+            for item in source:
+                if isinstance(item, (list, tuple)) and cls._is_pair(item):
+                    yield item[0], item[1]
+                elif isinstance(item, (str, bytes, bytearray)) or hasattr(item, "keys"):
+                    yield from cls._update_pairs(item)
+                elif isinstance(item, (list, tuple)):
+                    yield from cls._update_pairs(item)
+                else:
+                    raise TypeError(
+                        f"Cannot update Features with {item!r}: expected a mapping, a JSON string or a (column_name, feature) pair."
+                    )
         else:
