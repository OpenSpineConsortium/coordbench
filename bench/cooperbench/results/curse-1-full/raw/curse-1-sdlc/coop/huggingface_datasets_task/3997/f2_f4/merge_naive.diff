+        Example::
+
+            >>> features = Features({"image": Image(), "text": Value("string")})
+            >>> features.set_custom_decoding_criteria(lambda feature: isinstance(feature, Value))
+            >>> features.set_custom_decoding_criteria()  # back to the default rules
+        """
+        if custom_criteria is not None and not callable(custom_criteria):
