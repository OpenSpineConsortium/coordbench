+
+
+class CacheUsageTracker:
+    """Tracks the cache events (memory hits, disk hits and misses) that happen within a context.
+
+    This mirrors `UsageTracker`, but for `dspy.cache` instead of the LM: `Cache.get()` adds one event per lookup to
+    the tracker that is active in the current context, so that a prediction can report what its own call hit.
+    """
+
+    def __init__(self):
+        self.cache_usage = {"hits": 0, "mem_hits": 0, "disk_hits": 0, "misses": 0}
+        # The tracker is shared by the threads that a parallel module spawns inside its context.
+        self._lock = threading.Lock()
+
+    def add_event(self, event: str):
+        """Count one cache event: `mem_hit`, `disk_hit` or `miss`."""
+        with self._lock:
+            if event == "mem_hit":
+                self.cache_usage["mem_hits"] += 1
+                self.cache_usage["hits"] += 1
+            elif event == "disk_hit":
+                self.cache_usage["disk_hits"] += 1
+                self.cache_usage["hits"] += 1
+            elif event == "miss":
+                self.cache_usage["misses"] += 1
+            else:
+                raise ValueError(f"Unknown cache event: {event!r}")
+
+    def get_cache_usage(self) -> dict[str, int]:
+        """Return a snapshot of the cache events counted so far."""
+        with self._lock:
+            return dict(self.cache_usage)
+
+    def __deepcopy__(self, memo):
+        # A lock cannot be deep copied, so copy the counts into a new tracker.
+        new_tracker = CacheUsageTracker()
+        new_tracker.cache_usage = self.get_cache_usage()
+        return new_tracker
+
+
+@contextmanager
+def track_cache_usage():
+    """Context manager for tracking the cache events of a call."""
+    tracker = CacheUsageTracker()
+
+    with settings.context(cache_usage_tracker=tracker):
+        yield tracker
