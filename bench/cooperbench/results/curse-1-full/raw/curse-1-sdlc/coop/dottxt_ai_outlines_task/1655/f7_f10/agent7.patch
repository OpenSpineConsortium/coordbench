 )
+
+# Matches a SHA-256 digest written as 64 hexadecimal characters, in any case.
+# It checks the shape only: whether the digest belongs to some input cannot be
+# decided by a regular expression.
+hash_sha256 = Regex(r"[a-fA-F0-9]{64}")
