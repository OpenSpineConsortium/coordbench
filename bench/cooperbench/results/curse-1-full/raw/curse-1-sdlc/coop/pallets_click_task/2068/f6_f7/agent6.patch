+    def _set_process_priority(self, process: t.Any) -> None:
+        """Lower or raise the priority of a Unix process just started.
+        Windows sets it at creation instead (see ``edit_file``).
+
+        Setting a priority is a request: raising it usually needs
+        privileges, and some platforms cannot do it at all. A refusal is
+        ignored, so that the editor always runs.
+        """
+        if WIN or self.process_priority is None:
+            return
+
+        try:
+            os.setpriority(
+                os.PRIO_PROCESS, process.pid, _PRIORITY_NICE[self.process_priority]
+            )
+        except Exception:
+            pass
+
+    def get_command(self, editor: str, filename: str) -> str:
+        """Build the shell command that opens ``filename`` in ``editor``.
+
+        With ``escape_shell`` each word of the editor and the filename are
+        quoted with :func:`shlex.quote`, so shell metacharacters in them
+        are literal text. The editor is split into words first so that an
+        editor setting with arguments, like ``code --wait``, keeps working.
+        """
+        if not self.escape_shell:
+            return f'{editor} "{filename}"'
+
+        import shlex
+
+        try:
+            words = shlex.split(editor)
+        except ValueError:
+            # Unbalanced quotes: treat the whole setting as one word.
+            words = [editor]
+
+        words.append(filename)
+        return " ".join(shlex.quote(word) for word in words)
+
