+# Editor process priorities, from the lowest to the highest. Each maps to a
+# Unix niceness (lower numbers are scheduled sooner) and to a Windows
+# priority class, the value CreateProcess takes in its creation flags.
+# The numbers are written out because subprocess only defines the Windows
+# constants on Windows.
+_EDITOR_PRIORITIES: dict[str, tuple[int, int]] = {
+    "low": (10, 0x00000040),  # IDLE_PRIORITY_CLASS
+    "below_normal": (5, 0x00004000),  # BELOW_NORMAL_PRIORITY_CLASS
+    "normal": (0, 0x00000020),  # NORMAL_PRIORITY_CLASS
+    "above_normal": (-5, 0x00008000),  # ABOVE_NORMAL_PRIORITY_CLASS
+    "high": (-10, 0x00000080),  # HIGH_PRIORITY_CLASS
+}
+
+
+def _normalize_process_priority(priority: t.Any) -> str | None:
+    """Return ``priority`` if it names a known priority, else ``None``,
+    so a value Click does not know means "leave the priority alone"
+    rather than an error.
+    """
+    if isinstance(priority, str) and priority in _EDITOR_PRIORITIES:
+        return priority
+
+    return None
+
+
+def _priority_popen_kwargs(priority: str | None) -> dict[str, t.Any]:
+    """Extra :class:`subprocess.Popen` arguments that start a process at
+    the given priority. The priority is set when the process is created
+    and not afterwards, so that the editor and anything the shell starts
+    for it have it from their first instruction.
+
+    Setting a priority can fail, for example when a Unix user without
+    privileges asks for a higher one. That must not stop the editor from
+    opening, so the Unix hook swallows the error and the editor then runs
+    at the priority it inherited.
+    """
+    if priority is None:
+        return {}
+
+    nice, priority_class = _EDITOR_PRIORITIES[priority]
+
+    if WIN:
+        return {"creationflags": priority_class}
+
+    if not hasattr(os, "setpriority"):
+        return {}
+
+    def set_niceness() -> None:
+        # Runs in the child between fork and exec, so it must not raise.
+        with contextlib.suppress(Exception):
+            os.setpriority(os.PRIO_PROCESS, 0, nice)
+
+    return {"preexec_fn": set_niceness}
+
+
