+    @staticmethod
+    def _stop_editor(process: subprocess.Popen[bytes]) -> None:
+        """Stop an editor that ran past its timeout. Ask it to exit first,
+        then kill it if it ignores the request, and reap it either way.
+        """
+        import subprocess
+
+        process.terminate()
+
+        try:
