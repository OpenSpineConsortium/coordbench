+def _deepcopy_state(value: t.Any) -> t.Any:
+    """Deep copy ``value`` for a context snapshot, sharing what cannot be
+    copied.
+
+    Parameter values and user objects may hold open files, locks or
+    other handles that :func:`copy.deepcopy` refuses. A handle is a
+    resource, not state, so a dict or list that holds one is copied item
+    by item and the handle itself stays shared with the original.
+    """
+    import copy
+
+    try:
+        return copy.deepcopy(value)
+    except Exception:
+        if isinstance(value, dict):
+            rv = copy.copy(value)
+
+            for key, item in value.items():
+                rv[key] = _deepcopy_state(item)
+
+            return rv
+
+        if type(value) is list:
+            return [_deepcopy_state(item) for item in value]
+
+        return value
+
+
