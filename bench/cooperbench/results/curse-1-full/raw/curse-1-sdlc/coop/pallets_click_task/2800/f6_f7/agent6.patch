+    #: Attributes a snapshot keeps by reference. They tie the context to
+    #: its command, its parent, its open children and the resources it
+    #: must close, so they are not state that could be copied: a copy of
+    #: the children would copy each of them and its parent chain too.
+    _shared_state = frozenset(
+        {
+            "parent",
+            "command",
+            "token_normalize_func",
+            "_exit_stack",
+            "_child_contexts",
+        }
+    )
+
+    #: Attributes a restore leaves as they are. They follow the ``with``
+    #: blocks, the resources entered so far and the children still open,
+    #: so rolling them back would orphan what was opened since, or bring
+    #: back a child that has been closed.
+    _lifecycle_state = frozenset(
+        {"_depth", "_exit_stack", "_close_callbacks", "_child_contexts"}
+    )
+
+    #: Public spellings of private attributes, accepted when restoring.
+    _state_aliases = {
+        "protected_args": "_protected_args",
+        "opt_prefixes": "_opt_prefixes",
+        "meta": "_meta",
+        "parameter_source": "_parameter_source",
+    }
+
+    def save_state(self) -> dict[str, t.Any]:
+        """Take a snapshot of this context that :meth:`restore_state`
+        can later apply.
+
+        The snapshot is a dict with one key per attribute of the
+        context, among them ``params``, ``args``, ``_protected_args``,
+        ``_opt_prefixes``, ``obj``, ``_meta``, ``default_map`` and
+        ``_parameter_source``. Everything that holds state is copied,
+        and the values it holds are deep copied with
+        :func:`copy.deepcopy`, so changing a nested value of the context
+        afterwards does not change the snapshot. A value that cannot be
+        copied, such as an open file, is shared instead. The parent, the
+        command and the context's resources are references, not copies.
+
+        .. versionadded:: 8.2
+        """
+        state: dict[str, t.Any] = {}
+
+        for name, value in vars(self).items():
+            if name in self._shared_state:
+                state[name] = value
+            elif name == "_close_callbacks":
+                state[name] = list(value)
+            else:
+                state[name] = _deepcopy_state(value)
+
+        return state
+
+    def restore_state(self, snapshot: dict[str, t.Any]) -> None:
+        """Set this context back to the state :meth:`save_state` took.
+
+        Each attribute in ``snapshot`` is set again, as a deep copy, so
+        the snapshot stays unchanged and can be restored more than once.
+        An attribute the snapshot does not hold keeps its value. The
+        context's resources and ``with`` depth are not rolled back, so
+        nothing opened since the snapshot is left unclosed. ``_meta`` is
+        refilled in place, since it is the dict shared with the parent
+        and the nested contexts.
+
+        :param snapshot: A dict returned by :meth:`save_state`.
+
+        .. versionadded:: 8.2
+        """
+        for name, value in snapshot.items():
+            name = self._state_aliases.get(name, name)
+
+            if name in self._lifecycle_state:
+                continue
+
+            if name in self._shared_state:
+                setattr(self, name, value)
+            elif name == "_meta" and isinstance(self._meta, dict):
+                meta = _deepcopy_state(value)
+                self._meta.clear()
+                self._meta.update(meta)
+            else:
+                setattr(self, name, _deepcopy_state(value))
+
 
