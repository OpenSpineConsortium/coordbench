@@ -0,0 +1,87 @@
+package chi
+
+import (
+	"context"
+	"net/http"
+	"time"
+)
+
+// MetricsCollector receives one RecordHit call for every request that a Mux
+// routed to a handler, after that handler (and the inline middlewares of its
+// route) returned. Install one with Mux.SetMetricsCollector.
+//
+// RecordHit runs on the goroutine that serves the request, so an
+// implementation must be safe for concurrent use and should return quickly.
+// The context is the request's, so it still carries the routing Context:
+// RouteContext(ctx) gives the matched route pattern and the URL parameters.
+type MetricsCollector interface {
+	RecordHit(ctx context.Context, r *http.Request, duration time.Duration)
+}
+
+// RouteMetric describes one request that was routed to a handler.
+type RouteMetric struct {
+	// Pattern is the matched route pattern, joined across mounted
+	// subrouters, e.g. "/users/{id}".
+	Pattern string
+
+	// Method and Path are the request's HTTP method and URL path.
+	Method string
+	Path   string
+
+	// Duration is how long the handler took to serve the request.
+	Duration time.Duration
+
+	// Params are the URL parameters of the matched route keyed by name,
+	// e.g. {"id": "123"}. It is never nil, and it is the callee's to keep.
+	Params map[string]string
+}
+
+// SimpleMetricsCollector is a MetricsCollector that turns each hit into a
+// RouteMetric and hands it to OnHit. A nil OnHit makes it do nothing.
+//
+// OnHit is called for requests served concurrently, so it must be safe for
+// concurrent use.
+type SimpleMetricsCollector struct {
+	OnHit func(RouteMetric)
+}
+
+var _ MetricsCollector = (*SimpleMetricsCollector)(nil)
+
+// RecordHit builds the RouteMetric of the request from its routing context and
+// passes it to OnHit.
+func (c *SimpleMetricsCollector) RecordHit(ctx context.Context, r *http.Request, duration time.Duration) {
+	if c == nil || c.OnHit == nil {
+		return
+	}
+
+	metric := RouteMetric{
+		Method:   r.Method,
+		Duration: duration,
+		Params:   map[string]string{},
+	}
+	if r.URL != nil {
+		metric.Path = r.URL.Path
+	}
+
+	if rctx := RouteContext(ctx); rctx != nil {
+		metric.Pattern = rctx.RoutePattern()
+		metric.Params = urlParamsMap(rctx)
+	}
+
+	c.OnHit(metric)
+}
+
+// urlParamsMap copies the URL parameters of rctx into a map. When a name
+// occurs more than once, for example along a stack of subrouters, the value
+// captured last wins, as it does in Context.URLParam.
+func urlParamsMap(rctx *Context) map[string]string {
+	keys, values := rctx.URLParams.Keys, rctx.URLParams.Values
+	params := make(map[string]string, len(keys))
+	for i, key := range keys {
+		if i >= len(values) {
+			break
+		}
+		params[key] = values[i]
+	}
+	return params
+}
diff --git a/metrics_test.go b/metrics_test.go
new file mode 100644
index 0000000..90f7504
--- /dev/null
+++ b/metrics_test.go
@@ -0,0 +1,296 @@
+package chi
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"sync"
+	"testing"
+	"time"
+)
+
+// metricsRecorder collects the metrics of a test, safe for concurrent hits.
+type metricsRecorder struct {
+	mu   sync.Mutex
+	hits []RouteMetric
+}
+
+func (m *metricsRecorder) collector() *SimpleMetricsCollector {
+	return &SimpleMetricsCollector{OnHit: func(rm RouteMetric) {
+		m.mu.Lock()
+		defer m.mu.Unlock()
+		m.hits = append(m.hits, rm)
+	}}
+}
+
+func (m *metricsRecorder) all() []RouteMetric {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	return append([]RouteMetric(nil), m.hits...)
+}
+
+func serve(r http.Handler, method, path string) *httptest.ResponseRecorder {
+	w := httptest.NewRecorder()
+	r.ServeHTTP(w, httptest.NewRequest(method, path, nil))
+	return w
+}
+
+func TestMetricsCollectorRecordsHit(t *testing.T) {
+	rec := &metricsRecorder{}
+	r := NewRouter()
+	r.SetMetricsCollector(rec.collector())
+	r.Get("/users/{id}", func(w http.ResponseWriter, r *http.Request) {
+		time.Sleep(5 * time.Millisecond)
+		w.Write([]byte("ok"))
+	})
+
+	if w := serve(r, "GET", "/users/123"); w.Code != 200 || w.Body.String() != "ok" {
+		t.Fatalf("unexpected response %d %q", w.Code, w.Body.String())
+	}
+
+	hits := rec.all()
+	if len(hits) != 1 {
+		t.Fatalf("expected 1 hit, got %d", len(hits))
+	}
+	hit := hits[0]
+	if hit.Pattern != "/users/{id}" {
+		t.Errorf("Pattern = %q, want /users/{id}", hit.Pattern)
+	}
+	if hit.Method != "GET" {
+		t.Errorf("Method = %q, want GET", hit.Method)
+	}
+	if hit.Path != "/users/123" {
+		t.Errorf("Path = %q, want /users/123", hit.Path)
+	}
+	if want := map[string]string{"id": "123"}; !reflect.DeepEqual(hit.Params, want) {
+		t.Errorf("Params = %v, want %v", hit.Params, want)
+	}
+	if hit.Duration < 5*time.Millisecond {
+		t.Errorf("Duration = %v, want at least the handler's 5ms", hit.Duration)
+	}
+}
+
+func TestMetricsCollectorMultipleParams(t *testing.T) {
+	rec := &metricsRecorder{}
+	r := NewRouter()
+	r.SetMetricsCollector(rec.collector())
+	r.Post("/orgs/{org}/repos/{repo}", func(w http.ResponseWriter, r *http.Request) {})
+
+	serve(r, "POST", "/orgs/go-chi/repos/chi")
+
+	hits := rec.all()
+	if len(hits) != 1 {
+		t.Fatalf("expected 1 hit, got %d", len(hits))
+	}
+	want := map[string]string{"org": "go-chi", "repo": "chi"}
+	if !reflect.DeepEqual(hits[0].Params, want) {
+		t.Errorf("Params = %v, want %v", hits[0].Params, want)
+	}
+	if hits[0].Method != "POST" {
+		t.Errorf("Method = %q, want POST", hits[0].Method)
+	}
+}
+
+func TestMetricsCollectorNoParams(t *testing.T) {
+	rec := &metricsRecorder{}
+	r := NewRouter()
+	r.SetMetricsCollector(rec.collector())
+	r.Get("/ping", func(w http.ResponseWriter, r *http.Request) {})
+
+	serve(r, "GET", "/ping")
+
+	hits := rec.all()
+	if len(hits) != 1 {
+		t.Fatalf("expected 1 hit, got %d", len(hits))
+	}
+	if hits[0].Params == nil || len(hits[0].Params) != 0 {
+		t.Errorf("Params = %#v, want an empty, non-nil map", hits[0].Params)
+	}
+	if hits[0].Pattern != "/ping" {
+		t.Errorf("Pattern = %q, want /ping", hits[0].Pattern)
+	}
+}
+
+func TestMetricsCollectorCountsEachHit(t *testing.T) {
+	rec := &metricsRecorder{}
+	r := NewRouter()
+	r.SetMetricsCollector(rec.collector())
+	r.Get("/a", func(w http.ResponseWriter, r *http.Request) {})
+	r.Get("/b/{n}", func(w http.ResponseWriter, r *http.Request) {})
+
+	serve(r, "GET", "/a")
+	serve(r, "GET", "/b/1")
+	serve(r, "GET", "/b/2")
+	serve(r, "GET", "/a")
+
+	counts := map[string]int{}
+	for _, hit := range rec.all() {
+		counts[hit.Pattern]++
+	}
+	want := map[string]int{"/a": 2, "/b/{n}": 2}
+	if !reflect.DeepEqual(counts, want) {
+		t.Errorf("hits per pattern = %v, want %v", counts, want)
+	}
+}
+
+func TestMetricsCollectorSkipsUnroutedRequests(t *testing.T) {
+	rec := &metricsRecorder{}
+	r := NewRouter()
+	r.SetMetricsCollector(rec.collector())
+	r.Get("/only-get", func(w http.ResponseWriter, r *http.Request) {})
+
+	if w := serve(r, "GET", "/missing"); w.Code != 404 {
+		t.Fatalf("expected 404, got %d", w.Code)
+	}
+	if w := serve(r, "POST", "/only-get"); w.Code != 405 {
+		t.Fatalf("expected 405, got %d", w.Code)
+	}
+
+	if hits := rec.all(); len(hits) != 0 {
+		t.Errorf("expected no hits for 404 and 405 responses, got %v", hits)
+	}
+}
+
+func TestMetricsCollectorRecordsAfterHandlerAndInlineMiddleware(t *testing.T) {
+	var order []string
+	r := NewRouter()
+	r.SetMetricsCollector(&SimpleMetricsCollector{OnHit: func(RouteMetric) {
+		order = append(order, "hit")
+	}})
+	r.With(func(next http.Handler) http.Handler {
+		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			order = append(order, "inline-before")
+			next.ServeHTTP(w, r)
+			order = append(order, "inline-after")
+		})
+	}).Get("/x", func(w http.ResponseWriter, r *http.Request) {
+		order = append(order, "handler")
+	})
+
+	serve(r, "GET", "/x")
+
+	want := []string{"inline-before", "handler", "inline-after", "hit"}
+	if !reflect.DeepEqual(order, want) {
+		t.Errorf("order = %v, want %v", order, want)
+	}
+}
+
+func TestMetricsCollectorMountedSubrouter(t *testing.T) {
+	rec := &metricsRecorder{}
+	r := NewRouter()
+	r.SetMetricsCollector(rec.collector())
+	r.Route("/api/{version}", func(r Router) {
+		r.Get("/users/{id}", func(w http.ResponseWriter, r *http.Request) {})
+	})
+
+	serve(r, "GET", "/api/v1/users/42")
+
+	hits := rec.all()
+	if len(hits) != 1 {
+		t.Fatalf("expected 1 hit for a request through a subrouter, got %d", len(hits))
+	}
+	if want := "/api/{version}/users/{id}"; hits[0].Pattern != want {
+		t.Errorf("Pattern = %q, want %q", hits[0].Pattern, want)
+	}
+	want := map[string]string{"version": "v1", "id": "42", "*": ""}
+	if !reflect.DeepEqual(hits[0].Params, want) {
+		t.Errorf("Params = %v, want %v", hits[0].Params, want)
+	}
+}
+
+func TestMetricsCollectorCustomImplementation(t *testing.T) {
+	custom := &countingCollector{}
+	r := NewRouter()
+	r.SetMetricsCollector(custom)
+	r.Get("/x", func(w http.ResponseWriter, r *http.Request) {})
+
+	serve(r, "GET", "/x")
+	serve(r, "GET", "/x")
+
+	if custom.n != 2 {
+		t.Errorf("custom collector saw %d hits, want 2", custom.n)
+	}
+	if custom.pattern != "/x" {
+		t.Errorf("RouteContext pattern in the hit's context = %q, want /x", custom.pattern)
+	}
+}
+
+type countingCollector struct {
+	n       int
+	pattern string
+}
+
+func (c *countingCollector) RecordHit(ctx context.Context, r *http.Request, d time.Duration) {
+	c.n++
+	c.pattern = RouteContext(ctx).RoutePattern()
+}
+
+func TestMetricsCollectorDisabled(t *testing.T) {
+	rec := &metricsRecorder{}
+	r := NewRouter()
+	r.Get("/x", func(w http.ResponseWriter, r *http.Request) {})
+	r.SetMetricsCollector(rec.collector())
+	serve(r, "GET", "/x")
+	r.SetMetricsCollector(nil)
+	if w := serve(r, "GET", "/x"); w.Code != 200 {
+		t.Fatalf("expected 200 with no collector, got %d", w.Code)
+	}
+
+	if hits := rec.all(); len(hits) != 1 {
+		t.Errorf("expected only the hit before the collector was removed, got %d", len(hits))
+	}
+}
+
+func TestSimpleMetricsCollectorNilOnHit(t *testing.T) {
+	r := NewRouter()
+	r.SetMetricsCollector(&SimpleMetricsCollector{})
+	r.Get("/x", func(w http.ResponseWriter, r *http.Request) {})
+
+	if w := serve(r, "GET", "/x"); w.Code != 200 {
+		t.Fatalf("expected 200, got %d", w.Code)
+	}
+}
+
+func TestSimpleMetricsCollectorWithoutRouteContext(t *testing.T) {
+	var got RouteMetric
+	c := &SimpleMetricsCollector{OnHit: func(m RouteMetric) { got = m }}
+	req := httptest.NewRequest("PUT", "/free/standing", nil)
+
+	c.RecordHit(req.Context(), req, time.Second)
+
+	if got.Pattern != "" || got.Method != "PUT" || got.Path != "/free/standing" || got.Duration != time.Second {
+		t.Errorf("unexpected metric %#v", got)
+	}
+	if got.Params == nil || len(got.Params) != 0 {
+		t.Errorf("Params = %#v, want an empty, non-nil map", got.Params)
+	}
+}
+
+func TestMetricsCollectorConcurrentRequests(t *testing.T) {
+	rec := &metricsRecorder{}
+	r := NewRouter()
+	r.SetMetricsCollector(rec.collector())
+	r.Get("/items/{id}", func(w http.ResponseWriter, r *http.Request) {})
+
+	const n = 50
+	var wg sync.WaitGroup
+	for i := 0; i < n; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			serve(r, "GET", "/items/7")
+		}()
+	}
+	wg.Wait()
+
+	hits := rec.all()
+	if len(hits) != n {
+		t.Fatalf("expected %d hits, got %d", n, len(hits))
+	}
+	for _, hit := range hits {
+		if hit.Params["id"] != "7" {
+			t.Fatalf("Params = %v, want id=7", hit.Params)
+		}
+	}
+}
