+def validate_template_path(template: str) -> None:
+    """Check a template path for characters and sequences that must
+    never reach a loader, and raise `TemplateNotFound` if it has any.
+
+    A path is rejected when it is empty or ``None``, contains a null
+    byte, starts with ``/`` or ``\\`` (an absolute path), starts with a
+    Windows drive letter such as ``C:``, or contains an ASCII control
+    character other than tab, newline and carriage return.
+    """
+    if not template:
+        raise TemplateNotFound(template)
+
+    if "\x00" in template:
+        raise TemplateNotFound(template)
+
+    if template[0] in "/\\":
+        raise TemplateNotFound(template)
+
+    if template[1:2] == ":" and template[0].isascii() and template[0].isalpha():
+        raise TemplateNotFound(template)
+
+    for char in template:
+        if ord(char) < 32 and char not in "\t\n\r":
+            raise TemplateNotFound(template)
+
