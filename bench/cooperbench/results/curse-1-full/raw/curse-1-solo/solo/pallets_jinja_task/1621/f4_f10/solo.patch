+        """
+        return self._aliases.get(template, template)
+
+    def _guard_alias(self, alias: str, target: str, template: "Template") -> "Template":
+        """Make a template that was loaded under the name ``alias``, for
+        the template ``target``, out of date once ``alias`` is removed
+        or points somewhere else. The environment caches templates by
+        the name they were asked for, so without this it would go on
+        serving the old one, as long as ``target`` itself is unchanged.
+        """
+        if alias == target:
+            return template
+
+        uptodate = template._uptodate
+
+        def alias_uptodate() -> bool:
+            return self.resolve_alias(alias) == target and (
+                uptodate is None or uptodate()
+            )
+
+        template._uptodate = alias_uptodate
+        return template
+
