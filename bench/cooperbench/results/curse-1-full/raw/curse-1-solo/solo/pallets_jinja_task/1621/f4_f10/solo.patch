+        .. versionadded:: 3.1
+        """
+        self._aliases.pop(alias, None)
+
+    def resolve_alias(self, template: str) -> str:
+        """Return the template name that ``template`` is an alias for,
+        or ``template`` itself if it is not an alias. Loaders call this
+        first in :meth:`get_source`; a custom loader that wants to
+        support aliases does the same.
