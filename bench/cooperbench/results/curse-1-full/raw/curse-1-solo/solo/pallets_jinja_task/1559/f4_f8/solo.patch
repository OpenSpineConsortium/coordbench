+    def _trim_whitespace(self, string: str, _ws_re: t.Pattern[str] = _ws_re) -> str:
+        return _ws_re.sub(" ", string.strip())
+
+    def _parse_block(self, parser: "Parser") -> t.Tuple[t.List[str], str]:
+        """Parse until the next ``pluralize``, ``fallback`` or
+        ``endctrans`` tag, which the stream is left on, and return the
+        names of the variables referenced and the text with its
+        variables as ``%(name)s`` placeholders.
+        """
+        referenced = []
+        buf = []
+
+        while True:
+            if parser.stream.current.type == "data":
+                buf.append(parser.stream.current.value.replace("%", "%%"))
+                next(parser.stream)
+            elif parser.stream.current.type == "variable_begin":
+                next(parser.stream)
+                name = parser.stream.expect("name").value
+                referenced.append(name)
+                buf.append(f"%({name})s")
+                parser.stream.expect("variable_end")
+            elif parser.stream.current.type == "block_begin":
+                next(parser.stream)
+                if parser.stream.current.test_any(
+                    "name:pluralize", "name:fallback", "name:endctrans"
+                ):
+                    break
+                parser.fail(
+                    "control structures in translatable sections are not allowed"
                 )
-        return nodes.Output([node])
+            elif parser.stream.eos:
+                parser.fail("unclosed conditional translation block")
+            else:
+                raise RuntimeError("internal parser error")
+
+        return referenced, concat(buf)
+
+    def _make_conditional_node(
+        self,
+        condition: nodes.Expr,
+        singular: str,
+        plural: t.Optional[str],
+        fallback: str,
+        variables: t.Dict[str, nodes.Expr],
+        plural_expr: t.Optional[nodes.Expr],
+        num_called_num: bool,
+    ) -> nodes.If:
+        """Generates an ``If`` node that translates when the condition
+        holds and renders the fallback when it does not.
+        """
+        # The newstyle setting belongs to the i18n extension, which may
+        # not be loaded. The translation call then fails when it is made
+        # for want of a gettext, but the fallback does not need one.
+        newstyle = getattr(self.environment, "newstyle_gettext", False)
+
+        # A format that is applied to the variables below never has to
+        # keep a "%" that no variable follows, so only the text that no
+        # formatting reaches is unescaped.
+        translated = _make_gettext_call(
+            newstyle,
+            singular,
+            plural,
+            variables,
+            plural_expr,
+            bool(variables),
+            num_called_num,
+        )
+
+        # The fallback is formatted here, as old style gettext does it,
+        # whichever style the environment uses for the translation. The
+        # text is the template's own and so safe, and the variables are
+        # escaped when autoescaping is on.
+        rendered: nodes.Expr = nodes.MarkSafeIfAutoescape(nodes.Const(fallback))
+        rendered = nodes.Mod(rendered, _variables_dict(variables))
+
+        return nodes.If(
+            condition,
+            [nodes.Output([translated])],
+            [],
+            [nodes.Output([rendered])],
+        )
 
 
