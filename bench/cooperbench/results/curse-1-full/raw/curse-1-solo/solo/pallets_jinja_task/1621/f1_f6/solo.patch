+def _split_transformed_path(template: str, path: str) -> t.List[str]:
+    """Like :func:`split_template_path`, for a path that a loader's
+    ``path_transform`` made from ``template``. A path that is refused is
+    reported under the name the caller asked for, not the transformed one.
+    """
