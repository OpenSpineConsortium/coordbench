+
+# A deliberately practical rather than RFC 5322 complete check: a local part of the characters in common use,
+# then "@", then dot separated domain labels (no empty label, no leading or trailing hyphen) ending in a
+# top level domain of at least two letters.
+_EMAIL_REGEX = re.compile(
+    r'[A-Za-z0-9._%+-]+'
+    r'@'
+    r'(?:[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?\.)+'
+    r'[A-Za-z]{2,}'
+)
+
+
+class IsEmail(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid email address, optionally restricted to one domain.
+    """
+
+    def __init__(self, domain: Optional[str] = None):
+        """
+        Args:
+            domain: The domain the email address must belong to, compared exactly (case-sensitive),
+                if omitted, any domain is accepted.
+
+        ```py title="IsEmail"
+        from dirty_equals import IsEmail
+
+        assert 'user@example.com' == IsEmail
+        assert 'user@example.com' == IsEmail()
+        assert 'user@example.com' == IsEmail(domain='example.com')
+        assert 'user@example.org' != IsEmail(domain='example.com')
+        assert 'user@Example.com' != IsEmail(domain='example.com')
+        assert 'not an email' != IsEmail
+        assert 'user@example' != IsEmail
+        assert 123 != IsEmail
+        ```
+        """
+        self.domain = domain
+        super().__init__(plain_repr('*') if domain is None else domain)
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str) or _EMAIL_REGEX.fullmatch(other) is None:
+            return False
+
+        if self.domain is None:
+            return True
+        else:
+            return other.rpartition('@')[2] == self.domain
+
+
+# the length in hexadecimal characters of the digest each supported algorithm produces
+_HASH_LENGTHS = {
+    'md5': 32,
+    'sha1': 40,
+    'sha224': 56,
+    'sha256': 64,
+    'sha384': 96,
+    'sha512': 128,
+}
+_HEX_CHARS = frozenset('0123456789abcdefABCDEF')
+
+
+def _normalise_algorithm(algorithm: str) -> str:
+    """
+    Make "SHA-256", "sha_256" and "sha256" all look up the same entry of `_HASH_LENGTHS`.
+    """
+    return algorithm.lower().replace('-', '').replace('_', '')
+
+
+class IsHash(DirtyEquals[str]):
+    """
+    A class that checks if a value is a string in the format of a hexadecimal cryptographic hash digest.
+    """
+
+    def __init__(self, algorithm: str):
+        """
+        Args:
+            algorithm: The hash algorithm whose digest format to check, one of `md5`, `sha1`, `sha224`, `sha256`,
+                `sha384` and `sha512`, case-insensitive; `-` and `_` are ignored so `sha-256` also works.
+
+        Only the format is checked: the right number of hexadecimal characters for the algorithm, in upper
+        or lower case. Nothing is said about whether the digest is the hash of anything.
+
+        ```py title="IsHash"
+        from dirty_equals import IsHash
+
+        assert 'd41d8cd98f00b204e9800998ecf8427e' == IsHash('md5')
+        assert 'da39a3ee5e6b4b0d3255bfef95601890afd80709' == IsHash('sha1')
+        assert 'DA39A3EE5E6B4B0D3255BFEF95601890AFD80709' == IsHash('sha1')
+        assert 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855' == IsHash('sha256')
+        assert 'd41d8cd98f00b204e9800998ecf8427e' != IsHash('sha1')
+        assert 'zzz41d8cd98f00b204e9800998ecf8427e' != IsHash('md5')
+        assert 123 != IsHash('md5')
+        ```
+        """
+        try:
+            self.length = _HASH_LENGTHS[_normalise_algorithm(algorithm)]
+        except (KeyError, AttributeError):
+            supported = ', '.join(_HASH_LENGTHS)
+            raise ValueError(f'unsupported hash algorithm {algorithm!r}, expected one of: {supported}') from None
+        self.algorithm = algorithm
+        super().__init__(algorithm)
+
+    def equals(self, other: Any) -> bool:
+        return isinstance(other, str) and len(other) == self.length and all(c in _HEX_CHARS for c in other)
