+    def _scale_palette_lightness(self, factor):
+        if factor == 1.0:
+            return
+
+        # Index 0 stays 0 and a product of 255 or more stays 255; this also
+        # keeps an infinite factor, which int() would refuse, from failing.
+        table = bytes(
+            0 if value == 0 else 255 if value * factor >= 255 else int(value * factor)
+            for value in range(256)
