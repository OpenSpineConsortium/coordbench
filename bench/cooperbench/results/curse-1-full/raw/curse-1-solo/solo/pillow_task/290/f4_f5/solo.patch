+    def _quantize_within_error(self, colors, method, kmeans, error_threshold):
+        # Quantize to the smallest palette whose mean square error is within
+        # error_threshold, found by bisection, since asking for more colors
+        # almost never makes the error larger. Every image tried is measured
+        # as it is returned, so the one returned is within the threshold
+        # unless even `colors` colors are not enough, when it is the one
+        # with `colors` colors.
