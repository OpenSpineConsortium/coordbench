+def _palette_brightness(color):
+    # The weights Pillow itself uses to turn RGB into "L" (ITU-R 601-2 luma).
+    r, g, b = color[:3]
+    return 0.299 * r + 0.587 * g + 0.114 * b
+
+
+def _palette_rgb(color):
+    return tuple(color[:3])
+
+
+# The orders quantize() can sort a palette into, by the key each one sorts on.
+_PALETTE_SORT_KEYS = {"brightness": _palette_brightness, "rgb": _palette_rgb}
+
+
+def _palette_length(data, step, highest_used):
+    """
+    Counts the leading entries of a quantized palette that hold colors.
+
+    The core always hands back 256 entries and pads the ones the quantizer did
+    not fill with black. Those must stay at the end when the palette is sorted,
+    so the length is taken as far as the last entry that a pixel uses or that
+    is not black.
+
+    :param data: The palette bytes, ``step`` bytes to an entry.
+    :param step: The number of channels in an entry, 3 for RGB or 4 for RGBA.
+    :param highest_used: The highest palette index any pixel refers to.
+    """
+    length = highest_used + 1
+    for index in range(len(data) // step - 1, length - 1, -1):
+        if any(data[index * step : index * step + 3]):
+            return index + 1
+    return length
+
+
+def _lightness_table(lightness_factor):
+    # Scaling 0 gives 0 for every factor, including an infinite one.
+    return bytes(
+        0 if value == 0 else int(min(255, value * lightness_factor))
+        for value in range(256)
+    )
+
+
