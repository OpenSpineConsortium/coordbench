+    def _adjust_palette(self, sort_palette, lightness_factor):
+        """
+        Sorts and brightens the palette of this "P" image in place, for
+        :py:meth:`~PIL.Image.Image.quantize`, which calls it only on the new
+        image it is about to return, so nobody else holds this one.
+
+        The sort comes first and the brightness second, so that brightening is
+        the last thing done to the palette. The pixels are renumbered along
+        with a sort; brightening leaves them alone.
+        """
+        if sort_palette is None and lightness_factor == 1:
+            return
+
+        mode = self.im.getpalettemode()  # "RGB", or "RGBA" from an alpha quantizer
+        step = len(mode)
+        data = bytearray(self.im.getpalette(mode, mode))
+
+        if sort_palette is not None:
+            extrema = self.im.getextrema()  # None for an image with no pixels
+            length = _palette_length(data, step, extrema[1] if extrema else -1)
+            key = _PALETTE_SORT_KEYS[sort_palette]
+            colors = [data[i * step : (i + 1) * step] for i in range(length)]
+            order = sorted(range(length), key=lambda old: key(colors[old]))
+
+            new_index = list(range(256))  # entries past the sorted ones stay
+            for new, old in enumerate(order):
+                new_index[old] = new
+                data[new * step : (new + 1) * step] = colors[old]
+            self.im = self.im.point(new_index, None)
+
+        if lightness_factor != 1:
+            table = _lightness_table(lightness_factor)
+            for channel in range(3):  # not the alpha channel
+                data[channel::step] = data[channel::step].translate(table)
+
+        self._put_quantized_palette(mode, data)
+
+    def _put_quantized_palette(self, mode, data):
+        """
+        Replaces the core palette and the palette object of this "P" image with
+        ``data``, whole: 256 entries of ``mode``, "RGB" or "RGBA".
+        """
+        from . import ImagePalette
+
+        step = len(mode)
+        rgb = bytearray(len(data) // step * 3)
+        for channel in range(3):
+            rgb[channel::3] = data[channel::step]
+        self.im.putpalette("RGB", bytes(rgb))
+        if mode == "RGBA":
+            # putpalette gives the core palette back its "RGB" mode.
+            self.im.putpalettealphas(bytes(data[3::4]))
+        self.palette = ImagePalette.ImagePalette(mode, bytes(data))
+
