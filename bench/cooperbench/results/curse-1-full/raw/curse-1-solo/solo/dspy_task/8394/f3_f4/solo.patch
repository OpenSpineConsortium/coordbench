+class CacheUsageTracker:
+    """Tracks cache events (memory hits, disk hits and misses) within a context."""
+
+    # The keys of `get_total_cache_usage()`, the same ones `dspy.cache.stats()` has.
+    EVENT_NAMES = ("hits", "mem_hits", "disk_hits", "misses")
+
+    def __init__(self):
+        self._counts = Counter()
+        # Parallel workers of one call share the tracker, so counting is guarded.
+        self._lock = threading.Lock()
+
+    def add_events(self, *events: str) -> None:
+        """Count each of the given events once, e.g. `add_events("hits", "mem_hits")` for a memory hit."""
+        with self._lock:
+            self._counts.update(events)
+
+    def get_total_cache_usage(self) -> Dict[str, int]:
+        """Return how many events of each kind were counted so far, with zero for the kinds that never happened."""
+        with self._lock:
+            return {name: self._counts[name] for name in self.EVENT_NAMES}
+
+
+@contextmanager
+def track_cache_usage():
+    """Context manager for tracking cache hits and misses of the calls made inside it."""
+    tracker = CacheUsageTracker()
+
+    with settings.context(cache_usage_tracker=tracker):
+        yield tracker
