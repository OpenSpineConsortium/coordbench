diff --git a/metrics.go b/metrics.go
new file mode 100644
index 0000000..3703e01
--- /dev/null
+++ b/metrics.go
@@ -0,0 +1,70 @@
+package chi
+
+import (
+	"context"
+	"net/http"
+	"time"
+)
+
+// MetricsCollector receives one record for each request that a Mux routed to
+// a handler. It is called after the handler has returned, with the request's
+// context (which carries the routing context, so the matched pattern and the
+// URL params are still known), the request and how long the handler took.
+type MetricsCollector interface {
+	RecordHit(ctx context.Context, r *http.Request, duration time.Duration)
+}
+
+// RouteMetric describes one hit of a route.
+type RouteMetric struct {
+	// Pattern is the matched route pattern, e.g. "/users/{id}".
+	Pattern string
+
+	// Method is the HTTP method of the request.
+	Method string
+
+	// Path is the path of the request, e.g. "/users/123".
+	Path string
+
+	// Duration is how long the route's handler took to serve the request.
+	Duration time.Duration
+
+	// Params holds the URL params of the request keyed by name,
+	// e.g. {"id": "123"}.
+	Params map[string]string
+}
+
+// SimpleMetricsCollector is a MetricsCollector that hands each hit to a
+// callback as a RouteMetric.
+type SimpleMetricsCollector struct {
+	// OnHit is called once for each hit. A nil OnHit collects nothing.
+	OnHit func(RouteMetric)
+}
+
+// RecordHit builds the RouteMetric of a hit and passes it to OnHit.
+func (c SimpleMetricsCollector) RecordHit(ctx context.Context, r *http.Request, duration time.Duration) {
+	if c.OnHit == nil {
+		return
+	}
+
+	metric := RouteMetric{
+		Method:   r.Method,
+		Duration: duration,
+		Params:   map[string]string{},
+	}
+	if r.URL != nil {
+		metric.Path = r.URL.Path
+	}
+
+	if rctx := RouteContext(ctx); rctx != nil {
+		metric.Pattern = rctx.RoutePattern()
+		for i, key := range rctx.URLParams.Keys {
+			if i >= len(rctx.URLParams.Values) {
+				break
+			}
+			// A later value of a repeated name wins, as it does for URLParam.
+			metric.Params[key] = rctx.URLParams.Values[i]
+		}
+	}
+
+	c.OnHit(metric)
+}
