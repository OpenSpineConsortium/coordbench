+// SetMetricsCollector sets the collector that receives a record, after the
+// handler has returned, of each request this Mux routes to a handler. Passing
+// nil turns collecting off. A mounted subrouter has a collector of its own, if
+// it is given one; the parent's collector records a request to a mounted
+// subrouter once, with the full pattern and every URL param.
+//
+// Call it before the Mux serves requests: it is not safe to change the
+// collector while requests are being served.
+func (mx *Mux) SetMetricsCollector(collector MetricsCollector) {
+	mx.metricsCollector = collector
+}
+
 // Use appends a middleware handler to the Mux middleware stack.
 //
 // The middleware stack for any Mux will execute before searching for a matching
@@ -454,6 +470,15 @@ func (mx *Mux) routeHTTP(w http.ResponseWriter, r *http.Request) {
 
 	// Find the route
 	if _, _, h := mx.tree.FindRoute(rctx, method, routePath); h != nil {
+		if supportsPathValue {
+			setPathValue(rctx, r)
+		}
+		if mx.metricsCollector != nil {
+			start := time.Now()
+			h.ServeHTTP(w, r)
+			mx.metricsCollector.RecordHit(r.Context(), r, time.Since(start))
