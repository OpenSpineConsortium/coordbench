index 0000000..925a6c3
--- /dev/null
+++ b/path_value_fallback.go
@@ -0,0 +1,13 @@
+//go:build !go1.22
+// +build !go1.22
+
+package chi
+
+import "net/http"
+
+// supportsPathValue is false before Go 1.22, where `net/http.Request` has no
+// `SetPathValue` or `PathValue` methods.
+const supportsPathValue = false
+
+// setPathValue does nothing before Go 1.22.
+func setPathValue(rctx *Context, r *http.Request) {}
