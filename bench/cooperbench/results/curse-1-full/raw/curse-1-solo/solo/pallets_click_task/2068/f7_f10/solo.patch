+    def _quote_editor(self, editor: str) -> str:
+        """Quote an editor command for the shell, keeping its arguments.
+
+        An editor that names an executable as a whole (a path with spaces,
+        say) is quoted as one word. Anything else is split the way a
+        shell would split it and each word is quoted, so ``vim -p`` stays
+        a command with an argument while ``vim; rm -rf /`` cannot start a
+        second command.
+        """
+        import shlex
+        import shutil
+
+        if shutil.which(editor) is not None:
+            return shlex.quote(editor)
+
+        try:
+            words = shlex.split(editor)
+        except ValueError:
+            return shlex.quote(editor)
+
+        return " ".join(shlex.quote(word) for word in words)
+
+    def _build_command(self, editor: str, filename: str) -> str:
+        if not self.escape_shell:
+            return f'{editor} "{filename}"'
+
+        import shlex
+
+        return f"{self._quote_editor(editor)} {shlex.quote(filename)}"
+
     def edit_file(self, filename: str) -> None:
         import subprocess
 
