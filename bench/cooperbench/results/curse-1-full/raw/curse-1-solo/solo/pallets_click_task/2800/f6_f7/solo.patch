+def _describe_context(ctx: Context) -> str:
+    """A short name for a context in error messages."""
+    name = ctx.info_name or getattr(ctx.command, "name", None)
+
+    if name:
+        return repr(name)
+
+    return f"<{type(ctx.command).__name__}>"
+
+
+def _deepcopy_or_share(value: t.Any) -> t.Any:
+    """Deep copy ``value``. A value that cannot be copied, such as an open
+    file or a database connection, is shared with the copy instead of
+    failing, and a dict keeps copying every entry it can.
+    """
+    # Imported here, like ``warnings`` elsewhere, to keep ``import click``
+    # light: tests/test_imports.py lists what it may import.
+    import copy
+
+    try:
+        return copy.deepcopy(value)
+    except Exception:
+        if not isinstance(value, dict):
+            return value
+
+        rv = copy.copy(value)
+
+        for key, item in value.items():
+            rv[key] = _deepcopy_or_share(item)
+
+        return rv
+
+
+# Attributes that save_state() deep copies, so that nested changes made after
+# the snapshot reach neither the snapshot nor the restored context.
+_STATE_DEEP_COPIED = frozenset(
+    {"params", "obj", "_meta", "default_map", "_parameter_source"}
+)
+# Attributes that hold running resources or the nesting bookkeeping. They are
+# kept by reference in a snapshot and never restored: putting an old exit stack
+# back would drop a resource opened since without closing it.
+_STATE_LIVE = frozenset(
+    {"_exit_stack", "_close_callbacks", "_depth", "_child_contexts"}
+)
+# Public spellings of the private attributes, accepted by restore_state().
+_STATE_ALIASES = {
+    "protected_args": "_protected_args",
+    "opt_prefixes": "_opt_prefixes",
+    "meta": "_meta",
+    "parameter_source": "_parameter_source",
+}
+
+
+def _copy_state_value(name: str, value: t.Any) -> t.Any:
+    if name in _STATE_DEEP_COPIED:
+        return _deepcopy_or_share(value)
+
+    if isinstance(value, (list, set, dict)):
+        import copy
+
+        return copy.copy(value)
+
+    return value
+
+
