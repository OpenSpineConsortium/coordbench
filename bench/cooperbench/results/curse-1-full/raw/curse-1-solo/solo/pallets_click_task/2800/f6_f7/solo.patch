+    def save_state(self) -> dict[str, t.Any]:
+        """Take a snapshot of the state of this context that
+        :meth:`restore_state` can put back later.
+
+        The snapshot is a dict with one key per attribute of the context,
+        among them ``params``, ``args``, ``_protected_args``,
+        ``_opt_prefixes``, ``obj``, ``_meta``, ``default_map`` and
+        ``_parameter_source``. ``params``, ``obj``, ``_meta``,
+        ``default_map`` and ``_parameter_source`` are deep copied, the
+        lists, sets and dicts among the other attributes are copied, so
+        changes made to the context afterwards do not reach the snapshot.
+        A value that cannot be deep copied, such as an open file, is shared.
+
+        The parent and the command are kept by reference. So are the
+        resources, the exit stack and what was registered with
+        :meth:`call_on_close`: :meth:`restore_state` leaves them alone, so
+        a resource opened after the snapshot is still closed with the
+        context.
+
+        .. versionadded:: 8.2
+        """
+        snapshot: dict[str, t.Any] = {}
+
+        for name, value in vars(self).items():
+            if name not in _STATE_LIVE:
+                value = _copy_state_value(name, value)
+
+            snapshot[name] = value
+
+        return snapshot
+
+    def restore_state(self, snapshot: cabc.Mapping[str, t.Any]) -> None:
+        """Put back the state that :meth:`save_state` captured. Attributes
+        the snapshot does not hold are left as they are.
+
+        The values are copied again as they are restored, so the snapshot
+        stays as it was and can be restored more than once. The ``_meta``
+        dict is restored in place, since nested contexts share it.
+
+        :param snapshot: A dict returned by :meth:`save_state`.
+
+        .. versionadded:: 8.2
+        """
+        for key, value in snapshot.items():
+            name = _STATE_ALIASES.get(key, key)
+
+            if name in _STATE_LIVE:
+                continue
+
+            value = _copy_state_value(name, value)
+
+            if name == "_meta" and isinstance(value, dict):
+                items = list(value.items())
+                self._meta.clear()
+                self._meta.update(items)
+            else:
+                setattr(self, name, value)
+
