+    def shell_complete(self, ctx: Context, incomplete: str) -> list[CompletionItem]:
+        """Return a list of completions for the incomplete value. A
+        ``shell_complete`` function given during init is used first. If
+        there is none and ``auto_complete`` is enabled, the completions
+        are worked out by :meth:`_smart_complete`. Otherwise, the
+        :attr:`type` :meth:`~click.types.ParamType.shell_complete`
+        function is used.
+
+        :param ctx: Invocation context for this command.
+        :param incomplete: Value being completed. May be empty.
+
+        .. versionchanged:: 8.3
+            Complete the value from the option's name and type if
+            ``auto_complete`` is enabled.
+        """
+        if self.auto_complete and self._custom_shell_complete is None:
+            return self._smart_complete(ctx, incomplete)
+
+        return super().shell_complete(ctx, incomplete)
+
+    def _auto_complete_function(
+        self,
+    ) -> t.Callable[[str], list[CompletionItem]] | None:
+        """Find the function in the registry that completes this option,
+        from the words of its name, then of its flags. The last word of a
+        name tells what it is, as in ``--env-file``, so it comes first.
+        """
+        names = [self.name or "", *self.opts, *self.secondary_opts]
+
+        for name in names:
+            words = [w for w in name.lower().replace("-", "_").split("_") if w]
+
+            for word in reversed(words):
+                if word in _AUTO_COMPLETE_REGISTRY:
+                    return _AUTO_COMPLETE_REGISTRY[word]
+
+        return None
+
+    def _smart_complete(self, ctx: Context, incomplete: str) -> list[CompletionItem]:
+        """Work out the completions for the incomplete value from the
+        option's type and name and the environment that the command runs
+        in. A type that completes its own values, such as
+        :class:`~click.Choice` or :class:`~click.Path`, comes first, then
+        the registry matches the option's name against the users of the
+        system, git branches, paths and environment variables. Anything
+        else is left to the type.
+
+        :param ctx: Invocation context for this command.
+        :param incomplete: Value being completed. May be empty.
+
+        .. versionadded:: 8.3
+        """
+        type_complete = type(self.type).shell_complete
+
+        if type_complete is not types.ParamType.shell_complete:
+            return self.type.shell_complete(ctx, self, incomplete)
+
+        function = self._auto_complete_function()
+
+        if function is not None:
+            return function(incomplete)
+
+        return self.type.shell_complete(ctx, self, incomplete)
+
