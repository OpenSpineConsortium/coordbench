+def _complete_usernames(incomplete: str) -> list[CompletionItem]:
+    """Complete the names of the users of this system."""
+    from .shell_completion import CompletionItem
+
+    names: set[str] = set()
+
+    try:
+        import pwd
+
+        names.update(entry.pw_name for entry in pwd.getpwall())
+    except Exception:
+        # There is no user database on Windows.
+        pass
+
+    if not names:
+        # No user database, fall back to the current user alone.
+        import getpass
+
+        try:
+            names.add(getpass.getuser())
+        except Exception:
+            pass
+
+    return [CompletionItem(n) for n in sorted(names) if n.startswith(incomplete)]
+
+
+def _complete_git_branches(incomplete: str) -> list[CompletionItem]:
+    """Complete the local and remote branches of the git repository
+    that the current directory is in. There are no completions outside
+    of a repository, or when git is not available.
+    """
+    import subprocess
+
+    from .shell_completion import CompletionItem
+
+    try:
+        output = subprocess.check_output(
+            ["git", "branch", "-a", "--format=%(refname:short)"],
+            stderr=subprocess.DEVNULL,
+            text=True,
+            timeout=5,
+        )
+    except (OSError, subprocess.SubprocessError):
+        return []
+
+    if isinstance(output, bytes):
+        output = output.decode(errors="replace")
+
+    branches: list[str] = []
+
+    for line in str(output).splitlines():
+        branch = line.strip()
+
+        # Skips a detached HEAD, which git shows as "(HEAD detached ...)".
+        if branch and not branch.startswith("(") and branch not in branches:
+            branches.append(branch)
+
+    return [CompletionItem(b) for b in branches if b.startswith(incomplete)]
+
+
+def _complete_paths(incomplete: str, dirs_only: bool = False) -> list[CompletionItem]:
+    """Complete the files and directories that start with the incomplete
+    value. If none do, the shell is asked to complete the path instead,
+    as it is for :class:`~click.Path`.
+    """
+    from .shell_completion import CompletionItem
+
+    head = incomplete[: len(incomplete) - len(os.path.basename(incomplete))]
+    prefix = incomplete[len(head) :]
+    item_type = "dir" if dirs_only else "file"
+    items: list[CompletionItem] = []
+
+    try:
+        names = sorted(os.listdir(os.path.expanduser(head) if head else "."))
+    except OSError:
+        names = []
+
+    for name in names:
+        if not name.startswith(prefix) or (name.startswith(".") and not prefix):
+            continue
+
+        is_dir = os.path.isdir(os.path.join(os.path.expanduser(head), name))
+
+        if dirs_only and not is_dir:
+            continue
+
+        # Every item has the same type, since the shell acts on the last.
+        items.append(
+            CompletionItem(f"{head}{name}{os.sep if is_dir else ''}", type=item_type)
+        )
+
+    return items or [CompletionItem(incomplete, type=item_type)]
+
+
+def _complete_env_vars(incomplete: str) -> list[CompletionItem]:
+    """Complete the names of the environment variables."""
+    from .shell_completion import CompletionItem
+
+    return [CompletionItem(k) for k in sorted(os.environ) if k.startswith(incomplete)]
+
+
+def _complete_dirs(incomplete: str) -> list[CompletionItem]:
+    return _complete_paths(incomplete, dirs_only=True)
+
+
+#: Maps the words that an option name is made of to the function that
+#: completes its value. See :meth:`Option._smart_complete`.
+_AUTO_COMPLETE_REGISTRY: dict[str, t.Callable[[str], list[CompletionItem]]] = {
+    "user": _complete_usernames,
+    "users": _complete_usernames,
+    "username": _complete_usernames,
+    "usernames": _complete_usernames,
+    "login": _complete_usernames,
+    "branch": _complete_git_branches,
+    "branches": _complete_git_branches,
+    "file": _complete_paths,
+    "files": _complete_paths,
+    "filename": _complete_paths,
+    "filenames": _complete_paths,
+    "filepath": _complete_paths,
+    "path": _complete_paths,
+    "paths": _complete_paths,
+    "dir": _complete_dirs,
+    "dirs": _complete_dirs,
+    "directory": _complete_dirs,
+    "directories": _complete_dirs,
+    "folder": _complete_dirs,
+    "folders": _complete_dirs,
+    "env": _complete_env_vars,
+    "envs": _complete_env_vars,
+    "envvar": _complete_env_vars,
+    "envvars": _complete_env_vars,
+    "environment": _complete_env_vars,
+}
