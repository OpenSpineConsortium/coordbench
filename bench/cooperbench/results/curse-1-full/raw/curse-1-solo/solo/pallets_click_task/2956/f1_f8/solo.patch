+    def _record_option_value(
+        self, name: str, value: t.Any, source: ParameterSource | None
+    ) -> None:
+        """Append a value to the history of the parameter ``name``, if
+        tracking is enabled. When the parameter already has a recorded
+        value, the new entry also holds it as ``previous_value``.
+        """
+        if not self._track_changes:
+            return
+
+        import time
+
+        history = self._option_history.setdefault(name, [])
+        entry: dict[str, t.Any] = {
+            "value": value,
+            "source": source,
+            "timestamp": time.time(),
+        }
+
+        if history:
+            entry["previous_value"] = history[-1]["value"]
+
+        history.append(entry)
+
+    def _resolve_option_name(self, name: str) -> str:
+        """Turn an option flag such as ``--count`` or ``-c`` into the
+        name of the parameter it sets. Anything that is not the flag of
+        one of the command's options is returned unchanged.
+        """
+        params = list(self.command.params)
+        help_option = self.command.get_help_option(self)
+
+        if help_option is not None:
+            params.append(help_option)
+
+        for param in params:
+            if (
+                isinstance(param, Option)
+                and param.name is not None
+                and name in (*param.opts, *param.secondary_opts)
+            ):
+                return param.name
+
+        return name
+
+    def get_option_history(self, name: str) -> list[dict[str, t.Any]] | None:
+        """Get the recorded values of an option, oldest first. Each entry
+        is a dict with the ``value``, the ``source`` (a member of
+        :class:`~click.core.ParameterSource`) it came from and the
+        ``timestamp`` at which it was set. An entry that replaced an
+        earlier value also has that value as ``previous_value``.
+
+        History is only recorded for commands created with
+        ``track_changes=True``.
+
+        :param name: The name of the parameter, or one of the flags of
+            the option, such as ``"count"``, ``"--count"`` or ``"-c"``.
+        :return: ``None`` if tracking is disabled, otherwise the list of
+            entries, which is empty for an unknown option.
+
+        .. versionadded:: 8.3
+        """
+        if not self._track_changes:
+            return None
+
+        return list(self._option_history.get(self._resolve_option_name(name), ()))
+
 
