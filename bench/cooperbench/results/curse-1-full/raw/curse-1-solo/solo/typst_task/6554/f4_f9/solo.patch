+/// Checks that `repeat` asks for at least one grapheme cluster.
+fn check_repeat(repeat: i64) -> StrResult<usize> {
+    match usize::try_from(repeat) {
+        Ok(repeat) if repeat >= 1 => Ok(repeat),
+        _ => bail!("repeat must be at least 1"),
+    }
+}
+
+/// Returns all of `text` when it has exactly `repeat` grapheme clusters and
+/// fails when it has fewer. Called only once the iteration over the clusters
+/// ran out, so the count is paid for on that path alone.
+fn whole_unless_short(text: &str, repeat: usize) -> StrResult<Str> {
+    let len = text.graphemes(true).count();
+    if len < repeat {
+        bail!("not enough characters (requested {repeat}, but string only has {len})");
+    }
+    Ok(text.into())
+}
