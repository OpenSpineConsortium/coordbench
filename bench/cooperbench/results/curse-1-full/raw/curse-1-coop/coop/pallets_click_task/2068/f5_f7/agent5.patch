+    def _get_lock_filename(self, filename: str) -> str:
+        """Return the path of the lock file for ``filename``: the same
+        directory, named ``.{basename}.lock``.
+        """
+        directory, basename = os.path.split(filename)
+        return os.path.join(directory, f".{basename}.lock")
+
+    def _create_lock_file(self, filename: str) -> str:
+        """Create the lock file for ``filename`` and return its path.
+
+        The file is made with ``O_CREAT | O_EXCL``, so the check for an
+        existing lock and the creation are one atomic step and two
+        processes can never both take the lock. It records the process
+        ID and the time, to help whoever finds a stale lock.
+
+        :raises ClickException: if the file is already locked or the
+            lock file cannot be created.
+        """
+        from datetime import datetime
+
+        lock_filename = self._get_lock_filename(filename)
+        flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY
+
+        try:
+            fd = os.open(lock_filename, flags, 0o644)
+        except FileExistsError:
+            raise ClickException(
+                _(
+                    "{filename}: File is locked, it is already being edited by"
+                    " another process. Lock file {lock} exists, remove it if"
+                    " that session is gone."
+                ).format(filename=filename, lock=lock_filename)
+            ) from None
+        except OSError as e:
+            raise ClickException(
+                _("{filename}: Cannot create lock file: {e}").format(
+                    filename=filename, e=e
+                )
+            ) from e
+
+        try:
+            with os.fdopen(fd, "w", encoding="utf-8") as f:
+                f.write(f"PID: {os.getpid()}\nTime: {datetime.now().isoformat()}")
+        except BaseException:
+            # The file exists but is unusable. Don't leave it behind to
+            # block the next edit.
+            self._remove_lock_file(lock_filename)
+            raise
+
+        return lock_filename
+
+    def _remove_lock_file(self, lock_filename: str) -> None:
+        """Remove a lock file made by :meth:`_create_lock_file`. A lock
+        file that is already gone is not an error.
+        """
+        with contextlib.suppress(FileNotFoundError):
+            os.unlink(lock_filename)
 
