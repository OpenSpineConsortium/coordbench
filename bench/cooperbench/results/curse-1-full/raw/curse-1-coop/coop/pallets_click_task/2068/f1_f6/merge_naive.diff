+# How much each priority changes a Unix process's niceness. A positive
+# increment lowers the priority; a negative one raises it and normally
+# needs privileges.
+_PRIORITY_NICE = {
+    "low": 10,
+    "below_normal": 5,
+    "normal": 0,
+    "above_normal": -5,
+    "high": -10,
+}
+
+# The priority class of each priority, as a subprocess constant's name,
+# since the constants exist on Windows only.
+_PRIORITY_WINDOWS = {
+    "low": "IDLE_PRIORITY_CLASS",
+    "below_normal": "BELOW_NORMAL_PRIORITY_CLASS",
+    "normal": "NORMAL_PRIORITY_CLASS",
+    "above_normal": "ABOVE_NORMAL_PRIORITY_CLASS",
+    "high": "HIGH_PRIORITY_CLASS",
+}
+
