+        process_priority: str | None = None,
     ) -> None:
         self.editor = editor
         self.env = env
         self.require_save = require_save
         self.extension = extension
+        # An unknown priority is ignored, so the editor starts as usual.
+        self.process_priority = (
+            process_priority
+            if isinstance(process_priority, str) and process_priority in _PRIORITY_NICE
+            else None
+        )
+
+    def _priority_popen_kwargs(self) -> dict[str, t.Any]:
+        """Keyword arguments for ``subprocess.Popen`` that start the editor
+        at the requested priority, or an empty dict when none was asked
+        for or the platform has no way to set it.
+
+        Windows takes a priority class as a creation flag. Elsewhere the
+        child lowers or raises its own niceness before it runs the
+        editor, which the shell and anything it starts then inherit.
+        """
+        if self.process_priority is None:
+            return {}
+
+        if WIN:
+            import subprocess
+
+            flag = getattr(subprocess, _PRIORITY_WINDOWS[self.process_priority], 0)
+            return {"creationflags": flag} if flag else {}
+
+        if not hasattr(os, "nice"):
+            return {}
+
+        increment = _PRIORITY_NICE[self.process_priority]
+
+        def set_priority() -> None:
+            # Runs in the child before exec. An exception here would
+            # stop the editor from starting, and a plain user may not
+            # raise a priority, so a failure is swallowed.
+            with contextlib.suppress(OSError):
+                os.nice(increment)
+
+        return {"preexec_fn": set_priority}
 
