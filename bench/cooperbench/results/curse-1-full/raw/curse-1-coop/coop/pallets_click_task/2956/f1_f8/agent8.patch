+    def _record_option_change(
+        self, name: str, value: t.Any, source: ParameterSource | None
+    ) -> None:
+        """Append a value of the parameter ``name`` to its history. Does
+        nothing unless the command was created with ``track_changes``.
+
+        An entry holds the ``value``, its ``source`` and the ``timestamp``
+        it was set at. An entry that replaces an earlier one also holds
+        that one's value as ``previous_value``.
+        """
+        if not self._track_changes:
+            return
+
+        # Imported here because click keeps its import time down and
+        # only a command that tracks changes needs the clock.
+        import time
+
+        history = self._option_history.setdefault(name, [])
+        entry: dict[str, t.Any] = {
+            "value": value,
+            "source": source,
+            "timestamp": time.time(),
+        }
+
+        if history:
+            entry["previous_value"] = history[-1]["value"]
+
+        history.append(entry)
+
+    def _resolve_option_name(self, name: str) -> str:
+        """Turn an option flag such as ``--count`` or ``-c`` into the
+        name of the parameter it sets. Anything that is not a flag of
+        this command's options is returned unchanged.
+        """
+        if not name.startswith("-"):
+            return name
+
+        params: list[Parameter] = list(self.command.params)
+        help_option = self.command.get_help_option(self)
+
+        if help_option is not None:
+            params.append(help_option)
+
+        for param in params:
+            if param.name is not None and name in (
+                *param.opts,
+                *getattr(param, "secondary_opts", ()),
+            ):
+                return param.name
+
+        return name
+
+    def get_option_history(self, name: str) -> list[dict[str, t.Any]] | None:
+        """Get the history of the values an option took, with where each
+        value came from. This is only recorded if the command was created
+        with ``track_changes=True``.
+
+        Each entry is a dict with the keys ``value``, ``source`` (a member
+        of :class:`~click.core.ParameterSource`) and ``timestamp`` (seconds
+        since the epoch). An entry that replaced an earlier value also has
+        the key ``previous_value``. Entries are ordered oldest first.
+
+        :param name: The name of the parameter, or one of the option's
+            flags such as ``--count`` or ``-c``.
+        :return: A list of entries, empty if the option has no history
+            or does not exist, or ``None`` if tracking is disabled.
+
+        .. versionadded:: 8.3
+        """
+        if not self._track_changes:
+            return None
+
+        history = self._option_history.get(self._resolve_option_name(name), [])
+        return [dict(entry) for entry in history]
+
 
