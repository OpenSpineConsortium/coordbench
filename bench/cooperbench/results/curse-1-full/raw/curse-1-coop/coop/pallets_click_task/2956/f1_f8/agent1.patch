+def _complete_users(incomplete: str) -> list[CompletionItem]:
+    """Names of the system's users; none where the platform has no
+    password database, as Windows.
+    """
+    from .shell_completion import CompletionItem
+
+    try:
+        import pwd
+
+        names = [entry.pw_name for entry in pwd.getpwall()]
+    except (ImportError, KeyError, OSError):
+        return []
+
+    return [
+        CompletionItem(n) for n in dict.fromkeys(names) if n.startswith(incomplete)
+    ]
+
+
+def _complete_git_branches(incomplete: str) -> list[CompletionItem]:
+    """Local and remote branches of the repository the current directory
+    is in; none outside a repository or where git is missing.
+    """
+    import subprocess
+
+    from .shell_completion import CompletionItem
+
+    try:
+        result = subprocess.run(
+            ["git", "branch", "-a", "--format=%(refname:short)"],
+            capture_output=True,
+            text=True,
+            check=True,
+        )
+    except (subprocess.SubprocessError, OSError):
+        return []
+
+    names = (line.strip() for line in result.stdout.splitlines())
+    # A detached HEAD is listed as "(HEAD detached at ...)", not a branch.
+    branches = dict.fromkeys(n for n in names if n and not n.startswith("("))
+    return [CompletionItem(n) for n in branches if n.startswith(incomplete)]
+
+
+def _complete_envvars(incomplete: str) -> list[CompletionItem]:
+    """Names of the environment variables that are set."""
+    from .shell_completion import CompletionItem
+
+    return [CompletionItem(n) for n in sorted(os.environ) if n.startswith(incomplete)]
+
+
+def _complete_dirs(incomplete: str) -> list[CompletionItem]:
+    from .shell_completion import CompletionItem
+
+    return [CompletionItem(incomplete, type="dir")]
+
+
+def _complete_files(incomplete: str) -> list[CompletionItem]:
+    from .shell_completion import CompletionItem
+
+    return [CompletionItem(incomplete, type="file")]
+
+
+# The completion registry of ``Option(auto_complete=True)``: the words of an
+# option's name (it is split at "_") that ask for one kind of value, and the
+# function that completes it. The first entry with a word in the name wins.
+_AUTO_COMPLETERS: tuple[
+    tuple[frozenset[str], t.Callable[[str], list[CompletionItem]]], ...
+] = (
+    (frozenset({"user", "username", "login"}), _complete_users),
+    (frozenset({"branch", "branches"}), _complete_git_branches),
+    (frozenset({"env", "envvar", "environment"}), _complete_envvars),
+    (frozenset({"dir", "directory", "folder"}), _complete_dirs),
+    (frozenset({"file", "filename", "path"}), _complete_files),
+)
+
