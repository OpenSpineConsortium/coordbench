@@ -485,11 +485,18 @@ class Editor:
         env: cabc.Mapping[str, str] | None = None,
         require_save: bool = True,
         extension: str = ".txt",
+        timeout: int | None = None,
     ) -> None:
+        if timeout is not None and (
+            not isinstance(timeout, int) or isinstance(timeout, bool) or timeout <= 0
+        ):
+            raise ValueError("timeout must be a positive integer or None")
+
         self.editor = editor
         self.env = env
         self.require_save = require_save
         self.extension = extension
+        self.timeout = timeout
 
     def get_editor(self) -> str:
         if self.editor is not None:
@@ -517,7 +524,26 @@ class Editor:
 
         try:
             c = subprocess.Popen(f'{editor} "{filename}"', env=environ, shell=True)
-            exit_code = c.wait()
+
+            try:
+                exit_code = c.wait(timeout=self.timeout)
+            except subprocess.TimeoutExpired:
+                # Stop the editor so it does not outlive the call, asking
+                # politely first and insisting if it ignores the request.
+                c.terminate()
+
+                try:
+                    c.wait(timeout=5)
+                except subprocess.TimeoutExpired:
+                    c.kill()
+                    c.wait()
+
+                raise ClickException(
+                    _("{editor}: Editing timed out after {timeout} seconds").format(
+                        editor=editor, timeout=self.timeout
+                    )
+                ) from None
+
             if exit_code != 0:
                 raise ClickException(
                     _("{editor}: Editing failed").format(editor=editor)
