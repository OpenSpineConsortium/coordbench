+def _refill(current: t.Any, saved: t.Any) -> bool:
+    """Make a dictionary, list or set hold what ``saved`` holds, keeping
+    its identity. Return ``False`` and change nothing when the two are not
+    the same plain container type, so that the caller replaces it.
+    """
+    if type(current) is not type(saved):
+        return False
+
+    if isinstance(current, (dict, set)):
+        current.clear()
+        current.update(saved)
+    elif isinstance(current, list):
+        current[:] = saved
+    else:
+        return False
+
+    return True
+
