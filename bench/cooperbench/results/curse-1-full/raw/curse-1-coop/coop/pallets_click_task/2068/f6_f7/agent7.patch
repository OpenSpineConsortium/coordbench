+# Process priority names accepted by :class:`Editor`, mapped to the Unix
+# nice value and to the Windows priority class flag used for each.
+_PRIORITY_NICE = {
+    "low": 19,
+    "below_normal": 10,
+    "normal": 0,
+    "above_normal": -5,
+    "high": -10,
+}
+_PRIORITY_WIN_FLAGS = {
+    "low": 0x00000040,  # IDLE_PRIORITY_CLASS
+    "below_normal": 0x00004000,  # BELOW_NORMAL_PRIORITY_CLASS
+    "normal": 0x00000020,  # NORMAL_PRIORITY_CLASS
+    "above_normal": 0x00008000,  # ABOVE_NORMAL_PRIORITY_CLASS
+    "high": 0x00000080,  # HIGH_PRIORITY_CLASS
+}
+
+
+def _make_set_nice(nice: int) -> cabc.Callable[[], None]:
+    """Build a function for ``preexec_fn`` that sets the niceness of the
+    child process. Any failure, such as lacking the privilege to raise
+    the priority, is ignored so the editor still starts.
+    """
+
+    def set_nice() -> None:
+        try:
+            if hasattr(os, "setpriority"):
+                os.setpriority(os.PRIO_PROCESS, 0, nice)
+            else:
+                os.nice(nice)
+        except Exception:
+            pass
+
+    return set_nice
+
