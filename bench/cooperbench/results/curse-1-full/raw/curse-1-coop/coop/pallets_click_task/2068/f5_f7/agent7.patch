+    def _build_command(self, editor: str, filename: str) -> str:
+        """Build the command line that is run through the shell to edit
+        ``filename`` with ``editor``.
+
+        Without :attr:`escape_shell` the filename is only wrapped in
+        double quotes, which still lets ``$``, backticks and ``"`` act
+        as shell syntax. With it, every word is quoted with
+        :func:`shlex.quote` so that special characters are literal.
+        """
+        if not self.escape_shell:
+            return f'{editor} "{filename}"'
+
+        import shlex
+
+        try:
+            words = shlex.split(editor)
+        except ValueError:
+            words = [editor]
+
+        # An editor such as ``code --wait`` is a program followed by
+        # plain arguments, so each word is quoted on its own. One that
+        # holds shell operators (``vim; rm -rf /``) is not a command line
+        # at all, so it is quoted whole, as one program name that cannot
+        # run anything else.
+        if any(c in word for word in words for c in ";&|<>()$`\n"):
+            words = [editor]
+
+        return " ".join(shlex.quote(word) for word in [*words, filename])
+
     def edit_file(self, filename: str) -> None:
         import subprocess
 
