+/// Extracts `repeat` grapheme clusters from the start (or, with `from_end`,
+/// the end) of `text`.
+fn extract_graphemes(text: &str, repeat: usize, from_end: bool) -> StrResult<Str> {
+    if repeat == 0 {
+        bail!("repeat must be at least 1");
+    }
+    if text.is_empty() {
+        return Err(string_is_empty());
+    }
+    let available = text.graphemes(true).count();
+    if repeat > available {
+        bail!(
+            "not enough characters (requested {repeat}, but string only has {available})"
+        );
+    }
+    Ok(if from_end {
+        let start = text
+            .grapheme_indices(true)
+            .rev()
+            .nth(repeat - 1)
+            .map_or(0, |(i, _)| i);
+        text[start..].into()
+    } else {
+        let end = text.grapheme_indices(true).nth(repeat).map_or(text.len(), |(i, _)| i);
+        text[..end].into()
+    })
+}
