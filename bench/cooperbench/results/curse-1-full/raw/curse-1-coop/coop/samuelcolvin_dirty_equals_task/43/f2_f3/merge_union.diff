+class IsMac(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid MAC address, optionally checking how it is formatted.
+    """
+
+    _hex_pairs = r'[0-9a-f]{2}'
+    _patterns = {
+        'colon': re.compile(rf'{_hex_pairs}(?::{_hex_pairs}){{5}}', re.IGNORECASE),
+        'hyphen': re.compile(rf'{_hex_pairs}(?:-{_hex_pairs}){{5}}', re.IGNORECASE),
+        'dot': re.compile(r'[0-9a-f]{4}(?:\.[0-9a-f]{4}){2}', re.IGNORECASE),
+        'compact': re.compile(r'[0-9a-f]{12}', re.IGNORECASE),
+    }
+
+    def __init__(self, format: Literal[None, 'colon', 'hyphen', 'dot', 'compact'] = None):
+        """
+        Args:
+            format: The format the MAC address must have, one of `'colon'` (`00:1B:44:11:3A:B7`),
+                `'hyphen'` (`00-1B-44-11-3A-B7`), `'dot'` (`001B.4411.3AB7`) or `'compact'` (`001B44113AB7`).
+                If omitted, all of these formats are accepted.
+
+        Hexadecimal digits are matched case-insensitively and only strings are accepted.
+
+        ```py title="IsMac"
+        from dirty_equals import IsMac
+
+        assert '00:1B:44:11:3A:B7' == IsMac
+        assert '00:1b:44:11:3a:b7' == IsMac
+        assert '00-1B-44-11-3A-B7' == IsMac
+        assert '001B.4411.3AB7' == IsMac
+        assert '001b44113ab7' == IsMac
+        assert '00:1B:44:11:3A:B7' == IsMac('colon')
+        assert '00-1B-44-11-3A-B7' != IsMac('colon')
+        assert '001b44113ab7' == IsMac('compact')
+        assert '00:1B:44:11:3A' != IsMac
+        assert '00:1B:44:11:3A:BG' != IsMac
+        assert 123 != IsMac
+        ```
+        """
+        if format is not None and format not in self._patterns:
+            raise ValueError(f'invalid MAC address format {format!r}, expected one of {", ".join(self._patterns)}')
+        self.format = format
+        super().__init__(format or plain_repr('*'))
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        if self.format is None:
+            patterns = self._patterns.values()
+        else:
+            patterns = [self._patterns[self.format]]
+        return any(pattern.fullmatch(other) for pattern in patterns)
+
+
