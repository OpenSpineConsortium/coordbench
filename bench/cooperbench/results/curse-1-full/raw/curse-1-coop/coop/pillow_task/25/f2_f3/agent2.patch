diff --git a/Tests/test_image.py b/Tests/test_image.py
index c2e850c36..c106fa488 100644
--- a/Tests/test_image.py
+++ b/Tests/test_image.py
@@ -258,6 +258,50 @@ class TestImage:
             assert im.readonly
             im.save(temp_file)
 
+    def test_save_preserve_readonly(self, tmp_path: Path) -> None:
+        data = bytearray([255])
+        im = Image.frombuffer("L", (1, 1), data, "raw", "L", 0, 1)
+        assert im.readonly
+
+        # By default, saving copies the image and ends the link to the buffer
+        im.save(tmp_path / "temp.bmp")
+        assert not im.readonly
+        data[0] = 64
+        assert im.getdata()[0] == 255
+
+    def test_save_preserve_readonly_true(self, tmp_path: Path) -> None:
+        data = bytearray([255])
+        im = Image.frombuffer("L", (1, 1), data, "raw", "L", 0, 1)
+        assert im.readonly
+
+        temp_file = tmp_path / "temp.bmp"
+        im.save(temp_file, preserve_readonly=True)
+        assert im.readonly
+
+        # The image still reflects changes to the buffer
+        data[0] = 64
+        assert im.getdata()[0] == 64
+
+        # and what was saved is the image as it was
+        with Image.open(temp_file) as reloaded:
+            assert reloaded.getdata()[0] == 255
+
+        # Saving the changed image writes the changed data
+        im.save(temp_file, preserve_readonly=True)
+        assert im.readonly
+        with Image.open(temp_file) as reloaded:
+            assert reloaded.getdata()[0] == 64
+
+    def test_save_preserve_readonly_not_readonly(self, tmp_path: Path) -> None:
+        im = Image.new("L", (1, 1), 255)
+        assert not im.readonly
+
+        temp_file = tmp_path / "temp.bmp"
+        im.save(temp_file, preserve_readonly=True)
+        assert not im.readonly
+        with Image.open(temp_file) as reloaded:
+            assert reloaded.getdata()[0] == 255
+
     def test_dump(self, tmp_path: Path) -> None:
         im = Image.new("L", (10, 10))
         im._dump(str(tmp_path / "temp_L.ppm"))
