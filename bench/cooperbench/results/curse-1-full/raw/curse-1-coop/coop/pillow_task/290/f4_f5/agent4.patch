+    def _colors_within_error(self, colors, method, kmeans, error_threshold):
+        """
+        The fewest colors, at most ``colors``, for which quantizing this image
+        gives a mean square error within ``error_threshold``; ``colors`` if
+        no number of them does.
+
+        Adding colors lowers the error, so a binary search finds the count
+        with a handful of quantizations instead of one for every count.
+        """
+        errors = {}
+
+        def within_threshold(count):
+            if count not in errors:
+                quantized = self._new(self.im.quantize(count, method, kmeans))
+                errors[count] = self._mean_square_error(quantized)
+            return errors[count] <= error_threshold
+
+        if not within_threshold(colors):
+            return colors
+
+        # libimagequant cannot make fewer than two colors
+        low = 2 if method == LIBIMAGEQUANT else 1
+        high = colors
+        while low < high:
+            middle = (low + high) // 2
+            if within_threshold(middle):
+                high = middle
+            else:
+                low = middle + 1
+        return high
+
+    def _mean_square_error(self, quantized):
+        """
+        The mean square error between this image and a quantized copy of it,
+        averaged over every pixel and every channel.
+        """
+        from . import ImageChops
+
+        mode = "RGBA" if self.mode == "RGBA" else "RGB"
+        difference = ImageChops.difference(self.convert(mode), quantized.convert(mode))
+
+        # The histogram holds 256 counts per band, one band after another
+        squared = sum(
+            (index % 256) ** 2 * count
+            for index, count in enumerate(difference.histogram())
+        )
+        return squared / (difference.width * difference.height * len(mode))
+
