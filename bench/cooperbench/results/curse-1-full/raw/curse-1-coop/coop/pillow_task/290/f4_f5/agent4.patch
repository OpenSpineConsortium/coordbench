+def mean_square_error(image, quantized):
+    channels = len(image.getbands())
+    pixels = image.width * image.height * channels
+    total = sum(
+        (a - b) ** 2
+        for a, b in zip(image.tobytes(), quantized.convert(image.mode).tobytes())
+    )
+    return total / pixels
+
+
+def test_quantize_error_threshold_default():
+    image = hopper()
+    assert (
+        image.quantize(50, error_threshold=None).tobytes()
+        == image.quantize(50).tobytes()
+    )
+
+
+def test_quantize_error_threshold_fewer_colors():
+    image = hopper()
+
+    converted = image.quantize(256, error_threshold=100)
+
+    assert_image(converted, "P", converted.size)
+    assert len(converted.getcolors()) < 256
+    assert mean_square_error(image, converted) <= 100
+
+
+def test_quantize_error_threshold_is_smallest_count():
+    image = hopper()
+
+    converted = image.quantize(256, error_threshold=100)
+    colors = len(converted.getcolors())
+
+    # With one color fewer, the threshold is no longer met
+    fewer = image.quantize(colors - 1)
+    assert mean_square_error(image, fewer) > 100
+
+
+def test_quantize_error_threshold_larger_threshold_fewer_colors():
+    image = hopper()
+
+    strict = image.quantize(256, error_threshold=30)
+    loose = image.quantize(256, error_threshold=500)
+
+    assert len(loose.getcolors()) < len(strict.getcolors())
+    assert mean_square_error(image, strict) <= 30
+    assert mean_square_error(image, loose) <= 500
+
+
+def test_quantize_error_threshold_not_met():
+    image = hopper()
+
+    # Even 16 colors are not enough for an error of 1, so all 16 are used
+    converted = image.quantize(16, error_threshold=1)
+
+    assert len(converted.getcolors()) == 16
+    assert converted.tobytes() == image.quantize(16).tobytes()
+
+
+def test_quantize_error_threshold_zero():
+    image = hopper()
+    converted = image.quantize(256, error_threshold=0)
+    assert len(converted.getcolors()) == 256
+
+    # Two flat colors are represented exactly by two colors
+    image = Image.new("RGB", (4, 4), (255, 0, 0))
+    image.paste((0, 0, 255), (0, 0, 4, 2))
+    converted = image.quantize(256, error_threshold=0)
+    assert len(converted.getcolors()) == 2
+    assert mean_square_error(image, converted) == 0
+
+
+@pytest.mark.parametrize(
+    "method", (Image.MEDIANCUT, Image.MAXCOVERAGE, Image.FASTOCTREE)
+)
+def test_quantize_error_threshold_methods(method):
+    image = hopper()
+
+    converted = image.quantize(256, method=method, error_threshold=200)
+
+    assert len(converted.getcolors()) < 256
+    assert mean_square_error(image, converted) <= 200
+
+
+@pytest.mark.parametrize("mode", ("L", "P", "RGBA"))
+def test_quantize_error_threshold_modes(mode):
+    image = hopper().convert(mode)
+
+    converted = image.quantize(64, error_threshold=100)
+
+    assert_image(converted, "P", converted.size)
+    assert len(converted.getcolors()) < 64
+
+
+def test_quantize_error_threshold_negative():
+    with pytest.raises(ValueError):
+        hopper().quantize(error_threshold=-1)
+
+
+def test_quantize_error_threshold_palette():
+    image = hopper()
+    palette = hopper("P")
+
+    converted = image.quantize(palette=palette, error_threshold=1)
+
+    assert converted.palette.palette == palette.palette.palette
+
