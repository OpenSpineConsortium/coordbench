diff --git a/Tests/test_image_quantize.py b/Tests/test_image_quantize.py
index bd9db362c..772ac05d6 100644
--- a/Tests/test_image_quantize.py
+++ b/Tests/test_image_quantize.py
@@ -85,3 +85,59 @@ def test_transparent_colors_equal():
     converted = im.quantize()
     converted_px = converted.load()
     assert converted_px[0, 0] == converted_px[0, 1]
+
+
+def test_max_colors_default_is_colors():
+    image = hopper()
+    expected = image.quantize(100)
+    converted = image.quantize(100, max_colors=None)
+    assert converted.tobytes() == expected.tobytes()
+    assert converted.getpalette() == expected.getpalette()
+
+
+def test_max_colors_limits_colors():
+    image = hopper()
+    converted = image.quantize(colors=100, max_colors=50)
+    assert_image(converted, "P", converted.size)
+    assert len(converted.getcolors()) <= 50
+
+    # The result is the same as asking for the lower number directly
+    expected = image.quantize(colors=50)
+    assert converted.tobytes() == expected.tobytes()
+
+
+def test_max_colors_above_colors():
+    # max_colors is a limit, not a target, so it cannot raise colors
+    image = hopper()
+    converted = image.quantize(colors=20, max_colors=200)
+    assert len(converted.getcolors()) <= 20
+    assert converted.tobytes() == image.quantize(colors=20).tobytes()
+
+
+def test_max_colors_methods():
+    image = hopper()
+    for method in (Image.MEDIANCUT, Image.MAXCOVERAGE, Image.FASTOCTREE):
+        converted = image.quantize(colors=64, method=method, max_colors=16)
+        assert_image(converted, "P", converted.size)
+        assert len(converted.getcolors()) <= 16
+
+
+def test_max_colors_rgba():
+    image = hopper("RGBA")
+    converted = image.quantize(colors=64, max_colors=8)
+    assert converted.convert("RGBA").mode == "RGBA"
+    assert len(converted.getcolors()) <= 8
+
+
+def test_max_colors_invalid():
+    image = hopper()
+    with pytest.raises(ValueError):
+        image.quantize(colors=16, max_colors=0)
+
+
+def test_max_colors_with_palette():
+    # An explicit palette takes precedence, as it does for colors
+    image = hopper()
+    converted = image.quantize(palette=hopper("P"), max_colors=2)
+    expected = image.quantize(palette=hopper("P"))
+    assert converted.tobytes() == expected.tobytes()
