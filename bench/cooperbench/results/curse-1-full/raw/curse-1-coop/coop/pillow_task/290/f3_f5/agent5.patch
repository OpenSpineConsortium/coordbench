+def test_quantize_lightness_factor_default():
+    image = hopper()
+    default = image.quantize(16)
+    unchanged = image.quantize(16, lightness_factor=1.0)
+
+    assert unchanged.getpalette() == default.getpalette()
+    assert unchanged.tobytes() == default.tobytes()
+
+
+@pytest.mark.parametrize("factor", (0.5, 0.9, 1.1, 1.5, 2.0))
+def test_quantize_lightness_factor(factor):
+    image = hopper()
+    original = image.quantize(16)
+    adjusted = image.quantize(16, lightness_factor=factor)
+
+    assert_image(adjusted, "P", adjusted.size)
+
+    # Only the palette changes, so the pixels still use the same indexes
+    assert adjusted.tobytes() == original.tobytes()
+    assert adjusted.getpalette() == [
+        min(255, int(value * factor)) for value in original.getpalette()
+    ]
+    assert adjusted.palette.palette == bytes(adjusted.getpalette())
+
+    # The converted image follows the palette
+    index = adjusted.getpixel((10, 10))
+    expected = tuple(adjusted.getpalette()[index * 3 : index * 3 + 3])
+    assert adjusted.convert("RGB").getpixel((10, 10)) == expected
+
+
+def test_quantize_lightness_factor_brighter_and_darker():
+    image = hopper()
+    original = image.quantize(16).getpalette()
+    brighter = image.quantize(16, lightness_factor=1.2).getpalette()
+    darker = image.quantize(16, lightness_factor=0.8).getpalette()
+
+    assert sum(brighter) > sum(original) > sum(darker)
+    assert all(b >= o >= d for b, o, d in zip(brighter, original, darker))
+
+
+def test_quantize_lightness_factor_clamps():
+    image = hopper()
+    original = image.quantize(16).getpalette()
+
+    # There is no upper bound, but channels never go above 255
+    bright = image.quantize(16, lightness_factor=1000).getpalette()
+    assert max(bright) == 255
+    assert bright == [255 if value else 0 for value in original]
+
+    # A tiny positive factor takes every channel down to 0
+    dark = image.quantize(16, lightness_factor=0.0001).getpalette()
+    assert set(dark) == {0}
+
+
+@pytest.mark.parametrize("factor", (0, 0.0, -1, -0.5, float("nan")))
+def test_quantize_lightness_factor_invalid(factor):
+    image = hopper()
+    with pytest.raises(ValueError):
+        image.quantize(lightness_factor=factor)
+
+    # The check does not depend on how the image is quantized
+    with pytest.raises(ValueError):
+        image.quantize(palette=hopper("P"), lightness_factor=factor)
+
+
+def test_quantize_lightness_factor_palette():
+    image = hopper()
+    with Image.open("Tests/images/caption_6_33_22.png") as palette:
+        palette = palette.convert("P")
+    original_palette = palette.getpalette()
+
+    original = image.quantize(palette=palette)
+    adjusted = image.quantize(palette=palette, lightness_factor=1.3)
+
+    assert adjusted.tobytes() == original.tobytes()
+    assert adjusted.getpalette() == [
+        min(255, int(value * 1.3)) for value in original.getpalette()
+    ]
+    assert len(adjusted.palette.palette) == len(original.palette.palette)
+
+    # The reference palette image is left alone
+    assert palette.getpalette() == original_palette
+
+
+def test_quantize_lightness_factor_rgba():
+    image = hopper("RGBA")
+    image.putalpha(Image.linear_gradient("L").resize(image.size))
+
+    original = image.quantize()
+    adjusted = image.quantize(lightness_factor=1.5)
+    assert adjusted.palette.mode == "RGBA"
+
+    original_colors = original.palette.palette
+    adjusted_colors = adjusted.palette.palette
+    assert adjusted.tobytes() == original.tobytes()
+    assert adjusted_colors[3::4] == original_colors[3::4]
+    for channel in range(3):
+        assert adjusted_colors[channel::4] == bytes(
+            min(255, int(value * 1.5)) for value in original_colors[channel::4]
+        )
+    assert adjusted.convert("RGBA").getpixel((10, 10))[3] == (
+        original.convert("RGBA").getpixel((10, 10))[3]
+    )
+
+
