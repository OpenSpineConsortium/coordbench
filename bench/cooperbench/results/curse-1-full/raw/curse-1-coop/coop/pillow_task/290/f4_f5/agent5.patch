+def test_quantize_lightness_factor_default():
+    image = hopper()
+    default = image.quantize()
+    explicit = image.quantize(lightness_factor=1.0)
+
+    assert explicit.getpalette() == default.getpalette()
+    assert explicit.tobytes() == default.tobytes()
+
+
+@pytest.mark.parametrize("factor", (0.25, 0.5, 0.9, 1.1, 1.5, 3))
+def test_quantize_lightness_factor_scales_palette(factor):
+    image = hopper()
+    original = image.quantize()
+    adjusted = image.quantize(lightness_factor=factor)
+
+    expected = [min(255, int(value * factor)) for value in original.getpalette()]
+    assert adjusted.getpalette() == expected
+    assert adjusted.palette.palette == bytes(expected)
+
+    # Only the palette changes: the pixels still point at the same entries
+    assert adjusted.tobytes() == original.tobytes()
+    assert len(adjusted.getcolors()) == len(original.getcolors())
+
+
+def test_quantize_lightness_factor_brighter_and_darker():
+    image = hopper()
+    original = sum(image.quantize().getpalette())
+
+    assert sum(image.quantize(lightness_factor=1.2).getpalette()) > original
+    assert sum(image.quantize(lightness_factor=0.8).getpalette()) < original
+
+    original_mean = sum(image.quantize().convert("L").getdata())
+    assert sum(image.quantize(lightness_factor=1.2).convert("L").getdata()) > (
+        original_mean
+    )
+    assert sum(image.quantize(lightness_factor=0.8).convert("L").getdata()) < (
+        original_mean
+    )
+
+
+@pytest.mark.parametrize("factor", (1000, 1e300, float("inf")))
+def test_quantize_lightness_factor_is_clamped(factor):
+    image = Image.new("RGB", (2, 1), (0, 100, 255))
+    image.putpixel((1, 0), (1, 2, 3))
+
+    converted = image.quantize(lightness_factor=factor)
+
+    # Anything above zero reaches 255, and zero is still zero
+    assert sorted(converted.convert("RGB").getdata()) == [
+        (0, 255, 255),
+        (255, 255, 255),
+    ]
+
+
+@pytest.mark.parametrize("factor", (0, 0.0, -1, -0.5, float("-inf"), float("nan")))
+def test_quantize_lightness_factor_must_be_positive(factor):
+    image = hopper()
+
+    with pytest.raises(ValueError):
+        image.quantize(lightness_factor=factor)
+    with pytest.raises(ValueError):
+        image.quantize(palette=hopper("P"), lightness_factor=factor)
+
+
+def test_quantize_lightness_factor_known_colors():
+    image = Image.new("RGB", (2, 1), (100, 150, 200))
+    image.putpixel((1, 0), (0, 40, 255))
+
+    converted = image.quantize(lightness_factor=1.2)
+
+    assert sorted(converted.convert("RGB").getdata()) == [
+        (0, 48, 255),
+        (120, 180, 240),
+    ]
+    darker = image.quantize(lightness_factor=0.5)
+    assert sorted(darker.convert("RGB").getdata()) == [(0, 20, 127), (50, 75, 100)]
+
+
+def test_quantize_lightness_factor_with_palette():
+    image = hopper()
+    with Image.open("Tests/images/caption_6_33_22.png") as palette:
+        palette = palette.convert("P")
+    reference = palette.getpalette()
+
+    original = image.quantize(palette=palette)
+    adjusted = image.quantize(palette=palette, lightness_factor=0.5)
+
+    expected = [int(value * 0.5) for value in original.getpalette()]
+    assert adjusted.getpalette() == expected
+    assert adjusted.tobytes() == original.tobytes()
+
+    # The palette image given is not changed
+    assert palette.getpalette() == reference
+
+
+def test_quantize_lightness_factor_rgba():
+    image = Image.new("RGBA", (2, 1), (100, 150, 200, 128))
+    image.putpixel((1, 0), (10, 20, 30, 0))
+
+    original = image.quantize()
+    adjusted = image.quantize(lightness_factor=1.5)
+
+    assert sorted(original.convert("RGBA").getdata()) == [
+        (10, 20, 30, 0),
+        (100, 150, 200, 128),
+    ]
+    # Colors change, alpha does not
+    assert sorted(adjusted.convert("RGBA").getdata()) == [
+        (15, 30, 45, 0),
+        (150, 225, 255, 128),
+    ]
