+def _adjust_palette_lightness(im, lightness_factor):
+    """
+    Multiplies the color channels of the palette of a "P" image by
+    ``lightness_factor``, limiting each result to 0-255. An alpha channel is
+    left as it is. The pixel data is not touched, so no colors are added.
+
+    :param im: A "P" image with a palette of mode "RGB" or "RGBA". Both its
+       core palette and its :py:class:`~PIL.ImagePalette.ImagePalette` are
+       replaced.
+    :param lightness_factor: A number greater than zero. 1.0 changes nothing.
+    """
+    if lightness_factor == 1.0:
+        return
+
+    from . import ImagePalette
+
+    mode = im.im.getpalettemode()
+    data = im.im.getpalette(mode, mode)
+    step = len(mode)
+
+    def scale(value):
+        # A channel of 0 stays 0, which also keeps 0 * infinity from being NaN
+        if value == 0:
+            return 0
+        return int(min(value * lightness_factor, 255))
+
+    table = bytes(scale(value) for value in range(256))
+    adjusted = bytearray(data)
+    for channel in range(min(step, 3)):
+        adjusted[channel::step] = data[channel::step].translate(table)
+    adjusted = bytes(adjusted)
+
+    if mode == "RGBA":
+        # the core takes the colors of a palette and its alpha values separately
+        im.im.putpalette("RGBX", adjusted)
+        im.im.putpalettealphas(adjusted[3::4])
+    else:
+        im.im.putpalette(mode, adjusted)
+    im.palette = ImagePalette.ImagePalette(mode, adjusted)
+
+
