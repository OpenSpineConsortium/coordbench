+    def _sort_quantized_palette(self, sort_palette):
+        """
+        Reorders the palette of a freshly quantized "P" image and remaps its
+        pixels to match, so that the image looks exactly as before.
+
+        :param sort_palette: ``"brightness"`` or ``"rgb"``, as for
+           :py:meth:`quantize`.
+        :returns: A new image.
+        """
+        from . import ImagePalette
+
+        mode = self.im.getpalettemode()
+        step = len(mode)
+        data = self.im.getpalette(mode, mode)
+        colors = [tuple(data[i : i + step]) for i in range(0, len(data), step)]
+
+        # Only the entries up to the highest index in use belong to the
+        # quantized colors; the ones after them are padding and stay in place.
+        used = min(self.getextrema()[1] + 1, len(colors))
+
+        if sort_palette == "brightness":
+
+            def key(index):
+                red, green, blue = colors[index][:3]
+                return 299 * red + 587 * green + 114 * blue
+
+        else:
+
+            def key(index):
+                return colors[index]
+
+        # sorted() is stable, so equal colors keep the order they had
+        order = sorted(range(used), key=key)
+        new_colors = [colors[old] for old in order] + colors[used:]
+
+        lut = list(range(256))
+        for new, old in enumerate(order):
+            lut[old] = new
+
+        im = self.point(lut)
+        # the core only takes colors without alpha, which is set separately
+        im.im.putpalette("RGB", bytes(v for color in new_colors for v in color[:3]))
+        if mode == "RGBA":
+            im.im.putpalettealphas(bytes(color[3] for color in new_colors))
+        im.palette = ImagePalette.ImagePalette(
+            mode, bytes(v for color in new_colors for v in color)
+        )
         return im
 
