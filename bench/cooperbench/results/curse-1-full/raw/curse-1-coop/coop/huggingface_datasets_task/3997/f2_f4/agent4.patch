+    def update(self, iterable=(), **kwds):
+        """Update the features, keeping what tells which columns need decoding in step with them.
+
+        Unlike :meth:`dict.update`, it also takes JSON and batches. ``iterable`` can be:
+
+        - a mapping of column names to features, or an iterable of ``(column name, feature)`` pairs, as for a dict;
+        - a JSON string (or bytes) holding an object of column names and features, written as
+          :meth:`Features.to_dict` writes them (``{"_type": "Value", "dtype": "int32", "id": null}``) or, for a
+          :class:`Value`, as its dtype alone (``"int32"``);
+        - a batch: an iterable of mappings, JSON strings and pairs, or a JSON list of objects, applied in order, so
+          that a later member wins over an earlier one for the same column.
+
+        Keyword arguments are applied last. Everything is read before anything is changed, so a member that
+        is not valid leaves the features as they were.
+
+        Example::
+
+            >>> features = Features({"a": Value("int32")})
+            >>> features.update('{"b": "string"}')
+            >>> features.update([{"c": Value("bool")}, '{"d": "float32"}'], e=Value("int8"))
+            >>> list(features)
+            ['a', 'b', 'c', 'd', 'e']
+        """
+        updates = list(Features._updates_from(iterable))
+        updates.extend(kwds.items())
+        for column_name, feature in updates:
