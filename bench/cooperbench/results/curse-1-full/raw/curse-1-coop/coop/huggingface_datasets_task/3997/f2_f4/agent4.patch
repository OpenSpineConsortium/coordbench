+    def _feature_from_json(value: Any) -> FeatureType:
+        """Turn one value read from a JSON document into a feature.
+
+        A string is a :class:`Value` dtype (``"int32"``), a dict with a ``_type`` key is a serialized feature, as
+        :meth:`Features.to_dict` writes it, any other dict is a nested field and a list is a list of such features.
+        """
+        if isinstance(value, str):
+            return Value(value)
