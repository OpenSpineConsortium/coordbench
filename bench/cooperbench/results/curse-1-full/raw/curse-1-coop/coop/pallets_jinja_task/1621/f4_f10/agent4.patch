+            t.Sequence[
+                t.Union[str, os.PathLike, t.Tuple[t.Union[str, os.PathLike], int]]
+            ],
+        ],
         encoding: str = "utf-8",
         followlinks: bool = False,
     ) -> None:
         if not isinstance(searchpath, abc.Iterable) or isinstance(searchpath, str):
             searchpath = [searchpath]
 
-        self.searchpath = [os.fspath(p) for p in searchpath]
+        # Pair each path with its priority; a plain path has priority 0.
+        # Only a two item tuple is read as (path, priority); anything else
+        # is handled as a plain path, as it was before priorities existed.
+        prioritized: t.List[t.Tuple[str, int]] = []
+
+        for item in searchpath:
+            if isinstance(item, tuple) and len(item) == 2:
+                path, priority = item
+            else:
+                path, priority = item, 0
+
+            prioritized.append((os.fspath(path), priority))
+
+        # The sort is stable, so equal priorities keep their given order.
+        prioritized.sort(key=lambda pair: pair[1], reverse=True)
