+class ConditionalI18nExtension(Extension):
+    """Adds a ``ctrans`` tag that translates only when a runtime condition
+    holds and renders fallback content otherwise.
+
+    .. code-block:: jinja
+
+        {% ctrans use_i18n, count=items|length trimmed %}
+            One item
+        {% pluralize %}
+            {{ count }} items
+        {% fallback %}
+            {{ count }} item(s)
+        {% endctrans %}
+
+    The header is the condition followed by the same variable
+    declarations the ``trans`` tag takes and an optional ``trimmed`` or
+    ``notrimmed``; commas between them are optional. When the condition
+    is true the section is rendered through ``gettext`` or ``ngettext``
+    of the environment, exactly as ``trans`` would. When it is false the
+    mandatory ``fallback`` section is rendered as it is, with the same
+    variable substitution and escaping but without any translation.
+    ``trimmed`` and ``notrimmed`` apply to every section, the fallback
+    included.
+    """
+
+    tags = {"ctrans"}
+
+    def parse(self, parser: "Parser") -> t.Union[nodes.Node, t.List[nodes.Node]]:
+        """Parse a conditional translatable tag."""
+        lineno = next(parser.stream).lineno
+        num_called_num = False
+
+        condition = parser.parse_expression()
+
+        # find all the variables referenced, as the trans tag does; a
+        # variable can also be defined by use in the body of a section.
+        plural_expr: t.Optional[nodes.Expr] = None
+        plural_expr_assignment: t.Optional[nodes.Assign] = None
+        variables: t.Dict[str, nodes.Expr] = {}
+        trimmed = None
+        while parser.stream.current.type != "block_end":
+            # commas are only separators, so they may stand anywhere
+            if parser.stream.skip_if("comma"):
+                continue
+
+            token = parser.stream.expect("name")
+            if token.value in variables:
+                parser.fail(
+                    f"translatable variable {token.value!r} defined twice.",
+                    token.lineno,
+                    exc=TemplateAssertionError,
+                )
+
+            # expressions
+            if parser.stream.current.type == "assign":
+                next(parser.stream)
+                variables[token.value] = var = parser.parse_expression()
+            elif trimmed is None and token.value in ("trimmed", "notrimmed"):
+                trimmed = token.value == "trimmed"
+                continue
+            else:
+                variables[token.value] = var = nodes.Name(token.value, "load")
+
+            if plural_expr is None:
+                if isinstance(var, nodes.Call):
+                    plural_expr = nodes.Name("_trans", "load")
+                    variables[token.value] = plural_expr
+                    plural_expr_assignment = nodes.Assign(
+                        nodes.Name("_trans", "store"), var
+                    )
+                else:
+                    plural_expr = var
+                num_called_num = token.value == "num"
+
+        parser.stream.expect("block_end")
+
+        plural = None
+        plural_names: t.List[str] = []
+        have_plural = False
+
+        # now parse until pluralize, fallback or endctrans
+        singular_names, singular = self._parse_block(parser, True)
+        if singular_names and plural_expr is None:
+            plural_expr = nodes.Name(singular_names[0], "load")
+            num_called_num = singular_names[0] == "num"
+
+        # if we have a pluralize block, we parse that too
+        if parser.stream.current.test("name:pluralize"):
+            have_plural = True
+            next(parser.stream)
+            if parser.stream.current.type != "block_end":
+                token = parser.stream.expect("name")
+                if token.value not in variables:
+                    parser.fail(
+                        f"unknown variable {token.value!r} for pluralization",
+                        token.lineno,
+                        exc=TemplateAssertionError,
+                    )
+                plural_expr = variables[token.value]
+                num_called_num = token.value == "num"
+            parser.stream.expect("block_end")
+            plural_names, plural = self._parse_block(parser, False)
+
+        # the fallback block is what makes the tag safe to switch off
+        if not parser.stream.current.test("name:fallback"):
+            parser.fail("expected 'fallback' block")
+        next(parser.stream)
+        parser.stream.expect("block_end")
+        fallback_names, fallback = self._parse_block(parser, True)
+        if parser.stream.current.test("name:pluralize"):
+            parser.fail("the pluralize section must come before the fallback section")
+        if parser.stream.current.test("name:fallback"):
+            parser.fail("a conditional translation can have only one fallback section")
+        next(parser.stream)
+
+        if not have_plural:
+            plural_expr = None
+        elif plural_expr is None:
+            parser.fail("pluralize without variables", lineno)
+
+        if trimmed is None:
+            trimmed = self.environment.policies.get("ext.i18n.trimmed", False)
+        if trimmed:
+            singular = self._trim_whitespace(singular)
+            if plural is not None:
+                plural = self._trim_whitespace(plural)
+            fallback = self._trim_whitespace(fallback)
+
+        node = self._make_conditional_node(
+            condition,
+            singular,
+            plural,
+            fallback,
+            variables,
+            plural_expr,
+            singular_names + plural_names,
+            fallback_names,
+            num_called_num and have_plural,
+        )
+        node.set_lineno(lineno)
+        if plural_expr_assignment is not None:
+            return [plural_expr_assignment, node]
+        else:
+            return node
+
+    def _trim_whitespace(self, string: str, _ws_re: t.Pattern[str] = _ws_re) -> str:
+        return _ws_re.sub(" ", string.strip())
+
+    def _parse_block(
+        self, parser: "Parser", allow_pluralize: bool
+    ) -> t.Tuple[t.List[str], str]:
+        """Parse until the next tag that ends a section of the block, which
+        is ``endctrans``, ``fallback`` or, if allowed, ``pluralize``. The
+        stream is left on the name of that tag.
+        """
+        referenced = []
+        buf = []
+
+        while True:
+            if parser.stream.current.type == "data":
+                buf.append(parser.stream.current.value.replace("%", "%%"))
+                next(parser.stream)
+            elif parser.stream.current.type == "variable_begin":
+                next(parser.stream)
+                name = parser.stream.expect("name").value
+                referenced.append(name)
+                buf.append(f"%({name})s")
+                parser.stream.expect("variable_end")
+            elif parser.stream.current.type == "block_begin":
+                next(parser.stream)
+                if parser.stream.current.test_any("name:endctrans", "name:fallback"):
+                    break
+                elif parser.stream.current.test("name:pluralize"):
+                    if allow_pluralize:
+                        break
+                    parser.fail(
+                        "a translatable section can have only one pluralize section"
+                    )
+                parser.fail(
+                    "control structures in translatable sections are not allowed"
+                )
+            elif parser.stream.eos:
+                parser.fail("unclosed conditional translation block")
+            else:
+                raise RuntimeError("internal parser error")
+
+        return referenced, concat(buf)
+
+    def _make_conditional_node(
+        self,
+        condition: nodes.Expr,
+        singular: str,
+        plural: t.Optional[str],
+        fallback: str,
+        variables: t.Dict[str, nodes.Expr],
+        plural_expr: t.Optional[nodes.Expr],
+        referenced: t.Sequence[str],
+        fallback_referenced: t.Sequence[str],
+        num_called_num: bool,
+    ) -> nodes.If:
+        """Generates an ``If`` node that translates when the condition is
+        true and renders the fallback otherwise.
+
+        ``variables`` holds the variables the header declared and
+        ``referenced`` and ``fallback_referenced`` the names the sections
+        use with ``{{ name }}``. Each branch gets the declared variables
+        and the free names of its own sections, so a ``%`` in one section
+        is escaped by whether that section is formatted and not by what
+        the other one uses.
+        """
+        newstyle = getattr(self.environment, "newstyle_gettext", False)
+        translation = self._make_translation(
+            singular,
+            plural,
+            self._with_free_names(variables, referenced),
+            plural_expr,
+            newstyle,
+            num_called_num,
+        )
+        fallback_node = self._make_fallback(
+            fallback, self._with_free_names(variables, fallback_referenced)
+        )
+        return nodes.If(
+            condition,
+            [nodes.Output([translation])],
+            [],
+            [nodes.Output([fallback_node])],
+        )
+
+    def _with_free_names(
+        self, variables: t.Dict[str, nodes.Expr], names: t.Sequence[str]
+    ) -> t.Dict[str, nodes.Expr]:
+        """Register free names as simple name expressions."""
+        merged = dict(variables)
+        for name in names:
+            if name not in merged:
+                merged[name] = nodes.Name(name, "load")
+        return merged
+
+    def _make_translation(
+        self,
+        singular: str,
+        plural: t.Optional[str],
+        variables: t.Dict[str, nodes.Expr],
+        plural_expr: t.Optional[nodes.Expr],
+        newstyle: bool,
+        num_called_num: bool,
+    ) -> nodes.Expr:
+        """The gettext or ngettext call, formatted as the trans tag does."""
+        node: nodes.Expr
+
+        # without variables nothing formats the string, so there is
+        # nothing to escape for old style gettext invocations.
+        if not variables and not newstyle:
+            singular = singular.replace("%%", "%")
+            if plural:
+                plural = plural.replace("%%", "%")
+
+        # singular only:
+        if plural_expr is None:
+            gettext = nodes.Name("gettext", "load")
+            node = nodes.Call(gettext, [nodes.Const(singular)], [], None, None)
+
+        # singular and plural
+        else:
+            ngettext = nodes.Name("ngettext", "load")
+            node = nodes.Call(
+                ngettext,
+                [nodes.Const(singular), nodes.Const(plural), plural_expr],
+                [],
+                None,
+                None,
+            )
+
+        # in case newstyle gettext is used, the method is powerful
+        # enough to handle the variable expansion and autoescape
+        # handling itself
+        if newstyle:
+            for key, value in variables.items():
+                # the function adds that later anyways in case num was
+                # called num, so just skip it.
+                if num_called_num and key == "num":
+                    continue
+                node.kwargs.append(nodes.Keyword(key, value))
+
+        # otherwise do that here
+        else:
+            # mark the return value as safe if we are in an
+            # environment with autoescaping turned on
+            node = nodes.MarkSafeIfAutoescape(node)
+            if variables:
+                node = self._format(node, variables)
+        return node
+
+    def _make_fallback(
+        self, fallback: str, variables: t.Dict[str, nodes.Expr]
+    ) -> nodes.Expr:
+        """The fallback text with its variables put in, which no gettext
+        function does here whatever the style of the environment is.
+        """
+        if not variables:
+            fallback = fallback.replace("%%", "%")
+        node: nodes.Expr = nodes.MarkSafeIfAutoescape(nodes.Const(fallback))
+        if variables:
+            node = self._format(node, variables)
+        return node
+
+    def _format(
+        self, node: nodes.Expr, variables: t.Dict[str, nodes.Expr]
+    ) -> nodes.Expr:
+        """``node % {...}``, which escapes the values for a safe string."""
+        return nodes.Mod(
+            node,
+            nodes.Dict(
+                [
+                    nodes.Pair(nodes.Const(key), value)
+                    for key, value in variables.items()
+                ]
+            ),
+        )
+
+
 #: nicer import names
 i18n = InternationalizationExtension
 do = ExprStmtExtension
 loopcontrols = LoopControlExtension
 debug = DebugExtension
+conditional_i18n = ConditionalI18nExtension
