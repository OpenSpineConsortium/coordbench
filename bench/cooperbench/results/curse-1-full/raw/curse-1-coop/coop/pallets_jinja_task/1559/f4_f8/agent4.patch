+    def _parse_metadata_value(self, parser: "Parser", token: "Token") -> str:
+        """Parse the ``="value"`` after a metadata parameter name. The value
+        must be a string literal, since it is read from the AST by
+        translation tools and never evaluated.
+        """
+        if parser.stream.current.type != "assign":
+            parser.fail(
+                f"metadata parameter {token.value!r} requires a value assignment.",
+                token.lineno,
+                exc=TemplateAssertionError,
+            )
+
+        next(parser.stream)
+        value = parser.parse_expression()
+
+        if not isinstance(value, nodes.Const) or not isinstance(value.value, str):
+            parser.fail(
+                f"metadata parameter {token.value!r} must be a string literal.",
+                token.lineno,
+                exc=TemplateAssertionError,
+            )
+
+        return value.value
+
     def _trim_whitespace(self, string: str, _ws_re: t.Pattern[str] = _ws_re) -> str:
