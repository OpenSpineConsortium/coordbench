+    def add_alias(self, alias: str, target: str) -> None:
+        """Make the template ``target`` available under the name ``alias``.
+
+        Aliases are resolved before a template is looked up, so the
+        loader sees only the target name. Several aliases can point to
+        one template, and adding an alias that exists already replaces
+        it. Aliases do not chain: if ``target`` is itself an alias, it
+        is looked up as a template name and not resolved again.
+
+        :param alias: The additional name for the template. Any string
+            is allowed.
+        :param target: The name of the template the alias stands for.
+            It does not have to exist when the alias is added.
+        """
+        self._alias_map()[alias] = target
+
+    def remove_alias(self, alias: str) -> None:
+        """Remove ``alias`` so that the name is looked up as an ordinary
+        template name again. An alias that does not exist is ignored.
+        """
+        self._alias_map().pop(alias, None)
+
+    def _alias_map(self) -> t.Dict[str, str]:
+        # Loaders do not call ``BaseLoader.__init__``, so the mapping is
+        # created the first time it is needed.
+        aliases: t.Optional[t.Dict[str, str]] = getattr(self, "_aliases", None)
+
+        if aliases is None:
+            aliases = self._aliases = {}
+
+        return aliases
+
+    def _resolve_alias(self, template: str) -> str:
+        """Return the template name ``template`` is an alias for, or
+        ``template`` itself if it is not an alias. The result is not
+        resolved again.
+        """
+        aliases: t.Optional[t.Dict[str, str]] = getattr(self, "_aliases", None)
+
+        if aliases:
+            return aliases.get(template, template)
+
+        return template
+
+    def _track_alias(self, name: str, template: "Template") -> "Template":
+        """Make ``template``, loaded as ``name``, out of date once an
+        alias changes what ``name`` stands for.
+
+        Without this an environment with ``auto_reload`` would go on
+        returning the cached template for an alias that was removed or
+        pointed at another template. The loader is held weakly so the
+        template does not keep it alive.
+        """
+        target = self._resolve_alias(name)
+        loader_ref = weakref.ref(self)
+        uptodate = template._uptodate
+
+        def is_current() -> bool:
+            loader = loader_ref()
+
+            if loader is not None and loader._resolve_alias(name) != target:
+                return False
+
+            return uptodate is None or uptodate()
+
+        template._uptodate = is_current
+        return template
+
