+    def _record(self, event: str) -> None:
+        """Count one cache event ("mem_hits", "disk_hits" or "misses") globally and in the active usage tracker.
+
+        The global counters and the per-call tracker are updated under the same lock, so concurrent `get()` calls
+        never lose a count.
+        """
+        with self._lock:
+            self._stats[event] += 1
+            if event != "misses":
+                self._stats["hits"] += 1
+
+            usage_tracker = settings.usage_tracker
+            if usage_tracker is not None and hasattr(usage_tracker, "add_cache_usage"):
+                usage_tracker.add_cache_usage(event)
+
+    def stats(self) -> Dict[str, int]:
+        """Return the cache statistics since creation or the last `reset_stats()` as a new dict.
+
+        The keys are `hits`, `mem_hits`, `disk_hits` and `misses`; `hits` is `mem_hits + disk_hits`.
+        """
+        with self._lock:
+            return {key: self._stats[key] for key in CACHE_USAGE_KEYS}
+
+    def reset_stats(self) -> None:
+        """Set every cache statistics counter back to zero."""
+        with self._lock:
+            self._stats = Counter(dict.fromkeys(CACHE_USAGE_KEYS, 0))
