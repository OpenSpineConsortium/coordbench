+    def add_cache_usage(self, event: str):
+        """Record one cache event: "mem_hits", "disk_hits" or "misses".
+
+        A memory or disk hit also counts as a hit, so `hits` stays the sum of the two.
+        """
+        if event not in CACHE_USAGE_KEYS or event == "hits":
+            raise ValueError(f"Unknown cache event: {event!r}")
+        self.cache_usage[event] += 1
+        if event != "misses":
+            self.cache_usage["hits"] += 1
+
+    def get_cache_usage(self) -> Dict[str, int]:
+        """Return a snapshot of the cache events recorded so far."""
+        return dict(self.cache_usage)
