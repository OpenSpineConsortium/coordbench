+    @property
+    def _aliases(self) -> t.Dict[str, str]:
+        # Created on first use instead of in ``__init__``, because
+        # subclasses written by users do not call ``super().__init__()``.
+        try:
+            return self.__dict__["_alias_map"]
+        except KeyError:
+            aliases: t.Dict[str, str] = {}
+            self.__dict__["_alias_map"] = aliases
+            return aliases
+
+    def add_alias(self, alias: str, target: str) -> None:
+        """Make the template ``target`` available under the name
+        ``alias`` as well. Adding an alias that already exists replaces
+        it.
+
+        Aliases are resolved once, before the template is looked up, so
+        they do not chain: if ``a`` is an alias of ``b`` and ``b`` is an
+        alias of ``c``, loading ``a`` looks up the template ``b``. If the
+        target does not exist, :exc:`TemplateNotFound` names the target,
+        not the alias.
+
+        :param alias: The additional name for the template. Any string
+            is allowed.
+        :param target: The name of the template to load for ``alias``.
+        """
+        self._aliases[alias] = target
+
+    def remove_alias(self, alias: str) -> None:
+        """Remove an alias added by :meth:`add_alias`. The name can no
+        longer be used to load the template, unless the loader has a
+        template of that name. Removing an alias that does not exist does
+        nothing.
+
+        :param alias: The alias to remove.
+        """
+        self._aliases.pop(alias, None)
+
+    def _resolve_alias(self, template: str) -> str:
+        """Return the name of the template to load for ``template``:
+        its target if it is an alias, else the name itself. The target
+        is not looked up again, so aliases never chain.
+        """
+        return self._aliases.get(template, template)
+
