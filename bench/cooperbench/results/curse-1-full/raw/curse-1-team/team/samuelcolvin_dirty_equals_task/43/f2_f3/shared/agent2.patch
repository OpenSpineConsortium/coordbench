+class IsEmail(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid email address, optionally checking the email's domain.
+    """
+
+    _email_regex = re.compile(r'[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}')
+
+    def __init__(self, domain: 'str | None' = None):
+        """
+        Args:
+            domain: The domain the email address must belong to, compared case-sensitively,
+                if omitted, any domain is accepted.
+
+        ```py title="IsEmail"
+        from dirty_equals import IsEmail
+
+        assert 'user@example.com' == IsEmail
+        assert 'user@example.com' == IsEmail()
+        assert 'user@example.com' == IsEmail(domain='example.com')
+        assert 'user@other.com' != IsEmail(domain='example.com')
+        assert 'user@Example.com' != IsEmail(domain='example.com')
+        assert 'not an email' != IsEmail
+        assert 123 != IsEmail
+        ```
+        """
+        self.domain = domain
+        super().__init__(domain if domain is not None else plain_repr('*'))
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str) or not self._email_regex.fullmatch(other):
+            return False
+
+        if self.domain is None:
+            return True
+        else:
+            return other.rpartition('@')[2] == self.domain
+
