+    def _build_command(self, editor: str, filename: str) -> str:
+        """Build the command line that is handed to the shell.
+
+        Without ``escape_shell`` the filename is only wrapped in double
+        quotes, which still lets ``$``, backticks and a closing quote
+        reach the shell. With it, the filename and every word of the
+        editor command are quoted with :func:`shlex.quote`, so shell
+        metacharacters are passed on as literal text.
+        """
+        if not self.escape_shell:
+            return f'{editor} "{filename}"'
+
+        import shlex
+
+        return f"{self._quote_editor(editor)} {shlex.quote(filename)}"
+
+    @staticmethod
+    def _quote_editor(editor: str) -> str:
+        """Quote each word of an editor command, so ``code --wait`` keeps
+        its argument while ``vim; rm -rf /`` cannot start a second command.
+        An editor that is, as a whole, the path of an executable (it may
+        contain spaces) is quoted as a single word.
+        """
+        import shlex
+        import shutil
+
+        if shutil.which(editor) is not None:
+            return shlex.quote(editor)
+
+        try:
+            words = shlex.split(editor)
+        except ValueError:
+            # Unbalanced quotes: there is no command line to split, so
+            # treat the whole value as one word.
+            return shlex.quote(editor)
+
+        return " ".join(shlex.quote(word) for word in words) or shlex.quote(editor)
+
 
