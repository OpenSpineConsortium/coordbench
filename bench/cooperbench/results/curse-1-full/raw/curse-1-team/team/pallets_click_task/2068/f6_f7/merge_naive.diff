+ # How much to change the niceness of an editor process on Unix for each
+ # accepted ``process_priority``. Positive values are lower priority.
+ _PRIORITY_NICE = {
+     "low": 10,
+     "below_normal": 5,
+     "normal": 0,
+     "above_normal": -5,
+     "high": -10,
+ }
+ 
+ # The matching Windows priority classes, used as process creation flags.
+ # subprocess only exports the names on Windows, so the values are spelled
+ # out here as well.
+ _PRIORITY_WINDOWS_CLASS = {
+     "low": ("IDLE_PRIORITY_CLASS", 0x00000040),
+     "below_normal": ("BELOW_NORMAL_PRIORITY_CLASS", 0x00004000),
+     "normal": ("NORMAL_PRIORITY_CLASS", 0x00000020),
+     "above_normal": ("ABOVE_NORMAL_PRIORITY_CLASS", 0x00008000),
+     "high": ("HIGH_PRIORITY_CLASS", 0x00000080),
+ }
+ 
+ 
+ def _normalize_priority(priority: object) -> str | None:
+     """Return the canonical name of a process priority, or ``None`` if
+     it is not one of the supported names.
+     """
+     if isinstance(priority, str):
+         name = priority.strip().lower()
+ 
+         if name in _PRIORITY_NICE:
+             return name
+ 
+     return None
+ 
+ 
+ def _priority_popen_kwargs(priority: str | None) -> dict[str, t.Any]:
+     """Extra :class:`subprocess.Popen` arguments that start a process with
+     the given priority. Empty if no priority is given or the platform has
+     no way to set one.
+     """
+     if priority is None:
+         return {}
+ 
+     if WIN:
+         import subprocess
+ 
+         name, default = _PRIORITY_WINDOWS_CLASS[priority]
+         return {"creationflags": getattr(subprocess, name, default)}
+ 
+     if not hasattr(os, "nice"):
+         return {}
+ 
+     increment = _PRIORITY_NICE[priority]
+ 
+     if increment == 0:
+         return {}
+ 
+     def set_priority() -> None:
+         # Runs in the child just before the editor starts. Lowering the
+         # priority is always allowed, raising it usually needs privileges.
+         # Either way the editor must still start, so errors are ignored.
+         try:
+             os.nice(increment)
+         except OSError:
+             pass
+ 
+     return {"preexec_fn": set_priority}
+ 
