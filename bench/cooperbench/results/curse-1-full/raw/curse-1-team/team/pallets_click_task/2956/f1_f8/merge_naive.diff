+    # The completion registry used by ``auto_complete``. Each entry maps
+    # the words an option name may be made of to the name of the method
+    # that completes it. The first entry that has a word in common with
+    # the option wins, so a more specific pattern goes first. The methods
+    # are looked up by name so a subclass can replace one of them.
+    _auto_complete_registry: t.ClassVar[tuple[tuple[frozenset[str], str], ...]] = (
+        (
+            frozenset({"user", "users", "username", "usernames", "login"}),
+            "_complete_usernames",
+        ),
+        (
+            frozenset({"branch", "branches", "branchname"}),
+            "_complete_git_branches",
+        ),
+        (
+            frozenset({"env", "envs", "envvar", "envvars", "environ", "environment"}),
+            "_complete_env_vars",
+        ),
+        (
+            frozenset({"dir", "dirs", "dirname", "dirpath", "directory", "folder"}),
+            "_complete_directories",
+        ),
+        (
+            frozenset({"file", "files", "filename", "filepath", "path", "paths"}),
+            "_complete_files",
+        ),
+    )
+
+    def shell_complete(self, ctx: Context, incomplete: str) -> list[CompletionItem]:
+        """Return a list of completions for the incomplete value. A
+        ``shell_complete`` function given during init always wins. Next,
+        if ``auto_complete`` is enabled, the completion that
+        :meth:`_smart_complete` picks is used. Otherwise, or if that has
+        nothing to offer, the :attr:`type`
+        :meth:`~click.types.ParamType.shell_complete` function is used.
+
+        :param ctx: Invocation context for this command.
+        :param incomplete: Value being completed. May be empty.
+        """
+        if self.auto_complete and self._custom_shell_complete is None:
+            results = self._smart_complete(ctx, incomplete)
+
+            if results:
+                return results
+
+        return super().shell_complete(ctx, incomplete)
+
+    def _smart_complete(self, ctx: Context, incomplete: str) -> list[CompletionItem]:
+        """Pick a completion strategy for this option from its type and
+        its name, and return the completions it gives for the incomplete
+        value.
+
+        A type that completes by itself, such as :class:`Choice` or
+        :class:`Path`, is more specific than any name, so it is used
+        as it is. Otherwise the words in the option's name are matched
+        against :attr:`_auto_complete_registry`. An option no pattern
+        knows falls back to the completion of its type.
+
+        :param ctx: Invocation context for this command.
+        :param incomplete: Value being completed. May be empty.
+        """
+        if isinstance(self.type, (types.Choice, types.Path, types.File)):
+            return self.type.shell_complete(ctx, self, incomplete)
+
+        words = self._auto_complete_words()
+
+        for patterns, method_name in self._auto_complete_registry:
+            if words & patterns:
+                complete: t.Callable[[str], list[CompletionItem]]
+                complete = getattr(self, method_name)
+                return complete(incomplete)
+
+        return self.type.shell_complete(ctx, self, incomplete)
+
+    def _auto_complete_words(self) -> set[str]:
+        """The lower case words the option's name and flags are made of,
+        so ``--git-branch`` and ``git_branch`` both give ``git`` and
+        ``branch``.
+        """
+        words: set[str] = set()
+
+        for name in [self.name or "", *self.opts]:
+            words.update(name.lower().replace("-", "_").split("_"))
+
+        words.discard("")
+        return words
+
+    def _complete_usernames(self, incomplete: str) -> list[CompletionItem]:
+        from .shell_completion import CompletionItem
+
+        # Imported here so that importing click stays light.
+        try:
+            import pwd
+        except ImportError:
+            # No user database on this platform, offer the current user.
+            names = [os.environ.get("USERNAME", "")]
+        else:
+            names = [entry.pw_name for entry in pwd.getpwall()]
+
+        matched = (n for n in dict.fromkeys(names) if n and n.startswith(incomplete))
+        return [CompletionItem(n) for n in matched]
+
+    def _complete_git_branches(self, incomplete: str) -> list[CompletionItem]:
+        import subprocess
+
+        from .shell_completion import CompletionItem
+
+        try:
+            result = subprocess.run(
+                ["git", "branch", "-a", "--format=%(refname:short)"],
+                capture_output=True,
+                text=True,
+                check=True,
+            )
+        except (OSError, subprocess.SubprocessError):
+            # Git is not installed, or this is not inside a repository.
+            return []
+
+        if isinstance(result.returncode, int) and result.returncode != 0:
+            return []
+
+        # A detached HEAD is listed as "(HEAD detached at ...)".
+        lines = (line.strip() for line in result.stdout.splitlines())
+        branches = dict.fromkeys(b for b in lines if b and not b.startswith("("))
+        return [CompletionItem(b) for b in branches if b.startswith(incomplete)]
+
+    def _complete_env_vars(self, incomplete: str) -> list[CompletionItem]:
+        from .shell_completion import CompletionItem
+
+        return [CompletionItem(n) for n in os.environ if n.startswith(incomplete)]
+
+    def _complete_files(self, incomplete: str) -> list[CompletionItem]:
+        from .shell_completion import CompletionItem
+
+        return [CompletionItem(incomplete, type="file")]
+
+    def _complete_directories(self, incomplete: str) -> list[CompletionItem]:
+        from .shell_completion import CompletionItem
+
+        return [CompletionItem(incomplete, type="dir")]
+
 
