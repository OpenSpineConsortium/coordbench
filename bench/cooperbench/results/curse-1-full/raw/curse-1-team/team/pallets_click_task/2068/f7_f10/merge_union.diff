+    def get_command(self, editor: str, filename: str) -> str:
+        """Build the shell command line that opens ``filename`` in
+        ``editor``.
+
+        With ``escape_shell``, every word of the editor command and the
+        filename are quoted with :func:`shlex.quote`, so shell
+        metacharacters such as ``;``, ``|`` or a backtick reach the
+        editor as literal text instead of being run by the shell.
+        """
+        if not self.escape_shell:
+            return f'{editor} "{filename}"'
+
+        import shlex
+
+        try:
+            words = shlex.split(editor)
+        except ValueError:
+            # Unbalanced quotes: treat the whole value as one word,
+            # which the shell then fails to find instead of running.
+            words = [editor]
+
+        words.append(filename)
+        return " ".join(shlex.quote(word) for word in words)
+
