index 7ef90dd..0e437d7 100644
--- a/src/click/utils.py
+++ b/src/click/utils.py
@@ -143,6 +143,15 @@ class LazyFile:
     def __getattr__(self, name: str) -> t.Any:
         return getattr(self.open(), name)
 
+    def __copy__(self) -> LazyFile:
+        # Without this, copy looks up __copy__ through __getattr__,
+        # which opens the file, and a file opened for writing is
+        # truncated. A file is a resource that is shared, not duplicated.
+        return self
+
+    def __deepcopy__(self, memo: dict[int, t.Any]) -> LazyFile:
+        return self
+
     def __repr__(self) -> str:
         if self._f is not None:
             return repr(self._f)
