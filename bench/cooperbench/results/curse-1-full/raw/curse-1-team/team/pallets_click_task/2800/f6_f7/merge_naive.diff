+    def save_state(self) -> dict[str, t.Any]:
+        """Take a snapshot of the state of this context, to put back
+        later with :meth:`restore_state`.
+
+        The snapshot is a dict with one key per attribute of the
+        context, named like the attribute: ``params``, ``args``,
+        ``_protected_args``, ``_opt_prefixes``, ``obj``, ``_meta``,
+        ``default_map``, ``_parameter_source`` and the settings such as
+        ``terminal_width`` or ``color``. ``params``, ``obj``, ``_meta``,
+        ``default_map`` and ``_parameter_source`` are deep copies, so a
+        change to something nested in them after this call does not
+        change the snapshot. The lists and sets are copies, and the
+        parent, the command and the callbacks are the same objects.
+
+        .. code-block:: python
+
+            snapshot = ctx.save_state()
+            ctx.obj["config"]["debug"] = True
+            ctx.restore_state(snapshot)
+
+        .. versionadded:: 8.2
+        """
+        return {
+            name: _copy_state_value(name, value) for name, value in vars(self).items()
+        }
+
+    def restore_state(self, snapshot: cabc.Mapping[str, t.Any]) -> None:
+        """Put back the state that :meth:`save_state` took. Every
+        attribute the snapshot names gets the value it had then, and a
+        snapshot kept by hand may leave attributes out.
+
+        The values are copied again, so the snapshot stays as it was
+        and can be restored more than once. ``meta`` is shared with
+        the contexts nested in this one, so its dict is emptied and
+        filled again, not replaced. What is open at the moment, the
+        resources registered with :meth:`with_resource` and
+        :meth:`call_on_close` and how deep the ``with`` blocks are,
+        is not part of what is restored, so those are still closed
+        when the context is.
+
+        :param snapshot: The dict that :meth:`save_state` returned.
+
+        .. versionadded:: 8.2
+        """
+        if not isinstance(snapshot, cabc.Mapping):
+            raise TypeError(
+                f"The snapshot must be a dict from save_state(), not {snapshot!r}."
+            )
+
+        for key, value in snapshot.items():
+            name = _STATE_ALIASES.get(key, key)
+
+            if name in _STATE_NOT_RESTORED:
+                continue
+
+            value = _copy_state_value(name, value)
+
+            if name == "_meta" and isinstance(value, dict):
+                self._meta.clear()
+                self._meta.update(value)
+            else:
+                setattr(self, name, value)
+
 
