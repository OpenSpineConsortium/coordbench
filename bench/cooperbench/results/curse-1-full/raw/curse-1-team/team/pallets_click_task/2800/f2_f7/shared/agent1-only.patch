@@ -603,10 +620,27 @@ class Context:
         return self._exit_stack.callback(f)
 
     def close(self) -> None:
-        """Invoke all close callbacks registered with
-        :meth:`call_on_close`, and exit all context managers entered
-        with :meth:`with_resource`.
+        """Invoke the ``on_exit`` callback if one was given, then all close
+        callbacks registered with :meth:`call_on_close`, and exit all
+        context managers entered with :meth:`with_resource`.
+
+        The ``on_exit`` callback receives this context. An exception it
+        raises is ignored, so that it can not stop the other callbacks
+        and resources from being cleaned up. It runs once each time the
+        context is used, even though :meth:`exit` and the end of a
+        ``with`` block both close it.
+
+        .. versionchanged:: 8.2
+            Invoke the ``on_exit`` callback.
         """
+        if self.on_exit is not None and self._on_exit_pending:
+            self._on_exit_pending = False
+
+            try:
+                self.on_exit(self)
+            except Exception:
+                pass
+
         self._exit_stack.close()
         # In case the context is reused, create a new exit stack.
         self._exit_stack = ExitStack()
