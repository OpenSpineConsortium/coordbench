+# How much to add to the editor's niceness on Unix-like systems for each
+# accepted ``process_priority``. Raising the priority (a negative value)
+# usually needs extra privileges, so it can fail and is then ignored.
+_NICE_INCREMENT = {
+    "low": 19,
+    "below_normal": 10,
+    "normal": 0,
+    "above_normal": -5,
+    "high": -10,
+}
+
+# The matching Windows priority class, by the name ``subprocess`` gives it.
+_WIN_PRIORITY_CLASS = {
+    "low": "IDLE_PRIORITY_CLASS",
+    "below_normal": "BELOW_NORMAL_PRIORITY_CLASS",
+    "normal": "NORMAL_PRIORITY_CLASS",
+    "above_normal": "ABOVE_NORMAL_PRIORITY_CLASS",
+    "high": "HIGH_PRIORITY_CLASS",
+}
+
