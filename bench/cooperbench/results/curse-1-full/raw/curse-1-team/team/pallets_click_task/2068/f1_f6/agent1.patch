+        """Extra :class:`subprocess.Popen` arguments that start the
+        editor at the requested ``process_priority``.
+
+        The result is empty when no priority is requested, when the
+        value is not one of the known names, or when the platform has no
+        way to set it. Setting a priority is only ever a request, so it
+        must never stop the editor from starting.
+        """
+        priority = self.process_priority
+
+        if not isinstance(priority, str) or priority not in _NICE_INCREMENT:
+            return {}
+
+        if WIN:
+            import subprocess
+
+            flag = getattr(subprocess, _WIN_PRIORITY_CLASS[priority], 0)
+            return {"creationflags": flag} if flag else {}
+
+        increment = _NICE_INCREMENT[priority]
+
+        if increment == 0 or not hasattr(os, "nice"):
+            return {}
+
+        def set_priority() -> None:
+            # Runs in the child process just before it executes the shell.
+            # Any error here would abort the launch, so swallow it.
+            try:
+                os.nice(increment)
+            except Exception:
+                pass
+
+        return {"preexec_fn": set_priority}
+
