+/// Checks that `first` and `last` are asked for at least one grapheme cluster.
+fn check_repeat(repeat: usize) -> StrResult<()> {
+    if repeat == 0 {
+        bail!("repeat must be at least 1");
+    }
+    Ok(())
+}
+
+/// The error message when a string has fewer grapheme clusters than
+/// `first` or `last` was asked for. An empty string keeps its own message
+/// when a single grapheme cluster was asked for.
+#[cold]
+fn not_enough_characters(text: &str, requested: usize) -> EcoString {
+    let available = text.graphemes(true).count();
+    if available == 0 && requested == 1 {
+        return string_is_empty();
+    }
+    eco_format!(
+        "not enough characters (requested {}, but string only has {})",
+        requested,
+        available
+    )
+}
