+/// A built-in character class that `str.first` and `str.last` can look for.
+#[derive(Debug, Copy, Clone, Eq, PartialEq)]
+enum CharClass {
+    Alpha,
+    Numeric,
+    Alphanumeric,
+    Uppercase,
+    Lowercase,
+    Whitespace,
+}
+
+impl CharClass {
+    /// Looks up a class by the name callers pass as `pattern`.
+    fn parse(name: &str) -> StrResult<Self> {
+        Ok(match name {
+            "alpha" => Self::Alpha,
+            "numeric" => Self::Numeric,
+            "alphanumeric" => Self::Alphanumeric,
+            "uppercase" => Self::Uppercase,
+            "lowercase" => Self::Lowercase,
+            "whitespace" => Self::Whitespace,
+            _ => return Err(unknown_char_class(name)),
+        })
+    }
+
+    /// Whether a single character belongs to the class.
+    fn matches(self, c: char) -> bool {
+        match self {
+            Self::Alpha => c.is_alphabetic(),
+            Self::Numeric => c.is_numeric(),
+            Self::Alphanumeric => c.is_alphanumeric(),
+            Self::Uppercase => c.is_uppercase(),
+            Self::Lowercase => c.is_lowercase(),
+            Self::Whitespace => c.is_whitespace(),
+        }
+    }
+
+    /// Whether the first character of a grapheme cluster belongs to the class.
+    fn matches_leading(self, grapheme: &str) -> bool {
+        grapheme.chars().next().is_some_and(|c| self.matches(c))
+    }
+}
+
+/// The error message when no grapheme cluster matches the requested class.
+#[cold]
+fn no_char_matches_pattern(name: &str) -> EcoString {
+    eco_format!("no character matches pattern \"{}\"", name)
+}
+
+/// The error message when the requested character class does not exist.
+#[cold]
+fn unknown_char_class(name: &str) -> EcoString {
+    eco_format!(
+        "unknown pattern \"{}\" (expected \"alpha\", \"numeric\", \"alphanumeric\", \"uppercase\", \"lowercase\" or \"whitespace\")",
+        name
+    )
+}
+
