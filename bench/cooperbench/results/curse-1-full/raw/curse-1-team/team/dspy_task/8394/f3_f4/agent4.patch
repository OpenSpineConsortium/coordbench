+    def stats(self) -> Dict[str, int]:
+        """Return the global cache statistics as a dict with the keys `hits`, `mem_hits`, `disk_hits` and `misses`.
+
+        `hits` is the total number of cache hits, i.e. `mem_hits + disk_hits`. The counters accumulate over every
