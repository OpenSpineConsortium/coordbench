+
+class CacheUsageTracker:
+    """Tracks the cache hits and misses that happen within a context."""
+
+    # The keys of the dict returned by `get_cache_usage`, the same as `dspy.cache.stats()`.
+    KEYS = ("hits", "mem_hits", "disk_hits", "misses")
+
+    def __init__(self):
+        # Several threads can serve one call (e.g. through `dspy.Parallel`), so updates are guarded by a lock.
+        self._lock = threading.Lock()
+        self.cache_usage = Counter()
+
+    def add_cache_event(self, *counters: str):
+        """Count one cache event, given the names of the counters it bumps (e.g. `"hits"` and `"mem_hits"`)."""
+        with self._lock:
+            self.cache_usage.update(counters)
+
+    def get_cache_usage(self) -> Dict[str, int]:
+        """Return a snapshot of the cache usage: `hits`, `mem_hits`, `disk_hits` and `misses`."""
+        with self._lock:
+            return {key: self.cache_usage[key] for key in self.KEYS}
+
+
+@contextmanager
+def track_cache_usage():
+    """Context manager for tracking the cache hits and misses of the calls made within it."""
+    tracker = CacheUsageTracker()
+
+    with settings.context(cache_usage_tracker=tracker):
+        yield tracker
