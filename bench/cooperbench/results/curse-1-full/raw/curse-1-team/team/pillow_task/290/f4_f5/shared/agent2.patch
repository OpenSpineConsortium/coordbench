+def test_quantize_lightness_factor_default():
+    image = hopper()
+    default = image.quantize(16)
+
+    assert image.quantize(16, lightness_factor=1.0).getpalette() == default.getpalette()
+    assert image.quantize(16, lightness_factor=1).tobytes() == default.tobytes()
+
+
+def test_quantize_lightness_factor():
+    image = hopper()
+    default = image.quantize(16)
+
+    for factor in (0.5, 0.9, 1.1, 1.5, 3):
+        converted = image.quantize(16, lightness_factor=factor)
+        assert_image(converted, "P", converted.size)
+
+        # Only the palette changes: the pixels still index the same entries
+        assert converted.tobytes() == default.tobytes()
+        assert converted.palette.mode == "RGB"
+        assert list(converted.palette.palette) == converted.getpalette()
+        assert converted.getpalette() == [
+            min(255, int(value * factor)) for value in default.getpalette()
+        ]
+        assert len(converted.getcolors()) == len(default.getcolors())
+
+    brighter = image.quantize(16, lightness_factor=1.1).convert("RGB")
+    darker = image.quantize(16, lightness_factor=0.9).convert("RGB")
+    assert sum(brighter.getdata(0)) > sum(default.convert("RGB").getdata(0))
+    assert sum(darker.getdata(0)) < sum(default.convert("RGB").getdata(0))
+
+
+def test_quantize_lightness_factor_clamps():
+    image = Image.new("RGB", (2, 1), (100, 200, 0))
+    image.putpixel((1, 0), (250, 3, 255))
+
+    converted = image.quantize(2, lightness_factor=2).convert("RGB")
+    assert list(converted.getdata()) == [(200, 255, 0), (255, 6, 255)]
+
+    # There is no upper limit
+    for factor in (1000, 1e308, float("inf")):
+        converted = image.quantize(2, lightness_factor=factor).convert("RGB")
+        assert list(converted.getdata()) == [(255, 255, 0), (255, 255, 255)]
+
+    converted = image.quantize(2, lightness_factor=0.001).convert("RGB")
+    assert list(converted.getdata()) == [(0, 0, 0), (0, 0, 0)]
+
+
+@pytest.mark.parametrize("factor", (0, -1, -0.5, float("nan")))
+def test_quantize_lightness_factor_not_positive(factor):
+    image = hopper()
+    with pytest.raises(ValueError):
+        image.quantize(lightness_factor=factor)
+    with pytest.raises(ValueError):
+        image.quantize(palette=hopper("P"), lightness_factor=factor)
+
+
+@pytest.mark.parametrize("method", (Image.FASTOCTREE, Image.MEDIANCUT))
+def test_quantize_lightness_factor_methods(method):
+    image = hopper()
+    default = image.quantize(16, method)
+    converted = image.quantize(16, method, lightness_factor=1.2)
+
+    assert converted.tobytes() == default.tobytes()
+    assert converted.getpalette() == [
+        min(255, int(value * 1.2)) for value in default.getpalette()
+    ]
+
+
+def test_quantize_lightness_factor_rgba():
+    image = Image.new("RGBA", (2, 1), (100, 50, 200, 0))
+    image.putpixel((1, 0), (10, 20, 30, 128))
+
+    converted = image.quantize(lightness_factor=2)
+    assert converted.palette.mode == "RGBA"
+    # Alpha is left as it is
+    assert list(converted.convert("RGBA").getdata()) == [
+        (200, 100, 255, 0),
+        (20, 40, 60, 128),
+    ]
+
+
+def test_quantize_lightness_factor_palette():
+    image = hopper()
+    palette = hopper("P")
+
+    default = image.quantize(palette=palette)
+    converted = image.quantize(palette=palette, lightness_factor=1.5)
+    assert_image(converted, "P", converted.size)
+    assert converted.tobytes() == default.tobytes()
+    assert converted.getpalette() == [
+        min(255, int(value * 1.5)) for value in default.getpalette()
+    ]
+
+    # The reference image is left alone
+    assert palette.getpalette() == hopper("P").getpalette()
+
+    with Image.open("Tests/images/caption_6_33_22.png") as reference:
+        reference = reference.convert("P")
+    default = image.quantize(palette=reference)
+    converted = image.quantize(palette=reference, lightness_factor=0.8)
+    assert converted.getpalette() == [
+        int(value * 0.8) for value in default.getpalette()
+    ]
+
