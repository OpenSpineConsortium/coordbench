+def _scale_palette_lightness(im, factor):
+    """
+    Multiply the color channels of a "P" image's palette by ``factor``, in place.
+
+    The scaled values are cut off at 255, and the alpha channel of an RGBA
+    palette is left as it is. Only the palette changes, never the pixels,
+    so no color is added.
+
+    :param im: A "P" image with a palette.
+    :param factor: A number greater than zero.
+    """
+    from . import ImagePalette
+
+    def scale(value):
+        # 0 stays 0 even for an infinite factor, where 0 * inf is not a number
+        if value == 0:
+            return 0
+        scaled = value * factor
+        return 255 if scaled >= 255 else int(scaled)
+
+    table = bytes(scale(value) for value in range(256))
+
+    mode = im.im.getpalettemode()
+    data = bytearray(im.im.getpalette(mode, mode))
+    step = len(mode)
+
+    # The color bands come first, and an alpha band, if there is one, last
+    colors = bytearray(len(data) // step * 3)
+    for band in range(3):
+        data[band::step] = data[band::step].translate(table)
+        colors[band::3] = data[band::step]
+
+    # The core takes a palette without alpha, and its alpha values apart
+    im.im.putpalette("RGB", bytes(colors))
+    if mode == "RGBA":
+        im.im.putpalettealphas(bytes(data[3::4]))
+    im.palette = ImagePalette.ImagePalette(mode, bytes(data))
+
+
