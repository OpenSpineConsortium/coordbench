+    def _scale_palette(self, factor):
+        """
+        Multiplies the red, green and blue values of this "P" image's palette by
+        ``factor``, limiting each result to 0-255. Alpha is left as it is.
+
+        Only the palette changes, never the pixel data, so no color is added.
+        Values are cut down to whole numbers, as the palette holds bytes.
+
+        :param factor: The multiplier, greater than 0.
+        """
+        from . import ImagePalette
+
+        def scale(value):
+            if value == 0:
+                return 0  # also keeps 0 times an infinite factor from being nan
+            scaled = value * factor
+            # Compare before converting: a huge factor gives inf, which int()
+            # refuses.
+            return 255 if scaled >= 255 else int(scaled)
+
+        table = [scale(value) for value in range(256)]
+
+        # The colors that are drawn are the core image's palette: the one in
+        # self.palette can be a stand-in, as convert("P") leaves.
+        mode = self.im.getpalettemode()
+        channels = len(mode)
+        data = bytearray(self.im.getpalette(mode, mode))
+        for i in range(len(data)):
+            if i % channels < 3:
+                data[i] = table[data[i]]
+
+        # Put the palette back as load() does: "RGB" values, with the alpha of
+        # an "RGBA" palette set separately.
+        rgb = bytes(value for i, value in enumerate(data) if i % channels < 3)
+        self.im.putpalette("RGB", rgb)
+        if mode == "RGBA":
+            self.im.putpalettealphas(bytes(data[3::4]))
+        self.palette = ImagePalette.ImagePalette(mode, bytes(data))
