+def mean_square_error(image, converted):
+    mode = "RGBA" if image.mode == "RGBA" else "RGB"
+    expected = image.convert(mode).tobytes()
+    actual = converted.convert(mode).tobytes()
+    return sum((a - b) ** 2 for a, b in zip(expected, actual)) / len(expected)
+
+
+@pytest.mark.parametrize(
+    "method", (Image.MEDIANCUT, Image.MAXCOVERAGE, Image.FASTOCTREE)
+)
+def test_quantize_error_threshold(method):
+    image = hopper()
+    threshold = 500
+
+    converted = image.quantize(256, method, error_threshold=threshold)
+
+    assert_image(converted, "P", converted.size)
+    assert len(converted.getcolors()) < 256
+    assert mean_square_error(image, converted) <= threshold
+
+    # The fewest colors are used: one color fewer misses the threshold.
+    fewer = image.quantize(len(converted.getcolors()) - 1, method)
+    assert mean_square_error(image, fewer) > threshold
+
+
