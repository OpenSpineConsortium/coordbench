+    def test_save_mark_corners(self, tmp_path: Path) -> None:
+        im = Image.new("RGB", (10, 8), "white")
+        out = tmp_path / "temp.png"
+
+        im.save(out, mark_corners=True)
+
+        with Image.open(out) as reloaded:
+            assert reloaded.getpixel((0, 0)) == (255, 0, 0)
+            assert reloaded.getpixel((9, 7)) == (255, 0, 0)
+            # Nothing else changes
+            assert reloaded.getpixel((9, 0)) == (255, 255, 255)
+            assert reloaded.getpixel((0, 7)) == (255, 255, 255)
+            assert reloaded.getpixel((5, 4)) == (255, 255, 255)
+        assert im.getpixel((0, 0)) == (255, 0, 0)
+
+    def test_save_mark_corners_off_by_default(self, tmp_path: Path) -> None:
+        im = Image.new("RGB", (10, 8), "white")
+        out = tmp_path / "temp.png"
+
+        im.save(out)
+        im.save(out, mark_corners=False)
+
+        assert_image_equal_tofile(im, out)
+        assert im.getpixel((0, 0)) == (255, 255, 255)
+
+    @pytest.mark.parametrize(
+        ("format", "options"),
+        (
+            ("BMP", {}),
+            ("GIF", {}),
+            ("JPEG", {"quality": 100, "subsampling": 0}),
+            ("PNG", {}),
+            ("TIFF", {}),
+            ("WEBP", {"lossless": True}),
+        ),
+    )
+    def test_save_mark_corners_formats(
+        self, format: str, options: dict[str, Any]
+    ) -> None:
+        if format == "WEBP" and not features.check("webp"):
+            pytest.skip("WebP support not available")
+
+        im = Image.new("RGB", (16, 16), "white")
+        b = io.BytesIO()
+
+        im.save(b, format, mark_corners=True, **options)
+
+        b.seek(0)
+        with Image.open(b) as reloaded:
+            rgb = reloaded.convert("RGB")
+            # JPEG does not keep the exact value
+            for xy in ((0, 0), (15, 15)):
+                r, g, blue = rgb.getpixel(xy)
+                assert r > 200
+                assert g < 50
+                assert blue < 50
+            assert rgb.getpixel((8, 8)) == (255, 255, 255)
+
+    @pytest.mark.parametrize(
+        ("mode", "format", "expected"),
+        (
+            ("1", "PNG", 0),
+            ("L", "PNG", 76),
+            ("LA", "PNG", (76, 255)),
+            ("I", "TIFF", 76),
+            ("F", "TIFF", 76.24500274658203),
+            ("RGBA", "PNG", (255, 0, 0, 255)),
+            ("CMYK", "TIFF", (0, 255, 255, 0)),
+        ),
+    )
+    def test_save_mark_corners_modes(
+        self, mode: str, format: str, expected: float | tuple[int, ...]
+    ) -> None:
+        # Red has no exact value in these modes, so the closest is used
+        im = Image.new(mode, (4, 4), 255 if mode == "1" else None)
+
+        im.save(io.BytesIO(), format, mark_corners=True)
+
+        assert im.getpixel((0, 0)) == expected
+        assert im.getpixel((3, 3)) == expected
+        assert im.getpixel((3, 0)) != expected or mode == "1"
+
+    def test_save_mark_corners_palette(self) -> None:
+        im = Image.new("P", (4, 4))
+        im.putpalette((255, 255, 255, 0, 0, 255))
+
+        b = io.BytesIO()
+        im.save(b, "PNG", mark_corners=True)
+
+        b.seek(0)
+        with Image.open(b) as reloaded:
+            rgb = reloaded.convert("RGB")
+            assert rgb.getpixel((0, 0)) == (255, 0, 0)
+            assert rgb.getpixel((3, 3)) == (255, 0, 0)
+            assert rgb.getpixel((1, 1)) == (255, 255, 255)
+
+    def test_save_mark_corners_full_palette(self) -> None:
+        # Every one of the 256 colours is in use, so there is no room for red
+        # and the closest colour, a dark grey, is used
+        im = Image.new("P", (16, 16))
+        im.putpalette([value for i in range(256) for value in (i, i, i)])
+        im.putdata(range(256))
+
+        im.save(io.BytesIO(), "PNG", mark_corners=True)
+
+        assert im.getpixel((0, 0)) == 85
+        assert im.getpixel((15, 15)) == 85
+        assert im.getpixel((1, 0)) == 1
+
+    def test_save_mark_corners_single_pixel(self) -> None:
+        im = Image.new("RGB", (1, 1), "white")
+
+        im.save(io.BytesIO(), "PNG", mark_corners=True)
+
+        assert im.getpixel((0, 0)) == (255, 0, 0)
+
+    def test_save_mark_corners_empty_image(self) -> None:
+        im = Image.new("RGB", (0, 0))
+
+        with pytest.raises(ValueError):
+            im.save(io.BytesIO(), "JPEG", mark_corners=True)
+
