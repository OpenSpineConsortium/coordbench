@@ -85,3 +85,97 @@ def test_transparent_colors_equal():
     converted = im.quantize()
     converted_px = converted.load()
     assert converted_px[0, 0] == converted_px[0, 1]
+
+
+def _palette_colors(im, count):
+    palette = im.getpalette()
+    return [tuple(palette[i * 3 : i * 3 + 3]) for i in range(count)]
+
+
+def _brightness(color):
+    return 0.299 * color[0] + 0.587 * color[1] + 0.114 * color[2]
+
+
+def test_sort_palette_default_keeps_order():
+    image = hopper()
+    default = image.quantize(16)
+    assert default.tobytes() == image.quantize(16, sort_palette=None).tobytes()
+    assert default.getpalette() == image.quantize(16, sort_palette=None).getpalette()
+
+
+@pytest.mark.parametrize(
+    "method", (Image.MEDIANCUT, Image.MAXCOVERAGE, Image.FASTOCTREE)
+)
+def test_sort_palette_brightness(method):
+    image = hopper()
+    unsorted = image.quantize(16, method)
+    converted = image.quantize(16, method, sort_palette="brightness")
+    assert_image(converted, "P", converted.size)
+
+    colors = _palette_colors(converted, 16)
+    brightness = [_brightness(color) for color in colors]
+    assert brightness == sorted(brightness)
+
+    # The same colors in a new order, and the image looks the same
+    assert sorted(colors) == sorted(_palette_colors(unsorted, 16))
+    assert converted.convert("RGB").tobytes() == unsorted.convert("RGB").tobytes()
+
+
+def test_sort_palette_rgb():
+    image = hopper()
+    unsorted = image.quantize(16)
+    converted = image.quantize(16, sort_palette="rgb")
+
+    colors = _palette_colors(converted, 16)
+    assert colors == sorted(colors)
+    assert converted.convert("RGB").tobytes() == unsorted.convert("RGB").tobytes()
+
+
+def test_sort_palette_rgba():
+    image = hopper("RGBA")
+    image.putalpha(Image.linear_gradient("L").resize(image.size))
+    unsorted = image.quantize(16)
+    converted = image.quantize(16, sort_palette="brightness")
+
+    assert converted.palette.mode == "RGBA"
+    palette = converted.im.getpalette("RGBA", "RGBA")
+    colors = [tuple(palette[i * 4 : i * 4 + 4]) for i in range(16)]
+    brightness = [_brightness(color) for color in colors]
+    assert brightness == sorted(brightness)
+    assert converted.convert("RGBA").tobytes() == unsorted.convert("RGBA").tobytes()
+
+
+def test_sort_palette_few_colors():
+    # Unused entries at the end of the palette are not sorted in among the colors
+    image = Image.new("RGB", (2, 1), (200, 200, 200))
+    image.putpixel((1, 0), (10, 20, 30))
+
+    converted = image.quantize(256, sort_palette="brightness")
+
+    assert converted.getpalette()[:6] == [10, 20, 30, 200, 200, 200]
+    assert list(converted.getdata()) == [1, 0]
+    assert converted.convert("RGB").tobytes() == image.tobytes()
+
+
+def test_sort_palette_with_palette():
+    image = hopper()
+    with Image.open("Tests/images/caption_6_33_22.png") as palette:
+        palette = palette.convert("P")
+
+    unsorted = image.quantize(dither=0, palette=palette)
+    converted = image.quantize(dither=0, palette=palette, sort_palette="brightness")
+
+    assert_image(converted, "P", converted.size)
+    assert converted.convert("RGB").tobytes() == unsorted.convert("RGB").tobytes()
+    used = max(converted.getdata()) + 1
+    colors = _palette_colors(converted, used)
+    brightness = [_brightness(color) for color in colors]
+    assert brightness == sorted(brightness)
+
+
+def test_sort_palette_invalid():
+    image = hopper()
+    with pytest.raises(ValueError):
+        image.quantize(16, sort_palette="hue")
+    with pytest.raises(ValueError):
+        image.quantize(16, sort_palette=True)
