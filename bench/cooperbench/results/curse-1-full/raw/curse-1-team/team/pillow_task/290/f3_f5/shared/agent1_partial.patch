+    def _sorted_palette(self, sort_palette):
+        """
+        Reorders the palette entries of this "P" image by the named key of
+        ``_PALETTE_SORT_KEYS`` and remaps the pixels to match, so that every
+        pixel keeps its color.
+
+        Only the entries up to the highest index in use are sorted. The
+        quantizers pad the palette to 256 entries with black, and sorting
+        those with the real colors would put them among them.
+
+        :returns: A new image
+        """
+        from . import ImagePalette
+
+        mode = self.im.getpalettemode()
+        size = len(mode)
+        data = self.im.getpalette(mode, mode)
+
+        histogram = self.histogram()
+        used = max((i for i, count in enumerate(histogram) if count), default=-1) + 1
+        entries = [tuple(data[i * size : (i + 1) * size]) for i in range(used)]
+
+        key = _PALETTE_SORT_KEYS[sort_palette]
+        order = sorted(range(used), key=lambda i: key(entries[i]))
+
+        # order[new] is the old index of the entry that moves to position new
+        lut = list(range(256))
+        new_data = bytearray(data)
+        for new, old in enumerate(order):
+            lut[old] = new
+            new_data[new * size : (new + 1) * size] = bytes(entries[old])
+
+        im = self.point(lut)
+        if mode == "RGBA":
+            # the core takes the colors and the alpha values separately
+            rgb = bytes(value for i, value in enumerate(new_data) if i % 4 != 3)
+            im.im.putpalette("RGB", rgb)
+            im.im.putpalettealphas(bytes(new_data[3::4]))
+        else:
+            im.im.putpalette(mode, bytes(new_data))
+        im.palette = ImagePalette.ImagePalette(mode, bytes(new_data))
         return im
 
     def copy(self):
