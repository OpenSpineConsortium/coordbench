+class ConditionalI18nExtension(Extension):
+    """Adds a ``{% ctrans %}`` tag that renders a translation only when a
+    runtime condition holds, and a fixed fallback text otherwise.
+
+    .. code-block:: html+jinja
+
+        {% ctrans use_i18n, count=items|length %}
+            {{ count }} item
+        {% pluralize %}
+            {{ count }} items
+        {% fallback %}
+            Items: {{ count }}
+        {% endctrans %}
+
+    The condition is a normal expression.  When it is true the block
+    is translated with ``gettext`` or, with a ``pluralize`` section,
+    ``ngettext`` exactly like ``{% trans %}``; when it is false the
+    ``fallback`` section is rendered as it is written, with only the
+    variables substituted.  The ``fallback`` section is required and
+    comes last.  Commas in the header are optional, and ``trimmed`` or
+    ``notrimmed`` applies to every section, the fallback included.
+
+    This extension reuses the ``gettext`` and ``ngettext`` functions of
+    the :class:`InternationalizationExtension`, so load both.
+    """
+
+    tags = {"ctrans"}
+
+    def parse(self, parser: "Parser") -> t.Union[nodes.Node, t.List[nodes.Node]]:
+        """Parse a conditional translatable tag."""
+        lineno = next(parser.stream).lineno
+        num_called_num = False
+
+        parser.stream.skip_if("comma")
+        condition = parser.parse_expression()
+
+        # Find all the variables referenced.  Like in the trans tag, a
+        # variable can also be defined in the body, which is checked at
+        # a later stage.  Commas between the parts are optional.
+        plural_expr: t.Optional[nodes.Expr] = None
+        plural_expr_assignment: t.Optional[nodes.Assign] = None
+        variables: t.Dict[str, nodes.Expr] = {}
+        trimmed = None
+        while parser.stream.current.type != "block_end":
+            if parser.stream.skip_if("comma"):
+                continue
+
+            # skip colon for python compatibility
+            if parser.stream.skip_if("colon"):
+                break
+
+            token = parser.stream.expect("name")
+            if token.value in variables:
+                parser.fail(
+                    f"translatable variable {token.value!r} defined twice.",
+                    token.lineno,
+                    exc=TemplateAssertionError,
+                )
+
+            # expressions
+            if parser.stream.current.type == "assign":
+                next(parser.stream)
+                variables[token.value] = var = parser.parse_expression()
+            elif trimmed is None and token.value in ("trimmed", "notrimmed"):
+                trimmed = token.value == "trimmed"
+                continue
+            else:
+                variables[token.value] = var = nodes.Name(token.value, "load")
+
+            if plural_expr is None:
+                if isinstance(var, nodes.Call):
+                    plural_expr = nodes.Name("_trans", "load")
+                    variables[token.value] = plural_expr
+                    plural_expr_assignment = nodes.Assign(
+                        nodes.Name("_trans", "store"), var
+                    )
+                else:
+                    plural_expr = var
+                num_called_num = token.value == "num"
+
+        parser.stream.expect("block_end")
+
+        plural = None
+        plural_names: t.List[str] = []
+        have_plural = False
+
+        # now parse until fallback, pluralize or endctrans
+        singular_names, singular = self._parse_block(parser, True)
+        if singular_names and plural_expr is None:
+            plural_expr = nodes.Name(singular_names[0], "load")
+            num_called_num = singular_names[0] == "num"
+
+        # if we have a pluralize block, we parse that too
+        if parser.stream.current.test("name:pluralize"):
+            have_plural = True
+            next(parser.stream)
+            if parser.stream.current.type != "block_end":
+                token = parser.stream.expect("name")
+                if token.value not in variables and token.value in singular_names:
+                    variables[token.value] = nodes.Name(token.value, "load")
+                if token.value not in variables:
+                    parser.fail(
+                        f"unknown variable {token.value!r} for pluralization",
+                        token.lineno,
+                        exc=TemplateAssertionError,
+                    )
+                plural_expr = variables[token.value]
+                num_called_num = token.value == "num"
+            parser.stream.expect("block_end")
+            plural_names, plural = self._parse_block(parser, False)
+
+        # the fallback block is mandatory, it is what renders when the
+        # condition is false
+        if not parser.stream.current.test("name:fallback"):
+            parser.fail("expected 'fallback' block in conditional translation")
+        next(parser.stream)
+        parser.stream.expect("block_end")
+        fallback_names, fallback = self._parse_block(parser, False, False)
+        next(parser.stream)
+
+        # register free names as simple name expressions, the ones the
+        # translation uses and apart from them those the fallback uses
+        for name in singular_names + plural_names:
+            if name not in variables:
+                variables[name] = nodes.Name(name, "load")
+
+        fallback_variables = {
+            name: variables.get(name) or nodes.Name(name, "load")
+            for name in fallback_names
+        }
+
+        if not have_plural:
+            plural_expr = None
+        elif plural_expr is None:
+            parser.fail("pluralize without variables", lineno)
+
+        if trimmed is None:
+            trimmed = self.environment.policies.get("ext.i18n.trimmed", False)
+        if trimmed:
+            singular = self._trim_whitespace(singular)
+            if plural is not None:
+                plural = self._trim_whitespace(plural)
+            fallback = self._trim_whitespace(fallback)
+
+        node = self._make_conditional_node(
+            condition,
+            singular,
+            plural,
+            fallback,
+            variables,
+            fallback_variables,
+            plural_expr,
+            num_called_num and have_plural,
+        )
+        node.set_lineno(lineno)
+        if plural_expr_assignment is not None:
+            plural_expr_assignment.set_lineno(lineno)
+            return [plural_expr_assignment, node]
+        return node
+
+    def _trim_whitespace(self, string: str, _ws_re: t.Pattern[str] = _ws_re) -> str:
+        return _ws_re.sub(" ", string.strip())
+
+    def _parse_block(
+        self, parser: "Parser", allow_pluralize: bool, allow_fallback: bool = True
+    ) -> t.Tuple[t.List[str], str]:
+        """Parse until the next block tag that ends the section, which
+        is left as the stream's current token.
+        """
+        referenced = []
+        buf = []
+
+        while True:
+            if parser.stream.current.type == "data":
+                buf.append(parser.stream.current.value.replace("%", "%%"))
+                next(parser.stream)
+            elif parser.stream.current.type == "variable_begin":
+                next(parser.stream)
+                name = parser.stream.expect("name").value
+                referenced.append(name)
+                buf.append(f"%({name})s")
+                parser.stream.expect("variable_end")
+            elif parser.stream.current.type == "block_begin":
+                next(parser.stream)
+                if parser.stream.current.test("name:endctrans"):
+                    break
+                elif parser.stream.current.test("name:pluralize"):
+                    if allow_pluralize:
+                        break
+                    if allow_fallback:
+                        parser.fail(
+                            "a translatable section can have only one"
+                            " pluralize section"
+                        )
+                    parser.fail("the pluralize section must come before 'fallback'")
+                elif parser.stream.current.test("name:fallback"):
+                    if allow_fallback:
+                        break
+                    parser.fail(
+                        "a conditional translation can have only one fallback section"
+                    )
+                parser.fail(
+                    "control structures in translatable sections are not allowed"
+                )
+            elif parser.stream.eos:
+                parser.fail("unclosed conditional translation block")
+            else:
+                raise RuntimeError("internal parser error")
+
+        return referenced, concat(buf)
+
+    def _make_conditional_node(
+        self,
+        condition: nodes.Expr,
+        singular: str,
+        plural: t.Optional[str],
+        fallback: str,
+        variables: t.Dict[str, nodes.Expr],
+        fallback_variables: t.Dict[str, nodes.Expr],
+        plural_expr: t.Optional[nodes.Expr],
+        num_called_num: bool,
+    ) -> nodes.If:
+        """Generates an ``If`` node that renders the translation when
+        the condition is true and the fallback when it is false.
+        """
+        newstyle = getattr(self.environment, "newstyle_gettext", False)
+        node: nodes.Expr
+
+        # no variables?  no need to escape for old style gettext
+        # invocations, which only format when there are variables.
+        if not variables and not newstyle:
+            singular = singular.replace("%%", "%")
+            if plural:
+                plural = plural.replace("%%", "%")
+
         # singular only:
         if plural_expr is None:
             gettext = nodes.Name("gettext", "load")
