+def validate_template_path(template: str) -> None:
+    """Reject template paths that are empty or could reach outside the
+    template search path. Raises :exc:`TemplateNotFound` for an empty
+    path, a null byte, an absolute path (a leading ``/`` or ``\\``), a
+    Windows drive letter (``C:``), or an ASCII control character other
+    than tab, newline and carriage return.
+    """
+    if not template:
+        raise TemplateNotFound(template)
+
+    if "\x00" in template:
+        raise TemplateNotFound(template)
+
+    if template[0] in ("/", "\\"):
+        raise TemplateNotFound(template)
+
+    first = template[0]
+    if len(template) >= 2 and template[1] == ":" and (
+        "a" <= first <= "z" or "A" <= first <= "Z"
+    ):
+        raise TemplateNotFound(template)
+
+    for char in template:
+        if ord(char) < 32 and char not in "\t\n\r":
+            raise TemplateNotFound(template)
+
