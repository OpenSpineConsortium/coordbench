+class CacheUsageTracker:
+    """Tracks cache hits and misses within a context, mirroring `UsageTracker` for LM usage.
+
+    The counters are the same as the global ones of `dspy.cache.stats()`: `mem_hits`, `disk_hits`, `misses`, and
+    `hits`, which is `mem_hits + disk_hits`.
+    """
+
+    CACHE_USAGE_KEYS = ("hits", "mem_hits", "disk_hits", "misses")
+
+    def __init__(self):
+        self.cache_usage_data = Counter()
+        # A tracker can be shared by threads spawned inside its context, so updates are guarded.
+        self._lock = threading.RLock()
+
+    def __deepcopy__(self, memo):
+        # A lock cannot be copied; a copy gets a lock of its own and the counts so far.
+        clone = type(self)()
+        with self._lock:
+            clone.cache_usage_data.update(self.cache_usage_data)
+        return clone
+
+    def add_cache_event(self, event: str):
+        """Count one cache event: `mem_hits`, `disk_hits` or `misses`. A hit also counts toward `hits`."""
+        with self._lock:
+            self.cache_usage_data[event] += 1
+            if event in ("mem_hits", "disk_hits"):
+                self.cache_usage_data["hits"] += 1
+
+    def get_cache_usage(self) -> Dict[str, int]:
+        """Return the cache events counted so far, with every key present (0 when nothing was counted)."""
+        with self._lock:
+            return {key: self.cache_usage_data[key] for key in self.CACHE_USAGE_KEYS}
+
+
