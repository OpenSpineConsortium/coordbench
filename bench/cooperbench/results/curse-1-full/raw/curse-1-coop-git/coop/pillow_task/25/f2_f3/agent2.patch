+    def test_save_preserve_readonly(self, tmp_path: Path) -> None:
+        data = bytearray(b"\xff")
+        im = Image.frombuffer("L", (1, 1), data)
+        assert im.readonly
+
+        # By default, saving copies the image and breaks the link to the buffer
+        im.save(tmp_path / "default.bmp")
+        assert not im.readonly
+        data[0] = 64
+        assert im.getdata()[0] == 255
+
+        # With preserve_readonly, the image keeps reflecting the buffer
+        data = bytearray(b"\xff")
+        im = Image.frombuffer("L", (1, 1), data)
+        im.save(tmp_path / "preserved.bmp", preserve_readonly=True)
+        assert im.readonly
+        data[0] = 64
+        assert im.getdata()[0] == 64
+
+        with Image.open(tmp_path / "preserved.bmp") as reloaded:
+            assert reloaded.getdata()[0] == 255
+
+    def test_save_preserve_readonly_not_readonly(self, tmp_path: Path) -> None:
+        im = Image.new("L", (1, 1), 255)
+        assert not im.readonly
+        im.save(tmp_path / "temp.bmp", preserve_readonly=True)
+        assert not im.readonly
+
