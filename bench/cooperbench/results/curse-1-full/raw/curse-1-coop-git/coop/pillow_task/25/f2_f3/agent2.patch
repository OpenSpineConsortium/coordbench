+
+        assert not temp_file.exists()
+
+    def test_save_dry_run_save_all(self, tmp_path: Path) -> None:
+        temp_file = tmp_path / "temp.gif"
+        frames = [Image.new("P", (10, 10), color) for color in (0, 1)]
+
+        frames[0].save(temp_file, save_all=True, append_images=frames[1:], dry_run=True)
+
+        assert not temp_file.exists()
+
+    def test_save_dry_run_still_raises(self, tmp_path: Path) -> None:
+        temp_file = tmp_path / "temp.jpg"
+
+        # A mode that the format cannot store
+        with pytest.raises(OSError):
+            Image.new("RGBA", (10, 10)).save(temp_file, dry_run=True)
+
+        # An empty image
+        with pytest.raises(ValueError):
+            Image.new("RGB", (0, 0)).save(temp_file, dry_run=True)
+
+        # A file extension that no format owns
+        with pytest.raises(ValueError):
+            hopper().save(tmp_path / "temp.unknown", dry_run=True)
+
+        assert list(tmp_path.iterdir()) == []
+
+    def test_save_dry_run_beside_real_save(self, tmp_path: Path) -> None:
+        im = hopper()
+        im.save(tmp_path / "real.png", optimize=True)
+
+        im.save(tmp_path / "dry.png", optimize=True, dry_run=True)
+
+        assert [path.name for path in tmp_path.iterdir()] == ["real.png"]
+        assert not hasattr(im, "encoderinfo")
+
+    def test_save_dry_run_false_writes_file(self, tmp_path: Path) -> None:
+        temp_file = tmp_path / "temp.png"
+
+        hopper().save(temp_file, dry_run=False)
+
+        assert temp_file.exists()
+
