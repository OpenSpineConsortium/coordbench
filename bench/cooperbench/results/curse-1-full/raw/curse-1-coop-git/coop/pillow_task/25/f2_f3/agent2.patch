+
+    def test_save_dry_run_leaves_existing_file(self, tmp_path: Path) -> None:
+        temp_file = tmp_path / "temp.png"
+        temp_file.write_bytes(b"existing")
+
+        hopper().save(temp_file, dry_run=True)
+        hopper().save(temp_file, dry_run=True, append=True)
+
+        assert temp_file.read_bytes() == b"existing"
+
+    def test_save_dry_run_file_object(self) -> None:
