+    def _quantize_to_error_threshold(self, colors, method, kmeans, error_threshold):
+        """
+        Quantize with the fewest colors, up to ``colors``, whose mean square error
+        against this image is at most ``error_threshold``.
+
+        The error falls as colors are added, so the count is found by bisection
+        instead of trying every count. When even ``colors`` colors miss the
+        threshold, that quantization is returned.
+
+        :returns: The quantized image, in the core's "P" mode.
+        """
+        from . import ImageChops, ImageStat
+
+        def quantized(count):
+            return self.im.quantize(count, method, kmeans)
+
+        def meets_threshold(core):
+            restored = self._new(core.convert(self.mode))
+            stat = ImageStat.Stat(ImageChops.difference(self, restored))
+            pixels = sum(stat.count)
+            return pixels == 0 or sum(stat.sum2) / pixels <= error_threshold
+
+        best = quantized(colors)
+        if colors < 2 or not meets_threshold(best):
+            return best
+
+        low, high = 1, colors  # the answer lies in [low, high]; high is known good
+        while low < high:
+            middle = (low + high) // 2
+            candidate = quantized(middle)
+            if meets_threshold(candidate):
+                best, high = candidate, middle
+            else:
+                low = middle + 1
+        return best
+
