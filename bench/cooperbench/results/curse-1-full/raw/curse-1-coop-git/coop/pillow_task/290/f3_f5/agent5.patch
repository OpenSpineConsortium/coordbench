+def test_quantize_lightness_factor_saves(tmp_path):
+    image = hopper()
+    adjusted = image.quantize(lightness_factor=1.3)
+
+    out = str(tmp_path / "temp.png")
+    adjusted.save(out)
+    with Image.open(out) as reloaded:
