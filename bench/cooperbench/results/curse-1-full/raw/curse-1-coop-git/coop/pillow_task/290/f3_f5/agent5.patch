+def test_quantize_lightness_factor_default():
+    image = hopper()
+    default = image.quantize()
+    explicit = image.quantize(lightness_factor=1.0)
+
+    assert explicit.tobytes() == default.tobytes()
+    assert explicit.getpalette() == default.getpalette()
+    assert explicit.palette.palette == default.palette.palette
+
+
+@pytest.mark.parametrize("factor", (0.5, 0.9, 1.1, 1.5))
+def test_quantize_lightness_factor_scales_palette(factor):
+    image = hopper()
+    default = image.quantize()
+    adjusted = image.quantize(lightness_factor=factor)
+
+    assert_image(adjusted, "P", adjusted.size)
+    # The pixels keep their indexes: only the palette changes
+    assert adjusted.tobytes() == default.tobytes()
+
+    expected = [min(255, int(value * factor)) for value in default.getpalette()]
+    assert adjusted.getpalette() == expected
+    assert list(adjusted.palette.palette) == expected
+
+    # The image itself follows the palette
+    assert adjusted.convert("RGB").getpixel((10, 10)) == tuple(
+        expected[adjusted.getpixel((10, 10)) * 3 :][:3]
+    )
+
+
+def test_quantize_lightness_factor_brighter_and_darker():
+    image = hopper()
+    default = image.quantize().convert("RGB")
+    brighter = image.quantize(lightness_factor=1.2).convert("RGB")
+    darker = image.quantize(lightness_factor=0.8).convert("RGB")
+
+    def total(im):
+        return sum(sum(color) * count for count, color in im.getcolors(1 << 16))
+
+    assert total(darker) < total(default) < total(brighter)
+
+
+def test_quantize_lightness_factor_clamps():
+    image = Image.new("RGB", (4, 4), (100, 150, 200))
+
+    converted = image.quantize(lightness_factor=2.0)
+    assert converted.convert("RGB").getpixel((0, 0)) == (200, 255, 255)
+
+    converted = image.quantize(lightness_factor=1e300)
+    assert converted.convert("RGB").getpixel((0, 0)) == (255, 255, 255)
+    assert max(converted.getpalette()) == 255
+
+    converted = image.quantize(lightness_factor=float("inf"))
+    assert converted.convert("RGB").getpixel((0, 0)) == (255, 255, 255)
+
+    converted = image.quantize(lightness_factor=1e-300)
+    assert converted.convert("RGB").getpixel((0, 0)) == (0, 0, 0)
