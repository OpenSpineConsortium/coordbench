+
+def test_max_colors_defaults_to_colors():
+    image = hopper()
+    default = image.quantize(100, Image.FASTOCTREE)
+    explicit = image.quantize(100, Image.FASTOCTREE, max_colors=100)
+    assert len(explicit.getcolors()) == 100
+    assert default.tobytes() == explicit.tobytes()
+    assert default.getpalette() == explicit.getpalette()
+
+
+def test_max_colors_above_colors():
+    image = hopper()
+    converted = image.quantize(colors=50, method=Image.FASTOCTREE, max_colors=200)
+    assert len(converted.getcolors()) == 50
+
+
+@pytest.mark.parametrize("method", (Image.MEDIANCUT, Image.MAXCOVERAGE))
+def test_max_colors_methods(method):
+    image = hopper()
+    converted = image.quantize(colors=64, method=method, max_colors=16)
+    assert_image(converted, "P", converted.size)
+    assert len(converted.getcolors()) <= 16
+
+
+def test_max_colors_rgba():
+    image = hopper("RGBA")
+    converted = image.quantize(colors=100, max_colors=30)
+    assert converted.convert().mode == "RGBA"
+    assert len(converted.getcolors()) <= 30
+
+
+def test_max_colors_ignored_with_palette():
+    image = hopper()
+    palette = hopper("P")
+    converted = image.quantize(palette=palette, max_colors=2)
+    assert converted.palette.palette == palette.palette.palette
+
+
+def _palette_colors(im, count, size=3):
+    palette = im.getpalette()
+    return [tuple(palette[i * size : (i + 1) * size]) for i in range(count)]
+
+
+def _brightness(color):
+    return 0.299 * color[0] + 0.587 * color[1] + 0.114 * color[2]
+
+
+def test_sort_palette_default_keeps_quantizer_order():
+    image = hopper()
+    default = image.quantize(16)
+    explicit = image.quantize(16, sort_palette=None)
+    assert default.tobytes() == explicit.tobytes()
+    assert default.getpalette() == explicit.getpalette()
+
+
+def test_sort_palette_brightness():
+    image = hopper()
+    unsorted = image.quantize(16)
+    converted = image.quantize(16, sort_palette="brightness")
+    assert_image(converted, "P", converted.size)
+
+    colors = _palette_colors(converted, 16)
+    brightness = [_brightness(color) for color in colors]
+    assert brightness == sorted(brightness)
+
+    # The same colors, now in a new order, painted on the same pixels
+    assert sorted(colors) == sorted(_palette_colors(unsorted, 16))
+    assert converted.tobytes() != unsorted.tobytes()
+    assert converted.convert("RGB").tobytes() == unsorted.convert("RGB").tobytes()
+
+
+def test_sort_palette_rgb():
+    image = hopper()
+    unsorted = image.quantize(32)
+    converted = image.quantize(32, sort_palette="rgb")
+
+    colors = _palette_colors(converted, 32)
+    assert colors == sorted(colors)
+    assert converted.convert("RGB").tobytes() == unsorted.convert("RGB").tobytes()
+
+
+@pytest.mark.parametrize("sort_palette", ("brightness", "rgb"))
+def test_sort_palette_default_colors(sort_palette):
+    image = hopper()
+    unsorted = image.quantize()
+    converted = image.quantize(sort_palette=sort_palette)
+
+    colors = _palette_colors(converted, 256)
+    key = _brightness if sort_palette == "brightness" else None
+    assert colors == sorted(colors, key=key)
+    assert converted.convert("RGB").tobytes() == unsorted.convert("RGB").tobytes()
+
+
+@pytest.mark.parametrize(
+    "method", (Image.MEDIANCUT, Image.MAXCOVERAGE, Image.FASTOCTREE)
+)
+def test_sort_palette_methods(method):
+    image = hopper()
+    unsorted = image.quantize(20, method)
+    converted = image.quantize(20, method, sort_palette="brightness")
+
+    brightness = [_brightness(color) for color in _palette_colors(converted, 20)]
+    assert brightness == sorted(brightness)
+    assert converted.convert("RGB").tobytes() == unsorted.convert("RGB").tobytes()
+
+
+def test_sort_palette_is_stable_when_repeated():
+    image = hopper()
+    once = image.quantize(16, sort_palette="brightness")
+    again = once._sorted_palette_image("brightness", 16)
+    assert again.tobytes() == once.tobytes()
+    assert again.getpalette() == once.getpalette()
+
+
+def test_sort_palette_few_colors():
+    # Only the four colors the quantizer made are sorted, not the black
+    # padding after them, so the colors stay at the start of the palette
+    image = Image.new("RGB", (4, 1))
+    pixels = [(200, 200, 200), (10, 10, 10), (100, 0, 0), (0, 0, 100)]
+    image.putdata(pixels)
+
+    converted = image.quantize(sort_palette="brightness")
+    assert converted.convert("RGB").tobytes() == image.tobytes()
+
+    colors = _palette_colors(converted, 4)
+    assert colors == [(10, 10, 10), (0, 0, 100), (100, 0, 0), (200, 200, 200)]
+    assert list(converted.getdata()) == [3, 0, 2, 1]
+
+
+def test_sort_palette_rgba():
+    image = hopper("RGBA")
+    image.putalpha(Image.linear_gradient("L").resize(image.size))
+
+    unsorted = image.quantize(16)
+    converted = image.quantize(16, sort_palette="brightness")
+    assert converted.convert().mode == "RGBA"
+
+    palette = converted.im.getpalette("RGBA", "RGBA")
+    colors = [tuple(palette[i * 4 : (i + 1) * 4]) for i in range(16)]
+    brightness = [_brightness(color) for color in colors]
+    assert brightness == sorted(brightness)
+    assert converted.convert("RGBA").tobytes() == unsorted.convert("RGBA").tobytes()
+
+
+def test_sort_palette_with_palette():
+    image = hopper()
+    palette = hopper("P")
+    unsorted = image.quantize(palette=palette)
+    converted = image.quantize(palette=palette, sort_palette="rgb")
+
+    count = len(palette.palette.palette) // 3
+    assert len(converted.palette.palette) == len(palette.palette.palette)
+    colors = _palette_colors(converted, count)
+    assert colors == sorted(colors)
+    assert converted.convert("RGB").tobytes() == unsorted.convert("RGB").tobytes()
+    # the reference palette image is left alone
+    assert palette.palette.palette == hopper("P").palette.palette
+
+
+def test_sort_palette_with_max_colors():
+    image = hopper()
+    converted = image.quantize(
+        colors=100, method=Image.FASTOCTREE, max_colors=20, sort_palette="brightness"
+    )
+    count = len(converted.getcolors())
+    assert count <= 20
+
+    brightness = [_brightness(color) for color in _palette_colors(converted, count)]
+    assert brightness == sorted(brightness)
+
+
+@pytest.mark.parametrize("sort_palette", ("hue", "", "Brightness", 1, True, []))
+def test_sort_palette_invalid(sort_palette):
+    image = hopper()
+    with pytest.raises(ValueError):
+        image.quantize(16, sort_palette=sort_palette)
+    with pytest.raises(ValueError):
+        image.quantize(palette=hopper("P"), sort_palette=sort_palette)
