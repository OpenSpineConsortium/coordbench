+HashAlgorithm = Literal['md5', 'sha1', 'sha224', 'sha256', 'sha384', 'sha512']
+
+# the number of hexadecimal characters in the digest of each supported algorithm
+_HASH_LENGTHS = {
+    'md5': 32,
+    'sha1': 40,
+    'sha224': 56,
+    'sha256': 64,
+    'sha384': 96,
+    'sha512': 128,
+}
+
+
+class IsHash(DirtyEquals[str]):
+    """
+    A class that checks if a value is a hexadecimal hash digest of a given algorithm,
+    that is a string with the right length and only hexadecimal characters.
+    """
+
+    def __init__(self, algorithm: HashAlgorithm):
+        """
+        Args:
+            algorithm: The hash algorithm the value should look like the digest of, one of `md5`, `sha1`, `sha224`,
+                `sha256`, `sha384` and `sha512`. The name is not case sensitive and may contain hyphens,
+                so `SHA-256` is the same as `sha256`.
+
+        Only the format of the hash is checked, not that it's the hash of anything in particular.
+
+        ```py title="IsHash"
+        from dirty_equals import IsHash
+
+        assert 'd41d8cd98f00b204e9800998ecf8427e' == IsHash('md5')
+        assert 'D41D8CD98F00B204E9800998ECF8427E' == IsHash('MD5')
+        assert 'da39a3ee5e6b4b0d3255bfef95601890afd80709' == IsHash('sha1')
+        assert 'da39a3ee5e6b4b0d3255bfef95601890afd80709' != IsHash('md5')
+        assert 'not a hash' != IsHash('md5')
+        assert 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855' == IsHash('sha256')
+        ```
+        """
+        name = algorithm.lower().replace('-', '') if isinstance(algorithm, str) else None
+        if name not in _HASH_LENGTHS:
+            supported = ', '.join(_HASH_LENGTHS)
+            raise ValueError(f'Unsupported hash algorithm {algorithm!r}, must be one of: {supported}')
+        self.algorithm = algorithm
+        self._hex_digits = re.compile(f'[0-9a-fA-F]{{{_HASH_LENGTHS[name]}}}')
+        super().__init__(algorithm)
+
+    def equals(self, other: Any) -> bool:
+        return isinstance(other, str) and self._hex_digits.fullmatch(other) is not None
+
