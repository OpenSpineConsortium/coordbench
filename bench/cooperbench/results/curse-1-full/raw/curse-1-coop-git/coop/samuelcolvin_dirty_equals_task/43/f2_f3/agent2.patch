+class IsMac(DirtyEquals[str]):
+    """
+    A class that checks if a value is a valid MAC address, optionally checking the format it is written in.
+    """
+
+    _hex = '[0-9a-fA-F]'
+    _patterns = {
+        'colon': re.compile(f'{_hex}{{2}}(?::{_hex}{{2}}){{5}}'),
+        'hyphen': re.compile(f'{_hex}{{2}}(?:-{_hex}{{2}}){{5}}'),
+        'dot': re.compile(f'{_hex}{{4}}(?:\\.{_hex}{{4}}){{2}}'),
+        'compact': re.compile(f'{_hex}{{12}}'),
+    }
+
+    def __init__(self, format: Literal[None, 'colon', 'hyphen', 'dot', 'compact'] = None):
+        """
+        Args:
+            format: The format the MAC address must be written in, one of `'colon'`, `'hyphen'`, `'dot'`
+                or `'compact'`, if omitted, all of these formats are accepted.
+
+        Hexadecimal digits may be upper or lower case, in every format.
+
+        ```py title="IsMac"
+        from dirty_equals import IsMac
+
+        assert '00:1B:44:11:3A:B7' == IsMac
+        assert '00-1B-44-11-3A-B7' == IsMac
+        assert '001B.4411.3AB7' == IsMac
+        assert '001b44113ab7' == IsMac
+        assert '00:1b:44:11:3a:b7' == IsMac('colon')
+        assert '00-1B-44-11-3A-B7' != IsMac('colon')
+        assert '001b44113ab7' == IsMac('compact')
+        assert '00:1B:44:11:3A' != IsMac
+        assert '00:1B:44:11:3A:GG' != IsMac
+        ```
+        """
+        if format is not None and format not in self._patterns:
+            raise ValueError(f'Invalid MAC address format {format!r}, expected one of {", ".join(self._patterns)}')
+        self.format = format
+        super().__init__(format or plain_repr('*'))
+
+    def equals(self, other: Any) -> bool:
+        if not isinstance(other, str):
+            return False
+
+        if self.format is None:
+            return any(pattern.fullmatch(other) for pattern in self._patterns.values())
+        else:
+            return bool(self._patterns[self.format].fullmatch(other))
+
+
