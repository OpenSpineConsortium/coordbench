+_EMAIL_REGEX = re.compile(
+    r'[a-zA-Z0-9._%+-]+'  # local part
+    r'@'
+    r'(?P<domain>(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?\.)+[a-zA-Z]{2,})'  # dotted domain with a TLD
+)
