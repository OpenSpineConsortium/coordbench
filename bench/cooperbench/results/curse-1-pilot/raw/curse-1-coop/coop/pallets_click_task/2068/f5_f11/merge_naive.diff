+    def _get_lock_filename(self, filename: str) -> str:
+        """Return the path of the lock file for ``filename``: the same
+        directory, named ``.{basename}.lock``.
+        """
+        directory, basename = os.path.split(filename)
+        return os.path.join(directory, f".{basename}.lock")
+
+    def _create_lock_file(self, filename: str) -> str:
+        """Create the lock file for ``filename`` and return its path.
+
+        The file is created with ``O_CREAT | O_EXCL``, so the check for an
+        existing lock and the creation are one atomic step and two processes
+        can never both succeed. It holds the process id and the time, for
+        whoever has to find out why a lock is still there.
+
+        :raises ClickException: if the lock file exists already, meaning
+            another edit session holds the file, or cannot be created.
+        """
+        from datetime import datetime
+
+        lock_filename = self._get_lock_filename(filename)
+
+        try:
+            fd = os.open(lock_filename, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
+        except FileExistsError as e:
+            raise ClickException(
+                _(
+                    "{filename}: Cannot edit, another edit session holds the"
+                    " lock file {lock_filename}. If no editor is open on the"
+                    " file, remove the lock file and try again."
+                ).format(filename=filename, lock_filename=lock_filename)
+            ) from e
+        except OSError as e:
+            raise ClickException(
+                _("{filename}: Cannot create lock file {lock_filename}: {e}").format(
+                    filename=filename, lock_filename=lock_filename, e=e
+                )
+            ) from e
+
+        try:
+            with os.fdopen(fd, "w") as f:
+                f.write(f"PID: {os.getpid()}\nTime: {datetime.now().isoformat()}\n")
+        except BaseException:
+            # A lock file that was created but never filled would block the
+            # next session until someone removes it by hand.
+            self._remove_lock_file(lock_filename)
+            raise
+
+        return lock_filename
+
+    def _remove_lock_file(self, lock_filename: str) -> None:
+        """Remove the lock file. A lock file that is gone already is not an
+        error, so cleanup can run on every path out of an edit session.
+        """
+        try:
+            os.unlink(lock_filename)
+        except OSError:
+            pass
+
