+        directory, name = os.path.split(filename)
+        return os.path.join(directory, f".{name}.lock")
+
+    def _create_lock_file(self, filename: str) -> str:
+        """Create the lock file for ``filename`` and return its path.
+
+        The file is created with ``O_CREAT | O_EXCL``, so the check for an
+        existing lock and the creation are one atomic step and two
+        processes can never both succeed. It records the process ID and
+        the time, to help whoever finds a stale lock.
+
+        :raises ClickException: if the file is locked already or the lock
+            file cannot be created.
+        """
+        import datetime
+
+        lock_filename = self._get_lock_filename(filename)
+        flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY
+
+        try:
+            fd = os.open(lock_filename, flags, 0o644)
+        except FileExistsError:
+            raise ClickException(
+                _(
+                    "{filename!r} is already being edited. Lock file exists:"
+                    " {lock_filename!r}"
+                ).format(filename=filename, lock_filename=lock_filename)
+            ) from None
+        except OSError as e:
+            raise ClickException(
+                _("Could not create lock file {lock_filename!r}: {e}").format(
+                    lock_filename=lock_filename, e=e
+                )
+            ) from e
+
+        try:
+            with os.fdopen(fd, "w", encoding="utf-8") as f:
+                f.write(
+                    f"PID: {os.getpid()}\nTime: {datetime.datetime.now().isoformat()}"
+                )
+        except BaseException:
+            # Do not leave a half-written lock behind, it would block the
+            # file until someone removed it by hand.
+            self._remove_lock_file(lock_filename)
+            raise
+
+        return lock_filename
