+# Niceness values for the editor process on Unix-like systems. Lower is
+# higher priority, and a negative value needs privileges the process
+# usually lacks, in which case the priority is silently left alone.
+_UNIX_NICE: dict[str, int] = {
+    "low": 19,
+    "below_normal": 10,
+    "normal": 0,
+    "above_normal": -5,
+    "high": -10,
+}
+
+# Windows priority class flags, used if the subprocess module on this
+# Python does not name them.
+_WIN_PRIORITY_CLASS: dict[str, tuple[str, int]] = {
+    "low": ("IDLE_PRIORITY_CLASS", 0x00000040),
+    "below_normal": ("BELOW_NORMAL_PRIORITY_CLASS", 0x00004000),
+    "normal": ("NORMAL_PRIORITY_CLASS", 0x00000020),
+    "above_normal": ("ABOVE_NORMAL_PRIORITY_CLASS", 0x00008000),
+    "high": ("HIGH_PRIORITY_CLASS", 0x00000080),
+}
+
+
+def _set_unix_priority(nice: int) -> None:
+    """Set the niceness of the current process. This runs in the child
+    between ``fork`` and ``exec``, so it must never raise: an error there
+    would stop the editor from starting at all.
+    """
+    try:
+        if hasattr(os, "setpriority"):
+            os.setpriority(os.PRIO_PROCESS, 0, nice)
+        elif nice:
+            os.nice(nice)
+    except Exception:
+        # Not permitted or not supported, run at the default priority.
+        pass
+
+
