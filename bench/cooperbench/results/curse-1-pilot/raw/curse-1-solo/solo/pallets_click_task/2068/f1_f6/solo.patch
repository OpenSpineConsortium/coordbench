+    def _priority_popen_kwargs(self) -> dict[str, t.Any]:
+        """Extra ``Popen`` arguments that start the editor at the requested
+        priority. Empty if no priority is requested, the value is not a
+        known one, or the platform has no way to set it.
+        """
+        priority = self.process_priority
+
+        if not isinstance(priority, str) or priority not in _UNIX_NICE:
+            return {}
+
+        if WIN:
+            import subprocess
+
+            name, default = _WIN_PRIORITY_CLASS[priority]
+            return {"creationflags": getattr(subprocess, name, default)}
+
+        if not hasattr(os, "setpriority") and not hasattr(os, "nice"):
+            return {}
+
+        nice = _UNIX_NICE[priority]
+
+        def preexec() -> None:
+            _set_unix_priority(nice)
+
+        return {"preexec_fn": preexec}
 
