+    def _get_lock_filename(self, filename: str) -> str:
+        """Return the path of the lock file for ``filename``: a hidden
+        file named ``.{name}.lock`` in the same directory.
+        """
+        directory, name = os.path.split(filename)
+        return os.path.join(directory, f".{name}.lock")
+
+    def _create_lock_file(self, filename: str) -> str:
+        """Create the lock file for ``filename`` and return its path.
+
+        The file is created with ``O_CREAT | O_EXCL``, so the check for
+        an existing lock and the creation are one atomic step, on
+        Windows as well as on POSIX. If another edit session holds the
+        lock, a :exc:`ClickException` is raised and that lock is left
+        untouched. The lock records the process ID and the time to help
+        debugging.
+        """
+        import datetime
+
+        lock_filename = self._get_lock_filename(filename)
+
+        try:
+            fd = os.open(lock_filename, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
+        except FileExistsError:
+            raise ClickException(
+                _(
+                    "{filename}: File is already being edited."
+                    " Lock file exists: {lock_filename}"
+                ).format(filename=filename, lock_filename=lock_filename)
+            ) from None
+        except OSError as e:
+            raise ClickException(
+                _("{filename}: Could not create lock file: {e}").format(
+                    filename=filename, e=e
+                )
+            ) from e
+
+        try:
+            with os.fdopen(fd, "w", encoding="utf-8") as f:
+                f.write(
+                    f"PID: {os.getpid()}\n"
+                    f"Time: {datetime.datetime.now().isoformat()}"
+                )
+        except BaseException:
+            # Do not leave a half written lock behind that would block
+            # every later edit of the file.
+            self._remove_lock_file(lock_filename)
+            raise
+
+        return lock_filename
+
+    def _remove_lock_file(self, lock_filename: str) -> None:
+        """Remove a lock file made by :meth:`_create_lock_file`. A lock
+        that is already gone is not an error.
+        """
+        try:
+            os.unlink(lock_filename)
+        except OSError:
+            pass
+
+    def _quote_editor(self, editor: str) -> str:
+        """Escape an editor command for the shell, keeping its arguments.
+
+        An editor such as ``vim -u NONE`` is a command and its
+        arguments, so each word is quoted on its own. A value that is
+        an existing path as a whole, like ``/opt/my editor/bin/vim``, is
+        quoted as one word instead.
+        """
+        import shlex
+
+        if os.path.exists(editor):
+            return shlex.quote(editor)
+
+        try:
+            parts = shlex.split(editor)
+        except ValueError:
+            # Unbalanced quotes: treat the whole value as one word.
+            return shlex.quote(editor)
+
+        if not parts:
+            return shlex.quote(editor)
+
+        return " ".join(shlex.quote(part) for part in parts)
+
