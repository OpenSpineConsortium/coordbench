+    def _get_lock_filename(self, filename: str) -> str:
+        """Return the path of the lock file for ``filename``: a hidden
+        ``.{name}.lock`` file next to it.
+        """
+        directory, name = os.path.split(filename)
+        return os.path.join(directory, f".{name}.lock")
+
+    def _create_lock_file(self, filename: str) -> str:
+        """Create the lock file for ``filename`` and return its path.
+
+        The file is created with ``O_EXCL``, so the check that no other
+        edit session holds the lock and the creation are one atomic step
+        and two processes can never both succeed. The file records the
+        process id and the time for whoever finds a stale lock.
+        """
+        import datetime
+
+        lock_filename = self._get_lock_filename(filename)
+
+        try:
+            fd = os.open(lock_filename, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
+        except FileExistsError:
+            raise ClickException(
+                _(
+                    "{filename}: File is already being edited."
+                    " Lock file exists: {lock_filename}"
+                ).format(filename=filename, lock_filename=lock_filename)
+            ) from None
+        except OSError as e:
+            raise ClickException(
+                _("{filename}: Could not create lock file: {e}").format(
+                    filename=filename, e=e
+                )
+            ) from e
+
+        try:
+            with os.fdopen(fd, "w", encoding="utf-8") as f:
+                f.write(
+                    f"PID: {os.getpid()}\nTime: {datetime.datetime.now().isoformat()}"
+                )
+        except BaseException:
+            # Do not leave an empty lock behind that would block the file.
+            self._remove_lock_file(lock_filename)
+            raise
+
+        return lock_filename
+
+    def _remove_lock_file(self, lock_filename: str) -> None:
+        """Remove a lock file. A lock that is already gone is not an
+        error, and a failure to remove it must not hide the outcome of
+        the edit it guarded.
+        """
+        with contextlib.suppress(OSError):
+            os.unlink(lock_filename)
+
+    @contextlib.contextmanager
+    def _locked(self, filename: str) -> cabc.Iterator[None]:
+        """Hold the lock file of ``filename`` for the duration of the
+        block, if ``lock_files`` is enabled. The lock is removed on every
+        way out, including errors and interrupts.
+        """
+        if not self.lock_files:
+            yield
+            return
+
+        lock_filename = self._create_lock_file(filename)
+
+        try:
+            yield
+        finally:
+            self._remove_lock_file(lock_filename)
+
+    def _start_monitor(self, pid: int, editor: str) -> _EditorMonitor | None:
+        resolved = _resolve_monitor(self.monitor_process)
+
+        if resolved is None:
+            return None
+
+        callback, interval = resolved
+        monitor = _EditorMonitor(callback, pid, editor, interval)
+        monitor.start()
+        return monitor
+
     def edit_file(self, filename: str) -> None:
+        with self._locked(filename):
+            self._run_editor(filename)
+
