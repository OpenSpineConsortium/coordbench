+    def _get_lock_filename(self, filename: str) -> str:
+        """Return the path of the lock file that guards ``filename``.
+
+        The lock lives next to the file and is named ``.<name>.lock``, so
+        two processes that edit the same file agree on the same lock.
+        """
+        dirname, basename = os.path.split(filename)
+        return os.path.join(dirname, f".{basename}.lock")
+
+    def _create_lock_file(self, filename: str) -> str:
+        """Create the lock file for ``filename`` and return its path.
+
+        The file is created with ``O_CREAT | O_EXCL``, which the operating
+        system makes atomic, so of several processes that race for the lock
+        exactly one wins. The others get a :exc:`ClickException`. The lock
+        records the process id and the time, to help whoever has to find
+        out who holds it.
+        """
+        import datetime
+
+        lock_filename = self._get_lock_filename(filename)
+        flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY | getattr(os, "O_BINARY", 0)
+
+        try:
+            fd = os.open(lock_filename, flags, 0o644)
+        except FileExistsError:
+            raise ClickException(
+                _(
+                    "{filename}: File is already being edited (lock file"
+                    " {lock_filename} exists)"
+                ).format(filename=filename, lock_filename=lock_filename)
+            ) from None
+        except OSError as e:
+            raise ClickException(
+                _("{filename}: Could not create lock file: {e}").format(
+                    filename=filename, e=e
+                )
+            ) from e
+
+        try:
+            with os.fdopen(fd, "w", encoding="utf-8") as f:
+                f.write(
+                    f"PID: {os.getpid()}\n"
+                    f"Time: {datetime.datetime.now().isoformat()}"
+                )
+        except BaseException:
+            # Do not leave a half written lock behind.
+            self._remove_lock_file(lock_filename)
+            raise
+
+        return lock_filename
+
+    def _remove_lock_file(self, lock_filename: str) -> None:
+        """Remove a lock file made by :meth:`_create_lock_file`.
+
+        A lock that is already gone is not an error: cleanup must never
+        hide the outcome of the edit itself.
+        """
+        with contextlib.suppress(OSError):
+            os.unlink(lock_filename)
+
+    def _quote_editor(self, editor: str) -> str:
+        """Quote each word of the editor command for the shell. The
+        editor setting may carry arguments (``code --wait``), so it is
+        split into words first, unless the whole string names an
+        executable (a path with spaces), which is quoted as one word.
+        """
+        import shlex
+        import shutil
+
+        if shutil.which(editor) is not None:
+            return shlex.quote(editor)
+
+        try:
+            words = shlex.split(editor)
+        except ValueError:
+            # Unbalanced quotes: nothing sensible to split, quote it whole.
+            return shlex.quote(editor)
+
+        return " ".join(shlex.quote(word) for word in words)
+
+    def _get_command(self, editor: str, filename: str) -> str:
+        if self.escape_shell:
+            import shlex
+
+            return f"{self._quote_editor(editor)} {shlex.quote(filename)}"
+
+        return f'{editor} "{filename}"'
+
