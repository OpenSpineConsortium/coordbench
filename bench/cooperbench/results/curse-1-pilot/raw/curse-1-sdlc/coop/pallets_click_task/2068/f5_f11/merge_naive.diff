+def _process_is_stopped(pid: t.Any) -> bool:
+    """Whether the process was stopped by a job-control signal, such as
+    ``SIGTSTP`` from ``Ctrl-Z``. This is best effort: it reads ``/proc`` on
+    Linux, asks ``ps`` on other POSIX systems and always says no where
+    neither is available, so suspend and resume events are only reported
+    on platforms that can tell.
+    """
+    if WIN or not isinstance(pid, int):
+        return False
+
+    try:
+        if sys.platform.startswith("linux"):
+            with open(f"/proc/{pid}/stat", "rb") as f:
+                stat = f.read()
+
+            # The state is the first field after the command name, which
+            # is in parentheses and may itself contain spaces or ")".
+            return stat.rpartition(b")")[2].split()[:1] == [b"T"]
+
+        import subprocess
+
+        out = subprocess.run(
+            ["ps", "-o", "stat=", "-p", str(pid)],
+            stdout=subprocess.PIPE,
+            stderr=subprocess.DEVNULL,
+            check=False,
+        ).stdout
+        return out.strip().startswith(b"T")
+    except (OSError, ValueError):
+        return False
+
+
+def _monitor_settings(
+    monitor_process: t.Any,
+) -> tuple[t.Callable[[str, int, str, float], None], float] | None:
+    """Turn the ``monitor_process`` argument into ``(callback, interval)``,
+    or ``None`` if monitoring is off. It is either the callback itself, or
+    a mapping or an object with a ``callback`` and, optionally, a
+    ``poll_interval`` in seconds.
+    """
+    if monitor_process is None or monitor_process is False:
+        return None
+
+    if callable(monitor_process):
+        return monitor_process, _ProcessMonitor.poll_interval
+
+    if isinstance(monitor_process, cabc.Mapping):
+        callback = monitor_process.get("callback")
+        interval = monitor_process.get("poll_interval")
+    else:
+        callback = getattr(monitor_process, "callback", None)
+        interval = getattr(monitor_process, "poll_interval", None)
+
+    if not callable(callback):
+        raise TypeError(
+            "monitor_process must be a callable or a configuration with a"
+            " callable 'callback'."
+        )
+
+    if interval is None:
+        interval = _ProcessMonitor.poll_interval
+    elif not isinstance(interval, (int, float)) or interval <= 0:
+        raise ValueError("monitor_process 'poll_interval' must be positive.")
+
+    return callback, float(interval)
+
+
+class _ProcessMonitor:
+    """Reports the life of an editor process to a callback from a
+    background thread, while the thread that started the editor keeps
+    blocking on it.
+
+    The callback is called as ``callback(event_type, process_id,
+    editor_command, timestamp)`` with one of these event types:
+
+    -   ``"start"`` once, when monitoring begins.
+    -   ``"suspend"`` and ``"resume"`` when the process is stopped and
+        continued again, where the platform can tell (see
+        :func:`_process_is_stopped`).
+    -   ``"terminate"`` once, after the process ended and before leaving
+        the ``with`` block, so every event has been delivered by then.
+
+    If the callback raises, a :class:`UserWarning` is issued and the
+    monitoring goes on with the next event.
+    """
+
+    poll_interval = 0.1
+
+    def __init__(
+        self,
+        process: t.Any,
+        editor_command: str,
+        callback: t.Callable[[str, int, str, float], None],
+        poll_interval: float = poll_interval,
+    ) -> None:
+        import threading
+
+        self.process = process
+        self.editor_command = editor_command
+        self.callback = callback
+        self.interval = poll_interval
+        self._finished = threading.Event()
+        self._thread = threading.Thread(
+            target=self._run, name="click-editor-monitor", daemon=True
+        )
+
+    def __enter__(self) -> _ProcessMonitor:
+        self._thread.start()
+        return self
+
+    def __exit__(
+        self,
+        exc_type: type[BaseException] | None,
+        exc_value: BaseException | None,
+        tb: TracebackType | None,
+    ) -> None:
+        self._finished.set()
+        self._thread.join()
+
+    def _emit(self, event_type: str) -> None:
+        try:
+            self.callback(
+                event_type, self.process.pid, self.editor_command, time.time()
+            )
+        except Exception as e:
+            warnings.warn(
+                f"The monitor_process callback failed on the {event_type!r}"
+                f" event: {type(e).__name__}: {e}",
+                UserWarning,
+                stacklevel=2,
+            )
+
+    def _run(self) -> None:
+        self._emit("start")
+        suspended = False
+
+        # wait() is true once the editor returned and __exit__ asked to
+        # finish; otherwise it times out and the process is looked at.
+        while not self._finished.wait(self.interval):
+            if self.process.poll() is not None:
+                break
+
+            if _process_is_stopped(self.process.pid) != suspended:
+                suspended = not suspended
+                self._emit("suspend" if suspended else "resume")
+
+        self._emit("terminate")
+
+
