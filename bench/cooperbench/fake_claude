#!/bin/sh
# A stand-in for claude in a run that spends no usage, so the whole path
# (the task images, the containers, the hub, the git server, CooperBench's
# scoring and the workflow's artifacts) runs on a GitHub-hosted runner
# before any token does. The claude-cli driver execs it in the task
# container with claude's own flags and the prompt after "--", and it
# answers in Claude Code's stream-json, so the driver reads it as an
# agent: it makes one small change in a file of its own, tells its peers
# through whatever coordination commands the arm installed (coop-send;
# the sdlc arm's claim, pull request and ready), writes patch.txt as the
# prompt asks, and ends with a result event of zero usage. Every pair it
# runs fails CooperBench's tests by design, since it implements nothing;
# what a fake run checks is that the infrastructure ran, so its report
# wants 0 in the Errors column of the Pass rates table and every agent
# Submitted. A coordination command that fails (a claim refused, a pull
# request not opened, a push refused, no peers listed) ends the agent
# with an error result, so the pair shows in that column rather than as
# a pair that walked the protocol's path.
# `fake_claude --version` prints a version, so the overlay can label the
# image with it as it labels one with the real binary's; the version
# carries this file's checksum, so a changed fake agent reaches an image
# already overlaid with an earlier one (prepare_task.sh overlays again
# when the label differs). It is POSIX sh, since the Alpine task images
# have no bash.
set -u
if [ "${1:-}" = "--version" ]; then
    echo "0.0.0-fake.$(cksum < "$0" | cut -d' ' -f1) (Claude Code)"
    exit 0
fi
started=$(( $(date +%s) * 1000 ))
prompt=""
after_dashes=0
for word in "$@"; do
    if [ "$after_dashes" = 1 ]; then prompt=$word; break; fi
    [ "$word" = "--" ] && after_dashes=1
done
agent=${COORD_RPC_URL##*/}
agent=${agent:-agent}

json_text() {
    # The text as the content of a JSON string: backslashes and quotes
    # escaped, newlines made spaces, so no text breaks an event's line.
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr '\n' ' '
}

say() {
    # One assistant event, as Claude Code streams one.
    printf '{"type":"assistant","message":{"role":"assistant","content":[{"type":"text","text":"%s"}]}}\n' "$(json_text "$1")"
}

fail() {
    # The result event of an agent that could not do its part, with the
    # reason, so the driver records the agent in Error and the pair is
    # set apart rather than counted as one that walked the path.
    say "fake agent $agent: $1"
    ended=$(( $(date +%s) * 1000 ))
    printf '{"type":"result","subtype":"error_during_execution","is_error":true,"num_turns":3,"total_cost_usd":0,"duration_ms":%d,"duration_api_ms":0,"result":"%s","usage":{"input_tokens":0,"output_tokens":0,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}\n' \
        $((ended - started)) "$(json_text "$1")"
    exit 1
}

printf '{"type":"system","subtype":"init","session_id":"fake-%s","tools":["Bash"],"mcp_servers":[],"model":"%s","claude_code_version":"%s"}\n' \
    "$(json_text "$agent")" "$(json_text "${ANTHROPIC_MODEL:-fake}")" "$("$0" --version | cut -d' ' -f1)"
cd /workspace/repo 2>/dev/null || true
file="coordbench_fake_$agent.txt"
echo "A change by the fake agent $agent, for the infrastructure check; it implements no feature." > "$file"
git add -N "$file" >/dev/null 2>&1 || true
say "fake agent $agent: changed $file"

if command -v coop-agents >/dev/null 2>&1; then
    peers=$(coop-agents 2>/dev/null) || fail "coop-agents failed"
    [ -n "$peers" ] || fail "coop-agents listed no agent"
    for peer in $peers; do
        [ "$peer" = "$agent" ] && continue
        coop-send "$peer" "fake $agent here: I change only $file" >/dev/null 2>&1 || fail "coop-send to $peer failed"
    done
    coop-recv >/dev/null 2>&1 || true
    say "fake agent $agent: told the peers"
fi

issue=$(printf '%s' "$prompt" | grep -o 'Your issue is \*\*#[0-9]*' | grep -o '[0-9]*$' || true)
if [ -n "$issue" ] && command -v sdlc-claim >/dev/null 2>&1; then
    base=$(git rev-parse HEAD)
    sdlc-claim "$issue" >/dev/null 2>&1 || fail "sdlc-claim $issue failed"
    git checkout -q -b "claude/$issue" 2>/dev/null || git checkout -q "claude/$issue" || fail "no branch claude/$issue"
    git add "$file"
    git -c user.name="$agent" -c user.email=agent@cooperbench.local commit -q -m "fake: $file" || fail "commit failed"
    git push -q team "claude/$issue" >/dev/null 2>&1 || fail "push of claude/$issue failed"
    sdlc-pr "$issue" >/dev/null 2>&1 || fail "sdlc-pr $issue failed"
    answer=""
    status=0
    for _ in 1 2 3; do
        # sdlc-ready exits 0 with the pull request's state, 3 when main
        # moved past the branch (the gate's EXIT_MAIN_MOVED, its text on
        # stderr): bring main in and ask again; anything else is a failure.
        status=0
        answer=$(sdlc-ready "$issue" 2>&1) || status=$?
        case $status in
            0) break ;;
            3)
                git fetch -q team >/dev/null 2>&1 || fail "fetch failed"
                git merge -q --no-edit team/main >/dev/null 2>&1 || { git checkout --theirs . ; git add -A; git commit -q -m "merge main" || fail "merge of main failed"; }
                git push -q team "claude/$issue" >/dev/null 2>&1 || fail "push after main moved failed" ;;
            *) fail "sdlc-ready $issue failed ($status): $(printf '%s' "$answer" | head -n 1)" ;;
        esac
    done
    [ "$status" -eq 0 ] || fail "sdlc-ready $issue still says main moved after three tries"
    # The prompt's rule: patch.txt is the integrated diff once the pull
    # request has merged, else the branch's own, as the arm's prompt says.
    case $answer in
        *merged*)
            git fetch -q team >/dev/null 2>&1 || fail "fetch failed"
            git diff "$base" team/main > patch.txt || fail "diff of team/main failed" ;;
        *)
            git diff "$base" HEAD > patch.txt || fail "diff failed" ;;
    esac
    say "fake agent $agent: claimed, opened and readied #$issue (${answer%%:*})"
else
    git diff > patch.txt 2>/dev/null || true
fi
ended=$(( $(date +%s) * 1000 ))
printf '{"type":"result","subtype":"success","is_error":false,"num_turns":3,"total_cost_usd":0,"duration_ms":%d,"duration_api_ms":0,"result":"Done.","usage":{"input_tokens":0,"output_tokens":0,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}\n' \
    $((ended - started))
